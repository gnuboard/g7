{
    "comment": "본인인증 화면에 NHN KCP 전용 안내를 끼워 넣는다. 인증 진행 상태(시작 전·진행 중)에 따라 다른 문안을 보여야 하는데 그 상태는 코어가 전역에 실어 주고 문안은 제공사마다 다르다",
    "extension_point": "identity_provider_ui:provider",
    "mode": "append",
    "priority": 100,
    "components": [
        {
            "comment": "시작 전 상태 — provider_id=nhnkcp && !providerInProgress",
            "type": "basic",
            "name": "Div",
            "if": "{{_global.identityChallenge?.provider_id === 'nhnkcp' && !(_global.identityChallenge?.providerInProgress)}}",
            "props": {
                "className": "verificationnhnkcp:space-y-4"
            },
            "children": [
                {
                    "comment": "헤더 — 아이콘 + 제목 + 안내",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "verificationnhnkcp:flex verificationnhnkcp:items-center verificationnhnkcp:flex-col verificationnhnkcp:text-center verificationnhnkcp:space-y-2 verificationnhnkcp:pt-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "verificationnhnkcp:inline-flex verificationnhnkcp:items-center verificationnhnkcp:justify-center verificationnhnkcp:w-14 verificationnhnkcp:h-14 verificationnhnkcp:bg-blue-100 verificationnhnkcp:dark:bg-blue-900/40 verificationnhnkcp:rounded-full"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "mobile-screen",
                                        "className": "verificationnhnkcp:text-2xl verificationnhnkcp:leading-none verificationnhnkcp:text-blue-600 verificationnhnkcp:dark:text-blue-400"
                                    }
                                }
                            ]
                        },
                        {
                            "comment": "성인인증 purpose 전용 제목",
                            "type": "basic",
                            "name": "H3",
                            "if": "{{_global.identityChallenge?.purpose === 'nhnkcp.adult_verification'}}",
                            "props": {
                                "className": "verificationnhnkcp:text-base verificationnhnkcp:font-semibold verificationnhnkcp:text-gray-900 verificationnhnkcp:dark:text-white"
                            },
                            "text": "$t:sirsoft-verification_nhnkcp.modal.adult_title"
                        },
                        {
                            "comment": "기본 본인확인 제목 (signup/password_reset/self_update/sensitive_action 등)",
                            "type": "basic",
                            "name": "H3",
                            "if": "{{_global.identityChallenge?.purpose !== 'nhnkcp.adult_verification'}}",
                            "props": {
                                "className": "verificationnhnkcp:text-base verificationnhnkcp:font-semibold verificationnhnkcp:text-gray-900 verificationnhnkcp:dark:text-white"
                            },
                            "text": "$t:sirsoft-verification_nhnkcp.modal.title"
                        },
                        {
                            "comment": "성인인증 purpose 전용 설명",
                            "type": "basic",
                            "name": "P",
                            "if": "{{_global.identityChallenge?.purpose === 'nhnkcp.adult_verification'}}",
                            "props": {
                                "className": "verificationnhnkcp:text-sm verificationnhnkcp:text-gray-600 verificationnhnkcp:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-verification_nhnkcp.modal.adult_description"
                        },
                        {
                            "comment": "기본 본인확인 설명 (데스크톱)",
                            "type": "basic",
                            "name": "P",
                            "if": "{{_global.identityChallenge?.purpose !== 'nhnkcp.adult_verification'}}",
                            "responsive": {
                                "portable": {
                                    "classMerge": "verificationnhnkcp:hidden verification-nhnkcp-hidden"
                                }
                            },
                            "props": {
                                "className": "verificationnhnkcp:text-sm verificationnhnkcp:text-gray-600 verificationnhnkcp:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-verification_nhnkcp.modal.description"
                        },
                        {
                            "comment": "모바일 전용 안내 — 페이지가 인증 화면으로 이동함을 알린다",
                            "type": "basic",
                            "name": "P",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "verificationnhnkcp:text-sm verificationnhnkcp:text-gray-600 verificationnhnkcp:dark:text-gray-400"
                                    }
                                }
                            },
                            "props": {
                                "className": "verificationnhnkcp:text-sm verificationnhnkcp:text-gray-600 verificationnhnkcp:dark:text-gray-400 verificationnhnkcp:hidden verification-nhnkcp-hidden"
                            },
                            "text": "$t:sirsoft-verification_nhnkcp.modal.mobile_description"
                        }
                    ]
                },
                {
                    "comment": "본인확인 시작 버튼 — 사용자 제스처 컨텍스트에서 window.open 호출 (팝업 차단 회피)",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sirsoft-verification_nhnkcp.startAuth"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "verificationnhnkcp:w-full verificationnhnkcp:inline-flex verificationnhnkcp:items-center verificationnhnkcp:justify-center verificationnhnkcp:gap-2 verificationnhnkcp:px-4 verificationnhnkcp:py-3 verificationnhnkcp:bg-blue-600 verificationnhnkcp:dark:bg-blue-600 verificationnhnkcp:text-white verificationnhnkcp:rounded-lg verificationnhnkcp:hover:bg-blue-700 verificationnhnkcp:dark:hover:bg-blue-700 verificationnhnkcp:font-semibold verificationnhnkcp:transition-colors"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:sirsoft-verification_nhnkcp.modal.start_button"
                        },
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "arrow-right",
                                "className": "verificationnhnkcp:text-sm verificationnhnkcp:leading-none"
                            }
                        }
                    ]
                },
                {
                    "comment": "테스트 모드 안내 — 운영자가 테스트 환경임을 즉시 식별할 수 있게 한다",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_global.identityChallenge?.public_payload?.is_test_mode === true}}",
                    "props": {
                        "className": "verificationnhnkcp:p-2 verificationnhnkcp:bg-gray-50 verificationnhnkcp:dark:bg-gray-800 verificationnhnkcp:border verificationnhnkcp:border-gray-200 verificationnhnkcp:dark:border-gray-700 verificationnhnkcp:rounded verificationnhnkcp:text-xs verificationnhnkcp:text-gray-500 verificationnhnkcp:dark:text-gray-400 verificationnhnkcp:text-center"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:sirsoft-verification_nhnkcp.modal.test_mode_notice"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "진행 중 상태 — provider_id=nhnkcp && providerInProgress. 표준창이 열린 뒤 결과 대기",
            "type": "basic",
            "name": "Div",
            "if": "{{_global.identityChallenge?.provider_id === 'nhnkcp' && (_global.identityChallenge?.providerInProgress)}}",
            "props": {
                "className": "verificationnhnkcp:flex verificationnhnkcp:items-center verificationnhnkcp:flex-col verificationnhnkcp:text-center verificationnhnkcp:space-y-4 verificationnhnkcp:py-6",
                "role": "status",
                "aria-live": "polite"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "spinner",
                        "spin": true,
                        "className": "verificationnhnkcp:text-3xl verificationnhnkcp:leading-none verificationnhnkcp:text-blue-600 verificationnhnkcp:dark:text-blue-400"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "verificationnhnkcp:text-sm verificationnhnkcp:font-medium verificationnhnkcp:text-gray-900 verificationnhnkcp:dark:text-white"
                    },
                    "text": "$t:sirsoft-verification_nhnkcp.modal.in_progress.title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "verificationnhnkcp:p-3 verificationnhnkcp:bg-amber-50 verificationnhnkcp:dark:bg-amber-900/20 verificationnhnkcp:border verificationnhnkcp:border-amber-200 verificationnhnkcp:dark:border-amber-800 verificationnhnkcp:rounded verificationnhnkcp:text-xs verificationnhnkcp:text-yellow-700 verificationnhnkcp:dark:text-yellow-300"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "verificationnhnkcp:inline-flex verificationnhnkcp:items-start verificationnhnkcp:gap-1.5"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "circle-info",
                                        "className": "verificationnhnkcp:mt-0.5"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-verification_nhnkcp.modal.in_progress.hint"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
