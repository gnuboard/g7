{
    "comment": "관리자 회원 상세에 동의 이력 탭을 덧붙이는 조각 — 탭을 새로 만들지 않고 기존 탭 목록 props 에 끼워 넣는다.\n  지금의 동의 값(전체 동의, 채널, 법적 동의)은 회원 항목으로 선언되어 코어 회원 화면이 그리므로 여기서는 이력만 보인다.",
    "target_layout": "admin_user_detail",
    "priority": 200,
    "injections": [
        {
            "target_id": "user_detail_tabs",
            "position": "inject_props",
            "props": {
                "tabs": {
                    "_append": [
                        {
                            "id": "ext_marketing",
                            "label": "$t:admin.users.form.sections.marketing_consent",
                            "iconName": "puzzle-piece"
                        }
                    ]
                }
            }
        },
        {
            "target_id": "extension_tab_content",
            "position": "append_child",
            "components": [
                {
                    "id": "ext_marketing_content",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "id": "ext_marketing",
                        "className": "marketing:scroll-mt-32"
                    },
                    "children": [
                        {
                            "id": "section_marketing_consent",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "marketing:bg-white marketing:dark:bg-gray-800 marketing:border marketing:border-gray-200 marketing:dark:border-gray-700 marketing:rounded-lg marketing:p-6 marketing:mb-6"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "marketing-flex-between marketing:mb-4"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "marketing:flex marketing:items-center marketing:gap-2"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "bullhorn",
                                                        "size": "md",
                                                        "className": "marketing:text-gray-600 marketing:dark:text-gray-400"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "H3",
                                                    "props": {
                                                        "className": "marketing-section-heading"
                                                    },
                                                    "text": "$t:admin.users.form.sections.marketing_consent"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "composite",
                                            "name": "ExtensionBadge",
                                            "props": {
                                                "type": "plugin",
                                                "identifier": "sirsoft-marketing",
                                                "installedPlugins": "{{_global.installedPlugins}}"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "comment": "동의 이력 테이블 — 지금의 동의 값은 코어 회원 화면이 회원 항목으로 그린다",
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "H3",
                                            "props": {
                                                "className": "marketing:text-gray-900 marketing:dark:text-white marketing:text-sm marketing:font-semibold marketing:mb-3"
                                            },
                                            "text": "$t:admin.users.detail.consent_history"
                                        },
                                        {
                                            "comment": "이력이 없는 경우",
                                            "type": "basic",
                                            "name": "Div",
                                            "if": "{{user !== undefined && user !== null && (!user?.data?.consent_histories || user?.data?.consent_histories?.length === 0)}}",
                                            "props": {
                                                "className": "marketing:text-sm marketing:text-gray-500 marketing:dark:text-gray-400 marketing:py-4 marketing:text-center"
                                            },
                                            "text": "$t:sirsoft-marketing.no_consent_history"
                                        },
                                        {
                                            "comment": "이력 테이블",
                                            "type": "basic",
                                            "name": "Div",
                                            "if": "{{user?.data?.consent_histories?.length > 0}}",
                                            "props": {
                                                "className": "marketing:max-h-60 marketing:overflow-y-auto marketing:overflow-x-auto"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Table",
                                                    "props": {
                                                        "className": "marketing-divider-list marketing:min-w-full"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Thead",
                                                            "props": {
                                                                "className": "marketing:sticky marketing:top-0 marketing:bg-gray-50 marketing:dark:bg-gray-900 marketing:z-10"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "basic",
                                                                    "name": "Tr",
                                                                    "children": [
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Th",
                                                                            "props": {
                                                                                "className": "marketing-text-table-header marketing:px-2 marketing:py-1.5 marketing:text-left"
                                                                            },
                                                                            "text": "$t:sirsoft-marketing.history_date"
                                                                        },
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Th",
                                                                            "props": {
                                                                                "className": "marketing-text-table-header marketing:px-2 marketing:py-1.5 marketing:text-left"
                                                                            },
                                                                            "text": "$t:sirsoft-marketing.history_channel_key"
                                                                        },
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Th",
                                                                            "props": {
                                                                                "className": "marketing-text-table-header marketing:px-2 marketing:py-1.5 marketing:text-left"
                                                                            },
                                                                            "text": "$t:sirsoft-marketing.history_action"
                                                                        },
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Th",
                                                                            "props": {
                                                                                "className": "marketing-text-table-header marketing:px-2 marketing:py-1.5 marketing:text-left"
                                                                            },
                                                                            "text": "$t:sirsoft-marketing.history_source"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Tbody",
                                                            "props": {
                                                                "className": "marketing-divider-list"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "basic",
                                                                    "name": "Tr",
                                                                    "iteration": {
                                                                        "source": "{{user?.data?.consent_histories ?? []}}",
                                                                        "item_var": "history",
                                                                        "index_var": "histIdx"
                                                                    },
                                                                    "children": [
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Td",
                                                                            "props": {
                                                                                "className": "marketing:text-gray-900 marketing:dark:text-white marketing:px-2 marketing:py-1.5 marketing:text-xs marketing:whitespace-nowrap"
                                                                            },
                                                                            "text": "{{history?.created_at ?? '-'}}"
                                                                        },
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Td",
                                                                            "props": {
                                                                                "className": "marketing:text-gray-900 marketing:dark:text-white marketing:px-2 marketing:py-1.5 marketing:text-xs"
                                                                            },
                                                                            "text": "{{history?.channel_key === 'marketing_consent' ? '$t:sirsoft-marketing.marketing_consent' : history?.channel_key === 'third_party_consent' ? '$t:sirsoft-marketing.third_party_consent' : history?.channel_key === 'info_disclosure' ? '$t:sirsoft-marketing.info_disclosure' : ((user?.data?.channels ?? []).find(ch => ch.key === history?.channel_key)?.label ?? history?.channel_key ?? '-')}}"
                                                                        },
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Td",
                                                                            "props": {
                                                                                "className": "marketing:px-2 marketing:py-1.5 marketing:text-xs"
                                                                            },
                                                                            "children": [
                                                                                {
                                                                                    "type": "basic",
                                                                                    "name": "Span",
                                                                                    "props": {
                                                                                        "className": "{{history?.action === 'granted' ? 'marketing:text-green-700 marketing:dark:text-green-400' : 'marketing:text-red-600 marketing:dark:text-red-400'}}"
                                                                                    },
                                                                                    "text": "{{history?.action === 'granted' ? '$t:sirsoft-marketing.action_granted' : '$t:sirsoft-marketing.action_revoked'}}"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Td",
                                                                            "props": {
                                                                                "className": "marketing:px-2 marketing:py-1.5 marketing:text-xs marketing:text-gray-500 marketing:dark:text-gray-400"
                                                                            },
                                                                            "text": "{{history?.source === 'register' ? '$t:sirsoft-marketing.source_register' : history?.source === 'admin' ? '$t:sirsoft-marketing.source_admin' : '$t:sirsoft-marketing.source_profile'}}"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
