{
    "name": "sirsoft/cdn_cloudfront",
    "description": "CloudFront CDN plugin for G7 (public thumbnail disk and cache invalidation)",
    "type": "g7-plugin",
    "license": "MIT",
    "version": "1.0.1",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\Sirsoft\\CdnCloudfront\\": [
                "src/",
                "./"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\Sirsoft\\CdnCloudfront\\Tests\\": "tests/"
        }
    }
}
