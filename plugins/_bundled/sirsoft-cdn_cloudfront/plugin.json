{
    "identifier": "sirsoft-cdn_cloudfront",
    "vendor": "sirsoft",
    "name": {
        "ko": "CloudFront CDN",
        "en": "CloudFront CDN"
    },
    "version": "1.0.0",
    "license": "MIT",
    "description": {
        "ko": "공개 이미지 썸네일을 Amazon S3 에 저장하고 CloudFront 주소로 내보내며, 썸네일이 지워지면 CDN 캐시를 자동으로 무효화합니다.",
        "en": "Stores public image thumbnails on Amazon S3, serves them through CloudFront, and invalidates the CDN cache automatically when thumbnails are removed."
    },
    "g7_version": ">=7.2.0",
    "dependencies": {
        "modules": {},
        "plugins": {}
    },
    "integrations": {
        "modules": {},
        "plugins": {}
    },
    "github_url": null,
    "github_changelog_url": null,
    "assets": {
        "css": {
            "entry": "resources/css/main.css",
            "output": "dist/css/plugin.css",
            "namespace": "cdncf"
        }
    },
    "loading": {
        "strategy": "global",
        "priority": 100
    }
}
