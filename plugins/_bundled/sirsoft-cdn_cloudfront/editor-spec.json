{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "레이아웃 편집기 스펙 — CloudFront CDN 플러그인. admin/plugin_settings.g7.html 의 데이터소스 2종(settings: 코어 플러그인 설정 응답과 입력칸 name= 전수, cdncfPurgeStatus: PurgeService::status() 6필드) 응답 shape 와 화면 변종을 담는다. 자격 증명 칸은 서버가 가려서 내려주는 모양으로만 싣고, 이 파일이 릴리즈 페이로드로 배포되므로 실제 키나 배포 값을 싣지 않는다.",
  "pluginId": "sirsoft-cdn_cloudfront",
  "version": "1.0.0",
  "description": "CloudFront CDN 플러그인 레이아웃 편집기 샘플 데이터·화면 상태.",
  "sampleData": {
    "byDataSourceId": {
      "settings": {
        "data": {
          "cdn_base_url": "https://cdn.example.com",
          "distribution_id": "E1EXAMPLEDIST",
          "access_key": "********",
          "secret_key": "********",
          "purge_enabled": true,
          "abilities": {
            "can_update": true
          }
        }
      },
      "cdncfPurgeStatus": {
        "data": {
          "pending": 2,
          "abandoned": 1,
          "last_error": "AccessDenied: User is not authorized to perform cloudfront:CreateInvalidation",
          "last_failed_at": "2026-11-05T10:00:00+09:00",
          "last_success_at": "2026-11-05T09:30:00+09:00",
          "purge_ready": true
        }
      }
    }
  },
