{
    "comment": "관리자 주문 상세에 토스페이먼츠 결제 정보 패널을 덧붙인다. 가상계좌 입금 정보와 에스크로 여부처럼 이 PG 에만 있는 값이라 코어 주문 화면이 알 수 없다",
    "target_layout": "admin_ecommerce_order_detail",
    "injections": [
        {
            "target_id": "tab_content_area",
            "position": "append_child",
            "components": [
                {
                    "id": "tosspayments_payment_panel",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{(order.data?.payments?.filter(p => p.pg_provider === 'tosspayments' && p.transaction_id) ?? []).length > 0}}",
                    "props": {
                        "className": "pay-tosspayments-admin-card"
                    },
                    "children": [
                        {
                            "id": "tosspayments_payment_header",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "paytosspayments:flex paytosspayments:items-center paytosspayments:gap-2 paytosspayments:mb-4"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "paytosspayments:w-1.5 paytosspayments:h-4 paytosspayments:bg-blue-500 paytosspayments:rounded-full paytosspayments:flex-shrink-0"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "H3",
                                    "props": {
                                        "className": "paytosspayments:text-sm paytosspayments:font-semibold paytosspayments:text-gray-800 paytosspayments:dark:text-gray-200"
                                    },
                                    "text": "$t:sirsoft-tosspayments.admin.payment_panel_title"
                                }
                            ]
                        },
                        {
                            "id": "tosspayments_payment_rows",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "paytosspayments:space-y-2"
                            },
                            "children": [
                                {
                                    "id": "tosspayments_escrow_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!order.data?.payment?.is_escrow}}",
                                    "props": {
                                        "className": "pay-tosspayments-flex-between paytosspayments:text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "paytosspayments:text-sm pay-tosspayments-text-muted"
                                            },
                                            "text": "$t:sirsoft-tosspayments.admin.escrow_label"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "paytosspayments:inline-flex paytosspayments:items-center paytosspayments:gap-1 paytosspayments:px-2 paytosspayments:py-0.5 paytosspayments:rounded-full paytosspayments:text-xs paytosspayments:font-semibold paytosspayments:bg-blue-100 paytosspayments:text-blue-800 paytosspayments:dark:bg-blue-900/30 paytosspayments:dark:text-blue-300"
                                            },
                                            "text": "$t:sirsoft-tosspayments.admin.escrow_yes"
                                        }
                                    ]
                                },
                                {
                                    "id": "tosspayments_vbank_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!order.data?.payment?.vbank_number}}",
                                    "props": {
                                        "className": "pay-tosspayments-flex-between paytosspayments:text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "paytosspayments:text-sm pay-tosspayments-text-muted"
                                            },
                                            "text": "$t:sirsoft-tosspayments.admin.vbank_label"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "paytosspayments:text-gray-900 paytosspayments:dark:text-white paytosspayments:font-medium"
                                            },
                                            "text": "{{(order.data?.payment?.vbank_name ?? '') + ' ' + (order.data?.payment?.vbank_number ?? '') + ' (' + (order.data?.payment?.vbank_holder ?? '') + ')'}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "tosspayments_vbank_due_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!order.data?.payment?.vbank_due_at_formatted}}",
                                    "props": {
                                        "className": "pay-tosspayments-flex-between paytosspayments:text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "paytosspayments:text-sm pay-tosspayments-text-muted"
                                            },
                                            "text": "$t:sirsoft-tosspayments.admin.vbank_due_label"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "paytosspayments:text-gray-900 paytosspayments:dark:text-white paytosspayments:font-medium"
                                            },
                                            "text": "{{order.data?.payment?.vbank_due_at_formatted ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "tosspayments_receipt_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!order.data?.payment?.pg_receipt_url}}",
                                    "props": {
                                        "className": "pay-tosspayments-flex-between paytosspayments:text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "paytosspayments:text-sm pay-tosspayments-text-muted"
                                            },
                                            "text": "$t:sirsoft-tosspayments.admin.receipt_label"
                                        },
                                        {
                                            "id": "tosspayments_receipt_link",
                                            "type": "basic",
                                            "name": "A",
                                            "props": {
                                                "href": "{{order.data.payment.pg_receipt_url}}",
                                                "target": "_blank",
                                                "rel": "noopener noreferrer",
                                                "className": "paytosspayments:text-sm paytosspayments:text-blue-600 paytosspayments:dark:text-blue-400 paytosspayments:hover:underline"
                                            },
                                            "text": "$t:sirsoft-tosspayments.admin.receipt_view"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
