{
  "target_layout": "admin_ecommerce_order_detail",
  "injections": [
    {
      "target_id": "tab_content_area",
      "position": "append_child",
      "components": [
        {
          "id": "tosspayments_payment_panel",
          "type": "basic",
          "name": "Div",
          "if": "{{(order.data?.payments?.filter(p => p.pg_provider === 'tosspayments' && p.transaction_id) ?? []).length > 0}}",
          "props": {
            "className": "admin-card"
          },
          "children": [
            {
              "id": "tosspayments_payment_header",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex-center gap-2 mb-4"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "w-1.5 h-4 bg-blue-500 rounded-full flex-shrink-0"
                  }
                },
                {
                  "type": "basic",
                  "name": "H3",
                  "props": {
                    "className": "text-sm font-semibold text-gray-800 dark:text-gray-200"
                  },
                  "text": "$t:sirsoft-tosspayments.admin.payment_panel_title"
                }
              ]
            },
            {
              "id": "tosspayments_payment_rows",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "space-y-2"
              },
              "children": [
                {
                  "id": "tosspayments_escrow_row",
                  "type": "basic",
                  "name": "Div",
                  "if": "{{!!order.data?.payment?.is_escrow}}",
                  "props": {
                    "className": "flex-between text-sm"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label-subtle"
                      },
                      "text": "$t:sirsoft-tosspayments.admin.escrow_label"
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300"
                      },
                      "text": "$t:sirsoft-tosspayments.admin.escrow_yes"
                    }
                  ]
                },
                {
                  "id": "tosspayments_vbank_row",
                  "type": "basic",
                  "name": "Div",
                  "if": "{{!!order.data?.payment?.vbank_number}}",
                  "props": {
                    "className": "flex-between text-sm"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label-subtle"
                      },
                      "text": "$t:sirsoft-tosspayments.admin.vbank_label"
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-primary font-medium"
                      },
                      "text": "{{(order.data?.payment?.vbank_name ?? '') + ' ' + (order.data?.payment?.vbank_number ?? '') + ' (' + (order.data?.payment?.vbank_holder ?? '') + ')'}}"
                    }
                  ]
                },
                {
                  "id": "tosspayments_vbank_due_row",
                  "type": "basic",
                  "name": "Div",
                  "if": "{{!!order.data?.payment?.vbank_due_at_formatted}}",
                  "props": {
                    "className": "flex-between text-sm"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label-subtle"
                      },
                      "text": "$t:sirsoft-tosspayments.admin.vbank_due_label"
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-primary font-medium"
                      },
                      "text": "{{order.data?.payment?.vbank_due_at_formatted ?? ''}}"
                    }
                  ]
                },
                {
                  "id": "tosspayments_receipt_row",
                  "type": "basic",
                  "name": "Div",
                  "if": "{{!!order.data?.payment?.pg_receipt_url}}",
                  "props": {
                    "className": "flex-between text-sm"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label-subtle"
                      },
                      "text": "$t:sirsoft-tosspayments.admin.receipt_label"
                    },
                    {
                      "id": "tosspayments_receipt_link",
                      "type": "basic",
                      "name": "A",
                      "props": {
                        "href": "{{order.data.payment.pg_receipt_url}}",
                        "target": "_blank",
                        "rel": "noopener noreferrer",
                        "className": "text-sm text-blue-600 dark:text-blue-400 hover:underline"
                      },
                      "text": "$t:sirsoft-tosspayments.admin.receipt_view"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
