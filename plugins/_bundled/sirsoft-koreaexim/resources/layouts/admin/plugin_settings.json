{
    "version": "1.0.0",
    "layout_name": "plugin_settings",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:sirsoft-koreaexim.title",
        "description": "$t:sirsoft-koreaexim.description"
    },
    "data_sources": [
        {
            "id": "settings",
            "label_key": "$t:sirsoft-koreaexim.settings_tab",
            "type": "api",
            "endpoint": "/api/admin/plugins/sirsoft-koreaexim/settings",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "initLocal": "form",
            "refetchOnMount": true
        },
        {
            "id": "koreaeximStatus",
            "label_key": "$t:sirsoft-koreaexim.status",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-koreaexim/admin/status",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "refetchOnMount": true,
            "errorHandling": {
                "403": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                }
            }
        },
        {
            "id": "koreaeximRecentRuns",
            "if": "{{(query.tab ?? 'settings') === 'settings'}}",
            "label_key": "$t:sirsoft-koreaexim.recent",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-koreaexim/admin/runs",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "params": {
                "per_page": 5
            },
            "fallback": {
                "data": {
                    "data": [],
                    "pagination": {
                        "current_page": 1,
                        "last_page": 1,
                        "total": 0
                    }
                }
            }
        },
        {
            "id": "koreaeximRuns",
            "if": "{{query.tab === 'history'}}",
            "label_key": "$t:sirsoft-koreaexim.history_tab",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-koreaexim/admin/runs",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "params": {
                "page": "{{query.page ?? 1}}",
                "per_page": 20,
                "status": "{{query.status}}",
                "trigger": "{{query.trigger}}",
                "date_from": "{{query.date_from}}",
                "date_to": "{{query.date_to}}"
            },
            "fallback": {
                "data": {
                    "data": [],
                    "pagination": {
                        "current_page": 1,
                        "last_page": 1,
                        "total": 0
                    }
                }
            },
            "errorHandling": {
                "403": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                }
            }
        },
        {
            "id": "koreaeximNotificationDefinitions",
            "if": "{{(query.tab ?? 'settings') === 'settings'}}",
            "label_key": "$t:sirsoft-koreaexim.notifications",
            "type": "api",
            "endpoint": "/api/admin/notification-definitions?extension_type=plugin&extension_identifier=sirsoft-koreaexim",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "params": {
                "template_channel": "{{query.notification_channel ?? 'mail'}}"
            },
            "fallback": {
                "data": {
                    "data": [],
                    "pagination": {
                        "current_page": 1,
                        "last_page": 1,
                        "total": 0
                    }
                }
            }
        }
    ],
    "computed": {
        "activeTab": "{{query.tab || _global.activeKoreaeximTab || 'settings'}}",
        "isReadOnly": "{{koreaeximStatus?.data?.abilities?.can_manage !== true}}",
        "isNotificationReadOnly": "{{koreaeximNotificationDefinitions?.data?.abilities?.can_update !== true}}"
    },
    "permissions": [
        "sirsoft-koreaexim.exchange_rate.view"
    ],
    "slots": {
        "content": [
            {
                "id": "koreaexim_settings_content",
                "type": "basic",
                "name": "Div",
                "dataKey": "form",
                "trackChanges": true,
                "props": {
                    "className": "admin-page-content-responsive"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:sirsoft-koreaexim.title",
                            "description": "$t:sirsoft-koreaexim.description"
                        },
                        "children": [
                            {
                                "id": "koreaexim_back",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/plugins"
                                        }
                                    }
                                ],
                                "props": {
                                    "type": "button",
                                    "className": "btn btn-secondary whitespace-nowrap",
                                    "aria-label": "$t:admin.plugins.back_to_list"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "arrow-left"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.back"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "koreaexim_tab_navigation",
                        "type": "composite",
                        "name": "TabNavigation",
                        "actions": [
                            {
                                "type": "change",
                                "event": "onTabChange",
                                "handler": "sequence",
                                "actions": [
                                    {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "activeKoreaeximTab": "{{$args[0]}}"
                                        }
                                    },
                                    {
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/plugins/sirsoft-koreaexim/settings",
                                            "mergeQuery": true,
                                            "replace": true,
                                            "query": {
                                                "tab": "{{$args[0]}}"
                                            }
                                        }
                                    }
                                ]
                            }
                        ],
                        "props": {
                            "activeTabId": "{{_computed.activeTab}}",
                            "variant": "default",
                            "className": "sticky-tab-nav-responsive",
                            "tabs": [
                                {
                                    "id": "settings",
                                    "label": "$t:sirsoft-koreaexim.settings_tab"
                                },
                                {
                                    "id": "history",
                                    "label": "$t:sirsoft-koreaexim.history_tab"
                                }
                            ]
                        }
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_computed.isReadOnly}}",
                        "props": {
                            "role": "status",
                            "className": "alert-info mb-4"
                        },
                        "text": "$t:sirsoft-koreaexim.read_only"
                    },
                    {
                        "id": "koreaexim_tab_content",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "tab-content"
                        },
                        "children": [
                            {
                                "partial": "partials/plugin_settings/_tab_settings.json"
                            },
                            {
                                "partial": "partials/plugin_settings/_tab_history.json"
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_computed.activeTab === 'settings'}}",
                        "props": {
                            "className": "sticky-footer-buttons"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/plugins"
                                        }
                                    }
                                ],
                                "props": {
                                    "type": "button",
                                    "className": "btn btn-secondary"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.cancel"
                                    }
                                ]
                            },
                            {
                                "id": "koreaexim_save",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "isSaving": true,
                                                    "errors": null
                                                }
                                            },
                                            {
                                                "handler": "apiCall",
                                                "target": "/api/admin/plugins/sirsoft-koreaexim/settings",
                                                "auth_required": true,
                                                "params": {
                                                    "method": "PUT",
                                                    "body": "{{_local.form}}"
                                                },
                                                "onSuccess": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "hasChanges": false
                                                        }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": {
                                                            "dataSourceId": "settings"
                                                        }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": {
                                                            "dataSourceId": "koreaeximStatus"
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "success",
                                                            "message": "$t:sirsoft-koreaexim.saved"
                                                        }
                                                    }
                                                ],
                                                "onError": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "errors": "{{error.errors}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "error",
                                                            "message": "{{error.message}}"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "props": {
                                    "type": "button",
                                    "disabled": "{{_computed.isReadOnly || !_local.hasChanges || _local.isSaving}}",
                                    "className": "btn btn-primary disabled:opacity-50 disabled:cursor-not-allowed"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.save"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "modals": [
        {
            "partial": "partials/plugin_settings/_modal_notification_template_edit.json"
        },
        {
            "partial": "partials/plugin_settings/_modal_notification_template_preview.json"
        },
        {
            "partial": "partials/plugin_settings/_modal_notification_definition_reset.json"
        }
    ]
}
