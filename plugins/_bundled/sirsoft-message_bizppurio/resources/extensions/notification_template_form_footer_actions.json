                    },
                    "onSuccess": [
                      {
                        "handler": "apiCall",
                        "auth_required": true,
                        "target": "/api/plugins/sirsoft-message_bizppurio/admin/templates/{{response.data?.template?.id}}/request",
                        "params": {
                          "method": "POST",
                          "body": {
                            "comment": "{{_global.bz_tpl_modal?.request_comment ?? ''}}"
