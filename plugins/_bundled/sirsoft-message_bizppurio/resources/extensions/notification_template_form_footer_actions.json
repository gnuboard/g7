                            "target": "{{extensionPointProps.saveEndpoint}}",
                            "if": "{{(JSON.stringify(_global?.[extensionPointProps.stateKey]?.recipients ?? []) !== JSON.stringify(_global?.[extensionPointProps.stateKey]?.template?.recipients ?? []))}}",
                            "params": {
