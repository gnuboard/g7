{
    "name": "plugins/sirsoft-sso",
    "description": "Enterprise single sign-on (SAML 2.0, OpenID Connect, LDAP/AD, SCIM 2.0) for G7",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "sirsoft",
            "email": "contact@sirsoft.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "ext-dom": "*",
        "ext-zlib": "*",
        "onelogin/php-saml": "^4.3",
        "firebase/php-jwt": "^7.2"
    },
    "suggest": {
        "ext-ldap": "LDAP/Active Directory 로그인과 재직 조회에 필요합니다. 없으면 LDAP 드라이버만 사용할 수 없습니다."
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "Plugins\\Sirsoft\\Sso\\": ["src/", "./"]
        }
    }
}
