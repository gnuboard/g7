            "initialState": {
              "global": {
                "ssoLink": null,
                "ssoLinkExpired": true,
                "ssoLinkMethod": "password",
                "ssoLinkChallengeId": null,
                "ssoForm": {
                  "agree_terms": false,
                  "agree_privacy": false,
                  "password": "",
                  "code": ""
                },
                "ssoBusy": false,
                "ssoError": null
              }
            }
