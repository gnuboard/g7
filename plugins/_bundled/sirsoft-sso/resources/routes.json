{
    "version": "1.0.0",
    "routes": [
        {
            "path": "*/admin/plugins/sirsoft-sso/accounts",
            "layout": "sso_accounts",
            "auth_required": true,
            "meta": {
                "title": "$t:sirsoft-sso.admin.accounts.title",
                "permission": "sirsoft-sso.accounts.view"
            }
        },
        {
            "path": "*/admin/plugins/sirsoft-sso/logs",
            "layout": "sso_logs",
            "auth_required": true,
            "meta": {
                "title": "$t:sirsoft-sso.admin.logs.title",
                "permission": "sirsoft-sso.logs.view"
            }
        }
    ]
}
