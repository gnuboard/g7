{
    "comment": "E2E: tests/Playwright/specs/sso-oidc-mock.spec.ts·sso-saml-mock.spec.ts 가 이 버튼(`sso_login_button_{키}`)으로 회사 계정 로그인을 시작한다. 화면 폭·다크(§10 M14)는 F1 Chrome MCP 실측, 구운 JSON 계약은 Vitest\n     로그인 화면에 「회사 계정으로 로그인」 묶음을 붙이는 조각 — 소셜 로그인 버튼(priority 100)보다 위(priority 10)에 놓인다.\n     버튼은 이 사이트의 플러그인 시작 경로로 전체 페이지 이동을 한다(IdP 로 가는 302 는 서버가 만든다). 로그인 뒤 돌아갈 주소(query.redirect)는\n     공개 IdP 목록 요청에 실어 서버가 같은 출처 경로만 남긴 시작 주소를 받는다. 켜진 IdP 가 없으면 묶음째 그리지 않는다.",
    "extension_point": "auth_login_extensions",
    "mode": "prepend",
    "priority": 10,
    "data_sources": [
        {
            "id": "ssoPublicIdps",
            "label_key": "$t:sirsoft-sso.editor.data_source.public_idps",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-sso/idps",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "params": {
                "guard": "user",
                "redirect": "{{typeof query.redirect === 'string' ? query.redirect : ''}}"
            },
            "fallback": {
                "data": []
            },
            "errorHandling": {
                "default": {
                    "comment": "다른 확장의 화면에 붙는 덧붙임이다 — 목록을 못 받으면 버튼만 그리지 않는다(fallback 빈 목록)",
                    "handler": "suppress"
                }
            },
            "comment": "켜진 IdP 목록 — 비로그인으로 읽는다(키, 이름, 버튼 색, 시작 주소만)"
        }
    ],
    "components": [
        {
            "id": "sso_login_buttons_section",
            "type": "basic",
            "name": "Div",
            "if": "{{(ssoPublicIdps?.data ?? []).length > 0}}",
            "props": {
                "className": "sso:mt-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "sso:flex sso:items-center sso:gap-3 sso:mb-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "sso:flex-1 sso:h-px sso:bg-gray-200 sso:dark:bg-gray-700"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "sso:text-xs sso-text-muted"
                            },
                            "text": "$t:sirsoft-sso.buttons.company_account"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "sso:flex-1 sso:h-px sso:bg-gray-200 sso:dark:bg-gray-700"
                            }
                        }
                    ]
                },
                {
                    "id": "sso_login_buttons",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "sso:flex sso:flex-col sso:gap-2"
                    },
                    "children": [
                        {
                            "id": "sso_login_button_{{idp.key}}",
                            "type": "basic",
                            "name": "Button",
                            "iteration": {
                                "source": "ssoPublicIdps?.data ?? []",
                                "item_var": "idp"
                            },
                            "dataKey": "{{idp.key}}",
                            "responsive": {
                                "640-": {
                                    "props": {
                                        "className": "sso:w-full sso:inline-flex sso:items-center sso:justify-center sso:gap-3 sso:px-4 sso:py-2 sso:text-sm sso:font-medium sso:rounded-lg sso:border sso:cursor-pointer {{idp.button_style?.bg ? '' : 'sso:bg-white sso:dark:bg-gray-800 sso:text-gray-900 sso:dark:text-white sso:border-gray-300 sso:dark:border-gray-600 sso:hover:bg-gray-50 sso:dark:hover:bg-gray-700'}}"
                                    }
                                }
                            },
                            "actions": [
                                {
                                    "comment": "회사 계정 왕복 시작 — 이 플러그인의 같은 출처 시작 경로로만 이동한다",
                                    "type": "click",
                                    "handler": "sirsoft-sso.startLogin",
                                    "params": {
                                        "url": "{{idp.start_url}}"
                                    }
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "sso:w-full sso:inline-flex sso:items-center sso:justify-center sso:gap-3 sso:px-4 sso:py-3 sso:text-sm sso:font-medium sso:rounded-lg sso:border sso:cursor-pointer {{idp.button_style?.bg ? '' : 'sso:bg-white sso:dark:bg-gray-800 sso:text-gray-900 sso:dark:text-white sso:border-gray-300 sso:dark:border-gray-600 sso:hover:bg-gray-50 sso:dark:hover:bg-gray-700'}}",
                                "style": "{{idp.button_style?.bg ? 'background-color:' + idp.button_style.bg + ';color:' + (idp.button_style.fg ?? '#ffffff') + ';border-color:' + (idp.button_style.border ?? idp.button_style.bg) : ''}}",
                                "aria-label": "$t:sirsoft-sso.buttons.login_with|idp={{idp.label}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "aria-hidden": "true",
                                        "className": "sso:inline-flex sso:items-center sso:justify-center sso:w-6 sso:h-6 sso:rounded-full sso:ring-1 sso:ring-current sso:text-xs sso:font-semibold"
                                    },
                                    "text": "{{idp.initial}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-sso.buttons.login_with|idp={{idp.label}}"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
