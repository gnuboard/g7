                                                                        },
                                                                        {
                                                                            "type": "basic",
                                                                            "name": "Td",
                                                                            "props": {
                                                                                "className": "sso:py-2 sso:pr-3 sso:text-gray-900 sso:dark:text-white sso:break-all sso-break-all"
                                                                            },
