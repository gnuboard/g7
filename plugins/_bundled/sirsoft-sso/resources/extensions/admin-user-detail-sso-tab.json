                                                            },
                                                            "text": "{{(user?.data?.sso?.mapped_roles ?? []).includes(role.identifier) ? $t('sirsoft-sso.admin.user_tab.role_mapped') : $t('sirsoft-sso.admin.user_tab.role_manual')}}"
