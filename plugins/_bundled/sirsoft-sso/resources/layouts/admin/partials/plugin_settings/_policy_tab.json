                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "responsive": {
                                "desktop": {
                                    "props": {
                                        "className": "sso:col-span-1"
                                    }
                                }
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "sso-form-label"
                                    },
                                    "text": "$t:sirsoft-sso.admin.settings.policy.fields.session_max_minutes"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "sso-form-hint"
                                    },
                                    "text": "$t:sirsoft-sso.admin.settings.policy.hints.session_max_minutes"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "responsive": {
                                "desktop": {
                                    "props": {
                                        "className": "sso:col-span-2"
                                    }
                                }
                            },
                            "children": [
                                {
                                    "comment": "audit:allow layout-input-boundary-hardcoded 한계값은 저장 요청 규칙(PolicyUpdateRequest, IdpUpdateRequest)과 같은 상수다 — 플러그인 API 는 한계값을 따로 내려주지 않는다",
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "number",
                                        "name": "policy.session_max_minutes",
                                        "min": 0,
                                        "max": 10080,
                                        "className": "sso-input",
                                        "disabled": "{{!_computed.canUpdate}}"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "sso-flex-start sso:gap-3"
                    },
                    "children": [
                        {
                            "type": "composite",
                            "name": "Toggle",
                            "props": {
                                "name": "policy.discovery_enabled",
                                "ariaLabel": "$t:sirsoft-sso.admin.settings.policy.fields.discovery_enabled",
                                "size": "md",
                                "disabled": "{{!_computed.canUpdate}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "sso-form-label"
                                    },
                                    "text": "$t:sirsoft-sso.admin.settings.policy.fields.discovery_enabled"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "sso-form-hint"
                                    },
                                    "text": "$t:sirsoft-sso.admin.settings.policy.hints.discovery_enabled"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "comment": "영향 미리보기와 저장",
            "id": "policy_impact",
            "type": "basic",
            "name": "Div",
            "if": "{{!!_local.policyImpact}}",
            "props": {
                "role": "status",
                "className": "{{(_local.policyImpact?.password_users ?? 0) > 0 ? 'sso-alert-warning' : 'sso-alert-info'}} sso:flex-col sso:items-start sso:gap-1"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "sso:text-sm"
                    },
                    "text": "$t:sirsoft-sso.admin.settings.policy.impact_users|count={{_local.policyImpact?.password_users ?? 0}}"
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "sso:text-sm"
                    },
                    "text": "$t:sirsoft-sso.admin.settings.policy.impact_sessions|count={{_local.policyImpact?.password_sessions ?? 0}}"
                }
            ]
        },
        {
            "id": "policy_errors",
            "type": "basic",
            "name": "Div",
            "if": "{{!!_local.policyErrors?.code}}",
            "props": {
                "role": "alert",
                "className": "sso-alert-error"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "sso:text-sm sso:text-red-800 sso:dark:text-red-200"
                    },
                    "text": "{{$t('sirsoft-sso.admin.settings.policy.errors.' + _local.policyErrors.code)}}"
                }
            ]
        },
        {
            "id": "policy_actions",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "sso:flex sso:flex-wrap sso:gap-2"
            },
            "children": [
                {
                    "id": "policy_impact_button",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "영향 미리보기 — 저장하지 않고 바꿀 값으로 센다",
                            "type": "click",
                            "handler": "apiCall",
                            "target": "/api/plugins/sirsoft-sso/admin/policy/impact",
                            "auth_required": true,
                            "params": {
                                "method": "GET",
                                "query": {
                                    "enforce_site": "{{_local.policyForm?.policy?.enforce_site ? 1 : 0}}",
                                    "enforce_linked": "{{_local.policyForm?.policy?.enforce_linked ? 1 : 0}}",
                                    "enforce_roles[]": "{{(_local.policyForm?.policy?.enforce_roles ?? []).length > 0 ? _local.policyForm.policy.enforce_roles : undefined}}",
                                    "emergency_user_ids[]": "{{_local.policyForm?.policy?.emergency_user_ids ?? []}}"
                                }
                            },
                            "onSuccess": {
                                "handler": "setState",
                                "params": {
                                    "target": "local",
                                    "policyImpact": "{{response.data}}"
                                }
                            },
                            "onError": {
                                "handler": "toast",
                                "params": {
                                    "type": "error",
                                    "message": "{{error.message ?? '$t:sirsoft-sso.admin.settings.save_failed'}}"
                                }
                            }
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "sso-btn sso-btn-secondary sso:text-sm"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:sirsoft-sso.admin.settings.policy.preview_impact"
                        }
                    ]
                },
                {
                    "id": "policy_save_button",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "actionRef": "savePolicy"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "sso-btn sso-btn-primary sso:text-sm",
                        "disabled": "{{!_computed.canUpdate || _local.isSavingPolicy}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.save"
                        }
                    ]
                }
            ]
        }
    ]
}
