                {
                    "id": "emergency_search",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.policyForm?.abilities?.is_super === true}}",
                    "responsive": {
                        "640-": {
                            "props": {
                                "className": "sso:flex sso:flex-row sso:gap-2"
                            }
                        }
                    },
                    "props": {
                        "className": "sso:flex sso:flex-col sso:gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Input",
                            "actions": [
                                {
                                    "comment": "검색어만 담아 둔다 — 실제 검색은 옆 [검색] 버튼이 한다",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "emergencySearch": "{{$event.target.value}}"
                                    }
                                }
                            ],
                            "props": {
                                "type": "text",
                                "name": "emergencySearchBox",
                                "className": "sso-input sso:flex-1 sso:min-w-0",
                                "value": "{{_local.emergencySearch}}",
                                "placeholder": "$t:sirsoft-sso.admin.settings.policy.emergency_search_placeholder",
                                "aria-label": "$t:sirsoft-sso.admin.settings.policy.emergency_search_placeholder"
                            }
                        },
                        {
                            "id": "emergency_search_button",
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "회원 검색 — 코어 관리자 회원 목록 검색을 쓴다",
                                    "type": "click",
                                    "handler": "apiCall",
                                    "target": "/api/admin/users",
                                    "auth_required": true,
                                    "params": {
                                        "method": "GET",
                                        "query": {
                                            "search": "{{_local.emergencySearch}}",
                                            "per_page": 5
                                        }
                                    },
                                    "onSuccess": {
                                        "handler": "setState",
                                        "params": {
                                            "target": "local",
                                            "emergencyCandidates": "{{response.data?.data ?? []}}"
                                        }
                                    },
                                    "onError": {
                                        "handler": "toast",
                                        "params": {
                                            "type": "error",
                                            "message": "{{error.message ?? '$t:sirsoft-sso.admin.settings.save_failed'}}"
                                        }
                                    }
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "sso-btn sso-btn-secondary sso:text-sm",
                                "disabled": "{{!_local.emergencySearch}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-sso.admin.common.search"
