                            "dataKey": "{{candidate.uuid}}",
                            "props": {
                                "className": "sso:py-2 sso:flex sso:items-center sso:gap-3"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "sso:flex-1 sso:min-w-0"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "sso:text-sm sso:text-gray-900 sso:dark:text-white"
                                            },
                                            "text": "{{candidate.name}}"
                                        },
                                        {
                                            "comment": "후보는 코어 회원 목록 응답 — 같은 규칙의 실명 보조 값이 온다",
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{!!candidate.real_name}}",
                                            "props": {
                                                "data-testid": "emergency-candidate-real-name-sub",
                                                "role": "note",
                                                "aria-label": "{{$t('sirsoft-sso.admin.common.real_name_sub', { name: candidate.real_name })}}",
                                                "className": "sso:block sso:text-xs sso-text-muted"
                                            },
                                            "text": "{{candidate.real_name}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "sso:text-xs sso-text-muted sso:break-all sso-break-all"
                                            },
                                            "text": "{{candidate.email ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Button",
                                    "actions": [
                                        {
                                            "comment": "비상 계정에 넣는다 — 저장해야 반영된다",
                                            "type": "click",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "policyForm.policy.emergency_user_ids": "{{(_local.policyForm?.policy?.emergency_user_ids ?? []).concat([candidate.id])}}",
                                                "policyForm.emergency_users": "{{(_local.policyForm?.emergency_users ?? []).concat([{ id: candidate.id, name: candidate.name, real_name: candidate.real_name ?? null, email: candidate.email, has_password: candidate.has_password !== false }])}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "className": "sso-btn sso-btn-secondary sso:text-xs",
                                        "disabled": "{{(_local.policyForm?.policy?.emergency_user_ids ?? []).includes(candidate.id)}}"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:sirsoft-sso.admin.settings.policy.add_emergency"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
