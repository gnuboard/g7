                                            "text": "{{emergency.real_name}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "sso:text-xs sso-text-muted sso:break-all sso-break-all"
                                            },
                                            "text": "{{emergency.email ?? ''}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "if": "{{emergency.has_password === false}}",
                                            "props": {
                                                "className": "sso:text-xs sso:text-red-600 sso:dark:text-red-400"
                                            },
                                            "text": "$t:sirsoft-sso.admin.settings.policy.emergency_no_password"
                                        }
                                    ]
                                },
                                {
                                    "id": "remove_emergency_{{emergency.id}}",
                                    "type": "basic",
                                    "name": "Button",
                                    "actions": [
                                        {
                                            "comment": "비상 계정에서 뺀다 — 마지막 한 명은 뺄 수 없다(서버도 422)",
                                            "type": "click",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "policyForm.policy.emergency_user_ids": "{{(_local.policyForm?.policy?.emergency_user_ids ?? []).filter(id => id !== emergency.id)}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "className": "sso-btn-icon",
                                        "title": "$t:sirsoft-sso.admin.common.remove_row",
                                        "aria-label": "$t:sirsoft-sso.admin.settings.policy.remove_emergency|name={{emergency.name}}",
                                        "disabled": "{{!_computed.canUpdate || _local.policyForm?.abilities?.is_super !== true || (_local.policyForm?.policy?.emergency_user_ids ?? []).length <= 1}}"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "fa-solid fa-trash",
                                                "className": "sso:text-sm"
                                            }
