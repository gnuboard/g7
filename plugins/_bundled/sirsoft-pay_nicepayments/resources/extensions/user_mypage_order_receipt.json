                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-600 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-pay_nicepayments.user.vbank_bank"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{order.data.payment?.vbank_name}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex justify-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-600 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-pay_nicepayments.user.vbank_account"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium font-mono"
                                            },
                                            "text": "{{order.data.payment?.vbank_number}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex justify-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-600 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-pay_nicepayments.user.vbank_holder"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{order.data.payment?.vbank_holder}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex justify-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-600 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-pay_nicepayments.user.vbank_amount"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "font-bold text-blue-600 dark:text-blue-400"
                                            },
                                            "text": "{{order.data.total_due_amount_formatted ?? order.data.total_amount_formatted ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{order.data.payment?.vbank_due_at_formatted}}",
                                    "props": {
                                        "className": "flex justify-between text-sm pt-2 border-t border-blue-200 dark:border-blue-700 mt-2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-600 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-pay_nicepayments.user.vbank_due"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "font-medium text-red-600 dark:text-red-400"
                                            },
                                            "text": "{{order.data.payment?.vbank_due_at_formatted}}"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "if": "{{!order.data.payment?.paid_at}}",
                            "props": {
                                "className": "text-xs text-blue-700 dark:text-blue-300 mt-3"
                            },
                            "text": "$t:sirsoft-pay_nicepayments.user.vbank_notice"
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{order.data.payment?.pg_provider === 'nicepayments' && (order.data.total_vat_amount > 0 || order.data.total_tax_free_amount > 0)}}",
            "props": {
                "className": "pt-4 mt-2 border-t border-gray-200 dark:border-gray-700 space-y-1.5"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-sm font-semibold text-gray-800 dark:text-gray-200 mb-1"
                    },
                    "text": "$t:sirsoft-pay_nicepayments.user.tax_breakdown_title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex-between text-sm"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-pay_nicepayments.user.supply_amount"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-gray-900 dark:text-white font-medium"
                            },
                            "text": "{{order.data.total_taxable_supply_amount_formatted}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex-between text-sm"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-pay_nicepayments.user.vat_amount"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-gray-900 dark:text-white font-medium"
                            },
                            "text": "{{order.data.total_vat_amount_formatted}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{order.data.total_tax_free_amount > 0}}",
                    "props": {
                        "className": "flex-between text-sm"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-pay_nicepayments.user.tax_free_amount"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-gray-900 dark:text-white font-medium"
                            },
                            "text": "{{order.data.total_tax_free_amount_formatted}}"
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{order.data.payment?.pg_provider === 'nicepayments' && order.data.payment?.transaction_id && order.data.payment?.paid_at}}",
            "props": {
                "className": "pt-4 mt-2 border-t border-gray-200 dark:border-gray-700"
            },
            "children": [
                {
                    "comment": "간편결제 서비스명 — 주문 응답은 결제 메타를 싣지 않고 기본 결제수단(신용카드)만 안다. 원 수단 코드(naverpay 등)는 아래 영수증 조회 API 가 embedded_pg_provider 로 주고, 이름은 번역 키로 푼다. 종전에는 주입 스크립트가 템플릿의 결제 방법 행 글자를 직접 고쳐 썼다(#639).",
                    "id": "nicepay_mp_easy_pay_row",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{(['naverpay','kakaopay','samsungpay','applepay','payco','skpay','ssgpay','lpay']).includes(_local._npMpEasyPayProvider)}}",
                    "props": {
                        "className": "flex-between mb-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-sm text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-pay_nicepayments.user.easy_pay_label"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-sm font-medium text-gray-900 dark:text-white"
                            },
                            "text": "{{$t('sirsoft-pay_nicepayments.user.easy_pay_names.' + String(_local._npMpEasyPayProvider ?? '').toUpperCase())}}"
                        }
                    ]
                },
                {
                    "comment": "영수증 링크 행 — 결제 영수증 주소는 플러그인 API(payment_receipt_url)가 내려준다. 레이아웃에 결제사 외부 주소를 적으면 편집기 저장 게이트(외부 URL 금지)가 거절한다. 회원은 토큰, 비회원은 조회 토큰 헤더로 같은 API 를 부른다",
                    "type": "basic",
                    "name": "Div",
                    "lifecycle": {
                        "onMount": [
                            {
                                "handler": "apiCall",
                                "target": "/api/plugins/sirsoft-pay_nicepayments/user/orders/{{order.data.order_number}}/receipt",
                                "auth_mode": "optional",
                                "auth_required": true,
                                "params": {
                                    "method": "GET",
                                    "headers": {
                                        "X-Guest-Order-Token": "{{_global.guestOrderToken ?? ''}}"
                                    }
                                },
                                "onSuccess": {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "_npMpPaymentReceiptUrl": "{{response.data.payment_receipt_url}}",
                                        "_npMpSalesSlipUrl": "{{response.data.receipt_url}}",
                                        "_npMpEasyPayProvider": "{{response.data.embedded_pg_provider}}"
                                    }
                                }
                            }
                        ]
                    },
                    "props": {
                        "className": "flex-between"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-sm text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-pay_nicepayments.user.receipt_label"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex items-center gap-3"
                            },
                            "children": [
                                {
                                    "comment": "결제 영수증",
                                    "type": "basic",
                                    "name": "A",
                                    "if": "{{_local._npMpPaymentReceiptUrl}}",
                                    "props": {
                                        "href": "{{_local._npMpPaymentReceiptUrl}}",
                                        "target": "_blank",
                                        "rel": "noopener noreferrer",
                                        "className": "inline-flex items-center gap-1 text-sm text-blue-600 dark:text-blue-400 hover:underline"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "file-text",
                                                "className": "text-sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:sirsoft-pay_nicepayments.user.view_receipt"
                                        }
                                    ]
                                },
                                {
                                    "comment": "매출전표(type=0) — 주문 완료 화면 버튼과 같은 전표. 주소는 같은 조회 API 가 receipt_url 로 준다(결제 영수증 type=2 와 다른 값).",
                                    "type": "basic",
                                    "name": "A",
                                    "if": "{{_local._npMpSalesSlipUrl}}",
                                    "props": {
                                        "href": "{{_local._npMpSalesSlipUrl}}",
                                        "target": "_blank",
                                        "rel": "noopener noreferrer",
                                        "className": "inline-flex items-center gap-1 text-sm text-blue-600 dark:text-blue-400 hover:underline"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "file-text",
                                                "className": "text-sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:sirsoft-pay_nicepayments.user.view_sales_slip"
                                        }
                                    ]
                                },
                                {
                                    "comment": "현금영수증 조회 버튼",
                                    "type": "basic",
                                    "name": "Button",
                                    "if": "{{order.data.payment?.cash_receipt_type && !_local._npMpReceiptLoaded}}",
                                    "actions": [
                                        {
                                            "comment": "매출전표 보기 — 전표를 받아 팝업으로 띄운다",
                                            "type": "click",
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "_npMpReceiptLoading": true
                                                    }
                                                },
                                                {
                                                    "handler": "apiCall",
                                                    "target": "/api/plugins/sirsoft-pay_nicepayments/user/orders/{{order.data.order_number}}/receipt",
                                                    "auth_mode": "optional",
                                                    "auth_required": true,
                                                    "params": {
                                                        "method": "GET",
                                                        "headers": {
                                                            "X-Guest-Order-Token": "{{_global.guestOrderToken ?? ''}}"
                                                        }
                                                    },
                                                    "onSuccess": {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "_npMpReceiptLoading": false,
                                                            "_npMpReceiptLoaded": true,
                                                            "_npMpCashReceiptUrl": "{{response.data.cash_receipt_url}}"
                                                        }
                                                    },
                                                    "onError": {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "_npMpReceiptLoading": false
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "className": "inline-flex items-center gap-1 text-sm text-green-600 dark:text-green-400 hover:underline disabled:opacity-50"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "receipt",
                                                "className": "text-sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:sirsoft-pay_nicepayments.user.view_cash_receipt"
                                        }
                                    ]
                                },
                                {
                                    "comment": "현금영수증 링크 (조회 후)",
                                    "type": "basic",
                                    "name": "A",
                                    "if": "{{_local._npMpReceiptLoaded && _local._npMpCashReceiptUrl}}",
                                    "props": {
                                        "href": "{{_local._npMpCashReceiptUrl}}",
                                        "target": "_blank",
                                        "rel": "noopener noreferrer",
                                        "className": "inline-flex items-center gap-1 text-sm text-green-600 dark:text-green-400 hover:underline"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "receipt",
                                                "className": "text-sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:sirsoft-pay_nicepayments.user.view_cash_receipt"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
