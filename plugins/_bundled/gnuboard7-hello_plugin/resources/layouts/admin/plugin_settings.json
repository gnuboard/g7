{
    "comment": "학습용 플러그인 환경설정 화면 — 코어의 플러그인 설정 규약(경로·엔드포인트·저장 흐름)을 그대로 따르는 최소 예다. 모양은 템플릿 CSS 가 아니라 이 플러그인의 순수 CSS(resources/css/main.css, helloplugin-*)가 싣는다",
    "version": "1.0.0",
    "layout_name": "plugin_settings",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:gnuboard7-hello_plugin.settings.title",
        "description": "$t:gnuboard7-hello_plugin.settings.description"
    },
    "data_sources": [
        {
            "id": "settings",
            "label_key": "$t:gnuboard7-hello_plugin.editor.data_source.settings",
            "type": "api",
            "endpoint": "/api/admin/plugins/{{route.identifier}}/settings",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "initLocal": "form",
            "refetchOnMount": true,
            "errorHandling": {
                "default": {
                    "comment": "받기 실패(권한·없음 외) — 빈 폼·기본값으로 저장되지 않게 본문 오류 화면. 다시 받기(선택·쪽 넘김·저장 뒤 갱신 등) 실패는 받아 둔 값·선택을 그대로 두고 알린다 — 처음 받기 실패만 본문 오류 화면",
                    "handler": "conditions",
                    "conditions": [
                        {
                            "if": "{{error.refetch}}",
                            "then": {
                                "handler": "toast",
                                "params": {
                                    "type": "error",
                                    "message": "$t:core.errors.refresh_failed"
                                }
                            }
                        },
                        {
                            "then": {
                                "handler": "showErrorPage",
                                "params": {
                                    "errorCode": "{{error.status}}",
                                    "target": "content"
                                }
                            }
                        }
                    ]
                }
            },
            "comment": "현재 설정값. 화면에 들어올 때마다 다시 받아 폼 초기값으로 넣는다(initLocal=form) — 저장 후 되돌아왔을 때 낡은 값이 남지 않게"
        }
    ],
    "computed": {
        "isPluginReadOnly": "{{settings?.data?.abilities?.can_update !== true}}"
    },
    "permissions": [
        "core.plugins.read"
    ],
    "slots": {
        "content": [
            {
                "id": "plugin_settings_content",
                "type": "basic",
                "name": "Div",
                "dataKey": "form",
                "trackChanges": true,
                "responsive": {
                    "640-1023": {
                        "props": {
                            "className": "helloplugin-settings helloplugin-settings--md"
                        }
                    },
                    "1024-": {
                        "props": {
                            "className": "helloplugin-settings helloplugin-settings--lg"
                        }
                    }
                },
                "props": {
                    "className": "helloplugin-settings"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:gnuboard7-hello_plugin.settings.title",
                            "description": "$t:gnuboard7-hello_plugin.settings.description",
                            "backPath": "/admin/plugins",
                            "backLabel": "$t:admin.plugins.back_to_list"
                        }
                    },
                    {
                        "id": "plugin_read_only_banner",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_computed.isPluginReadOnly && !!settings?.data}}",
                        "props": {
                            "role": "status",
                            "className": "helloplugin-alert"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Icon",
                                "props": {
                                    "name": "lock",
                                    "className": "helloplugin-alert__icon"
                                }
                            },
                            {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                    "className": "helloplugin-alert__text"
                                },
                                "text": "$t:gnuboard7-hello_plugin.plugin_read_only"
                            }
                        ]
                    },
                    {
                        "id": "settings_form",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "helloplugin-card"
                        },
                        "children": [
                            {
                                "id": "settings_fields",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "helloplugin-card__body"
                                },
                                "children": [
                                    {
                                        "id": "field_log_enabled",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "helloplugin-field"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Input",
                                                "props": {
                                                    "type": "checkbox",
                                                    "id": "hello_plugin_log_enabled",
                                                    "name": "log_enabled",
                                                    "className": "helloplugin-checkbox",
                                                    "disabled": "{{_computed.isPluginReadOnly}}"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "helloplugin-label",
                                                            "htmlFor": "hello_plugin_log_enabled"
                                                        },
                                                        "text": "$t:gnuboard7-hello_plugin.settings.fields.log_enabled.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "helloplugin-hint"
                                                        },
                                                        "text": "$t:gnuboard7-hello_plugin.settings.fields.log_enabled.hint"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "footer_buttons",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "helloplugin-footer"
                        },
                        "children": [
                            {
                                "id": "cancel_button",
                                "type": "basic",
                                "name": "A",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate"
                                    }
                                ],
                                "props": {
                                    "href": "/admin/plugins",
                                    "className": "helloplugin-button helloplugin-button--secondary"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.cancel"
                                    }
                                ]
                            },
                            {
                                "id": "save_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "comment": "설정 저장. 저장 중 플래그로 버튼을 잠그고 직전 오류를 지운 뒤 보내며, 성공하면 설정을 다시 받아 화면을 서버 값에 맞춘다",
                                        "type": "click",
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "isSaving": true,
                                                    "errors": null
                                                }
                                            },
                                            {
                                                "handler": "apiCall",
                                                "target": "/api/admin/plugins/{{route.identifier}}/settings",
                                                "auth_required": true,
                                                "params": {
                                                    "method": "PUT",
                                                    "body": "{{_local.form}}"
                                                },
                                                "onSuccess": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "hasChanges": false
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "success",
                                                            "message": "$t:admin.plugins.settings.save_success"
                                                        }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": {
                                                            "dataSourceId": "settings"
                                                        }
                                                    }
                                                ],
                                                "onError": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "errors": "{{error.errors}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "error",
                                                            "message": "{{error.message ?? '$t:admin.plugins.settings.save_error'}}"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "props": {
                                    "type": "button",
                                    "disabled": "{{_computed.isPluginReadOnly || (!_local.hasChanges || _local.isSaving)}}",
                                    "className": "helloplugin-button helloplugin-button--primary helloplugin-footer__save"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{!_local.isSaving}}",
                                        "text": "$t:common.save"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{_local.isSaving}}",
                                        "text": "$t:common.saving"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
