{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "레이아웃 편집기 스펙 — 다음 우편번호 플러그인. admin/plugin_settings.g7.html 의 settings 데이터소스 응답 shape(입력칸 name= 전수)와 표시 방식 변종을 담는다.",
  "pluginId": "sirsoft-daum_postcode",
  "version": "1.0.0",
  "description": "다음 우편번호 플러그인 레이아웃 편집기 샘플 데이터·화면 상태.",
  "sampleData": {
    "byDataSourceId": {
      "settings": {
        "data": {
          "display_mode": "layer",
          "popup_width": 500,
          "popup_height": 600,
          "theme_color": "#2563eb"
        }
      }
    }
  },
  "states": {
    "comment": "표시 방식(레이어/팝업)에 따라 크기 입력 구역이 갈린다. 입력칸은 initLocal 로 채워지는데 편집기는 그 흐름을 실행하지 않아 _local.form 을 직접 시드한다.",
    "groups": [
      {
        "scope": {
          "kind": "route",
          "match": "*/admin/plugins/sirsoft-daum_postcode/settings"
        },
        "items": [
          {
            "id": "layer_mode",
            "label": "$t:editor.state.postcode_layer_mode",
            "default": true,
            "initialState": {
              "local": {
                "isSaving": false,
                "hasChanges": false,
                "errors": null,
                "form": {
                  "display_mode": "layer",
                  "popup_width": 500,
                  "popup_height": 600,
                  "theme_color": "#2563eb"
                }
              }
            }
          },
          {
            "id": "popup_mode",
            "label": "$t:editor.state.postcode_popup_mode",
            "initialState": {
              "local": {
                "isSaving": false,
                "hasChanges": false,
                "errors": null,
                "form": {
                  "display_mode": "popup",
                  "popup_width": 500,
                  "popup_height": 600,
                  "theme_color": "#2563eb"
                }
              }
            }
          },
          {
            "id": "validation_failed",
            "label": "$t:editor.state.validation_failed",
            "initialState": {
              "local": {
                "isSaving": false,
                "hasChanges": true,
                "form": {
                  "display_mode": "popup",
                  "popup_width": "",
                  "popup_height": 600,
                  "theme_color": "#2563eb"
                }
              }
            },
            "formErrors": {
              "_local.errors.popup_width": [
                "300 이상의 너비를 입력해 주세요."
              ]
            }
          }
        ]
      }
    ]
  }
}
