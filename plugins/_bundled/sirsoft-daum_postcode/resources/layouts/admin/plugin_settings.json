{
    "comment": "다음 우편번호 플러그인 환경설정 화면 — 코어 플러그인 설정 규약을 따른다\ne2e:allow 표시 방식 선택지 번역·의미 클래스 위치 교정 — 구조 Vitest(pluginSettingsDisplay.test.ts) + Playwright 격리 브라우저 ko/en·1440·375px 재실측",
    "version": "1.0.0",
    "layout_name": "plugin_settings",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:sirsoft-daum_postcode.settings.title",
        "description": "$t:sirsoft-daum_postcode.settings.description"
    },
    "data_sources": [
        {
            "id": "settings",
            "label_key": "$t:sirsoft-daum_postcode.editor.data_source.settings",
            "type": "api",
            "endpoint": "/api/admin/plugins/{{route.identifier}}/settings",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "initLocal": "form",
            "refetchOnMount": true,
            "comment": "현재 설정값. 화면에 들어올 때마다 다시 받아 폼 초기값으로 넣는다(initLocal=form)"
        }
    ],
    "permissions": [
        "core.plugins.update"
    ],
    "slots": {
        "content": [
            {
                "id": "plugin_settings_content",
                "type": "basic",
                "name": "Div",
                "dataKey": "form",
                "trackChanges": true,
                "props": {
                    "className": "admin-page-content-responsive"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:sirsoft-daum_postcode.settings.title",
                            "description": "$t:sirsoft-daum_postcode.settings.description",
                            "backPath": "/admin/plugins",
                            "backLabel": "$t:admin.plugins.back_to_list"
                        }
                    },
                    {
                        "id": "notice_banner",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "alert-info"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex gap-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "circle-info",
                                            "className": "text-xl text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": {
                                            "className": "text-info-soft"
                                        },
                                        "text": "$t:sirsoft-daum_postcode.settings.notice"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "validation_error",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_local.errors}}",
                        "props": {
                            "className": "alert-danger"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex gap-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "triangle-exclamation",
                                            "className": "text-xl text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H3",
                                                "props": {
                                                    "className": "text-error-strong"
                                                },
                                                "text": "$t:admin.plugins.settings.validation_error"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Ul",
                                                "if": "{{typeof _local.errors === 'object' && Object.keys(_local.errors).length > 0}}",
                                                "iteration": {
                                                    "source": "Object.entries(_local.errors ?? {}).flatMap(([field, messages]) => Array.isArray(messages) ? messages : [messages])",
                                                    "item_var": "message"
                                                },
                                                "props": {
                                                    "className": "mt-2 list-disc list-inside space-y-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Li",
                                                        "props": {
                                                            "className": "text-error-soft"
                                                        },
                                                        "text": "{{message}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "settings_form",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "id": "settings_fields",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "p-6 space-y-6"
                                },
                                "children": [
                                    {
                                        "id": "field_display_mode",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-3col-responsive"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "$t:sirsoft-daum_postcode.settings.fields.display_mode.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "$t:sirsoft-daum_postcode.settings.fields.display_mode.hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Select",
                                                        "props": {
                                                            "name": "display_mode",
                                                            "className": "focus:border-transparent"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Option",
                                                                "props": {
                                                                    "value": "popup"
                                                                },
                                                                "text": "$t:sirsoft-daum_postcode.settings.fields.display_mode.popup"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Option",
                                                                "props": {
                                                                    "value": "layer"
                                                                },
                                                                "text": "$t:sirsoft-daum_postcode.settings.fields.display_mode.layer"
                                                            }
                                                        ]
                                                    },
                                                    {
                                                        "comment": "저장 오류는 상단 상자와 함께 그 칸 아래에도 보인다(어느 칸을 고쳐야 하는지, 7.1.0 실측 M1-O11)",
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{_local.errors?.display_mode}}",
                                                        "props": {
                                                            "className": "form-error"
                                                        },
                                                        "text": "{{_local.errors?.display_mode?.[0]}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_popup_width",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-3col-responsive"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "$t:sirsoft-daum_postcode.settings.fields.popup_width.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "$t:sirsoft-daum_postcode.settings.fields.popup_width.hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "comment": "범위는 플러그인 설정 스키마(min 100 · max 2000)와 같다 — 서버 검증이 같은 값으로 422 를 낸다",
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "number",
                                                            "name": "popup_width",
                                                            "min": "100",
                                                            "max": "2000",
                                                            "className": "focus:border-transparent"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{_local.errors?.popup_width}}",
                                                        "props": {
                                                            "className": "form-error"
                                                        },
                                                        "text": "{{_local.errors?.popup_width?.[0]}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_popup_height",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-3col-responsive"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "$t:sirsoft-daum_postcode.settings.fields.popup_height.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "$t:sirsoft-daum_postcode.settings.fields.popup_height.hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "number",
                                                            "name": "popup_height",
                                                            "min": "100",
                                                            "max": "2000",
                                                            "className": "focus:border-transparent"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{_local.errors?.popup_height}}",
                                                        "props": {
                                                            "className": "form-error"
                                                        },
                                                        "text": "{{_local.errors?.popup_height?.[0]}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_theme_color",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "grid-3col-responsive"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "$t:sirsoft-daum_postcode.settings.fields.theme_color.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "$t:sirsoft-daum_postcode.settings.fields.theme_color.hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "text",
                                                            "name": "theme_color",
                                                            "placeholder": "#1D4ED8",
                                                            "className": "focus:border-transparent"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{_local.errors?.theme_color}}",
                                                        "props": {
                                                            "className": "form-error"
                                                        },
                                                        "text": "{{_local.errors?.theme_color?.[0]}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "guide_section",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 bg-gray-50 dark:bg-gray-800/50 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H3",
                                "props": {
                                    "className": "section-heading mb-4"
                                },
                                "text": "$t:sirsoft-daum_postcode.settings.guide.title"
                            },
                            {
                                "type": "basic",
                                "name": "Ol",
                                "props": {
                                    "className": "list-decimal list-inside space-y-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-label"
                                        },
                                        "text": "$t:sirsoft-daum_postcode.settings.guide.step1"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-label"
                                        },
                                        "text": "$t:sirsoft-daum_postcode.settings.guide.step2"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-label"
                                        },
                                        "text": "$t:sirsoft-daum_postcode.settings.guide.step3"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "footer_buttons",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "sticky-footer-buttons"
                        },
                        "children": [
                            {
                                "id": "cancel_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/plugins"
                                        }
                                    }
                                ],
                                "props": {
                                    "className": "btn btn-secondary"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.cancel"
                                    }
                                ]
                            },
                            {
                                "id": "save_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "comment": "설정 저장. 저장 중 플래그로 버튼을 잠그고 직전 오류를 지운 뒤 보내며, 성공하면 설정을 다시 받아 화면을 서버 값에 맞춘다",
                                        "type": "click",
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "isSaving": true,
                                                    "errors": null
                                                }
                                            },
                                            {
                                                "handler": "apiCall",
                                                "target": "/api/admin/plugins/{{route.identifier}}/settings",
                                                "auth_required": true,
                                                "params": {
                                                    "method": "PUT",
                                                    "body": "{{_local.form}}"
                                                },
                                                "onSuccess": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "hasChanges": false
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "success",
                                                            "message": "$t:admin.plugins.settings.save_success"
                                                        }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": {
                                                            "dataSourceId": "settings"
                                                        }
                                                    }
                                                ],
                                                "onError": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "errors": "{{error.errors}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "error",
                                                            "message": "{{error.message ?? '$t:admin.plugins.settings.save_error'}}"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "props": {
                                    "disabled": "{{!_local.hasChanges || _local.isSaving}}",
                                    "className": "btn btn-primary flex-center gap-1.5"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "if": "{{_local.isSaving}}",
                                        "props": {
                                            "name": "spinner",
                                            "className": "spinner-sm"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{!_local.isSaving}}",
                                        "text": "$t:common.save"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{_local.isSaving}}",
                                        "text": "$t:common.saving"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
