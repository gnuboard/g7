{
    "comment": "회원가입 화면 폼 위에 「…로 가입」 버튼을 붙이는 조각 — 켜진 제공자가 없거나 소셜 가입을 이어 가는 중이면(social_pending) 그리지 않는다.\n     버튼 뒤에는 「또는 이메일로 가입」 구분선이 와서 아래 가입 폼과 나뉜다.",
    "extension_point": "auth_register_extensions",
    "mode": "append",
    "priority": 100,
    "data_sources": [
        {
            "id": "socialProviders",
            "label_key": "$t:sirsoft-social_login.editor.data_source.providers",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-social_login/providers",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "fallback": {
                "data": []
            },
            "errorHandling": {
                "default": {
                    "comment": "다른 확장의 화면에 붙는 덧붙임이다 — 목록을 못 받으면 버튼만 그리지 않고(fallback 빈 목록), 템플릿 기본 오류 처리(원문 토스트)로 번지지 않게 막는다",
                    "handler": "suppress"
                }
            },
            "comment": "켜진 제공자 목록 — 비로그인으로 읽는다."
        }
    ],
    "components": [
        {
            "id": "social_register_buttons_section",
            "type": "basic",
            "name": "Div",
            "if": "{{(socialProviders?.data ?? []).length > 0 && !query.social_pending}}",
            "props": {
                "className": "sl:mb-6"
            },
            "children": [
                {
                    "id": "social_register_provider_buttons",
                    "type": "composite",
                    "name": "sirsoft-social_login.ProviderButtons",
                    "props": {
                        "providers": "{{socialProviders?.data ?? []}}",
                        "intent": "register",
                        "redirect": "{{query.redirect ?? '/'}}"
                    }
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "sl:flex sl:items-center sl:gap-3 sl:mt-6"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "sl:flex-1 sl:h-px sl:bg-gray-200 sl:dark:bg-gray-700"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "sl:text-xs sl:text-gray-500 sl:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-social_login.divider.or_email_signup"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "sl:flex-1 sl:h-px sl:bg-gray-200 sl:dark:bg-gray-700"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
