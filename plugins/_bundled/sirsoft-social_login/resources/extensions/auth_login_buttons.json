{
    "comment": "로그인 화면 폼 아래에 소셜 로그인 버튼을 붙이는 조각 — 켜진 제공자가 없으면 영역째 그리지 않는다.\n     버튼은 이 사이트의 시작 주소로 가는 링크이고, 로그인 뒤 돌아갈 주소(query.redirect)를 함께 싣는다.",
    "extension_point": "auth_login_extensions",
    "mode": "append",
    "priority": 100,
    "data_sources": [
        {
            "id": "socialProviders",
            "label_key": "$t:sirsoft-social_login.editor.data_source.providers",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-social_login/providers",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "fallback": {
                "data": []
            },
            "errorHandling": {
                "default": {
                    "comment": "다른 확장의 화면에 붙는 덧붙임이다 — 목록을 못 받으면 버튼만 그리지 않고(fallback 빈 목록), 템플릿 기본 오류 처리(원문 토스트)로 번지지 않게 막는다",
                    "handler": "suppress"
                }
            },
            "comment": "켜진 제공자 목록 — 비로그인으로 읽는다(자격증명 없음)."
        }
    ],
    "components": [
        {
            "comment": "이메일 제공을 거절해 가입이 막혀 돌아온 회원(social_error=email_required) — 그 제공자의 동의 화면을 다시 여는 단추.\n       제공자는 같은 앱의 다음 로그인에 동의 화면을 다시 띄우지 않으므로, 시작 주소에 재동의 요청(reconsent=1)을 싣는다.",
            "id": "social_login_reconsent",
            "type": "basic",
            "name": "Div",
            "if": "{{query.social_error === 'email_required' && (socialProviders?.data ?? []).some(p => p.key === query.provider)}}",
            "props": {
                "className": "sl:mt-6 sl:rounded-lg sl:border sl:border-amber-200 sl:dark:border-amber-800 sl:bg-amber-50 sl:dark:bg-amber-900/20 sl:p-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "sl:text-sm sl:text-amber-800 sl:dark:text-amber-200"
                    },
                    "text": "$t:sirsoft-social_login.notices.reconsent"
                },
                {
                    "id": "social_login_reconsent_link",
                    "type": "basic",
                    "name": "A",
                    "responsive": {
                        "640-": {
                            "props": {
                                "className": "sl:mt-3 sl:inline-flex sl:items-center sl:justify-center sl:w-full sl:px-4 sl:py-2 sl:text-sm sl:font-medium sl:rounded-lg sl:bg-amber-600 sl:hover:bg-amber-700 sl:text-white sl:dark:bg-amber-500 sl:dark:hover:bg-amber-600 sl:dark:text-gray-900"
                            }
                        }
                    },
                    "props": {
                        "href": "{{((socialProviders?.data ?? []).find(p => p.key === query.provider)?.start_url ?? '') + '?reconsent=1' + (typeof query.redirect === 'string' && query.redirect.startsWith('/') && !query.redirect.startsWith('/', 1) && !query.redirect.startsWith('\\\\', 1) ? '&redirect=' + encodeURIComponent(query.redirect) : '')}}",
                        "className": "sl:mt-3 sl:inline-flex sl:items-center sl:justify-center sl:w-full sl:px-4 sl:py-3 sl:text-sm sl:font-medium sl:rounded-lg sl:bg-amber-600 sl:hover:bg-amber-700 sl:text-white sl:dark:bg-amber-500 sl:dark:hover:bg-amber-600 sl:dark:text-gray-900"
                    },
                    "text": "$t:sirsoft-social_login.buttons.reconsent_with|provider={{(socialProviders?.data ?? []).find(p => p.key === query.provider)?.label ?? ''}}"
                }
            ]
        },
        {
            "id": "social_login_buttons_section",
            "type": "basic",
            "name": "Div",
            "if": "{{(socialProviders?.data ?? []).length > 0}}",
            "props": {
                "className": "sl:mt-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "sl:flex sl:items-center sl:gap-3 sl:mb-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "sl:flex-1 sl:h-px sl:bg-gray-200 sl:dark:bg-gray-700"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "sl:text-xs sl:text-gray-500 sl:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-social_login.divider.or"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "sl:flex-1 sl:h-px sl:bg-gray-200 sl:dark:bg-gray-700"
                            }
                        }
                    ]
                },
                {
                    "id": "social_login_provider_buttons",
                    "type": "composite",
                    "name": "sirsoft-social_login.ProviderButtons",
                    "props": {
                        "providers": "{{socialProviders?.data ?? []}}",
                        "intent": "login",
                        "redirect": "{{query.redirect ?? '/'}}"
                    }
                }
            ]
        }
    ]
}
