{
    "comment": "정보 수정 본인 확인 — 메일을 받을 수 없는 비밀번호 없는 회원(대체 이메일로 가입)에게 「{제공자}로 다시 확인」을 보인다.\n     템플릿의 기본 안내(관리자 문의)를 이 조각으로 바꾼다. 다시 로그인하고 돌아오면 정보 수정 화면의 진입 단계(mypage_profile_edit_reauth)가\n     확인을 마무리한다. 연결된 계정이 없으면 관리자 문의 안내를 그대로 보인다.",
    "extension_point": "mypage_reauth_methods",
    "mode": "replace",
    "priority": 100,
    "data_sources": [
        {
            "id": "socialReauthAccounts",
            "label_key": "$t:sirsoft-social_login.editor.data_source.accounts",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-social_login/me/accounts",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "comment": "내 연결 목록 — 다시 로그인할 제공자"
        }
    ],
    "components": [
        {
            "id": "social_reauth_methods",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "space-y-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "p-3 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 text-sm text-blue-700 dark:text-blue-300",
                        "role": "status"
                    },
                    "text": "$t:sirsoft-social_login.reauth.notice"
                },
                {
                    "id": "social_reauth_buttons",
                    "type": "composite",
                    "name": "sirsoft-social_login.ProviderButtons",
                    "props": {
                        "providers": "{{socialReauthAccounts?.data?.accounts ?? []}}",
                        "intent": "reauth"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "if": "{{!!socialReauthAccounts?.data && (socialReauthAccounts?.data?.accounts ?? []).length === 0}}",
                    "props": {
                        "className": "text-sm text-yellow-800 dark:text-yellow-300"
                    },
                    "text": "$t:sirsoft-social_login.reauth.unavailable"
                }
            ]
        }
    ]
}
