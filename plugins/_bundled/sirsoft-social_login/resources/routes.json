            "path": "*/admin/plugins/sirsoft-social_login/diagnostics",
            "layout": "social_login_diagnostics",
            "auth_required": true,
            "meta": {
                "title": "$t:sirsoft-social_login.admin.diagnostics.title",
                "permission": "sirsoft-social_login.settings.view"
            }
        },
        {
            "path": "*/admin/plugins/sirsoft-social_login/stats",
            "layout": "social_login_stats",
            "auth_required": true,
            "meta": {
                "title": "$t:sirsoft-social_login.admin.stats.title",
                "permission": "sirsoft-social_login.settings.view"
            }
        }
    ]
}
