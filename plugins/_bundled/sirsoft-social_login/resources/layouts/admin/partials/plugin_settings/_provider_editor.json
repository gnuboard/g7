                                    "name": "Input",
                                    "props": {
                                        "type": "url",
                                        "name": "userinfo_url",
                                        "className": "input"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:sirsoft-social_login.admin.providers.fields.jwks_url"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "url",
                                        "name": "jwks_url",
                                        "className": "input"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "grid grid-cols-3 gap-3"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:sirsoft-social_login.admin.providers.fields.button_bg"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "providerForm.button_style.bg": "{{$event.target.value}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "text",
                                        "className": "input",
                                        "placeholder": "#1F2937",
                                        "value": "{{_local.providerForm?.button_style?.bg ?? ''}}",
                                        "autoBinding": false
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:sirsoft-social_login.admin.providers.fields.button_fg"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "providerForm.button_style.fg": "{{$event.target.value}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "text",
                                        "className": "input",
                                        "placeholder": "#FFFFFF",
                                        "value": "{{_local.providerForm?.button_style?.fg ?? ''}}",
                                        "autoBinding": false
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:sirsoft-social_login.admin.providers.fields.button_border"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "providerForm.button_style.border": "{{$event.target.value}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "text",
                                        "className": "input",
                                        "placeholder": "#1F2937",
                                        "value": "{{_local.providerForm?.button_style?.border ?? ''}}",
                                        "autoBinding": false
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
