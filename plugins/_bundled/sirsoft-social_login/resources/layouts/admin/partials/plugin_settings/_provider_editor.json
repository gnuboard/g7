                                    "name": "Option",
                                    "props": {
                                        "value": "flag"
                                    },
                                    "text": "$t:sirsoft-social_login.admin.providers.email_trust.flag"
                                },
                                {
                                    "type": "basic",
                                    "name": "Option",
                                    "props": {
                                        "value": "trust"
                                    },
                                    "text": "$t:sirsoft-social_login.admin.providers.email_trust.trust"
                                },
                                {
                                    "type": "basic",
                                    "name": "Option",
                                    "props": {
                                        "value": "verify"
                                    },
                                    "text": "$t:sirsoft-social_login.admin.providers.email_trust.verify"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "form-hint"
                            },
                            "text": "$t:sirsoft-social_login.admin.providers.hints.email_trust"
                        }
                    ]
                }
            ]
        },
        {
            "id": "editor_buttons_{{provider.key}}",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex flex-wrap justify-end gap-2"
            },
            "children": [
                {
                    "id": "editor_cancel_button_{{provider.key}}",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "[저장]이 띄운 영향 확인(계속 저장 있음)도 닫는다 — 편집 칸 없이 남으면 [계속 저장]이 갈 곳이 없다",
                            "type": "click",
                            "handler": "setState",
                            "params": {
                                "target": "local",
                                "merge": "shallow",
                                "editingKey": null,
                                "providerForm": {},
                                "providerFormOrigin": {},
                                "providerErrors": null,
                                "impact": "{{_local.impact?.confirm === true ? null : _local.impact}}"
                            }
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-secondary text-sm"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "id": "editor_save_button_{{provider.key}}",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "켜진 제공자를 끄거나 자격증명을 바꾸면 먼저 영향(이 제공자로만 로그인하는 회원 수)을 보여 주고 확인을 받는다. 그 밖에는 바로 저장한다",
                            "type": "click",
                            "handler": "conditions",
                            "conditions": [
                                {
                                    "if": "{{provider.enabled && (!_local.providerForm?.enabled || (_local.providerForm?.client_id ?? '') !== (provider.client_id ?? '') || (_local.providerForm?.client_secret ?? null) !== (provider.client_secret ?? null))}}",
                                    "then": {
                                        "handler": "apiCall",
                                        "target": "/api/plugins/sirsoft-social_login/admin/providers/{{provider.key}}/impact",
                                        "auth_required": true,
                                        "params": {
                                            "method": "GET"
                                        },
                                        "onSuccess": {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "impact": "{{Object.assign({ key: provider.key, label: provider.display_label, confirm: true }, response.data)}}"
                                            }
                                        },
                                        "onError": {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message ?? '$t:sirsoft-social_login.admin.providers.save_failed'}}"
                                            }
                                        }
                                    }
                                },
                                {
                                    "then": {
                                        "actionRef": "saveProvider"
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-primary text-sm",
                        "disabled": "{{_local.isSavingProvider || !_computed.canEditProviders || JSON.stringify(_local.providerForm) === JSON.stringify(_local.providerFormOrigin)}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{!_local.isSavingProvider}}",
                            "text": "$t:common.save"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_local.isSavingProvider}}",
                            "text": "$t:common.saving"
                        }
                    ]
                }
            ]
        }
    ]
}
