                                    "props": {
                                        "type": "text",
                                        "name": "issuer",
                                        "className": "input"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:sirsoft-social_login.admin.providers.fields.authorize_url"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "url",
                                        "name": "authorize_url",
                                        "className": "input"
