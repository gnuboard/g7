{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "identifier": "sirsoft-social_login",
    "version": "1.0.1",
    "components": {
        "basic": [
            {
                "name": "ProviderMark",
                "type": "basic",
                "path": "plugins/_bundled/sirsoft-social_login/resources/js/components/basic/ProviderMark.tsx",
                "props": {
                    "brand": {
                        "type": "string",
                        "required": false,
                        "description": "버튼 모양 계열 — 서버가 `brand` 로 내려준다(모의 제공자도 원 제공자 계열). 내장 4종 밖은 custom"
                    },
                    "label": {
                        "type": "string",
                        "required": false,
                        "description": "커스텀 제공자 첫 글자 원형에 쓸 이름"
                    },
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    },
                    "id": {
                        "type": "string",
                        "required": false,
                        "description": "DOM id"
                    }
                }
            }
        ],
        "composite": [
            {
                "name": "ProviderButtons",
                "type": "composite",
                "path": "plugins/_bundled/sirsoft-social_login/resources/js/components/composite/ProviderButtons.tsx",
                "props": {
                    "providers": {
                        "type": "array",
                        "required": false,
                        "description": "제공자 목록"
                    },
                    "intent": {
                        "type": "ProviderButtonsIntent",
                        "required": false,
                        "description": "버튼이 하는 일"
                    },
                    "redirect": {
                        "type": "string",
                        "required": false,
                        "description": "로그인·가입 뒤 돌아갈 같은 출처 경로"
                    },
                    "size": {
                        "type": "'md' | 'sm'",
                        "required": false,
                        "description": "버튼 크기"
                    },
                    "disabled": {
                        "type": "boolean",
                        "required": false,
                        "description": "버튼 비활성"
                    },
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    },
                    "id": {
                        "type": "string",
                        "required": false,
                        "description": "DOM id"
                    },
                    "editorAttrs": {
                        "type": "object",
                        "required": false,
                        "description": "레이아웃 편집기가 주입하는 표식(편집 모드 전용)"
                    }
                }
            }
        ],
        "layout": []
    }
}
