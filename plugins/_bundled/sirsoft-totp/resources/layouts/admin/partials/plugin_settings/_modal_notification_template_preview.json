{
    "comment": "인증 앱 설정 — 알림 템플릿 미리보기 창. 편집 창이 만들어 둔 치환 결과를 보여 주기만 하고\n  입력이 없다 — 닫기 단추 하나뿐이다.",
    "meta": {
        "is_partial": true,
        "description": "인증 앱 보안 알림 치환 결과 미리보기"
    },
    "id": "modal_totp_notification_definition_preview",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-totp.admin.notifications.preview_modal.title",
        "size": "lg"
    },
    "children": [
        {
            "id": "totp_preview_content",
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "totp-form-label"
                            },
                            "text": "$t:sirsoft-totp.admin.notifications.preview_modal.rendered_subject"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "totp-text-primary totp:text-sm totp:bg-gray-50 totp:dark:bg-gray-900 totp:rounded-md totp:p-3 totp:border totp:border-gray-200 totp:dark:border-gray-700"
                            },
                            "text": "{{_global.totp_notification_template_form_modal?.preview?.subject ?? ''}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "totp-form-label"
                            },
                            "text": "$t:sirsoft-totp.admin.notifications.preview_modal.rendered_body"
                        },
                        {
                            "type": "composite",
                            "name": "HtmlContent",
                            "props": {
                                "content": "{{_global.totp_notification_template_form_modal?.preview?.body ?? ''}}",
                                "isHtml": true,
                                "className": "totp:text-sm totp:max-w-none totp:bg-white totp:dark:bg-gray-900 totp:rounded-md totp:p-4 totp:border totp:border-gray-200 totp:dark:border-gray-700 totp:max-h-[400px] totp:overflow-y-auto"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "totp:flex totp:justify-end totp:border-t totp:border-gray-200 totp:dark:border-gray-700"
                    },
                    "children": [
                        {
                            "id": "totp_btn_close_preview",
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "closeModal",
                                    "target": "modal_totp_notification_definition_preview"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "totp-text-body totp:px-4 totp:py-2 totp:rounded-md totp:border totp:border-gray-300 totp:dark:border-gray-600 totp:hover:bg-gray-50 totp:dark:hover:bg-gray-700 totp:transition-colors"
                            },
                            "text": "$t:sirsoft-totp.admin.notifications.preview_modal.btn_close"
                        }
                    ]
                }
            ]
        }
    ]
}
