                                    }
                                },
                                "onSuccess": {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "_kgReceipt": "{{response.data}}",
                                        "_kgEscrowConfirmUrl": "{{response.data.escrow_confirm_url ?? null}}"
                                    }
                                }
                            }
                        ]
                    },
                    "children": [
                        {
                            "comment": "간편결제 이름 — 결제 방법 행은 템플릿 소유라 값을 바꾸지 않고, 이 슬롯에 따로 한 줄을 둔다(이름은 요청 언어로 번역돼 온다)",
                            "id": "kginicis_easy_pay_row",
                            "type": "basic",
                            "name": "Div",
                            "if": "{{!!_local._kgReceipt?.embedded_pg_provider_label}}",
                            "props": {
                                "className": "pt-4 mt-2 border-t border-gray-200 dark:border-gray-700 flex-between"
