                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-pay_kginicis.user.payment_type_label"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300"
                                            },
                                            "text": "$t:sirsoft-pay_kginicis.admin.escrow_yes"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "id": "kginicis-mp-receipt-row",
                                        "className": "flex-between"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-pay_kginicis.user.receipt_label"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "A",
                                            "if": "{{_local._kgReceipt?.receipt_url}}",
                                            "props": {
                                                "href": "{{_local._kgReceipt?.receipt_url}}",
                                                "target": "_blank",
                                                "rel": "noopener noreferrer",
                                                "className": "text-sm text-blue-600 dark:text-blue-400 hover:underline"
                                            },
                                            "text": "$t:sirsoft-pay_kginicis.user.receipt_view"
                                        }
                                    ]
                                },
                                {
                                    "comment": "[구매결정] 은 새 창이라 토큰 로그인이 실리지 않는다 — 영수증 조회(토큰 인증)가 준 본인용 한시 서명 주소로 연다(S4-D19).",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!order.data.payment?.is_escrow && !!_local._kgEscrowConfirmUrl}}",
                                    "props": {
                                        "className": "pt-1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "A",
                                            "props": {
                                                "href": "{{_local._kgEscrowConfirmUrl}}",
                                                "target": "_blank",
                                                "rel": "noopener noreferrer",
                                                "className": "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "check-circle",
                                                        "className": "text-base"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-pay_kginicis.user.escrow_confirm_button"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "comment": "일본 결제(CBT) 결제확인서 — 결제사 영수증 주소가 없어 응답 항목으로 인쇄용 문서를 연다. 편의점 입금 대기면 같은 버튼이 입금정보 문서를 연다(이름은 응답이 요청 언어로 준다). 클릭한 틱에서 창을 열어야 팝업 차단에 걸리지 않으므로 받아 둔 응답을 그대로 넘긴다",
                            "id": "kginicis_cbt_confirmation_row",
                            "type": "basic",
                            "name": "Div",
                            "if": "{{_local._kgReceipt?.receipt_type === 'cbt_confirmation' && (_local._kgReceipt?.receipt_fields ?? []).length > 0}}",
                            "props": {
                                "className": "pt-4 mt-2 border-t border-gray-200 dark:border-gray-700 flex-between"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-sm text-gray-500 dark:text-gray-400"
                                    },
                                    "text": "{{_local._kgReceipt?.receipt_label || $t('sirsoft-pay_kginicis.user.receipt_label')}}"
                                },
                                {
                                    "comment": "결제확인서 보기 — 마운트 때 받아 둔 영수증 조회 응답으로 창을 연다. 클릭과 같은 틱에 열어야 팝업 차단에 걸리지 않아 다시 조회하지 않는다.",
                                    "type": "basic",
                                    "name": "Button",
                                    "actions": [
                                        {
                                            "type": "click",
                                            "handler": "sirsoft-pay_kginicis.openReceipt",
                                            "params": {
                                                "receipt": "{{_local._kgReceipt}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "className": "inline-flex items-center gap-1 text-sm text-blue-600 dark:text-blue-400 hover:underline"
                                    },
                                    "text": "{{_local._kgReceipt?.receipt_view_label || $t('sirsoft-pay_kginicis.user.receipt_view')}}"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
