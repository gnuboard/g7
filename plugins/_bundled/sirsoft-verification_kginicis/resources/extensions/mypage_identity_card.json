{
    "comment": "마이페이지 프로필에 KG이니시스 본인인증 이력 카드를 덧붙이는 조각",
    "target_layout": "mypage/profile",
    "priority": 110,
    "data_sources": [
        {
            "id": "inicisRecord",
            "label_key": "$t:sirsoft-verification_kginicis.editor.data_source.inicisRecord",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-verification_kginicis/me/identity/inicis",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "comment": "내 인증 이력. 없으면 카드 자체가 뜨지 않으므로 실패해도 프로필 화면은 그대로다"
        }
    ],
    "injections": [
        {
            "target_id": "profile_view_bio_card",
            "position": "append",
            "components": [
                {
                    "id": "profile_view_inicis_identity_card",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{inicisRecord?.data}}",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-4"
                            }
                        }
                    },
                    "props": {
                        "className": "bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "H3",
                            "props": {
                                "className": "text-base font-semibold text-gray-900 dark:text-white mb-4 pb-3 border-b border-gray-200 dark:border-gray-700"
                            },
                            "text": "$t:sirsoft-verification_kginicis.card.title"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6 text-sm"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-between gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-verification_kginicis.card.method"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{inicisRecord?.data?.method ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-between gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-verification_kginicis.card.verified_at"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{inicisRecord?.data?.verified_at ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-between gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-verification_kginicis.card.name"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{inicisRecord?.data?.name_masked ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-between gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-verification_kginicis.card.birthday"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{inicisRecord?.data?.birthday_masked ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-between gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-verification_kginicis.card.phone"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{inicisRecord?.data?.phone_masked ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-between gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-verification_kginicis.card.is_adult.label"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{inicisRecord?.data?.is_adult ? '$t:sirsoft-verification_kginicis.card.is_adult.true' : '$t:sirsoft-verification_kginicis.card.is_adult.false'}}"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "profile_view_inicis_identity_pending_card",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{!inicisRecord?.data}}",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-4"
                            }
                        }
                    },
                    "props": {
                        "className": "bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "H3",
                            "props": {
                                "className": "text-base font-semibold text-gray-900 dark:text-white mb-3 pb-3 border-b border-gray-200 dark:border-gray-700"
                            },
                            "text": "$t:sirsoft-verification_kginicis.card.title"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex items-start gap-3"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "circle-info",
                                        "className": "text-xl text-gray-400 dark:text-gray-500 flex-shrink-0 mt-0.5"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "space-y-1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "text-sm text-gray-700 dark:text-gray-300"
                                            },
                                            "text": "$t:sirsoft-verification_kginicis.card.pending.title"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "text-xs text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:sirsoft-verification_kginicis.card.pending.hint"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
