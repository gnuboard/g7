{
    "comment": "본인인증 창의 제공자 영역에 KG이니시스 안내·시작 버튼을 덧붙이는 조각 — 다른 제공자와 함께 실리므로 자기 provider_id 일 때만 그려진다",
    "extension_point": "identity_provider_ui:provider",
    "mode": "append",
    "priority": 100,
    "components": [
        {
            "comment": "초기 상태 — provider_id=inicis && !providerInProgress",
            "type": "basic",
            "name": "Div",
            "if": "{{_global.identityChallenge?.provider_id === 'inicis' && !(_global.identityChallenge?.providerInProgress)}}",
            "props": {
                "className": "verificationkginicis:space-y-4"
            },
            "children": [
                {
                    "comment": "헤더 — 아이콘 + 제목",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "verificationkginicis:flex verificationkginicis:items-center verificationkginicis:flex-col verificationkginicis:text-center verificationkginicis:space-y-2 verificationkginicis:pt-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "verificationkginicis:inline-flex verificationkginicis:items-center verificationkginicis:justify-center verificationkginicis:w-14 verificationkginicis:h-14 verificationkginicis:bg-blue-100 verificationkginicis:dark:bg-blue-900/40 verificationkginicis:rounded-full"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "fas fa-mobile-screen",
                                        "className": "verificationkginicis:text-2xl verificationkginicis:leading-none verificationkginicis:text-blue-600 verificationkginicis:dark:text-blue-400"
                                    }
                                }
                            ]
                        },
                        {
                            "comment": "성인인증 purpose 전용 제목",
                            "type": "basic",
                            "name": "H3",
                            "if": "{{_global.identityChallenge?.purpose === 'inicis.adult_verification'}}",
                            "props": {
                                "className": "verificationkginicis:text-base verificationkginicis:font-semibold verificationkginicis:text-gray-900 verificationkginicis:dark:text-white"
                            },
                            "text": "$t:sirsoft-verification_kginicis.modal.adult_title"
                        },
                        {
                            "comment": "기본 본인인증 제목 (signup/password_reset/self_update/sensitive_action 등)",
                            "type": "basic",
                            "name": "H3",
                            "if": "{{_global.identityChallenge?.purpose !== 'inicis.adult_verification'}}",
                            "props": {
                                "className": "verificationkginicis:text-base verificationkginicis:font-semibold verificationkginicis:text-gray-900 verificationkginicis:dark:text-white"
                            },
                            "text": "$t:sirsoft-verification_kginicis.modal.title"
                        },
                        {
                            "comment": "성인인증 purpose 전용 설명",
                            "type": "basic",
                            "name": "P",
                            "if": "{{_global.identityChallenge?.purpose === 'inicis.adult_verification'}}",
                            "props": {
                                "className": "verificationkginicis:text-sm verificationkginicis:text-gray-600 verificationkginicis:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-verification_kginicis.modal.adult_description"
                        },
                        {
                            "comment": "기본 본인인증 설명",
                            "type": "basic",
                            "name": "P",
                            "if": "{{_global.identityChallenge?.purpose !== 'inicis.adult_verification'}}",
                            "props": {
                                "className": "verificationkginicis:text-sm verificationkginicis:text-gray-600 verificationkginicis:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-verification_kginicis.modal.description"
                        }
                    ]
                },
                {
                    "comment": "본인인증 시작 버튼 — 사용자 제스처 컨텍스트에서 window.open 호출 (popup blocker 회피)",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sirsoft-verification_kginicis.startAuth"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "verificationkginicis:w-full verificationkginicis:inline-flex verificationkginicis:items-center verificationkginicis:justify-center verificationkginicis:gap-2 verificationkginicis:px-4 verificationkginicis:py-3 verificationkginicis:bg-blue-600 verificationkginicis:dark:bg-blue-600 verificationkginicis:text-white verificationkginicis:rounded-lg verificationkginicis:hover:bg-blue-700 verificationkginicis:dark:hover:bg-blue-700 verificationkginicis:font-semibold verificationkginicis:transition-colors"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:sirsoft-verification_kginicis.modal.start_button"
                        },
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "fas fa-arrow-right",
                                "className": "verificationkginicis:text-sm verificationkginicis:leading-none"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "comment": "진행 중 상태 — provider_id=inicis && providerInProgress. 팝업 열린 후 결과 대기 중",
            "type": "basic",
            "name": "Div",
            "if": "{{_global.identityChallenge?.provider_id === 'inicis' && (_global.identityChallenge?.providerInProgress)}}",
            "props": {
                "className": "verificationkginicis:flex verificationkginicis:items-center verificationkginicis:flex-col verificationkginicis:text-center verificationkginicis:space-y-4 verificationkginicis:py-6",
                "role": "status",
                "aria-live": "polite"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "fas fa-spinner fa-spin",
                        "className": "verificationkginicis:text-3xl verificationkginicis:leading-none verificationkginicis:text-blue-600 verificationkginicis:dark:text-blue-400"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "verificationkginicis:text-sm verificationkginicis:font-medium verificationkginicis:text-gray-900 verificationkginicis:dark:text-white"
                    },
                    "text": "$t:sirsoft-verification_kginicis.modal.in_progress.title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "verificationkginicis:p-3 verificationkginicis:bg-amber-50 verificationkginicis:dark:bg-amber-900/20 verificationkginicis:border verificationkginicis:border-amber-200 verificationkginicis:dark:border-amber-800 verificationkginicis:rounded verificationkginicis:text-xs verificationkginicis:text-yellow-700 verificationkginicis:dark:text-yellow-300"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "verificationkginicis:inline-flex verificationkginicis:items-start verificationkginicis:gap-1.5"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "fas fa-circle-info",
                                        "className": "verificationkginicis:mt-0.5"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-verification_kginicis.modal.in_progress.hint"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
