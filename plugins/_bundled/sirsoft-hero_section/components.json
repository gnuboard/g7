{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "identifier": "sirsoft-hero_section",
    "version": "1.0.0",
    "components": {
        "basic": [],
        "composite": [
            {
                "name": "HeroBannerPreview",
                "type": "composite",
                "path": "plugins/_bundled/sirsoft-hero_section/resources/js/components/composite/HeroBannerPreview.tsx",
                "props": {
                    "banners": {
                        "type": "array",
                        "required": false,
                        "description": "목록 미리보기의 공개 모양 배너"
                    },
                    "draft": {
                        "type": "HeroDraft",
                        "required": false,
                        "description": "편집 화면의 저장 전 원본 문구·이미지"
                    },
                    "locale": {
                        "type": "string",
                        "required": false,
                        "description": "콘텐츠 언어·사이트 기본 언어"
                    },
                    "defaultLocale": {
                        "type": "string",
                        "required": false
                    },
                    "localeNames": {
                        "type": "object",
                        "required": false,
                        "description": "언어 코드 => 언어 이름(언어 탭과 같은 표시 이름). 없거나 빠진 언어는 코드 대문자로 보인다."
                    },
                    "onContentLocaleChange": {
                        "type": "function",
                        "required": false,
                        "description": "실제로 바뀐 문구 언어를 편집 화면에 알립니다."
                    },
                    "settings": {
                        "type": "HeroSliderSettings",
                        "required": false,
                        "description": "위치 설정"
                    },
                    "device": {
                        "type": "'pc' | 'mobile'",
                        "required": false,
                        "description": "실제 미리보기 viewport"
                    },
                    "emptyText": {
                        "type": "string",
                        "required": false,
                        "description": "빈 목록 문구"
                    },
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 클래스"
                    },
                    "frame": {
                        "type": "PreviewFrame | null",
                        "required": false,
                        "description": "활성 사용자 템플릿의 구좌 틀(위치 설정 응답 `editor.preview_frame`). 주면 기기 viewport 안에 템플릿 본문 상자를 같은 템플릿 CSS 로 그려 실제 사이트와 같은 구좌 폭에서 미리 본다. 없거나 그 위치에 확장점이 없으면 기기 폭 전체(종전 동작)."
                    },
                    "position": {
                        "type": "string",
                        "required": false,
                        "description": "틀에서 고를 위치 키(`home_hero`·`shop_hero`)"
                    },
                    "onTextPositionChange": {
                        "type": "function",
                        "required": false,
                        "description": "편집 화면 전용 — 미리보기의 문구 상자를 끌거나 화살표 키로 옮기면 지금 기기의 새 자리를 표현값 조각으로 알린다 (`{ text_pc_x, text_pc_y }` 또는 `{ text_mobile_x, text_mobile_y }`). 주지 않으면 문구는 옮길 수 없다(목록 미리보기)."
                    }
                }
            },
            {
                "name": "HeroConflictResolver",
                "type": "composite",
                "path": "plugins/_bundled/sirsoft-hero_section/resources/js/components/composite/HeroConflictResolver.tsx",
                "props": {
                    "base": {
                        "type": "Detail | null",
                        "required": false,
                        "description": "편집을 시작한 기준 — 처음 불러온 상세(재적용 뒤에는 그때의 최신본)"
                    },
                    "mine": {
                        "type": "Detail | null",
                        "required": false,
                        "description": "지금 폼의 입력값"
                    },
                    "latest": {
                        "type": "Detail | null",
                        "required": false,
                        "description": "충돌 뒤 다시 받은 최신 상세(revision 포함)"
                    },
                    "locales": {
                        "type": "array",
                        "required": false,
                        "description": "사이트 활성 언어 — 다국어 값 표시 순서"
                    },
                    "onApply": {
                        "type": "function",
                        "required": false,
                        "description": "고른 값으로 만든 폼(최신 revision)과, 다음 비교의 기준이 될 최신본을 넘긴다."
                    }
                }
            },
            {
                "name": "HeroPeriodHint",
                "type": "composite",
                "path": "plugins/_bundled/sirsoft-hero_section/resources/js/components/composite/HeroPeriodHint.tsx",
                "props": {
                    "period": {
                        "type": "string",
                        "required": false,
                        "description": "상시/기간 지정"
                    },
                    "active": {
                        "type": "boolean",
                        "required": false,
                        "description": "사용 여부"
                    },
                    "start": {
                        "type": "string",
                        "required": false,
                        "description": "사이트 시간대로 입력한 시작·종료"
                    },
                    "end": {
                        "type": "string",
                        "required": false
                    },
                    "timezone": {
                        "type": "string",
                        "required": false,
                        "description": "서버가 알려준 사이트 시간대·현재 시각"
                    },
                    "serverNow": {
                        "type": "string",
                        "required": false
                    }
                }
            },
            {
                "name": "HeroPreviewLanguage",
                "type": "composite",
                "path": "plugins/_bundled/sirsoft-hero_section/resources/js/components/composite/HeroPreviewLanguage.tsx",
                "props": {
                    "locales": {
                        "type": "array",
                        "required": false,
                        "description": "사이트 활성 언어"
                    },
                    "locale": {
                        "type": "string",
                        "required": false,
                        "description": "미리 볼 콘텐츠 언어"
                    },
                    "localeNames": {
                        "type": "object",
                        "required": false,
                        "description": "언어 코드 => 언어 이름(언어 탭과 같은 표시 이름). 없거나 빠진 언어는 코드 대문자로 보인다."
                    },
                    "onLocaleChange": {
                        "type": "function",
                        "required": false,
                        "description": "언어 선택 콜백"
                    }
                }
            },
            {
                "name": "HeroSlider",
                "type": "composite",
                "path": "plugins/_bundled/sirsoft-hero_section/resources/js/components/composite/HeroSlider.tsx",
                "props": {
                    "banners": {
                        "type": "array",
                        "required": false,
                        "description": "노출 배너 (공개 API 순서 그대로)"
                    },
                    "settings": {
                        "type": "HeroSliderSettings",
                        "required": false,
                        "description": "위치 슬라이더 설정"
                    },
                    "position": {
                        "type": "string",
                        "required": false,
                        "description": "위치 키 (`home_hero`·`shop_hero`) — 오버라이드·테스트 식별용"
                    },
                    "forceDevice": {
                        "type": "'pc' | 'mobile'",
                        "required": false,
                        "description": "미리보기용 기기 고정 — 지정하면 화면 폭과 관계없이 그 기기 이미지·영상·모양을 쓴다(mobile 이면 루트에 `hs-slider--mobile`· `hs-slider--portable`, pc 면 둘 다 없음). 없으면 엔진 반응형 폭으로 판정한다."
                    },
                    "contentClass": {
                        "type": "string",
                        "required": false,
                        "description": "템플릿 본문 상자 클래스(지금 화면 폭에 맞는 값) — 확장점이 넘긴다(`extensionPointProps.contentClass`, 데스크톱은 `contentClassDesktop`). 본문 폭이면 슬라이더 바깥, 화면 전체면 문구 층·넘김 단추에 쓴다. 비우면 둘 다 감싸지 않는다."
                    },
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    },
                    "loading": {
                        "type": "boolean",
                        "required": false,
                        "description": "배너를 받는 중 — 확장점 조각이 공개 API 응답 전(`undefined`)이면 true 로 넘긴다. 받는 동안 배너가 없으면 같은 비율·폭의 스켈레톤을 그려 받은 뒤 아래 본문이 밀리지 않게 한다. 직전 방문에서 그 위치가 0건이었으면 스켈레톤도 그리지 않는다."
                    },
                    "skeletonWidth": {
                        "type": "'content' | 'full' | ''",
                        "required": false,
                        "description": "받는 동안 스켈레톤의 표시 폭 — 확장점 조각이 첫 로드 때 받은 플러그인 설정 힌트(`_global.plugins['sirsoft-hero_section'].slot_widths`) 를 넘긴다. 없으면 브라우저에 남긴 직전 모양, 그것도 없으면 본문 폭."
                    },
                    "skeletonOverlay": {
                        "type": "boolean",
                        "required": false,
                        "description": "받는 동안 메뉴를 겹칠지 — 확장점 조각이 플러그인 설정 힌트(`slot_overlays`)를 넘긴다. 켜져 있으면 스켈레톤도 메뉴 밑으로 들어가 배너가 와도 화면이 위아래로 밀리지 않는다. 없으면 브라우저에 남긴 직전 모양."
                    },
                    "skeletonBanners": {
                        "type": "boolean",
                        "required": false,
                        "description": "받는 동안 자리를 잡을지 — 확장점 조각이 첫 로드 플러그인 설정 힌트(`slot_banners`)로 넘긴다. 첫 접속은 브라우저 기억이 없으므로 이 값이 false 면 배너가 없는 위치에 스켈레톤을 그리지 않는다. 브라우저 기억이 0건이어도 그리지 않는다(둘 중 하나라도 없음이면 생략)."
                    },
                    "onTextMove": {
                        "type": "function",
                        "required": false,
                        "description": "편집 미리보기 전용 — 주면 문구 상자를 끌거나 화살표 키로 옮길 수 있고, 놓을 때 고정 기기(`forceDevice`)의 새 자리를 알린다. 사이트 화면에서는 넘기지 않는다."
                    },
                    "replay": {
                        "type": "number",
                        "required": false,
                        "description": "편집 미리보기 전용 — 값이 바뀌면 문구 등장 효과를 처음부터 다시 재생한다"
                    },
                    "id": {
                        "type": "string",
                        "required": false,
                        "description": "DOM id"
                    },
                    "editorAttrs": {
                        "type": "object",
                        "required": false,
                        "description": "레이아웃 편집기 주입 속성 (편집 모드 전용, 루트에 spread)"
                    }
                }
            },
            {
                "name": "HeroTextPositionPad",
                "type": "composite",
                "path": "plugins/_bundled/sirsoft-hero_section/resources/js/components/composite/HeroTextPositionPad.tsx",
                "props": {
                    "presentation": {
                        "type": "HeroTextPresentation | null",
                        "required": false,
                        "description": "저장 전 표현값(`_local.form.presentation`)"
                    },
                    "device": {
                        "type": "HeroDevice",
                        "required": false,
                        "description": "위치를 정할 기기 — 편집 미리보기의 기기와 같게 둔다"
                    },
                    "disabled": {
                        "type": "boolean",
                        "required": false,
                        "description": "잠금(저장 중)"
                    },
                    "onChange": {
                        "type": "function",
                        "required": false,
                        "description": "고른 자리를 표현값 조각으로 알린다(`{ text_pc_x, text_pc_y }` 등)"
                    },
                    "onDeviceChange": {
                        "type": "function",
                        "required": false,
                        "description": "기기를 바꿨다"
                    }
                }
            }
        ],
        "layout": []
    }
}
