{
    "_meta": {
        "version": "1.0.0",
        "description": "히어로섹션 플러그인 환경설정"
    },
    "defaults": {
        "max_upload_mb": 5,
        "max_video_upload_mb": 30,
        "public_cache_minutes": 10,
        "public_asset_disk": "",
        "slot_widths": { "home_hero": "content", "shop_hero": "content" },
        "slot_overlays": { "home_hero": false, "shop_hero": false },
        "slot_banners": { "home_hero": false, "shop_hero": false }
    },
    "frontend_schema": {
        "max_upload_mb": { "expose": false },
        "max_video_upload_mb": { "expose": false },
        "public_cache_minutes": { "expose": false },
        "public_asset_disk": { "expose": false },
        "slot_widths": { "expose": true },
        "slot_overlays": { "expose": true },
        "slot_banners": { "expose": true }
    }
}
