{
    "target_layout": "admin_ecommerce_order_list",
    "priority": 200,
    "data_sources": [
        {
            "id": "nhnkcp_test_map",
            "label_key": "$t:sirsoft-pay_nhnkcp.editor.data_source.nhnkcp_test_map",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-pay_nhnkcp/admin/orders/test-mode-map",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive"
        },
        {
            "id": "nhnkcp_easy_pay_display_map",
            "label_key": "$t:sirsoft-pay_nhnkcp.editor.data_source.nhnkcp_easy_pay_display_map",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-pay_nhnkcp/admin/orders/easy-pay-display-map",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive"
        },
        {
            "id": "nicepay_test_map",
            "label_key": "$t:sirsoft-pay_nhnkcp.editor.data_source.nicepay_test_map",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-pay_nicepayments/admin/orders/test-mode-map",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "condition": "{{installed_plugins?.['sirsoft-pay_nicepayments']?.is_active === true}}"
        }
    ],
    "injections": [
        {
            "target_id": "order_datagrid",
            "position": "inject_props",
            "props": {
                "columns": {
                    "_patch": {
                        "by": "field",
                        "items": [
                            {
                                "field": "payment_method",
                                "cellChildren": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "row-stack"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "{{nhnkcp_easy_pay_display_map.data?.[row.order_number]?.payment_method_display_label ?? row.payment?.payment_method_label}}"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "if": "{{nhnkcp_test_map.data?.[row.order_number] === true}}",
                                                "props": {
                                                    "className": "text-xs font-medium text-orange-500 dark:text-orange-400 leading-tight"
                                                },
                                                "text": "($t:sirsoft-pay_nhnkcp.admin.test_mode_badge)"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "if": "{{nicepay_test_map.data?.[row.order_number] === true}}",
                                                "props": {
                                                    "className": "text-xs font-medium text-orange-500 dark:text-orange-400 leading-tight"
                                                },
                                                "text": "($t:sirsoft-pay_nicepayments.admin.test_mode_badge)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        }
    ]
}
