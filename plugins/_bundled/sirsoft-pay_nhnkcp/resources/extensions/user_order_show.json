                                        "type": "submit",
                                        "className": "w-full py-1.5 text-xs font-semibold rounded border border-orange-400 dark:border-orange-600 bg-orange-50 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 hover:bg-orange-100 dark:hover:bg-orange-900/50 transition-colors"
                                    },
                                    "text": "$t:sirsoft-pay_nhnkcp.user.mock_submit"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "P",
                    "if": "{{nhnkcp_mock_deposit.data.is_admin_view === true}}",
                    "props": {
                        "className": "mt-2 text-xs text-center text-orange-500 dark:text-orange-400 font-medium"
                    },
                    "text": "$t:sirsoft-pay_nhnkcp.user.mock_admin_notice"
                }
            ]
        }
    ]
}
