                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{!(kcp_status.data?.refund_status === 'completed' && (kcp_status.data?.payment_status === 'cancelled' || kcp_status.data?.payment_status === 'partial_cancelled')) && kcp_status.data?.payment_status !== 'cancelled' && kcp_status.data?.payment_status !== 'partial_cancelled' && !(kcp_status.data?.payment_status === 'paid' && kcp_status.data?.res_cd === '0000')}}",
                                    "props": {
                                        "className": "ml-auto inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300"
                                    },
                                    "text": "$t:sirsoft-pay_nhnkcp.admin.pay_status_unknown"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{kcp_escrow_delivery.data?.has_escrow_payment === true}}",
                                    "props": {
                                        "className": "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300"
                                    },
                                    "text": "$t:sirsoft-pay_nhnkcp.admin.escrow_badge"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "grid grid-cols-2 gap-x-4 gap-y-2 text-xs"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-gray-500 dark:text-gray-400"
                                    },
                                    "text": "$t:sirsoft-pay_nhnkcp.admin.result_payment_status"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-gray-900 dark:text-gray-100"
                                    },
                                    "text": "{{kcp_status.data?.payment_status_label ?? '-'}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-gray-500 dark:text-gray-400"
