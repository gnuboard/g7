                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "font-mono text-gray-900 dark:text-gray-100 break-all"
                                    },
                                    "text": "{{kcp_status.data?.tno ?? '-'}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-gray-500 dark:text-gray-400"
                                    },
                                    "text": "$t:sirsoft-pay_nhnkcp.admin.result_app_no"
