                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{kcp_status.data?.payment_status === 'cancelled' && kcp_status.data?.refund_status !== 'completed'}}",
                                    "props": {
                                        "className": "ml-auto inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300"
                                    },
                                    "text": "$t:sirsoft-pay_nhnkcp.admin.pay_status_cancelled"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{kcp_status.data?.payment_status === 'paid' && kcp_status.data?.res_cd === '0000'}}",
                                    "props": {
                                        "className": "ml-auto inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300"
                                    },
                                    "text": "$t:sirsoft-pay_nhnkcp.admin.pay_status_approved"
