{
    "comment": "주문 상세에 NHN KCP 전용 결제 도구를 붙이는 조각 — 거래 상태 확인과 에스크로 배송 등록을 다룬다",
    "target_layout": "admin_ecommerce_order_detail",
    "data_sources": [
        {
            "id": "kcp_status",
            "label_key": "$t:sirsoft-pay_nhnkcp.editor.data_source.kcp_status",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-pay_nhnkcp/admin/orders/{{route.orderNumber}}/transaction-status",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "comment": "이 주문의 KCP 결제 상태 — 테스트 결제 배너의 근거이기도 하다"
        },
        {
            "id": "kcp_escrow_delivery",
            "label_key": "$t:sirsoft-pay_nhnkcp.editor.data_source.kcp_escrow_delivery",
            "type": "api",
            "endpoint": "/api/plugins/sirsoft-pay_nhnkcp/admin/orders/{{route.orderNumber}}/escrow-delivery",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "comment": "에스크로 배송 등록 상태 — 등록 폼을 띄울지 여기서 정한다"
        }
    ],
    "injections": [
        {
            "target_id": "sticky_header_container",
            "position": "append_child",
            "components": [
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{kcp_status.data?._is_test_mode === true}}",
                    "props": {
                        "className": "mx-6 mb-3 px-3 py-2 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-700 rounded-lg flex items-center gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "flask",
                                "className": "text-base text-orange-600 dark:text-orange-400 flex-shrink-0"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-sm font-semibold text-orange-800 dark:text-orange-300"
                            },
                            "text": "$t:sirsoft-pay_nhnkcp.admin.test_mode_badge"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-sm text-orange-700 dark:text-orange-400"
                            },
                            "text": "$t:sirsoft-pay_nhnkcp.admin.test_mode_order_notice"
                        }
                    ]
                }
            ]
        },
