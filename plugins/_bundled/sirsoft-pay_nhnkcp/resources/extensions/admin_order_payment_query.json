                                                    "name": "Option",
                                                    "props": {
                                                        "value": "08"
                                                    },
                                                    "text": "롯데택배"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Option",
                                                    "props": {
                                                        "value": "09"
                                                    },
                                                    "text": "우체국택배"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Option",
                                                    "props": {
                                                        "value": "11"
                                                    },
                                                    "text": "경동택배"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Option",
                                                    "props": {
                                                        "value": "13"
                                                    },
                                                    "text": "일양로지스"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Option",
                                                    "props": {
                                                        "value": "14"
                                                    },
                                                    "text": "합동택배"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Option",
                                                    "props": {
                                                        "value": "20"
                                                    },
                                                    "text": "드림택배"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Option",
                                                    "props": {
                                                        "value": "23"
                                                    },
                                                    "text": "천일택배"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Option",
                                                    "props": {
                                                        "value": "26"
                                                    },
                                                    "text": "건영택배"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Option",
                                                    "props": {
                                                        "value": "40"
                                                    },
                                                    "text": "$t:sirsoft-pay_nhnkcp.admin.escrow_delivery_courier_etc"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex justify-end"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Button",
                                            "actions": [
                                                {
                                                    "comment": "에스크로 배송 등록 — 위에서 입력한 송장번호·택배사 코드를 보내고, 끝나면 등록 상태를 다시 받는다",
                                                    "type": "click",
                                                    "handler": "sequence",
                                                    "actions": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "_ked_registering": true,
                                                                "_ked_error": null
                                                            }
                                                        },
                                                        {
                                                            "handler": "apiCall",
                                                            "target": "/api/plugins/sirsoft-pay_nhnkcp/admin/orders/{{route.orderNumber}}/escrow-delivery",
                                                            "auth_required": true,
                                                            "params": {
                                                                "method": "POST",
                                                                "body": {
                                                                    "deli_numb": "{{_local._ked_deli_numb ?? ''}}",
                                                                    "deli_corp": "{{_local._ked_deli_corp ?? ''}}"
                                                                }
                                                            },
                                                            "onSuccess": [
                                                                {
                                                                    "handler": "setState",
                                                                    "params": {
                                                                        "target": "local",
                                                                        "_ked_registering": false
                                                                    }
                                                                },
                                                                {
                                                                    "handler": "toast",
                                                                    "params": {
                                                                        "type": "success",
                                                                        "message": "$t:sirsoft-pay_nhnkcp.admin.escrow_delivery_success"
                                                                    }
                                                                },
                                                                {
                                                                    "handler": "refetchDataSource",
                                                                    "params": {
                                                                        "dataSourceId": "kcp_escrow_delivery"
                                                                    }
                                                                }
                                                            ],
                                                            "onError": {
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "_ked_registering": false,
                                                                    "_ked_error": "{{error.errors?.deli_numb?.[0] ?? error.errors?.deli_corp?.[0] ?? Object.values(error.errors ?? {}).flat()[0] ?? '$t:sirsoft-pay_nhnkcp.admin.escrow_delivery_error'}}"
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            ],
                                            "props": {
                                                "disabled": "{{order?.data?.abilities?.can_update !== true || (_local._ked_registering || String(_local._ked_deli_numb ?? '').trim() === '' || String(_local._ked_deli_corp ?? '').trim() === '')}}",
                                                "className": "flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-purple-600 hover:bg-purple-700 text-white rounded-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "if": "{{_local._ked_registering}}",
                                                    "props": {
                                                        "name": "spinner",
                                                        "className": "text-xs animate-spin"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "if": "{{_local._ked_registering}}",
                                                    "text": "$t:sirsoft-pay_nhnkcp.admin.escrow_delivery_registering"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "if": "{{!_local._ked_registering && !kcp_escrow_delivery.data?.registered_delivery}}",
                                                    "text": "$t:sirsoft-pay_nhnkcp.admin.escrow_delivery_register_button"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "if": "{{!_local._ked_registering && kcp_escrow_delivery.data?.registered_delivery}}",
                                                    "text": "$t:sirsoft-pay_nhnkcp.admin.escrow_delivery_change_button"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{_local._ked_error}}",
                                    "props": {
                                        "className": "text-xs text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 rounded px-2 py-1.5"
                                    },
                                    "text": "{{_local._ked_error}}"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
