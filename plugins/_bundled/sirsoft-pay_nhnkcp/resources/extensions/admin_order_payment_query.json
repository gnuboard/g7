                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "font-mono text-gray-900 dark:text-gray-100"
                                    },
                                    "text": "{{kcp_status.data?.app_no ?? '-'}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-gray-500 dark:text-gray-400"
