{
    "comment": "gdpr 설정 — 알림 템플릿 미리보기 창. 편집 창이 만들어 둔 결과를 보여 주기만 하고\n  입력이 없다 — 그래서 이 조각에는 액션이 하나도 없다.",
    "meta": {
        "is_partial": true,
        "description": "알림 템플릿 치환 결과 미리보기"
    },
    "id": "modal_gdpr_notification_definition_preview",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-gdpr.notification_definitions.preview_modal.title",
        "size": "lg"
    },
    "children": [
        {
            "id": "gdpr_preview_content",
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "gdpr-form-label"
                            },
                            "text": "$t:sirsoft-gdpr.notification_definitions.preview_modal.rendered_subject"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "gdpr-text-primary gdpr:text-sm gdpr:bg-gray-50 gdpr:dark:bg-gray-900 gdpr:rounded-md gdpr:p-3 gdpr:border gdpr:border-gray-200 gdpr:dark:border-gray-700"
                            },
                            "text": "{{_global.gdpr_notification_template_form_modal?.preview?.subject ?? ''}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "gdpr-form-label"
                            },
                            "text": "$t:sirsoft-gdpr.notification_definitions.preview_modal.rendered_body"
                        },
                        {
                            "type": "composite",
                            "name": "HtmlContent",
                            "props": {
                                "content": "{{_global.gdpr_notification_template_form_modal?.preview?.body ?? ''}}",
                                "isHtml": true,
                                "className": "gdpr:text-sm gdpr:max-w-none gdpr:bg-white gdpr:dark:bg-gray-900 gdpr:rounded-md gdpr:p-4 gdpr:border gdpr:border-gray-200 gdpr:dark:border-gray-700 gdpr:max-h-[400px] gdpr:overflow-y-auto"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "gdpr:flex gdpr:justify-end gdpr:border-t gdpr:border-gray-200 gdpr:dark:border-gray-700"
                    },
                    "children": [
                        {
                            "id": "gdpr_btn_close_preview",
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "closeModal",
                                    "target": "modal_gdpr_notification_definition_preview"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "gdpr-text-body gdpr:px-4 gdpr:py-2 gdpr:rounded-md gdpr:border gdpr:border-gray-300 gdpr:dark:border-gray-600 gdpr:hover:bg-gray-50 gdpr:dark:hover:bg-gray-700 gdpr:transition-colors"
                            },
                            "text": "$t:sirsoft-gdpr.notification_definitions.preview_modal.btn_close"
                        }
                    ]
                }
            ]
        }
    ]
}
