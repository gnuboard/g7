{
    "comment": "CKEditor 5 플러그인 환경설정 화면 — 툴바·높이·이미지 업로드 등 편집기 동작을 정하고 아래 미리보기로 바로 확인한다",
    "version": "1.0.0",
    "layout_name": "plugin_settings",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:sirsoft-ckeditor5.settings.title",
        "description": "$t:sirsoft-ckeditor5.settings.description"
    },
    "data_sources": [
        {
            "id": "settings",
            "label_key": "$t:sirsoft-ckeditor5.editor.data_source.settings",
            "type": "api",
            "endpoint": "/api/admin/plugins/{{route.identifier}}/settings",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "initLocal": "form",
            "refetchOnMount": true,
            "comment": "현재 설정값. 화면에 들어올 때마다 다시 받아 폼 초기값으로 넣는다(initLocal=form)"
        }
    ],
    "permissions": [
        "core.plugins.update"
    ],
    "slots": {
        "content": [
            {
                "id": "plugin_settings_content",
                "type": "basic",
                "name": "Div",
                "dataKey": "form",
                "trackChanges": true,
                "props": {
                    "className": "admin-page-content-responsive"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:sirsoft-ckeditor5.settings.title",
                            "description": "$t:sirsoft-ckeditor5.settings.description",
                            "backPath": "/admin/plugins",
                            "backLabel": "$t:admin.plugins.back_to_list"
                        }
                    },
                    {
                        "id": "notice_banner",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "alert-info"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex-center gap-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "circle-info",
                                            "size": "lg",
                                            "className": "text-blue-600 dark:text-blue-400 flex-shrink-0"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": {
                                            "className": "text-info-soft"
                                        },
                                        "text": "$t:sirsoft-ckeditor5.settings.notice"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "validation_error",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_local.errors}}",
                        "props": {
                            "className": "alert-danger"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex-center gap-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "triangle-exclamation",
                                            "size": "lg",
                                            "className": "text-red-600 dark:text-red-400 flex-shrink-0"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H3",
                                                "props": {
                                                    "className": "text-error-soft"
                                                },
                                                "text": "$t:admin.plugins.settings.validation_error"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Ul",
                                                "if": "{{typeof _local.errors === 'object' && Object.keys(_local.errors).length > 0}}",
                                                "iteration": {
                                                    "source": "Object.entries(_local.errors ?? {}).flatMap(([field, messages]) => Array.isArray(messages) ? messages : [messages])",
                                                    "item_var": "message"
                                                },
                                                "props": {
                                                    "className": "mt-2 list-disc list-inside space-y-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Li",
                                                        "props": {
                                                            "className": "grid-3col-responsive"
                                                        },
                                                        "text": "{{message}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section_toolbar_card",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-6 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "id": "section_toolbar_header",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "panel-header-row"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "H3",
                                        "props": {
                                            "className": "text-error-strong"
                                        },
                                        "text": "$t:sirsoft-ckeditor5.settings.section_toolbar"
                                    }
                                ]
                            },
                            {
                                "id": "section_toolbar_fields",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "p-6 space-y-6"
                                },
                                "children": [
                                    {
                                        "id": "field_toolbar",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "section-heading-md"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "$t:sirsoft-ckeditor5.settings.fields.toolbar.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "$t:sirsoft-ckeditor5.settings.fields.toolbar.hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Select",
                                                        "props": {
                                                            "name": "toolbar",
                                                            "className": "focus:border-transparent"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Option",
                                                                "props": {
                                                                    "value": "minimal"
                                                                },
                                                                "text": "$t:sirsoft-ckeditor5.settings.fields.toolbar.minimal"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Option",
                                                                "props": {
                                                                    "value": "standard"
                                                                },
                                                                "text": "$t:sirsoft-ckeditor5.settings.fields.toolbar.standard"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Option",
                                                                "props": {
                                                                    "value": "full"
                                                                },
                                                                "text": "$t:sirsoft-ckeditor5.settings.fields.toolbar.full"
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_editor_height",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "section-heading-md"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "$t:sirsoft-ckeditor5.settings.fields.editor_height.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "$t:sirsoft-ckeditor5.settings.fields.editor_height.hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "number",
                                                            "name": "editorHeight",
                                                            "className": "focus:border-transparent"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section_image_card",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "id": "section_image_header",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "panel-header-row"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "H3",
                                        "props": {
                                            "className": "text-error-strong"
                                        },
                                        "text": "$t:sirsoft-ckeditor5.settings.section_image"
                                    }
                                ]
                            },
                            {
                                "id": "section_image_fields",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "p-6 space-y-6"
                                },
                                "children": [
                                    {
                                        "id": "field_image_upload",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "section-heading-md"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "$t:sirsoft-ckeditor5.settings.fields.image_upload.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "$t:sirsoft-ckeditor5.settings.fields.image_upload.hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "composite",
                                                        "name": "Toggle",
                                                        "props": {
                                                            "name": "imageUpload"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "field_image_max_size",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "section-heading-md"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": {
                                                            "className": "form-label"
                                                        },
                                                        "text": "$t:sirsoft-ckeditor5.settings.fields.image_max_size.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "form-hint"
                                                        },
                                                        "text": "$t:sirsoft-ckeditor5.settings.fields.image_max_size.hint"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "lg:col-span-2"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "number",
                                                            "name": "imageMaxSizeMb",
                                                            "className": "focus:border-transparent"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "guide_section",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-4 bg-gray-50 dark:bg-gray-800/50 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H3",
                                "props": {
                                    "className": "section-heading mb-4"
                                },
                                "text": "$t:sirsoft-ckeditor5.settings.guide.title"
                            },
                            {
                                "type": "basic",
                                "name": "Ol",
                                "props": {
                                    "className": "list-decimal list-inside space-y-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-label"
                                        },
                                        "text": "$t:sirsoft-ckeditor5.settings.guide.step1"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-label"
                                        },
                                        "text": "$t:sirsoft-ckeditor5.settings.guide.step2"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-label"
                                        },
                                        "text": "$t:sirsoft-ckeditor5.settings.guide.step3"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-label"
                                        },
                                        "text": "$t:sirsoft-ckeditor5.settings.guide.step4"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": {
                                            "className": "text-label"
                                        },
                                        "text": "$t:sirsoft-ckeditor5.settings.guide.step5"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section_preview_card",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mt-4 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                            {
                                "id": "section_preview_header",
                                "type": "basic",
                                "name": "Div",
                                "actions": [
                                    {
                                        "comment": "미리보기 접기·펴기 — 화면 안에서만 쓰는 상태다",
                                        "type": "click",
                                        "handler": "setState",
                                        "params": {
                                            "target": "local",
                                            "showPreview": "{{!_local.showPreview}}"
                                        }
                                    }
                                ],
                                "props": {
                                    "className": "px-6 py-4 flex-between cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H3",
                                                "props": {
                                                    "className": "text-error-strong"
                                                },
                                                "text": "$t:sirsoft-ckeditor5.settings.section_preview"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "form-hint"
                                                },
                                                "text": "$t:sirsoft-ckeditor5.settings.section_preview_hint"
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "{{_local.showPreview ? 'chevron-up' : 'chevron-down'}}",
                                            "className": "text-gray-400 dark:text-gray-500"
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "section_preview_body",
                                "type": "basic",
                                "name": "Div",
                                "if": "{{_local.showPreview}}",
                                "props": {
                                    "className": "p-6 border-t border-gray-200 dark:border-gray-700"
                                },
                                "children": [
                                    {
                                        "id": "preview_editor",
                                        "type": "extension_point",
                                        "name": "html_editor",
                                        "props": {
                                            "content": "",
                                            "placeholder": "$t:sirsoft-ckeditor5.settings.preview_placeholder",
                                            "multilingual": true,
                                            "name": "preview_content"
                                        },
                                        "default": [
                                            {
                                                "type": "composite",
                                                "name": "HtmlEditor",
                                                "props": {
                                                    "name": "preview_content",
                                                    "content": "{{extensionPointProps.content ?? ''}}",
                                                    "multilingual": "{{extensionPointProps.multilingual ?? false}}",
                                                    "placeholder": "{{extensionPointProps.placeholder ?? ''}}",
                                                    "isHtml": true,
                                                    "rows": 15,
                                                    "showHtmlModeToggle": false
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "footer_buttons",
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "sticky-footer-buttons"
                        },
                        "children": [
                            {
                                "id": "cancel_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/plugins"
                                        }
                                    }
                                ],
                                "props": {
                                    "type": "button",
                                    "className": "btn btn-secondary"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.cancel"
                                    }
                                ]
                            },
                            {
                                "id": "save_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "comment": "설정 저장 — 저장 중 플래그로 버튼을 잠그고 이전 오류를 지운 뒤 보내며, 성공하면 설정을 다시 받아 화면을 서버 값으로 맞춘다",
                                        "type": "click",
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "isSaving": true,
                                                    "errors": null
                                                }
                                            },
                                            {
                                                "handler": "apiCall",
                                                "target": "/api/admin/plugins/{{route.identifier}}/settings",
                                                "auth_required": true,
                                                "params": {
                                                    "method": "PUT",
                                                    "body": "{{_local.form}}"
                                                },
                                                "onSuccess": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "hasChanges": false
                                                        }
                                                    },
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "global",
                                                            "plugins": "{{Object.assign({}, _global.plugins ?? {}, { 'sirsoft-ckeditor5': _local.form })}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "success",
                                                            "message": "$t:admin.plugins.settings.save_success"
                                                        }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": {
                                                            "dataSourceId": "settings"
                                                        }
                                                    },
                                                    {
                                                        "handler": "remount",
                                                        "params": {
                                                            "componentId": "preview_editor"
                                                        }
                                                    }
                                                ],
                                                "onError": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": false,
                                                            "errors": "{{error.errors}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "error",
                                                            "message": "$t:admin.plugins.settings.save_error"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "props": {
                                    "type": "button",
                                    "disabled": "{{!_local.hasChanges || _local.isSaving}}",
                                    "className": "btn btn-primary flex-center gap-1.5"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "if": "{{_local.isSaving}}",
                                        "props": {
                                            "name": "spinner",
                                            "size": "sm",
                                            "className": "animate-spin"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{!_local.isSaving}}",
                                        "text": "$t:common.save"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "if": "{{_local.isSaving}}",
                                        "text": "$t:common.saving"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
