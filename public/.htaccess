# 이 파일은 `Options` 를 쓰지 않는다 — 그 지시어는 `AllowOverride Options` 등급을
# 요구하는데, 저가형 공유 호스팅에서 흔한 `AllowOverride FileInfo Limit Indexes`
# 조합에서는 「not allowed here」로 이 디렉토리 하위 전 요청이 500 이 된다(실측).
# 배포 레이아웃 ② 에서는 모든 요청이 이 디렉토리로 위임되므로 그 500 이 곧 사이트
# 전체 장애다. 디렉토리 목록 노출은 같은 제한에서도 허용되는 `IndexIgnore`(Indexes
# 등급)로 막고, MultiViews 는 서버 기본값이 off 라 별도 조치를 두지 않는다.
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

# 정적 서빙에도 `X-Content-Type-Options: nosniff` 를 붙인다. 애플리케이션의 파일 응답
# 헬퍼가 같은 헤더를 붙이므로, `public/storage` 링크 유무(정적 서빙 ↔ 앱 서빙)에 따라
# 업로드된 SVG·HTML 이 이 오리진에서 실행되는지가 갈리지 않는다. `Header` 는 `mod_headers`
# 의 지시어이고 `AllowOverride FileInfo` 등급이라 제한 호스팅에서도 평가된다 — 모듈이
# 없는 서버에서 미지 지시어는 500 이므로 `<IfModule>` 로 감싼다(권한 등급 문제가 아니라
# 모듈 유무 문제라 여기서는 그 가드가 유효하다). `always` 가 없으면 4xx 응답에는 붙지
# 않는다. 이 파일은 위임된 요청(레이아웃 ②)과 표준 배치 모두가 지난다.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── 정본 주소 고정 (배포 레이아웃 ② 전용) ────────────────────────────────
    # 같은 사이트가 `/…` 와 `/public/…` 두 체계로 열리면 세션 쿠키 path·절대 URL·
    # 검색엔진 색인이 갈린다. 그래서 `/public/…` 로 들어온 주소는 정본으로 되돌리고,
    # 위임된 요청의 주소 정규화도 **이 파일이 소유한다** — 정규화를 루트에 두면
    # `public/` 아래의 실존 디렉토리(`install`·`build`)에서 무한 루프가 된다(실측).
    #
    # 이 규칙이 루트 `.htaccess` 가 아니라 여기 있는 이유: mod_rewrite 의 디렉토리별
    # 설정은 상속되지 않는다. 이 파일이 `RewriteEngine On` 을 선언하는 순간 `/public/…`
    # 요청에 대해서는 이 규칙집이 부모를 **대체**하므로, 루트에 적은 `^public/…` 규칙은
    # 평가될 기회 자체가 없다(실측: 301 이 아니라 200 이 나갔다).
    #
    # 판정은 **사이트가 마운트된 위치와 무관**해야 한다. 종전 판본은 `%{DOCUMENT_ROOT}/public`
    # 과 `^/public/` 을 리터럴로 봐서, 사이트가 문서 루트 하위 폴더에 있는 배치
    # (`https://host/g7/`)에서는 두 조건이 **동시에 거짓**이라 규칙이 통째로 꺼졌다 —
    # 그 배치에서는 `/g7/…` 와 `/g7/public/…` 가 둘 다 열려 있었다. 그 뒤 판정을
    # `%{DOCUMENT_ROOT}` 조회로 옮겼으나 그 값도 마운트를 모른다(아래 참조) — 지금은
    # 파일시스템도 문서 루트도 보지 않고 **매치 문자열**로만 판정한다.
    # ────────────────────────────────────────────────────────────────────────

    # ── 레이아웃 ② 판정은 **이 파일이 서 있는 자리**가 한다 ──────────────────
    # 종전 판본은 `%{DOCUMENT_ROOT}` 아래에 `public/index.php` 가 있는지로 배치를
    # 판정했다. 그 값은 **웹서버의 `DocumentRoot` 지시어**이지 사이트가 실제로 놓인
    # 위치가 아니다 — 운영자가 문서 루트 **밖**의 디렉토리를 `Alias` 로 여는 배치에서는
    # 두 조회가 함께 빗나가 판정이 거짓이 되고, 아래 (B)(C)(D) 가 통째로 꺼진다.
    # (실측: 별칭 대상이 문서 루트와 같은 디렉토리이면 우연히 성립하고, 문서 루트 밖이면
    #  `/g7out/public/favicon.ico` 가 301 이 아니라 **200** — 제2 주소가 열린 상태.)
    #
    # 그래서 파일시스템을 조회하지 않고, mod_rewrite 가 per-directory 규칙에 넘겨 주는
    # **매치 문자열**로 판정한다. 그 값은 요청 URL 에서 이 디렉토리에 해당하는 앞부분이
    # 이미 벗겨진 나머지이므로:
    #
    #   * 레이아웃 ②·하위 폴더·별칭 — URL 의 `/public/` 이 **이 디렉토리 자신**이라
    #     매치 문자열에는 남지 않는다 (`/g7out/public/favicon.ico` → `favicon.ico`).
    #   * 표준 배치(문서 루트 = 이 디렉토리) — URL 의 `/public/` 은 **하위 디렉토리**를
    #     가리키므로 매치 문자열에 그대로 남는다 (`/public/favicon.ico` → `public/favicon.ico`).
    #
    # 즉 아래 네 규칙 (B-0)(B)(C)(D) 의 패턴이 곧 배치 판정이다. 마운트 위치·문서 루트·
    # 별칭 대상 어디에도 의존하지 않고, 서버가 이미 계산해 둔 값만 읽는다. 표기는 둘인데
    # 판정은 하나다 — `!^public/`(부정)과 `^(?!public/)(.*)$`(선행 부정 + 캡처)는 같은
    # 것을 묻는다. (B) 만 뒤엣것을 쓰는 이유는 그 매치 문자열을 `$1` 로 **받아야** 하기
    # 때문이고(아래 참조), 부정 패턴은 백레퍼런스를 주지 않는다.
    # ────────────────────────────────────────────────────────────────────────

    # ── 슬래시 보정 (C)(D) 의 목적지는 `THE_REQUEST` 에서 만든다 ──────────────
    #
    # **이 절은 (C)(D) 만 다룬다.** 정본 주소 (B) 는 출처가 다르다 — 디코딩된
    # `%{REQUEST_URI}` 에서 만들고 `NE` 를 붙이지 않는다. 그 사유는 (B) 자신의 주석이
    # 소유하며, 두 축을 한 절로 묶으면 다음 편집이 (B) 를 요청 라인 원문으로 되돌려
    # **사이트 밖 301** 을 재현한다(그 결함이 실제로 있었다).
    #
    # 가르는 기준은 「어느 값에서 목적지를 만들었는가」다:
    #   * 요청 라인 원문(`%{THE_REQUEST}`, 인코딩됨) → `NE` **필수**
    #   * 디코딩된 `%{REQUEST_URI}`                  → `NE` **금지**
    #
    # 둘 다 「브라우저가 보고 있던 주소」로 돌려보내는 규칙이다. (C)(D) 에서 그 주소는
    # 재구성할 것이 아니라 **그대로 갖고 있는 값**이다 — `%{THE_REQUEST}` 는 요청 라인
    # 원문이라 위임으로 다시 쓰이기 전, 마운트 접두사가 붙은 형태 그대로다.
    #
    # 종전처럼 `%{REQUEST_URI}` 를 갈라 `%1/%2` 로 재조립하면 **어떤** 배치에서 접두사가
    # 소실된다. 「별칭이면 항상」이 아니다 — 위임된 요청의 `%{REQUEST_URI}` 를 7마운트에서
    # 직접 재 보면, 접두사를 잃는 것은 **별칭 대상이 그 vhost 의 문서 루트와 같은
    # 디렉토리**인 배치 하나뿐이다(`/g7sub` → `/public/…`). 대상이 문서 루트 **밖**인 별칭은
    # 그대로 싣고(`/g7out` → `/g7out/public/…`, `/my/public/alias` → `/my/public/alias/public/…`),
    # 물리적 하위 디렉토리도 싣는다. `SCRIPT_NAME` 이 접두사를 잃는 조건과 **같은 판별자**다.
    #
    # 잃는 그 배치에서는 `%1` 이 빈 문자열이 되어 결과가 `/install/` — **사이트 밖 주소**로
    # 되던져진다(실측). 접두사가 `SCRIPT_NAME` 에도 `REQUEST_URI` 에도 남지 않으므로
    # 재조립으로는 복원할 수 없다. 축이 하나뿐이어도 처방은 같다 — 잃는 배치가 실재하는 한
    # 요청 라인 원문을 써야 한다.
    #
    # 나머지 배치에서는 두 방식의 결과가 **같다**(재조립 값 == 요청 라인의 경로). 그래서 이
    # 전환은 접두사를 잃는 배치만 고치고 다른 마운트의 응답은 바꾸지 않는다.
    #
    # 요청 라인 원문을 쓰기 때문에 두 가지가 함께 따라온다.
    #
    #   * **경로 앵커** — 백레퍼런스는 `/` 로 시작하는 형태만 받는다. RFC 9112 는 서버가
    #     `GET http://호스트/경로 HTTP/1.1`(absolute-form) 요청 라인도 받아들이게 하므로,
    #     앵커가 없으면 그 호스트가 백레퍼런스에 실려 `Location:` 의 목적지를 **요청자가
    #     지정**하게 된다. 앞부분은 있어도 되고 없어도 되지만(문서 루트 마운트는 빈 값),
    #     있다면 반드시 `/` 로 시작한다.
    #   * **`NE`(noescape)** — `%{THE_REQUEST}` 는 **인코딩된 원문**이다(`%{REQUEST_URI}` 는
    #     디코딩된 값이었다). 그대로 두면 mod_rewrite 가 목적지를 한 번 더 이스케이프해
    #     `/내 문서/` 가 `%2520` 형태로 나가 404 가 된다 — 마운트 종류와 무관하게 걸린다.
    # ────────────────────────────────────────────────────────────────────────

    # (B-0) 인코딩으로 가린 `/public/` 은 **거부**한다.
    #
    # `%{REQUEST_URI}` 는 디코딩된 값이라 `/%70ublic/x` 도 `/public/x` 로 보이지만,
    # `%{THE_REQUEST}` 는 요청 라인 원문이라 그 리터럴이 없다. 그 어긋남 자체가 「주소를
    # 인코딩으로 가렸다」는 신호이므로 정본으로 되돌리지 않고 없는 주소로 답한다 —
    # 정적 서빙이 그 경로에 파일이 없을 때 주는 응답과 같다(실측: 수정 전 200).
    #
    # 이 규칙이 (B) **앞**에 있는 이유: 뒤에 두면 (B) 가 먼저 매치해 301 을 내보내므로 이
    # 거부는 영원히 도달하지 않는다. 순서 자체가 판정이라 자리를 바꾸면 조용히 사문화된다.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^(.*?)/public/(.*)$ [NC]
    RewriteCond %{THE_REQUEST} !^[A-Z]+\s((?:/[^/\s?](?:[^\s?]*[^/\s?])?)?)/public/ [NC]
    RewriteRule !^public/ - [R=404,L]

    # (B) 브라우저가 직접 친 `/public/…` → 정본 주소로. 경로 형태(트레일링 슬래시 포함)는
    #     그대로 보존한다 — 디렉토리 주소의 슬래시를 여기서 떼면 (D) 와 서로 되던진다.
    #
    # 목적지는 `%{REQUEST_URI}`(서버가 디코딩한 현재 URI)에서 만든다. (C)(D) 와 달리 이
    # 규칙은 **직접 요청 전용**(`REDIRECT_STATUS` 가 비어 있음)이라 위임으로 값이 다시
    # 쓰이기 전이고, 그 시점의 `REQUEST_URI` 는 마운트 접두사를 그대로 갖는다 — 별칭
    # 마운트에서 접두사가 소실되는 것은 **위임된** 요청의 이야기이며 여기 해당하지 않는다.
    #
    # 요청 라인 원문(`%{THE_REQUEST}`)에서 만들면 안 되는 이유: 그 값에서 `/public/` 을
    # 찾으면 **마운트 접두사 자신의 `public` 세그먼트**를 사이트의 공개 폴더로 오인한다.
    # 접두사에 그 이름이 든 배치(`Alias /my/public/site`)에서 요청 쪽 `public` 을 인코딩으로
    # 가리면 원문에는 접두사의 것 하나만 남아, 그 자리를 잘라 **사이트 밖 주소**로 301 이
    # 나갔다(실측: `/my/public/site/%70ublic/favicon.ico` → `Location: /my/site/%70ublic/…`).
    # 디코딩된 `REQUEST_URI` 는 두 세그먼트를 모두 보여 주므로 뒤엣것이 공개 폴더임이 확정된다.
    #
    # 그래서 `NE` 를 붙이지 않는다 — 디코딩된 값에서 만든 목적지는 mod_rewrite 가 한 번
    # 이스케이프하는 기본 동작이 옳다. 붙이면 `/내 문서/` 가 인코딩되지 않은 채 나간다.
    #
    # 가드 둘이 함께 붙는다.
    #   * `!//` — 경로에 빈 세그먼트가 있으면 이 규칙은 관여하지 않는다. `//public/…` 은
    #     접두사를 빈 문자열로 만들어 목적지가 `//호스트/…` 가 되고, 브라우저는 그것을
    #     프로토콜 상대 URL 로 읽어 **목적지 호스트를 요청자가 지정**한다(실측).
    #     정상 이용 경로에 빈 세그먼트는 없으므로 잃는 것이 없다.
    #   * 접두사 앵커 `(?:/[^/].*)?` — 비었거나 `/` + 비-슬래시로 시작한다. 위 가드와 겹쳐
    #     보이지만, 한쪽이 없어져도 다른 쪽이 같은 것을 막도록 둘 다 둔다.
    #
    # 잘라 낼 **자리**는 정규식 탐욕성이 아니라 매치 문자열이 정한다. `%{REQUEST_URI}` 만
    # 보면 한 URL 안에 `/public/` 이 여러 번 나올 때 어느 것이 사이트의 공개 폴더인지 알
    # 방법이 없고, 탐욕 매칭은 **마지막** 것을 고른다 — 그래서 라우트 자신의 `public`
    # 세그먼트가 잘렸다(실측). 레이아웃 ② 에서는 `/public/board/public/1` 이
    # `Location: /public/board/1` — `/public/` 접두는 그대로 남고 라우트 세그먼트만
    # 사라졌다. 표준 배치(문서 루트 = 이 디렉토리)에서는 더 나쁘다: 이 규칙이 관여하지
    # 말아야 할 배치인데 `/board/public/1` → `Location: /board/1`,
    # `/api/templates/assets/x/public/app.js` → `Location: /api/templates/assets/x/app.js`,
    # `/storage/public/img.png` → `Location: /storage/img.png` 로 주소를 깎았다. 오류도
    # 로그도 남지 않고 다른 화면이 열릴 뿐이라, 첫·마지막 어느 쪽을 골라도 다른 배치에서
    # 틀린다 — 접두사에 `public` 이 든 마운트는 **첫** 것이 접두사의 것이기 때문이다.
    #
    # 그 자리를 아는 값은 하나뿐이다. mod_rewrite 가 per-directory 규칙에 넘기는 **매치
    # 문자열**(`$1`)이 곧 「사이트 공개 폴더 기준 경로」이므로, 조건의 검사 문자열에 그 값을
    # 이어 붙이고(`%{REQUEST_URI}::$1`) 패턴이 꼬리를 백레퍼런스로 대조한다(`::\2$`).
    # 그러면 접두사가 「전체 − `/public/` − 매치 문자열」로 유일하게 정해지고, 마운트 접두사에
    # `public` 이 있든 라우트에 있든 같은 답이 나온다.
    #
    # 규칙 패턴이 `!^public/`(부정)에서 `^(?!public/)(.*)$` 로 바뀐 이유가 이것이다 — 부정
    # 패턴에는 백레퍼런스가 없어 `$1` 이 빈 문자열이 되고, 그러면 위 조건이 영영 매치하지
    # 않아 정본 주소 301 이 통째로 사라진다(제2 주소가 조용히 다시 열린다). 판정 자체는
    # 동치다: 「매치 문자열이 `public/` 로 시작하지 않는다」 — 그것이 곧 레이아웃 ② 판정이다.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} !//
    RewriteCond %{REQUEST_URI}::$1 ^((?:/[^/].*)?)/public/(.*)::\2$ [NC]
    RewriteRule ^(?!public/)(.*)$ %1/%2 [R=301,L]

    # (C) 위임된 요청이 **디렉토리인데 슬래시가 없다** → 정본 주소에 슬래시를 붙여 돌린다.
    #     이 규칙이 없으면 mod_dir 의 DirectorySlash 가 그 일을 하는데, 그 시점의 주소는
    #     이미 `/public/…` 로 다시 쓰인 상태라 `Location: /public/install/` 처럼 제2 주소를
    #     서버가 스스로 공표한다. mod_rewrite 의 fixup 이 mod_dir 보다 먼저 도므로 여기서 앞선다.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} ^(.*?)/public/(.*[^/])$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^/\s?](?:[^\s?]*[^\s?/])?)[\s?]
    RewriteRule !^public/ %1/ [R=301,NE,L]

    # (D) 위임된 요청이 **디렉토리가 아닌데 슬래시가 있다** → 정본 주소에서 슬래시를 뗀다.
    #     `/public` 을 실어 돌려보내면(`/admin/` → `Location: /public/admin`) 그 주소가
    #     제2 체계가 되고, 실존 최상위 디렉토리에서는 (B) 와 맞물려 무한 301 이 된다(실측).
    #
    #     첫 조건은 **루트 실존 디렉토리의 위임을 제외**한다. 루트 `.htaccess` 는 요청이
    #     프로젝트 루트의 실존 디렉토리(`/app/` · `/storage/logs/` …)일 때 위임에
    #     `G7_ROOTDIR` 표식을 싣는다(내부 리다이렉트를 지나며 `REDIRECT_` 가 붙는다). 그
    #     요청은 `public/` 아래에 같은 디렉토리가 없어 `!-d` 를 통과하는데, 여기서 슬래시를
    #     떼면 mod_dir 가 다시 붙여 무한 301 이 된다(P0 실측 재현). 표식이 없던 시절의
    #     대안이 루트의 `DirectorySlash Off` 였고, 그것은 슬래시 없는 마운트 루트를 403 으로
    #     만들었다(실측). 표식이 실린 요청은 그대로 프런트 컨트롤러로 간다(`/app/` →200).
    #
    #     `REDIRECT_` 는 **한 겹**이다 — 루트 `.htaccess` 의 위임이 내부 리다이렉트 1홉이라
    #     Apache 가 환경변수 이름에 그 접두를 한 번 붙인다. 위임 홉이 늘면(루트 규칙이 두 번
    #     위임하거나 중간 규칙집이 끼면) 이 줄의 접두도 함께 늘려야 한다 — 그러지 않으면 이
    #     조건이 빈 값과 비교돼 루트 실존 디렉토리 요청이 다시 무한 301 로 돌아간다. 소비처인
    #     `public/index.php` 는 같은 이유로 `G7_ROUTE` 를 0~4겹까지 올려 가며 찾는다.
    RewriteCond %{ENV:REDIRECT_G7_ROOTDIR} !=1
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.*?)/public/(.+)/$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/[^/\s?](?:[^\s?]*[^\s?/])?)/[\s?]
    RewriteRule !^public/ %1 [R=301,NE,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # (E) Redirect Trailing Slashes If Not A Folder... (표준 배치 · 직접 요청)
    #     레이아웃 ② 의 위임된 요청은 (C)·(D) 가 이미 처리했으므로 여기서 제외한다.
    #
    #     빈 세그먼트 가드가 형제 (B) 와 같은 이유로 붙는다. `(.+)/$` 는 탐욕·무앵커라
    #     `//evil.example/p/` 요청에서 `%1` 이 `//evil.example/p` 가 되고, 그러면
    #     `Location: //evil.example/p` 를 브라우저가 **프로토콜 상대 URL** 로 읽어
    #     **목적지 호스트를 요청자가 지정**한다. 이 규칙은 라라벨 스톡에서 그대로 온
    #     형태라 그 가드가 없었고, 같은 파일의 (B) 는 그 실패를 실측 근거로 적어 둔 채
    #     가드를 갖고 있었다 — 한 파일 안에서 같은 종류의 규칙에 규율이 갈려 있었다.
    #     정상 이용 경로에 빈 세그먼트는 없으므로 잃는 것이 없다.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !//
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
