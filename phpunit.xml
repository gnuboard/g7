<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Installation</exclude>
        </testsuite>
        <testsuite name="Module">
            <directory>modules/_bundled/*/tests</directory>
        </testsuite>
        <testsuite name="Plugin">
            <directory>plugins/_bundled/*/tests</directory>
        </testsuite>
        <testsuite name="Installation">
            <directory>tests/Feature/Installation</directory>
            <directory>modules/_bundled/*/tests/Feature/Installation</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        메모리 진단 확장 — `PROFILE_MEMORY=1` 일 때만 켜진다(평상시 실행 무영향).
        전량 스위트가 memory_limit 을 소진해 중간에 죽으면 그 뒤 결과 전부가 신호로 못 쓰이므로,
        클래스별 잔존 증가분을 계측해 누수원을 추측이 아니라 실측으로 특정하기 위한 것.
    -->
    <extensions>
        <bootstrap class="Tests\Support\MemoryProfilerExtension"/>
    </extensions>
    <php>
        <!--
            전량 스위트 실측 peak = 1,852MB (13,383 테스트 / 1,2xx 클래스, 2026-07-22).

            종전 1G 는 스위트가 그 규모가 되기 전에 정해진 값이라 완주 자체가 불가능했고,
            OOM 이후 결과가 전부 무의미해져 **실패 목록조차 만들지 못했다**. 사망 지점을 뒤로
            미는 개별 수정(대용량 슬러프 제거·훅 정적 상태 정리)을 반복했으나 지점만 밀렸다.

            원인은 특정 클래스의 누수가 아니다. `MemoryProfilerExtension` 으로 클래스별 live
            잔존을 계측한 결과 **테스트 1건당 약 0.1MB 가 일정하게 남고**(DB 를 쓰지 않는 순수
            Unit 도 동일: 건당 0.093~0.106MB) 5MB 초과 클래스는 24개뿐이다. 즉 프레임워크가
            테스트마다 남기는 공통 비용이며, 12,000+ 테스트 × 0.1MB ≈ 1.2GB 가 관측 곡선과 맞는다.

            그래서 스위트 규모에 맞춰 한도를 올린다(peak 대비 여유 ~10%).
            재계측: PROFILE_MEMORY=1 php artisan test → storage/logs/memory-profile.csv
        -->
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <!--
            DB_DATABASE / DB_WRITE_DATABASE / DB_READ_DATABASE 는 `.env.testing` 값을 그대로 사용.
            프로덕션 DB 오염 방지 안전망은 `tests/bootstrap.php` 의 "동일 DB 이름 중단 가드" 가 담당.
        -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="INSTALLER_ADMIN_NAME" value="관리자"/>
        <env name="INSTALLER_ADMIN_EMAIL" value="admin@example.com"/>
        <env name="INSTALLER_ADMIN_PASSWORD" value="password"/>
        <env name="INSTALLER_ADMIN_LANGUAGE" value="ko"/>
        <!-- RefreshDatabase 초회전 migration 중 CoreServiceProvider boot 가 DB 접근
             (g7_modules) 을 시도. installer_completed=true 면 Schema::hasTable 가드 생략되어
             테이블 부재 에러 발생. false 로 두어 가드 작동 → 안전한 boot. -->
        <env name="INSTALLER_COMPLETED" value="false"/>
    </php>
</phpunit>
