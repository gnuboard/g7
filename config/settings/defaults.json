    "frontend_schema": {
        "_description": "프론트엔드에 노출할 설정 필드 정의. 각 카테고리별로 노출할 필드와 타입 캐스팅, 민감 정보 여부를 정의합니다.",
        "general": {
            "expose": true,
            "_comment": "site_url, admin_email, language는 프론트엔드에서 미참조하므로 expose: false. timezone 은 관리자 빠른 기간·통계 기간이 「오늘」을 계정·사이트 시간대로 정하는 데 쓰므로 노출(민감 정보 아님)",
            "fields": {
                "site_name": { "type": "string", "sensitive": false },
                "site_url": { "type": "string", "sensitive": false, "expose": false },
                "site_description": { "type": "string", "sensitive": false },
                "admin_email": { "type": "string", "sensitive": false, "expose": false },
                "language": { "type": "string", "sensitive": false, "expose": false },
                "timezone": { "type": "string", "sensitive": false },
                "site_logo": { "type": "array", "sensitive": false, "transform": "attachments" },
                "site_logo_url": { "type": "string", "sensitive": false, "computed": true, "source": "site_logo", "transform": "first_image_url" },
                "asset_url_mode": { "type": "string", "sensitive": false }
            }
        },
        "security": {
            "expose": true,
            "_comment": "비밀번호 작성·재사용 규칙만 노출한다(가입·변경·재설정 화면 안내용). 만료·IP·2FA·토큰·잠금 키는 fields 에 선언하지 않아 내보내지 않는다 — 공격자에게 정책 정보 제공 위험",
            "fields": {
                "password_min_length": { "type": "integer", "sensitive": false },
                "require_password_special_char": { "type": "boolean", "sensitive": false },
                "password_require_char_types": { "type": "boolean", "sensitive": false },
                "password_block_identifier": { "type": "boolean", "sensitive": false },
                "password_block_repeated_chars": { "type": "boolean", "sensitive": false },
                "password_repeated_chars_length": { "type": "integer", "sensitive": false },
                "password_block_sequential_chars": { "type": "boolean", "sensitive": false },
                "password_sequential_chars_length": { "type": "integer", "sensitive": false },
                "password_reuse_prevention_enabled": { "type": "boolean", "sensitive": false },
                "password_reuse_count": { "type": "integer", "sensitive": false }
            }
        },
