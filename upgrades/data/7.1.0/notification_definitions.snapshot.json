                        }
                    ],
                    "subject": {
                        "ko": "[{app_name}] 월간 방문자 통계 ({period_label})",
                        "en": "[{app_name}] Monthly Analytics Report ({period_label})"
                    },
                    "body": {
                        "ko": "<h1>월간 방문자 통계</h1><p>{period_label} 요약입니다.</p><p>방문 <strong>{visits}</strong> · 순방문자 <strong>{visitors}</strong> · 페이지뷰 <strong>{pageviews}</strong> (직전 기간 대비 {change_pct})</p><h2>인기 페이지</h2>{top_pages}<h2>유입 경로</h2>{top_referrers}<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 24px 0;\"><tr><td align=\"center\"><a href=\"{report_url}\" style=\"display: inline-block; padding: 12px 32px; background-color: #2d3748; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 14px;\">통계 전체 보기</a></td></tr></table><p>감사합니다,<br><a href=\"{site_url}\">{app_name}</a></p>",
                        "en": "<h1>Monthly Analytics Report</h1><p>Summary for {period_label}.</p><p>Visits <strong>{visits}</strong> · Unique visitors <strong>{visitors}</strong> · Pageviews <strong>{pageviews}</strong> ({change_pct} vs previous period)</p><h2>Top Pages</h2>{top_pages}<h2>Top Referrers</h2>{top_referrers}<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin: 24px 0;\"><tr><td align=\"center\"><a href=\"{report_url}\" style=\"display: inline-block; padding: 12px 32px; background-color: #2d3748; color: #ffffff; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 14px;\">View Full Statistics</a></td></tr></table><p>Thank you,<br><a href=\"{site_url}\">{app_name}</a></p>"
                    }
                }
            ]
        }
    }
