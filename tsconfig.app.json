{
  // 브라우저 코드(시험 제외) 타입 검사 설정 — `npx tsc -p tsconfig.app.json`
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./resources/js/*"],
      /* 템플릿 시험이 쓰는 별칭. 루트와 템플릿 vitest.config.ts 의 '@core' 와 같은 곳을 가리킨다 */
      "@core/*": ["./resources/js/core/*"]
    },

    /* 전역 타입 — 브라우저 코드 전용 설정이라 @types/* 를 자동으로 싣지 않는다(빈 배열).
       Node 타입과 Vitest 전역은 시험 전용 tsconfig.test.json 에만 준다. 빌드 치환 상수
       `process.env.NODE_ENV` 는 resources/js/build-defines.d.ts 가 선언한다. */
    "types": []
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.tsx",
    /* 템플릿은 원본(_bundled)만 검사한다. 활성 디렉터리(templates/{id})는 template:update 가 만든
       설치 사본이라 내용이 같고 npm 의존성이 없어 모듈 해석 오류만 중복으로 낸다(vitest.config.ts 와 같은 기준) */
    "templates/_bundled/**/src/**/*.ts",
    "templates/_bundled/**/src/**/*.tsx"
  ],
  /* 시험 파일과 시험 고정물은 tsconfig.test.json 이 맡는다 */
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "resources/js/tests/**",
    "templates/_bundled/**/src/test-setup.ts"
  ]
}
