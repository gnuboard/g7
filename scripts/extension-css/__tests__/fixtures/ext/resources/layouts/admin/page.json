{
    "layout_name": "fixture_admin_page",
    "comment": "합성 관리자 화면. 이 주석 안의 class=\"flex\" 는 바꾸지 않는다",
    "components": [
        {
            "name": "Div",
            "props": {
                "className": "flex items-center gap-2 dark:hover:bg-gray-100 !mt-2 -mt-1 group group/item"
            },
            "children": [
                { "name": "Span", "props": { "className": "card {{row.status === 'active' ? 'bg-blue-100 text-blue-800' : 'input'}}" }, "text": "x" },
                { "name": "Span", "props": { "className": "hover-lift group-hover:underline fa fa-check readonly sr-only spinner" }, "text": "y" },
                { "name": "Span", "props": { "className": "{{ {'pending': 'bg-yellow-100', 'done': 'section-heading-md'}[row.status] }}" }, "text": "z" },
                { "name": "Span", "props": { "className": "{{row.tags.includes('hidden') || row.map['block'] ? 'hidden' : 'block'}}" }, "text": "w" },
                { "name": "Span", "props": { "className": "bg-{{row.color}}-500 {{'text-' + row.tone}} pay-demo-tone paydemo:flex" }, "text": "v" },
                { "name": "Span", "props": { "className": "{{(row.mode ?? 'standard') === 'standard' ? 'prose' : 'w-[200px] md:w-1/2'}}" }, "text": "u" },
                {
                    "name": "Div",
                    "props": { "className": "px-2" },
                    "classMap": {
                        "key": "{{row.state}}",
                        "base": "px-2",
                        "variants": {
                            "on": "bg-green-100 input"
                        },
                        "default": "text-gray-500"
                    }
                },
                { "name": "Table", "props": { "className": "table hidden" } },
                { "name": "Header", "props": { "className": "page-header px-4" } },
                { "name": "Icon", "props": { "name": "fa-solid fa-check", "className": "text-sm md:text-xl text-gray-500" } },
                { "props": { "name": "fa-solid fa-xmark", "className": "text-xs leading-5 text-[2rem]" }, "name": "Icon" },
                { "name": "DataGrid", "props": { "cellClassName": "px-4 text-sm", "label": "flex" } }
            ]
        }
    ]
}
