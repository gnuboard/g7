{
  "_comment": "responsive classMerge 병합 규칙 공용 픽스처 — 엔진 StyleHelpers(mergeClasses·applyResponsiveClassMerge)와 SEO App\\Support\\Style\\ClassMerger(merge·applyResponsive)가 같은 결과를 내는지 양쪽 시험이 이 파일로 증명한다 (engine-v1.98.0). prefixes 는 활성 확장 앞글자(G7Config.extensionClassPrefixes)다.",
  "prefixes": ["ecommerce", "board"],
  "cases": [
    { "id": "axis-px-keeps-p", "fn": "both", "base": "p-4 bg-white", "override": "px-2", "expected": "p-4 bg-white px-2", "note": "축 유틸리티는 전체 패딩을 지우지 않는다" },
    { "id": "upper-covers-lower", "fn": "both", "base": "px-4 pt-2 text-sm", "override": "p-0", "expected": "text-sm p-0", "note": "상위 그룹이 하위 축을 덮는다" },
    { "id": "same-group-replaced", "fn": "both", "base": "flex p-4 text-sm", "override": "p-6", "expected": "flex text-sm p-6", "note": "같은 축은 교체" },
    { "id": "variant-differs", "fn": "both", "base": "text-gray-900 dark:text-white", "override": "text-blue-500", "expected": "dark:text-white text-blue-500", "note": "변형이 다르면 충돌하지 않는다" },
    { "id": "variant-same", "fn": "both", "base": "dark:text-gray-200 dark:bg-gray-800", "override": "dark:text-gray-100", "expected": "dark:bg-gray-800 dark:text-gray-100", "note": "같은 변형은 충돌" },
    { "id": "single-color-name-no-group", "fn": "both", "base": "bg-white text-white p-4", "override": "bg-gray-50 text-gray-900", "expected": "bg-white text-white p-4 bg-gray-50 text-gray-900", "note": "현재 규칙 그대로: white·black·transparent 처럼 단계 없는 색 이름은 색 그룹 정규식(`-` 뒤 단계 필수)에 걸리지 않아 교체되지 않는다. classMerge 로 이런 색을 바꾸려면 기본 className 쪽을 단계 있는 색으로 적거나 구간 props.className 을 쓴다" },
    { "id": "hover-variant", "fn": "both", "base": "bg-white hover:bg-gray-50", "override": "hover:bg-gray-100", "expected": "bg-white hover:bg-gray-100", "note": "hover 변형끼리 교체" },
    { "id": "breakpoint-variant-kept", "fn": "both", "base": "p-4 md:p-8", "override": "p-6", "expected": "md:p-8 p-6", "note": "폭 변형 토큰은 다른 변형이라 남는다" },
    { "id": "display-hidden-to-flex", "fn": "both", "base": "hidden md:flex", "override": "flex", "expected": "md:flex flex", "note": "display 그룹" },
    { "id": "font-size-vs-color", "fn": "both", "base": "text-sm text-gray-500", "override": "text-base", "expected": "text-gray-500 text-base", "note": "글자 크기와 글자 색은 다른 그룹" },
    { "id": "border-width-vs-color", "fn": "both", "base": "border border-gray-200", "override": "border-2", "expected": "border-gray-200 border-2", "note": "테두리 두께와 색은 다른 그룹" },
    { "id": "gap-covers-axis", "fn": "both", "base": "gap-4 gap-x-2", "override": "gap-6", "expected": "gap-6", "note": "gap 은 gap-x 를 덮는다" },
    { "id": "rounded-covers-side", "fn": "both", "base": "rounded-lg rounded-t-none", "override": "rounded-none", "expected": "rounded-none", "note": "rounded 는 변 단위 rounded 를 덮는다" },
    { "id": "ext-prefix-same-group", "fn": "both", "base": "ecommerce:p-4 ecommerce:flex", "override": "ecommerce:p-6", "expected": "ecommerce:flex ecommerce:p-6", "note": "확장 앞글자를 떼고 판정한다" },
    { "id": "ext-prefix-vs-plain", "fn": "both", "base": "p-4 flex", "override": "ecommerce:p-6", "expected": "flex ecommerce:p-6", "note": "확장 앞글자는 변형이 아니다" },
    { "id": "ext-prefix-dark", "fn": "both", "base": "ecommerce:bg-white ecommerce:dark:bg-gray-800", "override": "ecommerce:dark:bg-gray-900", "expected": "ecommerce:bg-white ecommerce:dark:bg-gray-900", "note": "앞글자 뒤의 dark 변형" },
    { "id": "unknown-prefix-not-split", "fn": "both", "base": "p-4", "override": "foo:p-6", "expected": "p-4 foo:p-6", "note": "등록되지 않은 앞글자는 떼지 않는다" },
    { "id": "override-empty", "fn": "both", "base": "flex p-4", "override": "", "expected": "flex p-4", "note": "빈 override" },
    { "id": "override-blank", "fn": "both", "base": "flex p-4", "override": "   ", "expected": "flex p-4", "note": "공백 override" },
    { "id": "merge-semantic-dup", "fn": "mergeClasses", "base": "admin-card p-4", "override": "admin-card", "expected": "admin-card p-4 admin-card", "note": "mergeClasses 는 그룹 없는 토큰을 지우지 않는다(종전 규칙 그대로)" },
    { "id": "resp-semantic-dedupe", "fn": "applyResponsive", "base": "admin-card p-4", "override": "admin-card", "expected": "p-4 admin-card", "note": "classMerge 는 같은 토큰을 한 번만 남긴다" },
    { "id": "resp-semantic-add", "fn": "applyResponsive", "base": "flex p-4", "override": "ecommerce-admin-card", "expected": "flex p-4 ecommerce-admin-card", "note": "의미 클래스 덧붙이기" },
    { "id": "resp-base-empty", "fn": "applyResponsive", "base": "", "override": "p-6", "expected": "p-6", "note": "기본 className 없음" },
    { "id": "resp-base-null", "fn": "applyResponsive", "base": null, "override": "p-6 w-full", "expected": "p-6 w-full", "note": "기본 className null" },
    { "id": "resp-whitespace", "fn": "applyResponsive", "base": "  flex   p-4 ", "override": " p-6  ", "expected": "flex p-6", "note": "연속 공백 정리" },
    { "id": "resp-dup-in-merge", "fn": "applyResponsive", "base": "p-4", "override": "p-6 p-6", "expected": "p-6", "note": "merge 안 중복" },
    { "id": "resp-resolved-binding", "fn": "applyResponsive", "base": "flex p-4 text-sm", "override": "p-6 text-base", "expected": "flex p-6 text-base", "note": "바인딩 해석 후 값(`{{_local.wide ? 'p-8' : 'p-6'}} text-base` 의 해석 결과)" },
    { "id": "resp-merge-null", "fn": "applyResponsive", "base": "flex p-4", "override": null, "expected": "flex p-4", "note": "classMerge 없음" },
    { "id": "resp-real-card", "fn": "applyResponsive", "base": "w-full max-w-md p-8 bg-white rounded-lg shadow", "override": "p-6 max-w-none", "expected": "w-full bg-white rounded-lg shadow p-6 max-w-none", "note": "실제 변환 사례 모양(카드 모바일 패딩)" }
  ]
}
