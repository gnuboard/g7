                                "actions": [
                                    {
                                        "comment": "배송지 행의 작업 메뉴 — 고른 항목(회원 보기 등)에 따라 분기한다",
                                        "event": "onItemClick",
                                        "handler": "switch",
                                        "cases": {
                                            "view_member": {
                                                "handler": "openWindow",
                                                "params": {
                                                    "path": "/admin/users/{{row.member?.uuid}}"
                                                }
                                            },
                                            "search_member": {
                                                "comment": "손에 든 회원 한정도 이 한 명으로 맞춘다 — URL 만 갈면 필터 칸이 이전 선택을 든 채로 남는다",
                                                "handler": "sequence",
                                                "actions": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "_local",
                                                            "filter.memberUuids": "{{[row.member?.uuid]}}",
                                                            "filter.memberOptions": "{{[{ value: row.member?.uuid, label: row.member?.name, description: row.member?.email }]}}",
                                                            "selectedItems": []
                                                        }
                                                    },
                                                    {
                                                        "handler": "navigate",
                                                        "params": {
                                                            "path": "/admin/ecommerce/user-addresses",
                                                            "mergeQuery": true,
                                                            "replace": true,
                                                            "transition_overlay_target": "pc_data_table__body",
                                                            "query": {
                                                                "user_uuid": "",
                                                                "user_uuids[]": "{{[row.member?.uuid]}}",
                                                                "page": 1
                                                            }
                                                        }
                                                    }
                                                ]
                                            }
                                        }
                                    }
                                ],
                                "props": {
                                    "position": "right",
                                    "items": [
                                        {
                                            "id": "view_member",
                                            "label": "$t:sirsoft-ecommerce.admin.user_addresses.actions.view_member",
                                            "iconName": "user"
