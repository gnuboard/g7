                        "iconName": "fa-regular fa-trash-can",
                        "variant": "danger",
                        "disabled": "{{_computed.canManage !== true}}"
                    }
                ],
                "columns": [
                    {
                        "field": "checkbox",
                        "header": "",
                        "width": "40px",
                        "selectable": true
                    },
                    {
                        "field": "created_at",
                        "header": "$t:sirsoft-ecommerce.admin.user_addresses.columns.created_at",
                        "width": "150px",
                        "cellChildren": [
                            {
                                "type": "basic",
                                "name": "Span",
                                "props": {
