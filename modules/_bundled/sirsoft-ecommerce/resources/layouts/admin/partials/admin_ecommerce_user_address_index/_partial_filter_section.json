                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "flex-center gap-1 cursor-pointer"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "actions": [
                                                {
                                                    "comment": "기본 제외. 정리 대상을 고를 때 쓰는 갈래다 — 기본 배송지는 지우면 회원이 다시 골라야 한다.",
                                                    "type": "change",
                                                    "handler": "setState",
                                                    "params": {
