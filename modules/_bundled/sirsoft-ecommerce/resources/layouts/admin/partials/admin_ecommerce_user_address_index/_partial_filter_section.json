                                                "className": "radio"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-body"
                                            },
                                            "text": "$t:common.all"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "flex-center gap-1 cursor-pointer"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "actions": [
                                                {
                                                    "comment": "기본 배송지만. 회원마다 한 건이므로 「회원 수만큼」 이 나온다.",
                                                    "type": "change",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "_local",
                                                        "filter.isDefault": "1"
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "type": "radio",
                                                "name": "isDefault",
                                                "value": "1",
                                                "checked": "{{_local.filter.isDefault === '1'}}",
                                                "className": "radio"
