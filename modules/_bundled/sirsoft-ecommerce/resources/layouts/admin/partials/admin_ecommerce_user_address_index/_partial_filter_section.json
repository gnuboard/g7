                                                                "filter.memberUuids": "{{(_local.filter?.memberUuids ?? []).filter(v => v !== member.value)}}",
                                                                "filter.memberOptions": "{{(_local.filter?.memberOptions ?? []).filter(o => o.value !== member.value)}}"
                                                            }
