                                            "props": {
                                                "type": "radio",
                                                "name": "isDefault",
                                                "value": "0",
                                                "checked": "{{_local.filter.isDefault === '0'}}",
                                                "className": "radio"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-body"
                                            },
                                            "text": "$t:sirsoft-ecommerce.admin.user_addresses.filter.is_default_except"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "filter_actions",
            "type": "basic",
            "name": "Div",
