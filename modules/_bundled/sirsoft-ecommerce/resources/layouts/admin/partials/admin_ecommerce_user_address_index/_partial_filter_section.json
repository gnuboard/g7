                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "actions": [
                                                {
                                                    "comment": "기본 배송지 여부 — 전체. 하나만 고르는 값이라 \"전체\" 도 값(`all`)이다.",
                                                    "type": "change",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "_local",
                                                        "filter.isDefault": "all"
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "type": "radio",
                                                "name": "isDefault",
