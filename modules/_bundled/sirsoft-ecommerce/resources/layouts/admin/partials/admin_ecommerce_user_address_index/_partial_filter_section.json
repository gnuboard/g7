                                            ],
                                            "props": {
                                                "className": "{{_local.filter.dateQuick === '3months' ? 'btn-date active' : 'btn-date cursor-pointer'}}"
                                            },
                                            "text": "$t:sirsoft-ecommerce.common.date.3months"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "actions": [
                                                {
                                                    "comment": "1년. 배송지는 한 번 담아 두면 오래 남는 데이터라 긴 구간을 함께 둔다.",
                                                    "type": "click",
                                                    "handler": "sequence",
                                                    "actions": [
                                                        {
                                                            "handler": "sirsoft-ecommerce.setDateRange",
                                                            "params": {
                                                                "preset": "1year"
                                                            }
                                                        },
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "_local",
                                                                "filter.dateQuick": "{{$prev.preset}}",
                                                                "filter.startDate": "{{$prev.startDate}}",
                                                                "filter.endDate": "{{$prev.endDate}}"
                                                            }
                                                        }
                                                    ]
                                                }
                                            ],
                                            "props": {
                                                "className": "{{_local.filter.dateQuick === '1year' ? 'btn-date active' : 'btn-date cursor-pointer'}}"
                                            },
                                            "text": "$t:sirsoft-ecommerce.common.date.1year"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "is_default_filter_row",
