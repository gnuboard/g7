                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "claimAddresses.addresses.return.address1": "{{$event.target.value}}",
                                                "claimAddressesDirty": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "text",
                                        "className": "{{_local.errors?.['addresses.return.address1'] ? 'input input-error w-full' : 'input w-full'}}",
                                        "value": "{{_local.claimAddresses?.addresses?.return?.address1 ?? ''}}",
                                        "disabled": "{{_computed.isReadOnly || (!!route.id && _local.claimAddresses?._loaded !== true)}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{_local.errors?.['addresses.return.address1']}}",
                                    "props": {
                                        "className": "form-error-xs mt-0.5"
                                    },
                                    "text": "{{_local.errors?.['addresses.return.address1']?.[0]}}"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.shipping_policy.form.claim_address_address2"
                                },
                                {
                                    "comment": "반품 회수지 상세주소(선택) — 비워도 회수지는 유효하다. 필수 검사는 받는 사람과 기본주소 두 칸에만 걸린다.",
                                    "id": "claim_address_return_address2",
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "claimAddresses.addresses.return.address2": "{{$event.target.value}}",
                                                "claimAddressesDirty": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "text",
                                        "className": "input w-full",
                                        "value": "{{_local.claimAddresses?.addresses?.return?.address2 ?? ''}}",
                                        "disabled": "{{_computed.isReadOnly || (!!route.id && _local.claimAddresses?._loaded !== true)}}"
                                    }
                                }
                            ]
                        },
                        {
                            "comment": "노출 판정은 저장 payload 의 '채워짐' 판정(5칸 .some)과 같은 필드 집합을 쓴다 — 교환 회수지와 같은 이유다.",
                            "id": "claim_address_return_clear",
                            "type": "basic",
                            "name": "Button",
                            "if": "{{[_local.claimAddresses?.addresses?.return?.recipient_name, _local.claimAddresses?.addresses?.return?.address1, _local.claimAddresses?.addresses?.return?.address2, _local.claimAddresses?.addresses?.return?.zipcode, _local.claimAddresses?.addresses?.return?.phone].some(v => String(v ?? '').trim() !== '')}}",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "claimAddresses.addresses.return": null,
                                        "claimAddressesDirty": true
                                    },
                                    "confirm": "$t:sirsoft-ecommerce.admin.shipping_policy.form.claim_address_clear_confirm"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "text-xs text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400 self-start underline",
                                "disabled": "{{_computed.isReadOnly || (!!route.id && _local.claimAddresses?._loaded !== true)}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-ecommerce.admin.shipping_policy.form.claim_address_clear"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
