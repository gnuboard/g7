                        "className": "card-title"
                    },
                    "text": "{{_local.viewMode === 'edit' ? '$t:sirsoft-ecommerce.admin.main_banner.form.edit_title' : '$t:sirsoft-ecommerce.admin.main_banner.form.add_title'}}"
