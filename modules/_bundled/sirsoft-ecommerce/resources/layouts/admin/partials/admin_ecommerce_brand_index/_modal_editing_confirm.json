                                    "params": {
                                        "target": "global",
                                        "panelMode": "view",
                                        "selectedBrandId": null,
                                        "selectedBrand": null
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "px-4 py-2 bg-red-600 dark:bg-red-500 text-white rounded-lg hover:bg-red-700 dark:hover:bg-red-600"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:sirsoft-ecommerce.admin.brand.modal.editing.discard"
                        }
                    ]
                }
            ]
        }
    ]
