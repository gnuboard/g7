                },
                "text": "$t:sirsoft-ecommerce.admin.promotion_discount_code.modal.status_change.cancel"
            },
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "closeModal"
                    }
                ],
                "props": {
                    "type": "button",
