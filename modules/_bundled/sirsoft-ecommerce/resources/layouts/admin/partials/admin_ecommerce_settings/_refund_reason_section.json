                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "추가 확인. 코드와 기본 언어 문구가 있어야 통과하고, 없으면 배열을 건드리지 않고 오류 표시만 세운다.",
                                    "type": "click",
                                    "handler": "conditions",
                                    "conditions": [
                                        {
                                            "if": "{{(_local.refundReasonForm?.code ?? '').trim() && 'abcdefghijklmnopqrstuvwxyz'.includes((_local.refundReasonForm?.code ?? '').trim().charAt(0)) && (_local.refundReasonForm?.code ?? '').trim().split('').every(ch => 'abcdefghijklmnopqrstuvwxyz0123456789_'.includes(ch)) && !(_local.refundReasonForm?.code ?? '').trim().includes('__') && (_local.refundReasonForm?.code ?? '').trim().charAt((_local.refundReasonForm?.code ?? '').trim().length - 1) !== '_' && (_local.refundReasonForm?.code ?? '').trim().length <= 50 && !(_local.form?.claim?.refund_reasons ?? []).some(r => String(r.code ?? '').toLowerCase() === (_local.refundReasonForm?.code ?? '').trim().toLowerCase()) && (_local.refundReasonForm?.name?.[(_global.appConfig?.siteLocale ?? $locale ?? 'ko')] ?? '').trim()}}",
                                            "then": {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "form.claim.refund_reasons": "{{[...(_local.form?.claim?.refund_reasons ?? []), {..._local.refundReasonForm, sort_order: (_local.form?.claim?.refund_reasons ?? []).length}]}}",
                                                    "isAddingRefundReason": false,
                                                    "refundReasonForm": null,
                                                    "refundReasonFormErrors": null,
                                                    "hasChanges": true
                                                }
                                            }
                                        },
                                        {
                                            "then": {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "local",
                                                    "refundReasonFormErrors": {
                                                        "code": "{{!(_local.refundReasonForm?.code ?? '').trim() ? 'required' : (!('abcdefghijklmnopqrstuvwxyz'.includes((_local.refundReasonForm?.code ?? '').trim().charAt(0)) && (_local.refundReasonForm?.code ?? '').trim().split('').every(ch => 'abcdefghijklmnopqrstuvwxyz0123456789_'.includes(ch)) && !(_local.refundReasonForm?.code ?? '').trim().includes('__') && (_local.refundReasonForm?.code ?? '').trim().charAt((_local.refundReasonForm?.code ?? '').trim().length - 1) !== '_') ? 'format' : ((_local.refundReasonForm?.code ?? '').trim().length > 50 ? 'length' : ((_local.form?.claim?.refund_reasons ?? []).some(r => String(r.code ?? '').toLowerCase() === (_local.refundReasonForm?.code ?? '').trim().toLowerCase()) ? 'duplicate' : null)))}}",
                                                        "name_ko": "{{!(_local.refundReasonForm?.name?.[(_global.appConfig?.siteLocale ?? $locale ?? 'ko')] ?? '').trim() ? true : null}}"
                                                    }
                                                }
                                            }
