{
    "comment": "쇼핑몰 설정 — 상품 진열 탭. 상품 상세 아래 「이 상품은 어떠세요?」(관련 상품) 목록의 순서와 목록 유지 시간을 정한다.\n  관련 상품은 대표 분류 → 그 상위 분류 단계로 채우고, 여기서 고르는 것은 같은 단계 안 순서다. 숫자 칸의 형 변환과 범위 판정은 저장 시 서버가 한다.\n  e2e:allow — 탭 표시는 Chrome MCP 로 실측했고, 저장·검증·캐시 비움은 PHPUnit(PublicProductRelatedTest)이 HTTP 로 잠근다.",
    "meta": {
        "is_partial": true,
        "description": "쇼핑몰 설정 상품 진열 탭 콘텐츠"
    },
    "id": "tab_content_product_display",
    "type": "basic",
    "name": "Div",
    "if": "{{(_global.activeEcommerceSettingsTab || query.tab || 'basic_info') === 'product_display'}}",
    "children": [
        {
            "id": "product_display_related_card",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "admin-card"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "card-title"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.settings.product_display.title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "card-description"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.settings.product_display.description"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "row-stack"
                    },
                    "children": [
                        {
                            "comment": "같은 단계 안 순서",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-center gap-2 flex-wrap"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body w-48 shrink-0"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.product_display.order_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Select",
                                    "actions": [
                                        {
                                            "comment": "단계 안 순서. 저장하면 이미 골라 둔 목록을 비우므로 다음 상세 열람부터 새 순서다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.product_display.related_order": "{{$event.target.value}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "name": "product_display.related_order",
                                        "aria-label": "$t:sirsoft-ecommerce.admin.settings.product_display.order_label",
                                        "autoBinding": false,
                                        "className": "w-48",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "value": "{{_local.form?.product_display?.related_order ?? 'random'}}",
                                        "error": "{{_local.errors?.['product_display.related_order']?.[0] ?? ''}}",
                                        "options": [
                                            {
                                                "value": "random",
                                                "label": "$t:sirsoft-ecommerce.admin.settings.product_display.order_random"
                                            },
                                            {
                                                "value": "sales",
                                                "label": "$t:sirsoft-ecommerce.admin.settings.product_display.order_sales"
                                            },
                                            {
                                                "value": "reviews",
                                                "label": "$t:sirsoft-ecommerce.admin.settings.product_display.order_reviews"
                                            },
                                            {
                                                "value": "latest",
                                                "label": "$t:sirsoft-ecommerce.admin.settings.product_display.order_latest"
                                            }
                                        ]
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "w-full form-hint"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.product_display.order_hint"
                                }
                            ]
                        },
                        {
                            "comment": "목록 유지 시간",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-center gap-2 flex-wrap"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body w-48 shrink-0"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.product_display.cache_hours_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "comment": "한 번 고른 목록을 몇 시간 그대로 둘지(0~720). 0 이면 볼 때마다 새로 고른다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.product_display.related_cache_hours": "{{Number($event.target.value)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "number",
                                        "min": "0",
                                        "max": "720",
                                        "step": "1",
                                        "aria-label": "$t:sirsoft-ecommerce.admin.settings.product_display.cache_hours_label",
                                        "className": "input w-20",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "value": "{{_local.form?.product_display?.related_cache_hours ?? 24}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.product_display.hours_unit"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "w-full form-hint"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.product_display.cache_hours_hint"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{_local.errors?.['product_display.related_cache_hours']}}",
                                    "props": {
                                        "className": "w-full form-error"
                                    },
                                    "text": "{{_local.errors?.['product_display.related_cache_hours']?.[0] ?? ''}}"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
