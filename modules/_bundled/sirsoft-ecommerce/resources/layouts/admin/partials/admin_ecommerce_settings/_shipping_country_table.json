{
    "comment": "쇼핑몰 설정 — 배송 국가 목록, 넓은 화면용 표. 좁은 화면용 카드(`_shipping_country_cards`)와\n  같은 배열을 편집한다. 해외배송을 껐다면 이 목록은 남되 쓰이지 않는다.",
    "meta": {
        "is_partial": true,
        "description": "배송설정 - 배송가능국가 테이블"
    },
    "id": "shipping_country_table_container",
    "type": "basic",
    "name": "Div",
    "props": {
        "className": "ecommerce-table-container"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "if": "{{settings !== undefined && ((_local.form?.shipping?.available_countries ?? []).length === 0)}}",
            "props": {
                "className": "ecommerce:p-8 ecommerce:text-center ecommerce-text-label-subtle"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "globe",
                        "className": "ecommerce:text-2xl ecommerce:text-gray-500 ecommerce:dark:text-gray-500 ecommerce:mb-2"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "text": "$t:sirsoft-ecommerce.admin.settings.shipping.countries.empty"
                }
            ]
        },
        {
            "id": "country_list",
            "type": "basic",
            "name": "Div",
            "if": "{{(_local.form?.shipping?.available_countries ?? []).length > 0}}",
            "responsive": {
                "portable": {
                    "props": {
                        "className": ""
                    },
                    "children": [
                        {
                            "partial": "_shipping_country_cards.json"
                        }
                    ]
                }
            },
            "props": {
                "className": "ecommerce:overflow-x-auto"
            },
            "children": [
                {
                    "id": "country_table",
                    "type": "basic",
                    "name": "Table",
                    "props": {
                        "className": "ecommerce:table ecommerce-table"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Thead",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Tr",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Th",
                                            "props": {
                                                "className": "ecommerce:w-24"
                                            },
                                            "text": "$t:sirsoft-ecommerce.admin.settings.shipping.countries.country_code"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Th",
                                            "text": "$t:sirsoft-ecommerce.admin.settings.shipping.countries.country_name"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Th",
                                            "props": {
                                                "className": "ecommerce:w-24 ecommerce:text-center"
                                            },
                                            "text": "$t:sirsoft-ecommerce.admin.settings.shipping.countries.is_active"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Th",
                                            "props": {
                                                "className": "ecommerce:w-20"
                                            },
                                            "text": ""
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Tbody",
                            "children": [
                                {
                                    "id": "country_row_{{countryIndex}}",
                                    "type": "basic",
                                    "name": "Tr",
                                    "iteration": {
                                        "source": "(_local.form?.shipping?.available_countries ?? []).map((c, i) => ({...c, _idx: i}))",
                                        "item_var": "country",
                                        "index_var": "countryIndex"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Td",
                                            "props": {
                                                "className": "ecommerce:font-mono ecommerce:text-sm ecommerce:font-medium"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "props": {
                                                        "className": "ecommerce-flex-center ecommerce:gap-2"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "{{'ecommerce-flag ecommerce-flag-' + (country.code?.toLowerCase() ?? '') + ' ecommerce-flag--square ecommerce:rounded'}}"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "text": "{{country.code}}"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Td",
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{$localized(country.name, 'sirsoft-ecommerce::settings.countries.' + (country.code ?? '') + '.name')}}"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Td",
                                            "props": {
                                                "className": "ecommerce:text-center"
                                            },
                                            "children": [
                                                {
                                                    "type": "composite",
                                                    "name": "Toggle",
                                                    "actions": [
                                                        {
                                                            "comment": "사용 여부. 끄면 주문 시 그 나라를 고를 수 없게 된다.",
                                                            "type": "change",
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "form.shipping.available_countries": "{{(_local.form?.shipping?.available_countries ?? []).map((c, i) => i === country._idx ? {...c, is_active: !(c.is_active ?? false)} : c)}}",
                                                                "hasChanges": true
                                                            }
                                                        }
                                                    ],
                                                    "props": {
                                                        "checked": "{{country.is_active ?? false}}",
                                                        "ariaLabel": "$t:common.row_cell|row={{country.code ?? ''}}|column={{$t('sirsoft-ecommerce.admin.settings.shipping.countries.is_active')}}",
                                                        "size": "sm",
                                                        "disabled": "{{_computed.isReadOnly || !(_local.form?.shipping?.international_shipping_enabled ?? false) && country.code !== (_local.form?.shipping?.default_country ?? 'KR')}}"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Td",
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Button",
                                                    "if": "{{country.code !== (_local.form?.shipping?.default_country ?? 'KR')}}",
                                                    "actions": [
                                                        {
                                                            "comment": "국가 삭제.",
                                                            "type": "click",
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "form.shipping.available_countries": "{{(_local.form?.shipping?.available_countries ?? []).filter((_, i) => i !== country._idx)}}",
                                                                "hasChanges": true
                                                            }
                                                        }
                                                    ],
                                                    "props": {
                                                        "type": "button",
                                                        "className": "ecommerce:p-1 ecommerce:text-gray-500 ecommerce:dark:text-gray-500 ecommerce:hover:text-red-600 ecommerce:dark:hover:text-red-400 ecommerce:transition-colors ecommerce:disabled:opacity-50 ecommerce:disabled:cursor-not-allowed",
                                                        "title": "$t:common.delete",
                                                        "disabled": "{{_computed.isReadOnly || !(_local.form?.shipping?.international_shipping_enabled ?? false)}}"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Icon",
                                                            "props": {
                                                                "name": "trash",
                                                                "className": "ecommerce:text-sm"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "if": "{{country.code === (_local.form?.shipping?.default_country ?? 'KR')}}",
                                                    "props": {
                                                        "className": "ecommerce-tone-info-soft ecommerce:inline-flex ecommerce:items-center ecommerce:px-2 ecommerce:py-0.5 ecommerce:font-medium ecommerce:bg-blue-100 ecommerce:dark:bg-blue-900/30 ecommerce:rounded-full ecommerce:text-xs"
                                                    },
                                                    "text": "$t:sirsoft-ecommerce.admin.settings.shipping.countries.default_badge"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
