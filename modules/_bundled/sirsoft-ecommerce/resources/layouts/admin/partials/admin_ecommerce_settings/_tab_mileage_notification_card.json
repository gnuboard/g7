{
    "comment": "쇼핑몰 설정 — 마일리지 알림 카드. 적립·소멸 알림을 언제 보낼지 정한다.\n  값 입력은 폼 자동 바인딩이고, 이 조각의 유일한 동작은 알림 설정 화면으로 건너가는 것이다.",
    "meta": {
        "is_partial": true,
        "description": "마일리지 설정 - 소멸 예정 알림 카드 (활성 채널 동적 표시)"
    },
    "id": "mileage_expiry_notification_card",
    "type": "basic",
    "name": "Div",
    "props": {
        "className": "ecommerce-admin-card"
    },
    "children": [
        {
            "type": "basic",
            "name": "H3",
            "props": {
                "className": "ecommerce-section-heading ecommerce:mb-4"
            },
            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.title"
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "ecommerce-flex-between ecommerce:py-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "ecommerce:block ecommerce:text-sm ecommerce:font-medium ecommerce:text-gray-900 ecommerce:dark:text-white"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.enabled"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "ecommerce:text-xs ecommerce-text-muted ecommerce:mt-0.5"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.enabled_hint"
                        }
                    ]
                },
                {
                    "type": "composite",
                    "name": "Toggle",
                    "props": {
                        "name": "mileage.expiry_notification_enabled",
                        "value": "{{_local.form?.mileage?.expiry_notification_enabled ?? true}}",
                        "disabled": "{{_computed.isReadOnly}}"
                    }
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{settings !== undefined && (_local.form?.mileage?.expiry_notification_enabled ?? true)}}",
            "props": {
                "className": "ecommerce:border-t ecommerce:border-gray-200 ecommerce:dark:border-gray-700 ecommerce:pt-4 ecommerce:space-y-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "ecommerce:block ecommerce:text-sm ecommerce:font-medium ecommerce:text-gray-900 ecommerce:dark:text-white ecommerce:mb-2"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.days_before"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce:flex ecommerce:items-center ecommerce:gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce:text-sm ecommerce:text-gray-600 ecommerce:dark:text-gray-400"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.days_before_prefix"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "number",
                                        "name": "mileage.expiry_notification_days_before",
                                        "value": "{{_local.form?.mileage?.expiry_notification_days_before ?? 7}}",
                                        "min": "{{_local?.form?._meta?.limits?.expiry_notification_days_before_min ?? 1}}",
                                        "className": "ecommerce-input ecommerce:w-20 ecommerce:text-center",
                                        "disabled": "{{_computed.isReadOnly}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce:text-sm ecommerce:text-gray-600 ecommerce:dark:text-gray-400"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.days_before_suffix|count={{_local.form?.mileage?.expiry_notification_days_before ?? 7}}"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "template_status_block",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce:border-t ecommerce:border-gray-100 ecommerce:dark:border-gray-700/50 ecommerce:pt-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "ecommerce:block ecommerce:text-sm ecommerce:font-medium ecommerce:text-gray-900 ecommerce:dark:text-white ecommerce:mb-2"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.template_status_title"
                        },
                        {
                            "id": "template_status_list",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce:space-y-2"
                            },
                            "children": [
                                {
                                    "id": "template_status_row_{{tplIndex}}",
                                    "type": "basic",
                                    "name": "Div",
                                    "iteration": {
                                        "source": "(((ecommerceNotificationDefinitions?.data?.data ?? []).find(d => d.type === 'mileage_expiring_soon')?.templates) ?? [])",
                                        "item_var": "tpl",
                                        "index_var": "tplIndex"
                                    },
                                    "props": {
                                        "className": "ecommerce-flex-between ecommerce:gap-2 ecommerce:px-3 ecommerce:py-2 ecommerce:rounded-lg ecommerce:bg-gray-50 ecommerce:dark:bg-gray-700/40"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "ecommerce:flex ecommerce:items-center ecommerce:gap-2 ecommerce:min-w-0"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "{{tpl.channel === 'mail' ? 'envelope' : 'bell'}}",
                                                        "size": "sm",
                                                        "className": "ecommerce-text-muted ecommerce:flex-shrink-0"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "props": {
                                                        "className": "ecommerce:min-w-0"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "ecommerce:block ecommerce:text-xs ecommerce:font-medium ecommerce-text-muted"
                                                            },
                                                            "text": "{{tpl.channel === 'mail' ? $t('sirsoft-ecommerce.admin.mileage_settings.notification.channel_mail') : (tpl.channel === 'database' ? $t('sirsoft-ecommerce.admin.mileage_settings.notification.channel_database') : tpl.channel)}}"
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "ecommerce:block ecommerce:text-sm ecommerce:text-gray-800 ecommerce:dark:text-gray-200 ecommerce:truncate"
                                                            },
                                                            "text": "{{$localized(tpl.subject) || $t('sirsoft-ecommerce.admin.mileage_settings.notification.template_status_empty')}}"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "{{tpl.is_active ? 'ecommerce:bg-green-50 ecommerce:text-green-700 ecommerce:dark:bg-green-900/30 ecommerce:dark:text-green-300' : 'ecommerce:bg-gray-100 ecommerce:text-gray-600 ecommerce:dark:bg-gray-700 ecommerce:dark:text-gray-300'}} ecommerce:inline-flex ecommerce:items-center ecommerce:px-2.5 ecommerce:py-0.5 ecommerce:rounded-full ecommerce:text-xs ecommerce:font-medium ecommerce:flex-shrink-0"
                                            },
                                            "text": "{{tpl.is_active ? $t('sirsoft-ecommerce.admin.mileage_settings.notification.template_status_active') : $t('sirsoft-ecommerce.admin.mileage_settings.notification.template_status_inactive')}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{ecommerceNotificationDefinitions !== undefined && ((((ecommerceNotificationDefinitions?.data?.data ?? []).find(d => d.type === 'mileage_expiring_soon')?.templates) ?? []).length === 0)}}",
                                    "props": {
                                        "className": "ecommerce:px-3 ecommerce:py-2 ecommerce:text-sm ecommerce-text-muted"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.template_status_empty"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-flex-between ecommerce:gap-2 ecommerce:flex-wrap ecommerce:mt-3"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "ecommerce:text-xs ecommerce-text-muted"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.template_status_hint"
                                },
                                {
                                    "id": "go_to_notification_settings",
                                    "type": "basic",
                                    "name": "A",
                                    "actions": [
                                        {
                                            "comment": "알림 설정 화면으로 이동. 마일리지 알림의 실제 문구·채널은 그쪽에서 정하므로 여기서는 자리만 안내한다.",
                                            "type": "click",
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "activeEcommerceSettingsTab": "notification_definitions"
                                                    }
                                                },
                                                {
                                                    "comment": "audit:allow layout-list-context-navigate-merge-query 탭 전환 — 탭마다 다루는 대상이 달라 이전 탭의 목록 상태를 물려받으면 오히려 잘못된 화면이 된다.",
                                                    "handler": "navigate",
                                                    "params": {
                                                        "path": "/admin/ecommerce/settings",
                                                        "replace": true,
                                                        "query": {
                                                            "tab": "notification_definitions"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    ],
                                    "props": {
                                        "href": "/admin/ecommerce/settings?tab=notification_definitions",
                                        "className": "ecommerce:flex ecommerce-btn ecommerce-btn-secondary ecommerce:gap-1.5 ecommerce:px-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "arrow-up-right-from-square",
                                                "size": "sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.notification.go_to_notification_settings"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
