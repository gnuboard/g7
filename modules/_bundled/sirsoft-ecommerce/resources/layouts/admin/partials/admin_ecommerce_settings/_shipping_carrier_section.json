                    "name": "Div",
                    "props": {
                        "className": "flex-between w-full"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "H3",
                                    "props": {
                                        "className": "card-title"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.shipping.carriers.section_title"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "if": "{{!_local.isAddingCarrier}}",
                            "actions": [
                                {
                                    "comment": "신규 행의 name 은 활성 언어팩($locales) 전체에 대한 빈 문자열 맵으로 시드한다. [추가] 확정 게이트가 `name[사이트 기본 언어]` 을 요구하므로, ko/en 을 리터럴로 열거하면 그 밖의 로케일 운영자는 그 언어의 입력칸도 언어 추가 버튼(MultilingualInput 은 activeLocales 를 value 의 키에서 뽑고 버튼을 사이트 기본 언어 필드에만 붙인다)도 없어 폼을 영영 확정할 수 없다 — 그동안 페이지 [저장]은 그 폼을 확정하라고 막는다.",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "isAddingCarrier": true,
                                        "carrierForm": "{{ { code: '', name: Object.fromEntries(($locales ?? []).map(l => [l, ''])), type: 'domestic', tracking_url: '', is_active: true, sort_order: 0 } }}",
                                        "carrierFormErrors": null
                                    }
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "flex-center gap-1.5 px-3 py-1.5 text-sm bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed",
                                "disabled": "{{_computed.isReadOnly}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "plus",
                                        "className": "text-xs"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-ecommerce.admin.settings.shipping.carriers.add_button"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{_local.isAddingCarrier}}",
