{
    "comment": "쇼핑몰 설정 — 리뷰 설정 탭. 리뷰 작성 조건과 적립 보상을 정한다.\n  숫자 칸이라 값이 문자열로 들어오고, 형 변환과 범위 판정은 저장 시 서버가 한다.",
    "meta": {
        "is_partial": true,
        "description": "쇼핑몰 설정 리뷰설정 탭 콘텐츠"
    },
    "id": "tab_content_review_settings",
    "type": "basic",
    "name": "Div",
    "if": "{{(_global.activeEcommerceSettingsTab || query.tab || 'basic_info') === 'review_settings'}}",
    "children": [
        {
            "id": "review_settings_card",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "ecommerce-admin-card"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "ecommerce-card-title"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-card-description"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.description"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-row-stack"
                    },
                    "children": [
                        {
                            "comment": "리뷰 작성 가능 기간",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-flex-center ecommerce:gap-2 ecommerce:flex-wrap"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce-text-body ecommerce:w-48 ecommerce:shrink-0"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.write_deadline_days_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "comment": "리뷰 작성 가능 기간. 주문 확정 뒤 며칠까지 쓸 수 있는지다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.review_settings.write_deadline_days": "{{Number($event.target.value)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "number",
                                        "min": "{{_local?.form?._meta?.limits?.write_deadline_days_min ?? 1}}",
                                        "aria-label": "$t:sirsoft-ecommerce.admin.settings.review_settings.write_deadline_days_label",
                                        "max": "{{_local?.form?._meta?.limits?.write_deadline_days_max ?? 365}}",
                                        "step": "1",
                                        "className": "ecommerce-input ecommerce:w-20",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "value": "{{_local.form?.review_settings?.write_deadline_days ?? 30}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce-text-body"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.days_unit"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "ecommerce:w-full ecommerce-form-hint"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.write_deadline_days_hint"
                                }
                            ]
                        },
                        {
                            "comment": "최대 이미지 수",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-flex-center ecommerce:gap-2 ecommerce:flex-wrap"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce-text-body ecommerce:w-48 ecommerce:shrink-0"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_images_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "comment": "리뷰 한 건에 붙일 수 있는 이미지 개수(0~10). 0 이면 사진 없이 글만 받는다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.review_settings.max_images": "{{Number($event.target.value)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "number",
                                        "min": "{{_local?.form?._meta?.limits?.max_images_min ?? 0}}",
                                        "aria-label": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_images_label",
                                        "max": "{{_local?.form?._meta?.limits?.max_images_max ?? 20}}",
                                        "step": "1",
                                        "className": "ecommerce-input ecommerce:w-20",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "value": "{{_local.form?.review_settings?.max_images ?? 5}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce-text-body"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.images_unit"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "ecommerce:w-full ecommerce-form-hint"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_images_hint"
                                }
                            ]
                        },
                        {
                            "comment": "이미지 최대 용량",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-flex-center ecommerce:gap-2 ecommerce:flex-wrap"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce-text-body ecommerce:w-48 ecommerce:shrink-0"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_image_size_mb_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "comment": "이미지 한 장의 최대 용량(MB). 0.5 단위로 넣고, 실제 거부는 업로드 시 서버가 한다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.review_settings.max_image_size_mb": "{{Number($event.target.value)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "number",
                                        "min": "{{_local?.form?._meta?.limits?.max_image_size_mb_min ?? 1}}",
                                        "aria-label": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_image_size_mb_label",
                                        "max": "{{_local?.form?._meta?.limits?.max_image_size_mb_max ?? 50}}",
                                        "step": "1",
                                        "className": "ecommerce-input ecommerce:w-20",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "value": "{{_local.form?.review_settings?.max_image_size_mb ?? 5}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce-text-body"
                                    },
                                    "text": "MB"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "ecommerce:w-full ecommerce-form-hint"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_image_size_mb_hint"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "comment": "후기 작성자 표시 이름(#490). 방식은 「상위 영역 따름 / 특정 종류 고정 / 회원이 고른 값」이고, 종류 칸은 고정일 때만 나온다.\n         값은 폼(`form.display_name.review`)에 담겨 하단 [저장]으로 나간다. 종류 목록과 지금 적용되는 값은 설정 응답의 읽기 전용\n         `display_name_options` 에서 읽는다(저장에 싣지 않는다). 서버가 그 키를 주지 않으면 카드를 그리지 않는다.\n         문의 쪽 같은 칸은 기본 정보 탭의 문의 설정 카드에 있다.",
            "id": "review_display_name_card",
            "type": "basic",
            "name": "Div",
            "if": "{{!!_local.form?.display_name_options}}",
            "props": {
                "className": "ecommerce-admin-card"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "ecommerce-card-title"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.settings.display_name.title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-card-description"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.settings.display_name.review_description"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-flex-center ecommerce:gap-2 ecommerce:flex-wrap"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "ecommerce-text-body ecommerce:w-48 ecommerce:shrink-0"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.settings.display_name.mode_label"
                        },
                        {
                            "id": "review_display_name_mode",
                            "type": "basic",
                            "name": "Select",
                            "actions": [
                                {
                                    "comment": "후기 표시 방식. 고정이 아니면 종류를 비운다(고정일 때만 뜻이 있는 값이다). 방식과 종류를 한 객체로 바꿔 담는다.",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "form.display_name.review": "{{({ mode: $event.target.value, kind: $event.target.value === 'fixed' ? (_local.form?.display_name?.review?.kind ?? null) : null })}}",
                                        "hasChanges": true
                                    }
                                }
                            ],
                            "props": {
                                "aria-label": "$t:sirsoft-ecommerce.admin.settings.display_name.review_mode_aria",
                                "value": "{{_local.form?.display_name?.review?.mode ?? 'inherit'}}",
                                "options": "{{[{ value: 'inherit', label: $t('sirsoft-ecommerce.admin.settings.display_name.mode.inherit') }, { value: 'fixed', label: $t('sirsoft-ecommerce.admin.settings.display_name.mode.fixed') }, { value: 'member', label: $t('sirsoft-ecommerce.admin.settings.display_name.mode.member') }]}}",
                                "className": "ecommerce:w-64",
                                "disabled": "{{_computed.isReadOnly}}"
                            }
                        },
                        {
                            "id": "review_display_name_kind",
                            "type": "basic",
                            "name": "Select",
                            "if": "{{(_local.form?.display_name?.review?.mode ?? 'inherit') === 'fixed'}}",
                            "actions": [
                                {
                                    "comment": "후기에 고정할 표시 이름 종류. 비워 두면 null 로 담기고 저장할 때 서버가 칸 아래 오류로 알린다.",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "form.display_name.review.kind": "{{$event.target.value || null}}",
                                        "hasChanges": true
                                    }
                                }
                            ],
                            "props": {
                                "aria-label": "$t:sirsoft-ecommerce.admin.settings.display_name.review_kind_aria",
                                "value": "{{_local.form?.display_name?.review?.kind ?? ''}}",
                                "options": "{{[{ value: '', label: $t('sirsoft-ecommerce.admin.settings.display_name.kind_placeholder') }].concat((_local.form?.display_name_options?.kinds ?? []).map(k => ({ value: k.key, label: k.preview ? $t('sirsoft-ecommerce.admin.settings.display_name.kind_option', { label: k.label ?? k.key, preview: k.preview }) : (k.label ?? k.key) })))}}",
                                "className": "{{_local.errors?.['display_name.review.kind'] ? 'ecommerce:w-64 ecommerce:border-red-500' : 'ecommerce:w-64'}}",
                                "disabled": "{{_computed.isReadOnly}}"
                            }
                        },
                        {
                            "id": "review_display_name_effective",
                            "type": "basic",
                            "name": "P",
                            "if": "{{(_local.form?.display_name?.review?.mode ?? 'inherit') === 'inherit' && (settings?.data?.display_name?.review?.mode ?? 'inherit') === 'inherit' && !!_local.form?.display_name_options?.effective?.review?.kind_label}}",
                            "props": {
                                "className": "ecommerce:w-full ecommerce-form-hint"
                            },
                            "text": "{{_local.form?.display_name_options?.effective?.review?.source_label ? $t('sirsoft-ecommerce.admin.settings.display_name.effective_with_source', { kind: _local.form?.display_name_options?.effective?.review?.kind_label, source: _local.form?.display_name_options?.effective?.review?.source_label }) : $t('sirsoft-ecommerce.admin.settings.display_name.effective', { kind: _local.form?.display_name_options?.effective?.review?.kind_label })}}"
                        },
                        {
                            "id": "review_display_name_nickname_hint",
                            "type": "basic",
                            "name": "P",
                            "if": "{{(_local.form?.display_name?.review?.mode ?? 'inherit') === 'fixed' && (_local.form?.display_name_options?.kinds ?? []).find(k => k.key === _local.form?.display_name?.review?.kind)?.requires_nickname === true}}",
                            "props": {
                                "className": "ecommerce:w-full ecommerce-form-hint"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.settings.display_name.requires_nickname_hint"
                        },
                        {
                            "id": "review_display_name_mode_error",
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_local.errors?.['display_name.review.mode']}}",
                            "props": {
                                "className": "ecommerce-form-error-xs ecommerce:w-full ecommerce:mt-1"
                            },
                            "text": "{{_local.errors?.['display_name.review.mode']?.[0] ?? ''}}"
                        },
                        {
                            "id": "review_display_name_kind_error",
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_local.errors?.['display_name.review.kind']}}",
                            "props": {
                                "className": "ecommerce-form-error-xs ecommerce:w-full ecommerce:mt-1"
                            },
                            "text": "{{_local.errors?.['display_name.review.kind']?.[0] ?? ''}}"
                        }
                    ]
                }
            ]
        }
    ]
}
