{
    "comment": "쇼핑몰 설정 — 리뷰 설정 탭. 리뷰 작성 조건과 적립 보상을 정한다.\n  숫자 칸이라 값이 문자열로 들어오고, 형 변환과 범위 판정은 저장 시 서버가 한다.",
    "meta": {
        "is_partial": true,
        "description": "쇼핑몰 설정 리뷰설정 탭 콘텐츠"
    },
    "id": "tab_content_review_settings",
    "type": "basic",
    "name": "Div",
    "if": "{{(_global.activeEcommerceSettingsTab || query.tab || 'basic_info') === 'review_settings'}}",
    "children": [
        {
            "id": "review_settings_card",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "admin-card"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "card-title"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "card-description"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.description"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "row-stack"
                    },
                    "children": [
                        {
                            "comment": "리뷰 작성 가능 기간",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-center gap-2 flex-wrap"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body w-48 shrink-0"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.write_deadline_days_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "comment": "리뷰 작성 가능 기간. 주문 확정 뒤 며칠까지 쓸 수 있는지다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.review_settings.write_deadline_days": "{{Number($event.target.value)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "number",
                                        "min": "{{_local?.form?._meta?.limits?.write_deadline_days_min ?? 1}}",
                                        "max": "{{_local?.form?._meta?.limits?.write_deadline_days_max ?? 365}}",
                                        "step": "1",
                                        "className": "input w-20",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "value": "{{_local.form?.review_settings?.write_deadline_days ?? 30}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.days_unit"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "w-full form-hint"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.write_deadline_days_hint"
                                }
                            ]
                        },
                        {
                            "comment": "최대 이미지 수",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-center gap-2 flex-wrap"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body w-48 shrink-0"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_images_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "comment": "리뷰 한 건에 붙일 수 있는 이미지 개수(0~10). 0 이면 사진 없이 글만 받는다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.review_settings.max_images": "{{Number($event.target.value)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "number",
                                        "min": "{{_local?.form?._meta?.limits?.max_images_min ?? 0}}",
                                        "max": "{{_local?.form?._meta?.limits?.max_images_max ?? 20}}",
                                        "step": "1",
                                        "className": "input w-20",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "value": "{{_local.form?.review_settings?.max_images ?? 5}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.images_unit"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "w-full form-hint"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_images_hint"
                                }
                            ]
                        },
                        {
                            "comment": "이미지 최대 용량",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-center gap-2 flex-wrap"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body w-48 shrink-0"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_image_size_mb_label"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "comment": "이미지 한 장의 최대 용량(MB). 0.5 단위로 넣고, 실제 거부는 업로드 시 서버가 한다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.review_settings.max_image_size_mb": "{{Number($event.target.value)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "number",
                                        "min": "{{_local?.form?._meta?.limits?.max_image_size_mb_min ?? 1}}",
                                        "max": "{{_local?.form?._meta?.limits?.max_image_size_mb_max ?? 50}}",
                                        "step": "1",
                                        "className": "input w-20",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "value": "{{_local.form?.review_settings?.max_image_size_mb ?? 5}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-body"
                                    },
                                    "text": "MB"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "w-full form-hint"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.review_settings.max_image_size_mb_hint"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
