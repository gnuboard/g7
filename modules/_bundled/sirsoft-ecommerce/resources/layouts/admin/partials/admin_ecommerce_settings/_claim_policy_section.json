                  "name": "Input",
                  "props": {
                    "type": "number",
                    "min": "{{_local?.form?._meta?.limits?.claim_max_images_min ?? 1}}",
                    "max": "{{_local?.form?._meta?.limits?.claim_max_images_max ?? 20}}",
                    "step": "1",
                    "className": "input w-20",
                    "disabled": "{{_computed.isReadOnly}}",
                    "value": "{{_local.form?.claim?.max_images ?? 5}}"
                  },
                  "actions": [
                    {
                      "type": "change",
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "form.claim.max_images": "{{Number($event.target.value)}}",
                        "hasChanges": true
                      }
                    }
                  ]
                },
                {
                  "type": "basic",
                  "name": "Span",
                  "props": {
                    "className": "text-body"
                  },
                  "text": "$t:sirsoft-ecommerce.admin.settings.claim.policy.images_unit"
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "w-full form-hint"
                  },
                  "text": "$t:sirsoft-ecommerce.admin.settings.claim.policy.attachment.max_images_hint"
                },
                {
                  "type": "basic",
                  "name": "Span",
                  "if": "{{_local.errors?.['claim.max_images']}}",
                  "props": {
                    "className": "w-full form-error-xs"
                  },
                  "text": "{{_local.errors?.['claim.max_images']?.[0] ?? ''}}"
                }
              ]
            },
            {
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "border-t border-gray-100 dark:border-gray-700"
              }
            },
            {
              "id": "claim_image_max_size_kb_field",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex-center gap-2 flex-wrap"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Span",
                  "props": {
                    "className": "text-body w-48 shrink-0"
                  },
                  "text": "$t:sirsoft-ecommerce.admin.settings.claim.policy.attachment.image_max_size_kb_label"
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "number",
                    "min": "{{_local?.form?._meta?.limits?.claim_image_max_size_kb_min ?? 128}}",
                    "max": "{{_local?.form?._meta?.limits?.claim_image_max_size_kb_max ?? 20480}}",
                    "step": "1",
                    "className": "input w-28",
                    "disabled": "{{_computed.isReadOnly}}",
                    "value": "{{_local.form?.claim?.image_max_size_kb ?? 2048}}"
                  },
                  "actions": [
                    {
                      "type": "change",
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "form.claim.image_max_size_kb": "{{Number($event.target.value)}}",
                        "hasChanges": true
                      }
                    }
                  ]
                },
                {
                  "type": "basic",
                  "name": "Span",
                  "props": {
                    "className": "text-body"
                  },
                  "text": "KB"
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "w-full form-hint"
                  },
                  "text": "$t:sirsoft-ecommerce.admin.settings.claim.policy.attachment.image_max_size_kb_hint"
                },
                {
                  "type": "basic",
                  "name": "Span",
                  "if": "{{_local.errors?.['claim.image_max_size_kb']}}",
                  "props": {
                    "className": "w-full form-error-xs"
                  },
                  "text": "{{_local.errors?.['claim.image_max_size_kb']?.[0] ?? ''}}"
                }
              ]
            }
          ]
        }
      ]
    },
