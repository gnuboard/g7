{
    "comment": "쇼핑몰 설정 — 마일리지 기본 설정 카드. 적립률·유효기간 같은 값을 폼 자동 바인딩으로만\n  받으므로 액션이 없다.",
    "meta": {
        "is_partial": true,
        "description": "마일리지 설정 - 기본 설정 카드"
    },
    "id": "mileage_basic_card",
    "type": "basic",
    "name": "Div",
    "props": {
        "className": "ecommerce-admin-card"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "ecommerce-flex-between ecommerce:mb-4 ecommerce:gap-2 ecommerce:flex-wrap"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "ecommerce-section-heading"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.title"
                },
                {
                    "id": "view_transactions_button",
                    "type": "basic",
                    "name": "A",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "navigate"
                        }
                    ],
                    "props": {
                        "href": "/admin/ecommerce/mileage-transactions",
                        "className": "ecommerce:flex ecommerce:items-center ecommerce:gap-1.5 ecommerce:px-3 ecommerce:py-2 ecommerce:text-sm ecommerce:bg-white ecommerce:dark:bg-gray-800 ecommerce:text-gray-700 ecommerce:dark:text-gray-300 ecommerce:border ecommerce:border-gray-300 ecommerce:dark:border-gray-600 ecommerce:rounded-lg ecommerce:hover:bg-gray-50 ecommerce:dark:hover:bg-gray-700 ecommerce:transition-colors"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "list",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.view_transactions"
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "ecommerce-flex-between ecommerce:py-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "ecommerce:block ecommerce:text-sm ecommerce:font-medium ecommerce:text-gray-900 ecommerce:dark:text-white"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.enabled"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "ecommerce:text-xs ecommerce:text-gray-500 ecommerce:dark:text-gray-400 ecommerce:mt-0.5"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.enabled_hint"
                        }
                    ]
                },
                {
                    "type": "composite",
                    "name": "Toggle",
                    "props": {
                        "name": "mileage.enabled",
                        "value": "{{_local.form?.mileage?.enabled ?? false}}",
                        "disabled": "{{_computed.isReadOnly}}"
                    }
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "ecommerce:border-t ecommerce:border-gray-200 ecommerce:dark:border-gray-700 ecommerce:py-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "ecommerce:block ecommerce:text-sm ecommerce:font-medium ecommerce:text-gray-900 ecommerce:dark:text-white ecommerce:mb-2"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_rate"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce:flex ecommerce:items-center ecommerce:gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "ecommerce:text-sm ecommerce:text-gray-600 ecommerce:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_rate_prefix"
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "number",
                                "name": "mileage.default_earn_rate",
                                "value": "{{_local.form?.mileage?.default_earn_rate ?? 1}}",
                                "min": "{{_local?.form?._meta?.limits?.default_earn_rate_min ?? 0}}",
                                "max": "{{_local?.form?._meta?.limits?.default_earn_rate_max ?? 100}}",
                                "step": "0.1",
                                "className": "ecommerce-input ecommerce:w-24 ecommerce:text-center",
                                "disabled": "{{_computed.isReadOnly}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "ecommerce:text-sm ecommerce:text-gray-600 ecommerce:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_rate_suffix"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{_local.errors?.['mileage.default_earn_rate']}}",
                    "props": {
                        "className": "ecommerce:text-red-600 ecommerce:dark:text-red-400 ecommerce:text-xs ecommerce:mt-1 ecommerce:block"
                    },
                    "text": "{{_local.errors?.['mileage.default_earn_rate']?.[0] ?? ''}}"
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "ecommerce:text-xs ecommerce:text-gray-500 ecommerce:dark:text-gray-400 ecommerce:mt-1"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_rate_hint"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "ecommerce:border-t ecommerce:border-gray-200 ecommerce:dark:border-gray-700 ecommerce:pt-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "ecommerce:block ecommerce:text-sm ecommerce:font-medium ecommerce:text-gray-900 ecommerce:dark:text-white ecommerce:mb-2"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce:flex ecommerce:items-center ecommerce:gap-2 ecommerce:flex-wrap"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Select",
                            "props": {
                                "name": "mileage.earn_trigger",
                                "aria-label": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger",
                                "value": "{{_local.form?.mileage?.earn_trigger ?? 'confirmed'}}",
                                "className": "ecommerce:h-9 ecommerce:w-32",
                                "disabled": "{{_computed.isReadOnly}}",
                                "options": [
                                    {
                                        "value": "confirmed",
                                        "label": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger_confirmed"
                                    },
                                    {
                                        "value": "delivered",
                                        "label": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger_delivered"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "ecommerce:text-sm ecommerce:text-gray-600 ecommerce:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_delay_prefix"
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "number",
                                "name": "mileage.earn_delay_days",
                                "aria-label": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_delay_days",
                                "value": "{{_local.form?.mileage?.earn_delay_days ?? 0}}",
                                "min": "{{_local?.form?._meta?.limits?.earn_delay_days_min ?? 0}}",
                                "className": "ecommerce-input ecommerce:w-20 ecommerce:text-center",
                                "disabled": "{{_computed.isReadOnly}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "ecommerce:text-sm ecommerce:text-gray-600 ecommerce:dark:text-gray-400"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_delay_suffix|count={{_local.form?.mileage?.earn_delay_days ?? 0}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "ecommerce:text-xs ecommerce:text-gray-500 ecommerce:dark:text-gray-400 ecommerce:mt-1"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger_hint"
                }
            ]
        }
    ]
}
