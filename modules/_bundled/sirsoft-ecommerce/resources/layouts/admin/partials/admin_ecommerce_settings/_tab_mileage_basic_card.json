                            "comment": "audit:allow layout-input-boundary-hardcoded 금액의 하한 0 은 저장 규칙(min:0)과 같은 고정값이다",
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "number",
                                "name": "mileage.signup_earn_amount",
                                "aria-label": "$t:sirsoft-ecommerce.admin.mileage_settings.policy.signup_earn_amount",
