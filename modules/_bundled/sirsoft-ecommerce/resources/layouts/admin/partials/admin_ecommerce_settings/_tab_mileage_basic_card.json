                                        "className": "ecommerce:text-xs ecommerce-text-muted ecommerce:mt-0.5"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.policy.signup_earn_hint"
                                }
                            ]
