                    ]
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{_local.errors?.['mileage.default_earn_rate']}}",
                    "props": {
                        "className": "ecommerce-form-error"
                    },
                    "text": "{{_local.errors?.['mileage.default_earn_rate']?.[0] ?? ''}}"
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "ecommerce:text-xs ecommerce-text-muted ecommerce:mt-1"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_rate_hint"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "ecommerce:border-t ecommerce:border-gray-200 ecommerce:dark:border-gray-700 ecommerce:pt-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "ecommerce:block ecommerce:text-sm ecommerce:font-medium ecommerce:text-gray-900 ecommerce:dark:text-white ecommerce:mb-2"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce:flex ecommerce:items-center ecommerce:gap-2 ecommerce:flex-wrap"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Select",
                            "props": {
                                "name": "mileage.earn_trigger",
                                "aria-label": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger",
                                "value": "{{_local.form?.mileage?.earn_trigger ?? 'confirmed'}}",
                                "className": "ecommerce:h-9 ecommerce:w-32",
                                "disabled": "{{_computed.isReadOnly}}",
                                "options": [
                                    {
                                        "value": "confirmed",
                                        "label": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger_confirmed"
                                    },
                                    {
                                        "value": "delivered",
                                        "label": "$t:sirsoft-ecommerce.admin.mileage_settings.basic.earn_trigger_delivered"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "ecommerce:text-sm ecommerce:text-gray-600 ecommerce:dark:text-gray-400"
