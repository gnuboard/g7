{
    "comment": "쇼핑몰 설정 — 배송 국가 목록, 좁은 화면용 카드. 넓은 화면용 표(`_shipping_country_table`)와\n  같은 배열을 편집한다.\n  국가는 해외배송을 켰을 때만 의미가 있다 — 끄면 이 목록은 남되 쓰이지 않는다.",
    "meta": {
        "is_partial": true,
        "description": "배송설정 - 배송가능국가 모바일 카드 뷰"
    },
    "id": "country_cards_container",
    "type": "basic",
    "name": "Div",
    "children": [
        {
            "id": "country_card_{{countryIndex}}",
            "type": "basic",
            "name": "Div",
            "iteration": {
                "source": "(_local.form?.shipping?.available_countries ?? []).map((c, i) => ({...c, _idx: i}))",
                "item_var": "country",
                "index_var": "countryIndex"
            },
            "props": {
                "className": "ecommerce-excel-card ecommerce:mb-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-excel-card-header"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-flex-center ecommerce:gap-2 ecommerce:min-w-0"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "{{'ecommerce-flag ecommerce-flag-' + (country.code?.toLowerCase() ?? '') + ' ecommerce-flag--square ecommerce:rounded ecommerce:text-lg'}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "ecommerce:min-w-0"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "ecommerce-excel-card-title ecommerce:font-mono"
                                            },
                                            "text": "{{country.code}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "ecommerce-text-tertiary ecommerce:truncate"
                                            },
                                            "text": "{{$localized(country.name, 'sirsoft-ecommerce::settings.countries.' + (country.code ?? '') + '.name')}}"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-flex-center ecommerce:gap-2 ecommerce:shrink-0"
                            },
                            "children": [
                                {
                                    "type": "composite",
                                    "name": "Toggle",
                                    "actions": [
                                        {
                                            "comment": "사용 여부. 끄면 주문 시 그 나라를 고를 수 없게 되고, 이미 받은 주문에는 영향이 없다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.shipping.available_countries": "{{(_local.form?.shipping?.available_countries ?? []).map((c, i) => i === country._idx ? {...c, is_active: !(c.is_active ?? false)} : c)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "checked": "{{country.is_active ?? false}}",
                                        "ariaLabel": "$t:common.row_cell|row={{country.code ?? ''}}|column={{$t('sirsoft-ecommerce.admin.settings.shipping.countries.is_active')}}",
                                        "size": "sm",
                                        "disabled": "{{_computed.isReadOnly || !(_local.form?.shipping?.international_shipping_enabled ?? false) && country.code !== (_local.form?.shipping?.default_country ?? 'KR')}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Button",
                                    "if": "{{country.code !== (_local.form?.shipping?.default_country ?? 'KR')}}",
                                    "actions": [
                                        {
                                            "comment": "국가 삭제.",
                                            "type": "click",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "form.shipping.available_countries": "{{(_local.form?.shipping?.available_countries ?? []).filter((_, i) => i !== country._idx)}}",
                                                "hasChanges": true
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "className": "ecommerce-btn-icon ecommerce-tone-error ecommerce:disabled:opacity-50 ecommerce:disabled:cursor-not-allowed",
                                        "disabled": "{{_computed.isReadOnly || !(_local.form?.shipping?.international_shipping_enabled ?? false)}}",
                                        "aria-label": "$t:common.delete"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "fa-solid fa-trash",
                                                "className": "ecommerce:text-sm"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{country.code === (_local.form?.shipping?.default_country ?? 'KR')}}",
                                    "props": {
                                        "className": "ecommerce-tone-info-soft ecommerce:inline-flex ecommerce:items-center ecommerce:px-2 ecommerce:py-0.5 ecommerce:font-medium ecommerce:bg-blue-100 ecommerce:dark:bg-blue-900/30 ecommerce:rounded-full ecommerce:text-xs"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.settings.shipping.countries.default_badge"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
