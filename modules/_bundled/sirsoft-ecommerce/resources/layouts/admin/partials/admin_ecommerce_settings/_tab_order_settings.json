                        "hasChanges": true
                      }
                    }
                  ]
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "text-xs text-secondary mt-1"
                  },
                  "text": "$t:sirsoft-ecommerce.admin.settings.order_settings.cash_receipt.provider_help"
