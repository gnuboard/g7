                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{_local.errors?.['order_settings.stock_restore_on_cancel']}}",
                    "props": {
                        "className": "form-error-xs mt-1"
                    },
                    "text": "{{_local.errors?.['order_settings.stock_restore_on_cancel']?.[0] ?? ''}}"
                }
            ]
        }
    ]
}
