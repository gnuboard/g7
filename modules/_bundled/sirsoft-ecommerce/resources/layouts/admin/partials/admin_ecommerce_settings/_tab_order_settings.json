                  "props": {
                    "value": "{{_local.form?.order_settings?.cash_receipt_provider ?? ''}}",
                    "className": "w-full",
                    "options": "{{[{ value: '', label: $t('sirsoft-ecommerce.admin.settings.order_settings.cash_receipt.provider_none') }].concat((_local.form?.available_cash_receipt_providers ?? []).map(p => ({ value: p.id, label: $localized(p.name) ?? p.id })))}}",
