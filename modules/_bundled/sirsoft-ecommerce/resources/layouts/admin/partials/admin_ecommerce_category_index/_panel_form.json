                                            "text": "$t:sirsoft-ecommerce.admin.category.form.image"
                                        },
                                        {
                                            "id": "form_image_uploader",
                                            "type": "composite",
                                            "name": "FileUploader",
                                            "actions": [
                                                {
                                                    "comment": "파일을 건드린 것도 폼 변경으로 친다 — 이미지만 바꾸고 나가려 할 때 이탈 경고가 뜨게 하는 자리. 이미 `true` 면 다시 쓰지 않는다.",
                                                    "type": "change",
                                                    "event": "onFilesChange",
                                                    "handler": "setState",
                                                    "if": "{{!_local.hasChanges}}",
                                                    "params": {
                                                        "target": "local",
                                                        "hasChanges": true
                                                    }
                                                },
                                                {
                                                    "comment": "업로드가 끝난 파일을 폼의 이미지 목록에 **덧붙인다**. 통째로 갈아끼우지 않는 것은 여러 번에 나눠 올릴 때 앞서 올린 것이 사라지기 때문이다.",
                                                    "type": "change",
                                                    "event": "onUploadComplete",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "form.images": "{{[...(_local.form?.images ?? []), ...$args[0]]}}"
                                                    }
                                                },
                                                {
                                                    "comment": "업로드 실패 — 사유를 알림으로 띄우면서 `_local.uploadError` 에도 남긴다. 알림은 사라지지만 이 값은 남아 다른 자리에서 상태를 물을 수 있다.",
                                                    "type": "change",
                                                    "event": "onUploadError",
                                                    "handler": "sequence",
                                                    "actions": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "uploadError": "{{$args[0]}}"
                                                            }
                                                        },
                                                        {
                                                            "handler": "toast",
                                                            "params": {
                                                                "type": "error",
                                                                "message": "{{$args[0]}}",
                                                                "icon": "triangle-exclamation"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "comment": "삭제 실패 — 서버 사유 대신 고정 문구를 쓴다. 여기서 목록을 되돌리지 않으므로, 화면에서 사라진 이미지가 서버에는 남아 있을 수 있다.",
                                                    "type": "change",
                                                    "event": "onDeleteError",
