                                                    "type": "change",
                                                    "event": "onRemove",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "form.images": "{{(_local.form?.images ?? []).filter(img => (img.hash || img.id) !== $args[0])}}"
                                                    }
