                                            "text": "$t:sirsoft-ecommerce.admin.category.form.slug_hint"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "form_name_field",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "id": "form_name_label",
