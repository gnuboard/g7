                                                "name": "Badge",
                                                "if": "{{row.reactivated_at_formatted != null && row.is_partially_reactivated === true}}",
                                                "props": {
                                                    "variant": "info",
                                                    "size": "sm"
                                                },
                                                "text": "$t:defer:sirsoft-ecommerce.admin.claim.column.reactivated_partial_badge|at={{row.reactivated_at_formatted}}"
