                                                "name": "Span",
                                                "if": "{{(row.outstanding_amount ?? 0) > 0}}",
                                                "props": {
                                                    "className": "text-xs text-red-600 dark:text-red-400"
                                                },
                                                "text": "$t:defer:sirsoft-ecommerce.admin.claim.column.outstanding_short|amount={{row.outstanding_amount_formatted}}"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "if": "{{row.refund_total_formatted != null}}",
                                                "props": {
                                                    "className": "font-medium"
                                                },
                                                "text": "{{row.refund_total_formatted}}"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "if": "{{row.total_charge_amount_formatted == null && row.refund_total_formatted == null}}",
                                                "props": {
                                                    "className": "text-gray-500 dark:text-gray-400"
                                                },
                                                "text": "-"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "field": "tracking",
                                "comment": "운송장 열 (교환·반품) — 송장은 상품 행마다 있어 방향별 첫 운송장과 「외 N개」 로 줄인다(서버 `tracking_summary`). 「외 N개」 는 운송장이 둘 이상일 때만 붙인다 — 하나뿐인 대부분의 건에 「외 0개」 가 서면 안 된다(구매자 목록과 같은 규칙).",
                                "header": "$t:sirsoft-ecommerce.admin.claim.column.tracking",
                                "width": "170px",
                                "sortable": false,
                                "required": false,
                                "cellChildren": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "stack-flush gap-1 text-xs"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "if": "{{!!row.tracking_summary?.collection?.first}}",
                                                "props": {
                                                    "className": "flex-center gap-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "$t:defer:sirsoft-ecommerce.admin.claim.column.tracking_collection|number={{row.tracking_summary?.collection?.first ?? ''}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{(row.tracking_summary?.collection?.count ?? 0) > 1}}",
                                                        "props": {
                                                            "className": "text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:defer:sirsoft-ecommerce.admin.claim.column.tracking_more|more={{(row.tracking_summary?.collection?.count ?? 0) - 1}}"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "if": "{{!!row.tracking_summary?.redelivery?.first}}",
                                                "props": {
                                                    "className": "flex-center gap-1"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "$t:defer:sirsoft-ecommerce.admin.claim.column.tracking_redelivery|number={{row.tracking_summary?.redelivery?.first ?? ''}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{(row.tracking_summary?.redelivery?.count ?? 0) > 1}}",
                                                        "props": {
                                                            "className": "text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:defer:sirsoft-ecommerce.admin.claim.column.tracking_more|more={{(row.tracking_summary?.redelivery?.count ?? 0) - 1}}"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "if": "{{!row.tracking_summary?.collection?.first && !row.tracking_summary?.redelivery?.first}}",
                                                "props": {
                                                    "className": "text-gray-500 dark:text-gray-400"
                                                },
                                                "text": "-"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "field": "completed_at",
                                "header": "$t:sirsoft-ecommerce.admin.claim.column.completed_at",
                                "width": "140px",
                                "sortable": false,
                                "required": false,
                                "cellChildren": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "{{row.completed_at_formatted ?? '-'}}"
                                    }
                                ]
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
