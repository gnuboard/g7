{
    "meta": {
        "is_partial": true,
        "description": "Claim List - Preset Save Modal"
    },
    "id": "modal_claim_preset_save",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-ecommerce.admin.claim.modal.preset_save.title",
        "description": "$t:sirsoft-ecommerce.admin.claim.modal.preset_save.description",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Input",
            "actions": [
                {
                    "type": "input",
                    "handler": "setState",
                    "params": {
                        "target": "local",
                        "presetName": "{{$event.target.value}}"
                    }
                }
            ],
            "props": {
                "type": "text",
                "placeholder": "$t:sirsoft-ecommerce.admin.claim.modal.preset_save.placeholder",
                "className": "input",
                "value": "{{_local.presetName}}"
            }
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "modal-footer-buttons"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "closeModal"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "px-4 py-2 text-body border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isSaving}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isSaving": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/modules/sirsoft-ecommerce/admin/presets",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST",
                                        "body": {
                                            "target_screen": "claims",
                                            "name": "{{_local.presetName}}",
                                            "conditions": {
                                                "claimType": "{{_global.savingPresetConditions.claimType || (query.type || 'exchange')}}",
                                                "searchField": "{{_global.savingPresetConditions.searchField || 'claim_number'}}",
                                                "searchKeyword": "{{_global.savingPresetConditions.searchKeyword || ''}}",
                                                "startDate": "{{_global.savingPresetConditions.startDate || ''}}",
                                                "endDate": "{{_global.savingPresetConditions.endDate || ''}}",
                                                "dateQuick": "{{_global.savingPresetConditions.dateQuick || ''}}",
                                                "claimStatus": "{{_global.savingPresetConditions.claimStatus || []}}",
                                                "faultTypes": "{{_global.savingPresetConditions.faultTypes || []}}",
                                                "chargeMethods": "{{_global.savingPresetConditions.chargeMethods || []}}",
                                                "reasonCode": "{{_global.savingPresetConditions.reasonCode || ''}}",
                                                "requesterType": "{{_global.savingPresetConditions.requesterType || ''}}",
                                                "minAmount": "{{_global.savingPresetConditions.minAmount || ''}}",
                                                "maxAmount": "{{_global.savingPresetConditions.maxAmount || ''}}",
                                                "currencyCode": "{{_global.savingPresetConditions.currencyCode || ''}}",
                                                "chargePaymentMethods": "{{_global.savingPresetConditions.chargePaymentMethods || []}}"
                                            }
                                        }
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isSaving": false
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "presetName": ""
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "presets"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:sirsoft-ecommerce.messages.presets.created"
                                            }
                                        },
                                        {
                                            "handler": "closeModal"
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isSaving": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "flex-center gap-2 px-4 py-2 text-sm bg-blue-600 dark:bg-blue-500 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{!_local.presetName || _local.presetName.trim() === '' || _global.isSaving}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isSaving}}",
                            "props": {
                                "name": "spinner",
                                "className": "spinner-sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isSaving ? '$t:common.saving' : '$t:sirsoft-ecommerce.admin.claim.modal.preset_save.save'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
