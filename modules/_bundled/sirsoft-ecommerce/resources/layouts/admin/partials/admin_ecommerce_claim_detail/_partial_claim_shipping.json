                                                            "type": "basic",
                                                            "name": "Span",
                                                            "if": "{{group.can_deliver !== true && !!group.blocked_reason}}",
                                                            "props": {
                                                                "className": "text-xs text-gray-500 dark:text-gray-400"
                                                            },
                                                            "text": "{{group.blocked_reason}}"
                                                        },
                                                        {
                                                            "id": "cs_015b_redelivery_deliver_{{groupIdx}}",
                                                            "type": "basic",
                                                            "name": "Button",
                                                            "actions": [
                                                                {
                                                                    "comment": "재발송 묶음을 배송완료로 바꾼다 — 묶음의 택배사·송장을 함께 넘기고, 실패 안내는 핸들러가 띄운다",
                                                                    "type": "click",
                                                                    "handler": "sirsoft-ecommerce.deliverClaimTracking",
                                                                    "params": {
                                                                        "pathSegment": "{{claim?.data?.claim_path_segment ?? ''}}",
                                                                        "claimId": "{{claim?.data?.claim?.id ?? null}}",
                                                                        "direction": "redelivery",
                                                                        "carrierId": "{{group.carrier_id}}",
                                                                        "trackingNumber": "{{group.tracking_number}}"
                                                                    },
                                                                    "onError": {
                                                                        "handler": "suppress"
                                                                    }
                                                                }
                                                            ],
                                                            "props": {
                                                                "type": "button",
                                                                "className": "btn btn-outline btn-sm",
                                                                "disabled": "{{claim?.data?.abilities?.can_update_status !== true || group.can_deliver !== true || _local.isDeliveringTracking === true}}"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "basic",
                                                                    "name": "Icon",
                                                                    "if": "{{_local.deliveringTrackingKey === 'redelivery|' + group.carrier_id + '|' + group.tracking_number}}",
                                                                    "props": {
                                                                        "name": "spinner",
                                                                        "className": "spinner-sm mr-1"
                                                                    }
                                                                },
                                                                {
                                                                    "type": "basic",
                                                                    "name": "Span",
                                                                    "text": "$t:sirsoft-ecommerce.admin.claim.detail.shipping.deliver"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "mt-2 space-y-1"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "iteration": {
                                                        "source": "{{group.items ?? []}}",
                                                        "item_var": "gItem",
                                                        "index_var": "gItemIdx"
                                                    },
                                                    "props": {
                                                        "className": "flex-center gap-2 text-sm text-secondary flex-wrap"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-gray-900 dark:text-gray-100"
                                                            },
                                                            "text": "{{(gItem.product_name ?? '') + (gItem.option_name ? ' (' + gItem.option_name + ')' : '') + ' × ' + (gItem.quantity ?? 0)}}"
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-xs"
                                                            },
                                                            "text": "{{gItem.status_label ?? ''}}"
                                                        },
                                                        {
                                                            "type": "composite",
                                                            "name": "Badge",
                                                            "if": "{{gItem.arrived === true}}",
                                                            "props": {
                                                                "variant": "success",
                                                                "size": "sm"
                                                            },
                                                            "text": "$t:sirsoft-ecommerce.admin.claim.detail.shipping.arrived"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
