                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "claimRefundExecuteBankCode": "{{$event.target.value}}"
                                    }
                                }
                            ],
                            "props": {
                                "type": "text",
                                "value": "{{_global.claimRefundExecuteBankCode ?? ''}}",
                                "placeholder": "$t:sirsoft-ecommerce.admin.claim.detail.refund_execute.refund_bank_code_placeholder",
                                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-blue-500 dark:focus:border-blue-400 disabled:opacity-50 disabled:cursor-not-allowed",
                                "disabled": "{{_global.isProcessing || _global.claimRefundExecuteForce === true}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "actions": [
                                {
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "claimRefundExecuteBankAccount": "{{$event.target.value}}"
                                    }
                                }
                            ],
                            "props": {
                                "type": "text",
                                "value": "{{_global.claimRefundExecuteBankAccount ?? ''}}",
                                "placeholder": "$t:sirsoft-ecommerce.admin.claim.detail.refund_execute.refund_bank_account_placeholder",
                                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-blue-500 dark:focus:border-blue-400 disabled:opacity-50 disabled:cursor-not-allowed",
                                "disabled": "{{_global.isProcessing || _global.claimRefundExecuteForce === true}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "actions": [
                                {
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "claimRefundExecuteBankHolder": "{{$event.target.value}}"
                                    }
                                }
                            ],
                            "props": {
                                "type": "text",
                                "value": "{{_global.claimRefundExecuteBankHolder ?? ''}}",
                                "placeholder": "$t:sirsoft-ecommerce.admin.claim.detail.refund_execute.refund_bank_holder_placeholder",
                                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-sm focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-blue-500 dark:focus:border-blue-400 disabled:opacity-50 disabled:cursor-not-allowed",
                                "disabled": "{{_global.isProcessing || _global.claimRefundExecuteForce === true}}"
                            }
                        },
                        {
                            "comment": "계좌 없이 직권으로 완료를 찍는 동의 (PO 결정 2026-09-23) — 운영상 필요하기 때문에 길 자체는 남기되, **모르고 눌러 닫히는 것**과 알고 누르는 것을 가른다. 체크박스 한 칸 + 결과를 말하는 힌트라는 형태는 주문 상세의 「원 주문서도 결제완료로 처리」(`mark_order_complete`)와 같다. 체크하면 위 계좌 칸은 잠긴다 — 둘을 함께 보내면 무엇이 실행됐는지 창이 두 가지로 읽힌다.",
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "flex items-start gap-2 cursor-pointer"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "claimRefundExecuteForce": "{{$event.target.checked}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "checkbox",
                                        "name": "force_without_refund_bank",
                                        "className": "mt-0.5",
                                        "checked": "{{_global.claimRefundExecuteForce ?? false}}",
                                        "disabled": "{{_global.isProcessing}}"
