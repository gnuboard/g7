                                            "text": "$t:sirsoft-ecommerce.admin.claim.detail.refund_execute.force_without_bank"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-hint block"
                                            },
                                            "text": "$t:sirsoft-ecommerce.admin.claim.detail.refund_execute.force_without_bank_hint"
                                        }
                                    ]
                                }
                            ]
