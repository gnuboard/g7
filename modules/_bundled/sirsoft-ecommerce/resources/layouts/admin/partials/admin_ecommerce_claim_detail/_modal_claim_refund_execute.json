                {
                    "id": "crm_006_irreversible_notice",
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "p-3 rounded-lg bg-yellow-50 dark:bg-yellow-900/20 text-sm text-yellow-700 dark:text-yellow-400"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.claim.detail.refund_execute.modal.warning"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex justify-end gap-2 pt-2"
                    },
                    "children": [
                        {
                            "id": "crm_007_cancel",
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "closeModal"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "btn btn-outline",
                                "disabled": "{{_global.isProcessing}}"
                            },
                            "text": "$t:common.cancel"
                        },
                        {
                            "comment": "이 창에서 실제로 환불을 일으키는 유일한 버튼이다 — 진행 표식을 실행보다 먼저 세워 응답 전 두 번째 클릭을 버튼 비활성으로 막는다(서버의 409 는 그다음 방어선이다).",
                            "id": "crm_008_confirm",
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isProcessing": true
                                            }
                                        },
                                        {
                                            "comment": "onError 는 진행 상태만 되돌린다 — 사유 토스트는 핸들러가 이미 띄운다(서버 사유 우선 + 다국어 폴백). 여기서 한 번 더 띄우면 같은 문구가 두 번 뜬다. 모달은 닫지 않는다: 409(더블클릭)·422(상한 초과)는 운영자가 그 자리에서 확인해야 할 사유다.",
                                            "handler": "sirsoft-ecommerce.executeClaimRefund",
                                            "onSuccess": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "isProcessing": false
                                                    }
                                                },
                                                {
                                                    "handler": "closeModal"
                                                }
                                            ],
                                            "onError": {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "global",
                                                    "isProcessing": false
                                                }
                                            }
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "btn btn-primary",
                                "disabled": "{{!_global.claimRefundExecuteContext || _global.isProcessing || (_global.claimRefundExecuteContext?.refundAccountRequired === true && _global.claimRefundExecuteForce !== true && !((_global.claimRefundExecuteBankCode ?? '').trim() && (_global.claimRefundExecuteBankAccount ?? '').trim() && (_global.claimRefundExecuteBankHolder ?? '').trim()))}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "if": "{{_global.isProcessing}}",
                                    "props": {
                                        "name": "spinner",
                                        "className": "spinner-sm"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "{{_global.isProcessing ? '$t:common.processing' : ''}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{!_global.isProcessing}}",
                                    "text": "$t:sirsoft-ecommerce.admin.claim.detail.refund_execute.modal.confirm"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
