{
    "comment": "배송정책 한 건을 지우는 확인 창. 대상은 목록이 `_global.targetPolicy` 에 담아 준 정책이고,\n  이름을 회색 상자로 다시 보여 줘 무엇을 지우는지 확인시킨다.\n  경고 두 줄은 일괄 삭제 창과 같다 — 되돌릴 수 없고, 그 정책을 쓰던 상품이 배송비 기준을 잃는다.\n  성공하면 대상을 비운다(지운 정책이 남아 있으면 창을 다시 열었을 때 없는 것을 가리킨다).",
    "meta": {
        "is_partial": true,
        "description": "Shipping Policy Delete Confirmation Modal"
    },
    "id": "delete_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-ecommerce.admin.shipping_policy.modal.delete.title",
        "size": "medium",
        "footer": [
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "closeModal"
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "ecommerce:px-4 ecommerce:py-2 ecommerce:bg-white ecommerce:dark:bg-gray-800 ecommerce:text-gray-700 ecommerce:dark:text-gray-300 ecommerce:border ecommerce:border-gray-300 ecommerce:dark:border-gray-600 ecommerce:rounded-lg ecommerce:hover:bg-gray-50 ecommerce:dark:hover:bg-gray-700 ecommerce:disabled:opacity-50 ecommerce:disabled:cursor-not-allowed",
                    "disabled": "{{_global.isDeleting}}"
                },
                "text": "$t:sirsoft-ecommerce.admin.shipping_policy.common.cancel"
            },
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "comment": "삭제 실행. 성공 갈래가 대상을 비운 뒤 목록을 다시 부른다.",
                        "type": "click",
                        "handler": "sequence",
                        "actions": [
                            {
                                "handler": "setState",
                                "params": {
                                    "target": "global",
                                    "isDeleting": true
                                }
                            },
                            {
                                "handler": "apiCall",
                                "target": "/api/modules/sirsoft-ecommerce/admin/shipping-policies/{{_global.targetPolicy?.id}}",
                                "auth_required": true,
                                "params": {
                                    "method": "DELETE"
                                },
                                "onSuccess": [
                                    {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "isDeleting": false,
                                            "targetPolicy": null
                                        }
                                    },
                                    {
                                        "handler": "refetchDataSource",
                                        "params": {
                                            "dataSourceId": "shipping_policies"
                                        }
                                    },
                                    {
                                        "handler": "toast",
                                        "params": {
                                            "type": "success",
                                            "message": "$t:sirsoft-ecommerce.admin.shipping_policy.messages.deleted"
                                        }
                                    },
                                    {
                                        "handler": "closeModal"
                                    }
                                ],
                                "onError": [
                                    {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "isDeleting": false
                                        }
                                    },
                                    {
                                        "handler": "toast",
                                        "params": {
                                            "type": "error",
                                            "message": "{{error.message}}"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "ecommerce-flex-center ecommerce:gap-2 ecommerce:px-4 ecommerce:py-2 ecommerce:bg-red-600 ecommerce:dark:bg-red-600 ecommerce:text-white ecommerce:rounded-lg ecommerce:hover:bg-red-700 ecommerce:dark:hover:bg-red-700 ecommerce:disabled:opacity-50 ecommerce:disabled:cursor-not-allowed",
                    "disabled": "{{_global.isDeleting}}"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Icon",
                        "if": "{{_global.isDeleting}}",
                        "props": {
                            "name": "spinner",
                            "className": "ecommerce-spinner-sm"
                        }
                    },
                    {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{_global.isDeleting ? '$t:sirsoft-ecommerce.admin.shipping_policy.common.deleting' : '$t:sirsoft-ecommerce.admin.shipping_policy.common.delete'}}"
                    }
                ]
            }
        ]
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "ecommerce:text-gray-700 ecommerce:dark:text-gray-300"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.shipping_policy.modal.delete.message"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce:bg-gray-50 ecommerce:dark:bg-gray-700/50 ecommerce:rounded-lg ecommerce:p-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "ecommerce-text-primary ecommerce:font-medium"
                            },
                            "text": "{{_global.targetPolicy?.name_localized}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-alert-warning"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "triangle-exclamation",
                                "className": "ecommerce:text-xl ecommerce:text-amber-600 ecommerce:dark:text-amber-400 ecommerce:flex-shrink-0 ecommerce:mt-0.5"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-tone-warning-soft ecommerce:text-xs"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "text": "$t:sirsoft-ecommerce.admin.shipping_policy.modal.delete.warning"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "ecommerce:mt-1"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.shipping_policy.modal.delete.product_warning"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
