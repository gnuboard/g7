{
    "comment": "상품 폼 — 고시 항목을 템플릿으로 저장. 같은 항목 묶음을 다음 상품에서 불러 쓰려고 지금 입력분을\n  이름 붙여 남긴다. 입력값은 전역에 두고(창은 별도 컨텍스트라 폼의 _local 을 못 쓴다), 미리보기만\n  `$parent` 없이 폼의 고시 값을 그대로 읽는다.",
    "meta": {
        "is_partial": true,
        "description": "Product Form - Save Notice Template Modal"
    },
    "id": "modal_save_template",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-ecommerce.admin.product.modal.save_template.title",
        "size": "md",
        "footer": [
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "closeModal"
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "ecommerce-btn ecommerce-btn-outline"
                },
                "text": "$t:sirsoft-ecommerce.common.cancel"
            },
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "sirsoft-ecommerce.confirmSaveNoticeTemplate"
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "ecommerce-btn ecommerce-btn-primary",
                    "disabled": "{{!_global.ui.saveTemplateData?.name}}"
                },
                "text": "$t:sirsoft-ecommerce.admin.product.modal.save_template.save_button"
            }
        ]
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "id": "save_template_description",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce:text-center"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-flex-center ecommerce:w-16 ecommerce:h-16 ecommerce:mx-auto ecommerce:mb-4 ecommerce:rounded-full ecommerce:bg-blue-100 ecommerce:dark:bg-blue-900/30 ecommerce:justify-center"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "save",
                                        "className": "ecommerce:text-[2rem] ecommerce:text-blue-500 ecommerce:dark:text-blue-400"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "ecommerce-text-label-subtle"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.product.modal.save_template.description"
                        }
                    ]
                },
                {
                    "id": "save_template_form",
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "id": "template_name_field",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "ecommerce-form-label"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-ecommerce.admin.product.modal.save_template.template_name"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "ecommerce-text-required"
                                                    },
                                                    "text": "*"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "actions": [
                                                {
                                                    "comment": "템플릿 이름 — 비어 있으면 저장 버튼이 잠긴다",
                                                    "type": "change",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "ui.saveTemplateData.name": "{{$event.target.value}}"
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "name": "template_name",
                                                "value": "{{_global.ui.saveTemplateData?.name ?? ''}}",
                                                "placeholder": "$t:sirsoft-ecommerce.admin.product.modal.save_template.template_name_placeholder"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "template_category_field",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "ecommerce-form-label"
                                            },
                                            "text": "$t:sirsoft-ecommerce.admin.product.modal.save_template.category"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Select",
                                            "actions": [
                                                {
                                                    "comment": "어느 분류의 템플릿으로 묶을지 — 비워 두어도 저장된다",
                                                    "type": "change",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "ui.saveTemplateData.category_id": "{{$event.target.value}}"
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "name": "template_category",
                                                "value": "{{_global.ui.saveTemplateData?.category_id}}",
                                                "placeholder": "$t:sirsoft-ecommerce.admin.product.modal.save_template.category_placeholder",
                                                "options": "{{(notice_template_categories?.data?.data ?? []).map(c => ({ value: c.id, label: $localized(c.name) }))}}",
                                                "clearable": true
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "template_set_default",
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "ecommerce-flex-center ecommerce:gap-3 ecommerce:cursor-pointer"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Checkbox",
                                    "actions": [
                                        {
                                            "comment": "기본 템플릿으로 지정 — 다음 상품 등록에서 자동으로 불려 온다",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "ui.saveTemplateData.is_default": "{{$event.target.checked}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "name": "is_default",
                                        "checked": "{{_global.ui.saveTemplateData?.is_default ?? false}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce-text-label ecommerce:cursor-pointer"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.product.modal.save_template.set_as_default"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "save_template_preview",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-toggle-group"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce:p-3 ecommerce:bg-gray-50 ecommerce:dark:bg-gray-800 ecommerce:border-b ecommerce:border-gray-200 ecommerce:dark:border-gray-700"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "ecommerce-text-body ecommerce:font-medium"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.product.modal.save_template.preview"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce:p-4 ecommerce:max-h-48 ecommerce:overflow-y-auto"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "ecommerce-text-label"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "ecommerce:mb-2"
                                            },
                                            "text": "$t:sirsoft-ecommerce.admin.product.modal.save_template.fields_count: {{Object.keys(_local.form.product_notice ?? {}).length}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "ecommerce:grid ecommerce:grid-cols-2 ecommerce:gap-2 ecommerce:text-xs"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "iteration": {
                                                        "source": "{{Object.entries(_local.form.product_notice ?? {}).slice(0, 6)}}",
                                                        "item_var": "entry",
                                                        "index_var": "entryIdx"
                                                    },
                                                    "props": {
                                                        "className": "ecommerce:bg-gray-100 ecommerce:dark:bg-gray-700 ecommerce:rounded ecommerce:px-2 ecommerce:py-1"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "ecommerce:text-gray-600 ecommerce:dark:text-gray-300"
                                                            },
                                                            "text": "{{entry[0]}}: "
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "ecommerce:text-gray-700 ecommerce:dark:text-gray-300"
                                                            },
                                                            "text": "{{(entry[1] ?? '').toString().substring(0, 20)}}{{(entry[1] ?? '').toString().length > 20 ? '...' : ''}}"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "if": "{{Object.keys(_local.form.product_notice ?? {}).length > 6}}",
                                            "props": {
                                                "className": "ecommerce:mt-2 ecommerce:text-gray-500 ecommerce:dark:text-gray-400 ecommerce:italic"
                                            },
                                            "text": "... +{{Object.keys(_local.form.product_notice ?? {}).length - 6}} $t:sirsoft-ecommerce.admin.product.modal.save_template.more_fields"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "save_template_info",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-alert-info"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce-flex-start ecommerce:gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "info-circle",
                                        "className": "ecommerce:text-base ecommerce:text-blue-500 ecommerce:dark:text-blue-400 ecommerce:flex-shrink-0 ecommerce:mt-0.5"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "ecommerce-tone-info-soft ecommerce:text-xs"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.product.modal.save_template.info"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
