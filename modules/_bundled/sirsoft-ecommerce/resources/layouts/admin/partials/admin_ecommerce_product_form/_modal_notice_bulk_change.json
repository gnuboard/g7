{
    "comment": "상품 폼 — 고시 항목 일괄 변경 확인. 한 항목의 값을 이 상품의 모든 고시 줄에 한꺼번에 채우는\n  동작이라, 이미 손으로 다르게 적어 둔 줄까지 덮는다는 것을 먼저 알린다.",
    "meta": {
        "is_partial": true,
        "description": "Product Form - Notice Items Bulk Change Confirmation Modal"
    },
    "id": "notice_bulk_change_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-ecommerce.admin.product.notice.modals.bulk_change.title",
        "size": "medium",
        "footer": [
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "closeModal"
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "ecommerce:px-4 ecommerce:py-2 ecommerce:bg-white ecommerce:dark:bg-gray-800 ecommerce:text-gray-700 ecommerce:dark:text-gray-300 ecommerce:border ecommerce:border-gray-300 ecommerce:dark:border-gray-600 ecommerce:rounded-lg ecommerce:hover:bg-gray-50 ecommerce:dark:hover:bg-gray-700"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:common.cancel"
                    }
                ]
            },
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "comment": "확정 — 창이 직접 폼을 고치지 못하므로(별도 컨텍스트) 채울 값을 실어 사건으로 넘기고 닫는다. 실제 반영은 고시 구획이 받아서 한다",
                        "type": "click",
                        "handler": "sequence",
                        "actions": [
                            {
                                "handler": "emitEvent",
                                "params": {
                                    "event": "notice:productBulkChangeConfirmed",
                                    "data": {
                                        "form": "{{_global.tempFormForBulkChange}}"
                                    }
                                }
                            },
                            {
                                "handler": "closeModal"
                            }
                        ]
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "ecommerce:px-4 ecommerce:py-2 ecommerce:bg-blue-600 ecommerce:dark:bg-blue-600 ecommerce:text-white ecommerce:rounded-lg ecommerce:hover:bg-blue-700 ecommerce:dark:hover:bg-blue-700"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:sirsoft-ecommerce.admin.product.notice.modals.bulk_change.confirm"
                    }
                ]
            }
        ]
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "ecommerce-flex-start ecommerce:gap-3"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce:flex-shrink-0 ecommerce:mt-0.5"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "info-circle",
                                        "className": "ecommerce:text-xl ecommerce:text-blue-600 ecommerce:dark:text-blue-400"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "ecommerce:flex-1"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "ecommerce-text-primary ecommerce:text-base ecommerce:mb-2"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.product.notice.modals.bulk_change.message"
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "ecommerce:bg-gray-100 ecommerce:dark:bg-gray-700 ecommerce:rounded-lg ecommerce:p-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "ecommerce-text-label-subtle"
                                            },
                                            "text": "$t:sirsoft-ecommerce.admin.product.notice.modals.bulk_change.preview_label"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "ecommerce-text-primary ecommerce:font-medium ecommerce:mt-1"
                                            },
                                            "text": "$t:sirsoft-ecommerce.admin.product.notice.modals.bulk_change.preview_value"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "ecommerce:text-sm ecommerce:text-amber-700 ecommerce:dark:text-amber-400 ecommerce:mt-3"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.product.notice.modals.bulk_change.notice"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
