{
    "comment": "상품 폼 — 추가옵션 비우기 확인. 넣어 둔 추가옵션 줄이 모두 사라지므로 되묻는다",
    "meta": {
        "is_partial": true
    },
    "id": "additional_options_clear_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-ecommerce.common.confirm",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "text-center"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "triangle-exclamation",
                        "size": "3x",
                        "className": "text-amber-500 dark:text-amber-400 mx-auto mb-4"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-secondary"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.product.options.additional_clear_confirm"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex justify-end gap-3 mt-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "closeModal"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "variant": "secondary",
                        "className": "btn btn-outline",
                        "data-testid": "additional-clear-cancel"
                    },
                    "text": "$t:sirsoft-ecommerce.common.cancel"
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sirsoft-ecommerce.clearAdditionalOptions"
                        },
                        {
                            "type": "click",
                            "handler": "closeModal"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "variant": "danger",
                        "className": "btn btn-danger",
                        "data-testid": "additional-clear-confirm"
                    },
                    "text": "$t:sirsoft-ecommerce.common.confirm"
                }
            ]
        }
    ]
}
