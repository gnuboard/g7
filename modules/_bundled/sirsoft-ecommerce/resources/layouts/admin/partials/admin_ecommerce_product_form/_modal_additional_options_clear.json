{
    "comment": "상품 폼 — 추가옵션 비우기 확인. 넣어 둔 추가옵션 줄이 모두 사라지므로 되묻는다",
    "meta": {
        "is_partial": true
    },
    "id": "additional_options_clear_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-ecommerce.common.confirm",
        "size": "sm",
        "footer": [
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "closeModal"
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "ecommerce-btn ecommerce-btn-outline",
                    "data-testid": "additional-clear-cancel"
                },
                "text": "$t:sirsoft-ecommerce.common.cancel"
            },
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "sirsoft-ecommerce.clearAdditionalOptions"
                    },
                    {
                        "type": "click",
                        "handler": "closeModal"
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "ecommerce-btn ecommerce-btn-danger",
                    "data-testid": "additional-clear-confirm"
                },
                "text": "$t:sirsoft-ecommerce.common.confirm"
            }
        ]
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "ecommerce:text-center"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "triangle-exclamation",
                        "size": "3x",
                        "className": "ecommerce:text-amber-600 ecommerce:dark:text-amber-400 ecommerce:mx-auto ecommerce:mb-4"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "ecommerce-text-secondary"
                    },
                    "text": "$t:sirsoft-ecommerce.admin.product.options.additional_clear_confirm"
                }
            ]
        }
    ]
}
