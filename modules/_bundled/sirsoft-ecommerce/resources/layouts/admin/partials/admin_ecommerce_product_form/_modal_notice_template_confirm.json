{
    "comment": "상품 폼 — 고시 템플릿 적용 확인. 템플릿을 고르면 지금 넣어 둔 고시 내용이 템플릿 값으로 갈리므로\n  되묻는다. 고른 템플릿은 확정 전까지 전역에 대기시켜 두고, 어느 쪽으로 끝나든 그 자리를 비운다.",
    "meta": {
        "is_partial": true,
        "description": "Product Form - Notice Template Change Confirmation Modal"
    },
    "id": "notice_template_confirm_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-ecommerce.admin.product.notice.confirm_change_title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "alert-warning"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "triangle-exclamation",
                                "className": "text-xl text-amber-500 shrink-0 mt-0.5"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-sm font-medium text-warning-soft"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.product.notice.confirm_change_warning"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-warning-soft"
                                    },
                                    "text": "$t:sirsoft-ecommerce.admin.product.notice.confirm_change_description"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex justify-end gap-3"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "취소 — 대기시켜 둔 선택을 버린다(그대로 두면 다음에 창을 열 때 지난 선택이 적용된다)",
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "pendingNoticeTemplateId": null
                                            }
                                        },
                                        {
                                            "handler": "closeModal"
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "btn btn-outline"
                            },
                            "text": "$t:sirsoft-ecommerce.common.cancel"
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "확정 — 창을 닫고 대기 중이던 템플릿을 적용한 뒤 그 자리를 비운다",
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "closeModal"
                                        },
                                        {
                                            "handler": "sirsoft-ecommerce.selectNoticeTemplate",
                                            "params": {
                                                "templateId": "{{_global.pendingNoticeTemplateId}}"
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "pendingNoticeTemplateId": null
                                            }
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "btn btn-warning"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.product.notice.confirm_change_button"
                        }
                    ]
                }
            ]
        }
    ]
}
