                    "id": "shipping_policy_forbidden_notice",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{shipping_policies?.data?.unavailable === true}}",
                    "props": {
                        "className": "ecommerce:flex ecommerce:items-center ecommerce:gap-2 ecommerce:text-sm ecommerce:text-amber-700 ecommerce:dark:text-amber-300"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "circle-exclamation",
                                "className": "ecommerce:text-base"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:sirsoft-ecommerce.admin.product.selector_forbidden.shipping_policies"
                        }
                    ]
                },
                {
                    "id": "shipping_empty_state",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{shipping_policies?.data?.unavailable !== true && !_local.form.shipping_policy_id && (_computed.shippingPolicyOptions ?? []).length === 0}}",
                    "props": {
                        "className": "ecommerce:text-center ecommerce:py-8"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "truck",
                                "className": "ecommerce:text-5xl ecommerce:mx-auto ecommerce:text-gray-500 ecommerce:dark:text-gray-500 ecommerce:mb-3"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "ecommerce-text-label-subtle"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.product.shipping.empty_message"
                        },
                        {
                            "type": "basic",
                            "name": "A",
                            "actions": [
                                {
                                    "comment": "audit:allow layout-list-context-navigate-merge-query 상품 폼에서 배송정책 목록 클러스터로 나가는 이동이다 — 상품 목록의 페이지·필터를 물려주지 않는다.",
                                    "type": "click",
                                    "handler": "navigate"
                                }
                            ],
                            "props": {
                                "href": "/admin/ecommerce/shipping-policies/create",
                                "className": "ecommerce-button ecommerce:mt-3 ecommerce:px-4 ecommerce:py-2 ecommerce:bg-blue-600 ecommerce:dark:bg-blue-600 ecommerce:text-white ecommerce:rounded-lg ecommerce:text-sm ecommerce:hover:bg-blue-700 ecommerce:dark:hover:bg-blue-700"
                            },
                            "text": "$t:sirsoft-ecommerce.admin.product.buttons.create_shipping_policy"
                        }
                    ]
                }
            ]
        }
    ]
}
