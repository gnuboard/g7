                                "partial": "partials/admin_ecommerce_shipping_policy_form/_partial_claim_addresses.json"
                            },
                            {
                                "id": "country_settings_wrapper",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "row-stack"
                                },
                                "children": [
                                    {
                                        "partial": "partials/admin_ecommerce_shipping_policy_form/_partial_country_tabs.json"
                                    },
                                    {
                                        "partial": "partials/admin_ecommerce_shipping_policy_form/_partial_country_basic_fields.json"
                                    },
                                    {
                                        "partial": "partials/admin_ecommerce_shipping_policy_form/_partial_charge_settings.json"
                                    },
                                    {
                                        "partial": "partials/admin_ecommerce_shipping_policy_form/_partial_claim_country_fee.json"
                                    },
                                    {
                                        "partial": "partials/admin_ecommerce_shipping_policy_form/_partial_extra_fee.json"
                                    }
                                ]
                            },
                            {
                                "id": "footer_buttons",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "sticky-footer-buttons-between"
                                },
                                "children": [
                                    {
                                        "id": "footer_list_button",
                                        "type": "basic",
                                        "name": "Button",
                                        "actions": [
                                            {
                                                "comment": "목록으로. 보던 목록 상태를 이고 간다",
                                                "type": "click",
                                                "handler": "navigate",
                                                "params": {
                                                    "path": "/admin/ecommerce/shipping-policies",
                                                    "mergeQuery": true,
                                                    "query": {}
                                                }
                                            }
                                        ],
                                        "props": {
                                            "type": "button",
                                            "className": "flex-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 font-medium transition-colors"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "$t:common.list"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "footer_save_button",
                                        "type": "basic",
                                        "name": "Button",
                                        "actions": [
                                            {
                                                "comment": "저장 — 등록/수정 구분은 `route.id` 유무 하나로 엔드포인트와 메서드를 함께 가른다. 성공하면 목록으로 돌아가므로 폼을 되받아 채울 필요가 없고, 실패하면 서버 오류를 폼 위 배너로 넘긴다",
                                                "type": "click",
                                                "handler": "sequence",
                                                "actions": [
                                                    {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isSaving": true,
                                                            "errors": null
                                                        }
                                                    },
                                                    {
                                                        "comment": "savedPolicyId 는 '이 화면에서 방금 만든 정책' 이다. 신규 등록에서 정책 POST 는 성공했는데 뒤이은 회수지 PUT 이 거절되면 화면에 머무는데, route.id 는 여전히 비어 있어 다시 [저장] 을 누르면 같은 정책이 하나 더 생긴다. 첫 성공 시점에 그 id 를 붙잡아 재저장이 PUT 으로 가게 한다.",
                                                        "handler": "apiCall",
                                                        "target": "{{(route.id || _local.savedPolicyId) ? '/api/modules/sirsoft-ecommerce/admin/shipping-policies/' + (route.id || _local.savedPolicyId) : '/api/modules/sirsoft-ecommerce/admin/shipping-policies'}}",
                                                        "auth_required": true,
                                                        "params": {
                                                            "method": "{{(route.id || _local.savedPolicyId) ? 'PUT' : 'POST'}}",
                                                            "body": "{{_local.form}}"
                                                        },
                                                        "onSuccess": [
                                                            {
                                                                "comment": "저장 가드는 **체인 끝**에서 푼다. 회수지 요청이 이어지는 경우(dirty+loaded)에는 그 요청의 onSuccess/onError 가 풀고, 이어지지 않는 경우에만 여기서 푼다. 아래 토스트·이동의 `if` 가 같은 술어를 다시 읽어도 두 번 발화하지 않는 것은 실행 순서 때문이 아니라, 외곽 시퀀스가 내부 onSuccess 의 setState 결과를 자기 스냅샷에 반영하지 않기 때문이다(엔진의 시퀀스 스냅샷 격리). 엔진이 내부 상태를 외곽에 전파하도록 바뀌면 성공 경로에서 토스트·이동이 2회가 되므로 그때는 이 구조를 다시 본다. — `savedPolicyId` 는 **요청 주소를 정하는 값이지 '수정이었는가' 의 술어가 아니다.** 여기서 쓴 값은 같은 시퀀스의 뒤 액션 스냅샷에 병합되므로(`ActionDispatcher.handleSequence` 가 `__target:'local'` setState 결과를 `currentState` 에 합친다), 신규 등록에서도 이 줄 다음부터는 언제나 truthy 다. 토스트 문구가 이 값을 읽으면 새로 만든 정책에 '수정되었습니다' 가 나간다 — 그 판정은 `route.id`(이 화면에 무엇을 하러 들어왔는가) 하나로만 한다.",
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "isSaving": "{{_local.claimAddressesDirty === true && _local.claimAddresses?._loaded === true}}",
                                                                    "savedPolicyId": "{{route.id || response?.data?.id}}"
                                                                }
                                                            },
                                                            {
                                                                "comment": "회수지는 본 폼 PUT 이 받지 않는 축이라 별도 엔드포인트로 이어 저장한다. 운영자가 손대지 않았으면 요청 자체를 보내지 않는다. 지우기 판정은 **모든 칸이 비었을 때**만 내린다 — 필수 2칸만 비었다고 null 로 바꾸면 전화·우편번호가 남은 회수지가 확인창 없이 통째로 지워지고(전용 지우기 버튼에는 확인창이 있다), 반대로 전화만 친 상태는 오류 없이 버려진다. 일부만 채워진 입력은 그대로 보내 서버가 무엇이 빠졌는지 422 로 알려준다.",
                                                                "handler": "apiCall",
                                                                "target": "{{'/api/modules/sirsoft-ecommerce/admin/shipping-policies/' + (route.id || _local.savedPolicyId || response?.data?.id) + '/claim-settings'}}",
                                                                "if": "{{_local.claimAddressesDirty === true && _local.claimAddresses?._loaded === true}}",
                                                                "auth_required": true,
                                                                "params": {
                                                                    "method": "PUT",
                                                                    "body": {
                                                                        "addresses": {
                                                                            "exchange": "{{[_local.claimAddresses?.addresses?.exchange?.recipient_name, _local.claimAddresses?.addresses?.exchange?.address1, _local.claimAddresses?.addresses?.exchange?.address2, _local.claimAddresses?.addresses?.exchange?.zipcode, _local.claimAddresses?.addresses?.exchange?.phone].some(v => String(v ?? '').trim() !== '') ? _local.claimAddresses.addresses.exchange : null}}",
                                                                            "return": "{{[_local.claimAddresses?.addresses?.return?.recipient_name, _local.claimAddresses?.addresses?.return?.address1, _local.claimAddresses?.addresses?.return?.address2, _local.claimAddresses?.addresses?.return?.zipcode, _local.claimAddresses?.addresses?.return?.phone].some(v => String(v ?? '').trim() !== '') ? _local.claimAddresses.addresses.return : null}}"
                                                                        }
                                                                    }
                                                                },
                                                                "onSuccess": [
                                                                    {
                                                                        "comment": "회수지까지 끝났으므로 저장 가드를 여기서 푼다 (앞 setState 는 이 요청이 이어질 때 가드를 유지했다).",
                                                                        "handler": "setState",
                                                                        "params": {
                                                                            "target": "local",
                                                                            "isSaving": false,
                                                                            "claimAddressesDirty": false
                                                                        }
                                                                    },
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "success",
                                                                            "message": "{{route.id ? '$t:sirsoft-ecommerce.admin.shipping_policy.messages.updated' : '$t:sirsoft-ecommerce.admin.shipping_policy.messages.created'}}"
                                                                        }
                                                                    },
                                                                    {
                                                                        "handler": "navigate",
                                                                        "params": {
                                                                            "path": "/admin/ecommerce/shipping-policies",
                                                                            "mergeQuery": true,
                                                                            "query": {}
                                                                        }
                                                                    }
                                                                ],
                                                                "onError": [
                                                                    {
                                                                        "comment": "정책은 이미 저장됐고 회수지만 실패했다 — 목록으로 나가면 그 사실이 화면에서 사라지므로 남는다.",
                                                                        "handler": "setState",
                                                                        "params": {
                                                                            "target": "local",
                                                                            "isSaving": false,
                                                                            "errors": "{{error.errors}}"
                                                                        }
                                                                    },
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "error",
                                                                            "message": "{{error.message || '$t:sirsoft-ecommerce.admin.shipping_policy.messages.claim_settings_save_error'}}"
                                                                        }
                                                                    }
                                                                ]
                                                            },
                                                            {
                                                                "comment": "회수지를 손댔는데 조회가 성공하지 못한 경우 — 저장을 보내지 않았음을 알린다 (조용히 건너뛰면 운영자는 저장된 줄 안다).",
                                                                "handler": "toast",
                                                                "if": "{{_local.claimAddressesDirty === true && _local.claimAddresses?._loaded !== true}}",
                                                                "params": {
                                                                    "type": "warning",
                                                                    "message": "$t:sirsoft-ecommerce.admin.shipping_policy.messages.claim_settings_not_loaded"
                                                                }
                                                            },
                                                            {
                                                                "handler": "toast",
                                                                "if": "{{_local.claimAddressesDirty !== true}}",
                                                                "params": {
                                                                    "type": "success",
                                                                    "message": "{{route.id ? '$t:sirsoft-ecommerce.admin.shipping_policy.messages.updated' : '$t:sirsoft-ecommerce.admin.shipping_policy.messages.created'}}"
                                                                }
                                                            },
                                                            {
                                                                "handler": "navigate",
                                                                "if": "{{_local.claimAddressesDirty !== true}}",
                                                                "params": {
                                                                    "path": "/admin/ecommerce/shipping-policies",
                                                                    "mergeQuery": true,
                                                                    "query": {}
                                                                }
                                                            }
                                                        ],
                                                        "onError": [
                                                            {
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "isSaving": false,
                                                                    "errors": "{{error.errors}}"
                                                                }
                                                            },
                                                            {
                                                                "handler": "toast",
                                                                "params": {
                                                                    "type": "error",
                                                                    "message": "{{error.message || '$t:common.validation_error'}}"
                                                                }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ],
                                        "props": {
                                            "type": "button",
                                            "disabled": "{{_local.isSaving || _computed.isReadOnly}}",
                                            "className": "btn btn-primary flex-center gap-1.5"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Icon",
                                                "if": "{{_local.isSaving}}",
                                                "props": {
                                                    "name": "spinner",
                                                    "className": "spinner-sm"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "if": "{{!_local.isSaving}}",
                                                "text": "$t:sirsoft-ecommerce.common.save"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "if": "{{_local.isSaving}}",
                                                "text": "$t:sirsoft-ecommerce.common.saving"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "modals": [
        {
            "comment": "추가배송비 템플릿 만들기·고치기 — 정책 저장과 별개로 이 창에서 바로 서버에 반영된다",
            "partial": "partials/admin_ecommerce_shipping_policy_form/_modal_extra_fee_template.json"
