                                            ],
                                            "props": {
                                                "data-testid": "user-addresses-link",
                                                "className": "inline-flex items-center gap-1.5 px-3 py-2 text-sm bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "map-pin",
                                                        "className": "text-base"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-ecommerce.admin.user_ecommerce_data.view_addresses"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "view_member_inquiries",
                                            "type": "basic",
                                            "name": "A",
                                            "actions": [
                                                {
                                                    "type": "click",
                                                    "handler": "navigate",
                                                    "params": {
                                                        "path": "/admin/ecommerce/inquiries",
                                                        "query": {
                                                            "user_uuid": "{{user?.data?.uuid ?? ''}}"
                                                        }
                                                    }
                                                }
                                            ],
                                            "props": {
