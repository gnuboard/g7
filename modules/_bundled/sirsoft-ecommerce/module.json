{
    "identifier": "sirsoft-ecommerce",
    "vendor": "sirsoft",
    "name": {
        "ko": "이커머스",
        "en": "Ecommerce"
    },
    "version": "1.3.0",
    "license": "MIT",
    "description": {
        "ko": "그누보드7 이커머스 모듈 - 상품, 주문, 결제 관리",
        "en": "Gnuboard7 Ecommerce Module - Product, Order, Payment Management"
    },
    "g7_version": ">=7.1.0",
    "dependencies": {
        "modules": {},
        "plugins": {}
    },
    "integrations": {
        "modules": ["sirsoft-board"]
    },
    "github_url": "https://github.com/gnuboard/g7-module-sirsoft-ecommerce",
    "github_changelog_url": "https://github.com/gnuboard/g7-module-sirsoft-ecommerce/blob/main/CHANGELOG.md",
    "assets": {
        "js": {
            "entry": "resources/js/index.ts",
            "output": "dist/js/module.iife.js"
        },
        "css": {
            "entry": "resources/css/main.css",
            "output": "dist/css/module.css"
        },
        "handlers": true,
        "static": "resources/assets/"
    },
    "loading": {
        "strategy": "global",
        "priority": 100
    },
    "state_contracts": {
        "preferredCurrency": {
            "description": {
                "ko": "방문자가 고른 표시 통화 코드 (예: KRW, JPY). 결제 통화 판정과 결제 플러그인이 읽는다",
                "en": "Display currency chosen by the visitor (e.g. KRW, JPY). Read by checkout currency resolution and payment plugins"
            },
            "schema": {
                "type": "string"
            },
            "writers": [
                "@template"
            ]
        },
        "availableCurrencies": {
            "description": {
                "ko": "고를 수 있는 통화 목록",
                "en": "Currencies the visitor can choose"
            },
            "schema": {
                "type": "array"
            },
            "writers": [
                "@template"
            ]
        },
        "defaultCurrency": {
            "description": {
                "ko": "쇼핑몰 기본 통화 코드",
                "en": "Shop default currency code"
            },
            "schema": {
                "type": "string"
            },
            "writers": [
                "@template"
            ]
        },
        "preferredShippingCountry": {
            "description": {
                "ko": "방문자가 고른 배송 국가 코드",
                "en": "Shipping country chosen by the visitor"
            },
            "schema": {
                "type": "string"
            },
            "writers": [
                "@template"
            ]
        },
        "availableShippingCountries": {
            "description": {
                "ko": "고를 수 있는 배송 국가 목록",
                "en": "Shipping countries the visitor can choose"
            },
            "schema": {
                "type": "array"
            },
            "writers": [
                "@template"
            ]
        },
        "guestOrderToken": {
            "description": {
                "ko": "비회원 주문 조회 토큰 (조회 화면이 발급, 결제 플러그인의 영수증 조회가 읽는다). 로그아웃하면 비운다",
                "en": "Guest order lookup token (issued by the lookup screen, read by payment plugins for receipts). Cleared on logout"
            },
            "schema": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "writers": [
                "@template"
            ]
        },
        "activeEcommerceSettingsTab": {
            "description": {
                "ko": "쇼핑몰 환경설정 화면의 현재 탭 — 다른 확장이 그 화면에 끼운 조각이 읽는다",
                "en": "Current tab of the shop settings screen — read by other extensions' fragments placed on that screen"
            },
            "schema": {
                "type": "string"
            },
            "writers": []
        }
    }
}
