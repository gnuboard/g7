                        {
                            "id": "permissions_error_alert",
                            "type": "basic",
                            "name": "Div",
                            "if": "{{ !!route?.slug && (_local.errors?.permissions || Object.keys(_local.errors ?? {}).some(k => k.startsWith('permissions.'))) }}",
                            "props": {
                                "className": "alert-danger items-start mb-6"
