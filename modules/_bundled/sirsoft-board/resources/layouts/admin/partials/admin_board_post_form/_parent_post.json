{
    "comment": "답글을 쓸 때만 뜨는 원글 요약. 「원글이 있는가」를 두 곳에서 함께 본다 — 폼 데이터의 `parent_id` 와 URL 의 `parent_id`(새로 답글을 여는 순간에는 폼에 아직 값이 없다). 실제로 보여줄 내용은 `form_meta` 가 준다",
    "meta": {
        "is_partial": true,
        "description": "Post Form - Parent Post Information (답글 작성 시에만 표시)"
    },
    "id": "parent_post_card",
    "type": "basic",
    "name": "Div",
    "if": "{{(form_data?.data?.parent_id || query?.parent_id) && form_meta?.data?.parent_post?.id}}",
    "props": {
        "className": "board:bg-white board:dark:bg-gray-700 board:border board:border-gray-200 board:dark:border-gray-600 board:rounded-lg board:p-4 board:mb-6"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "board-flex-center board:gap-2 board:mb-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "reply",
                        "className": "board:text-base board:text-blue-600 board:dark:text-blue-400"
                    }
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "board-text-primary board:text-sm board:font-semibold"
                    },
                    "text": "$t:sirsoft-board.admin.posts.form.reply_to"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{form_meta?.data?.parent_post?.is_notice}}",
                    "props": {
                        "className": "board:text-xs board-tone-danger board:inline-flex board:items-center board:px-2 board:py-0.5 board:rounded board:font-medium board:bg-red-100 board:dark:bg-red-900"
                    },
                    "text": "$t:sirsoft-board.admin.posts.notice"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{form_meta?.data?.parent_post?.is_secret}}",
                    "props": {
                        "className": "board:text-xs board-tone-warning board:inline-flex board:items-center board:px-2 board:py-0.5 board:rounded board:font-medium board:bg-yellow-100 board:dark:bg-yellow-900"
                    },
                    "text": "$t:sirsoft-board.admin.posts.secret"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "board-flex-center board:gap-2 board:mb-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H4",
                    "props": {
                        "className": "board-section-heading-md"
                    },
                    "text": "{{form_meta?.data?.parent_post?.title}}"
                },
                {
                    "type": "basic",
                    "name": "A",
                    "props": {
                        "href": "/admin/board/{{route.slug}}/{{form_meta?.data?.parent_post?.id}}",
                        "title": "$t:sirsoft-board.admin.posts.form.view_original",
                        "className": "board:text-blue-600 board:dark:text-blue-400 board:hover:text-blue-700 board:dark:hover:text-blue-300 board:transition-colors"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "arrow-up-right-from-square",
                                "className": "board:text-sm"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "board-flex-center board:gap-2 board-text-tertiary board:mb-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Span",
                    "text": "{{form_meta?.data?.parent_post?.author?.name ?? '$t:sirsoft-board.admin.posts.unknown_author'}}"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "text": "·"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "text": "{{form_meta?.data?.parent_post?.created_at}}"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{form_meta?.data?.parent_post?.content}}",
            "props": {
                "className": "board:bg-gray-50 board:dark:bg-gray-800 board:border board:border-gray-200 board:dark:border-gray-700 board:rounded board:p-3"
            },
            "children": [
                {
                    "id": "ext_html_content",
                    "type": "extension_point",
                    "name": "html_content",
                    "props": {
                        "content": "{{form_meta?.data?.parent_post?.content}}",
                        "isHtml": "{{(form_meta?.data?.parent_post?.content_mode ?? 'text') === 'html'}}",
                        "className": "{{_local.parentPostExpanded ? '' : 'board:line-clamp-3'}} board:text-sm board:text-gray-600 board:dark:text-gray-300 board:mb-2"
                    },
                    "default": [
                        {
                            "type": "composite",
                            "name": "HtmlContent",
                            "props": {
                                "content": "{{form_meta?.data?.parent_post?.content}}",
                                "isHtml": "{{(form_meta?.data?.parent_post?.content_mode ?? 'text') === 'html'}}",
                                "className": "{{_local.parentPostExpanded ? '' : 'board:line-clamp-3'}} board:text-sm board:text-gray-600 board:dark:text-gray-300 board:mb-2"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "if": "{{(form_meta?.data?.parent_post?.content?.length ?? 0) > 150}}",
                    "actions": [
                        {
                            "comment": "원글 본문을 세 줄에서 전문으로 펼친다 — 답글을 쓰는 화면이라 원글은 참고용이고, 버튼은 원글이 150자를 넘을 때만 나온다",
                            "type": "click",
                            "handler": "setState",
                            "params": {
                                "target": "local",
                                "parentPostExpanded": "{{!_local.parentPostExpanded}}"
                            }
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "board-flex-center board:text-xs board:text-blue-600 board:dark:text-blue-400 board:hover:text-blue-700 board:dark:hover:text-blue-300 board:font-medium board:transition-colors board:gap-1"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_local.parentPostExpanded ? '$t:sirsoft-board.admin.posts.form.hide_content' : '$t:sirsoft-board.admin.posts.form.show_full_content'}}"
                        },
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "{{_local.parentPostExpanded ? 'chevron-up' : 'chevron-down'}}",
                                "className": "board:text-xs"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
