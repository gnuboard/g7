                    "props": {
                        "className": "mt-1.5 px-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-center flex-wrap gap-x-4 gap-y-2 text-label-subtle"
