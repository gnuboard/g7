                            "name": "Span",
                            "if": "{{comment.depth > 0}}",
                            "props": {
                                "className": "text-gray-400 dark:text-gray-500 flex-shrink-0 text-sm"
                            },
                            "text": "↳"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-1 min-w-0"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-center gap-2"
                                    },
                                    "children": [
                                        {
                                            "id": "author_name_menu_{{comment.id}}",
                                            "type": "composite",
                                            "name": "ActionMenu",
                                            "if": "{{!comment?.author?.is_guest}}",
                                            "actions": [
                                                {
                                                    "comment": "글쓴이 이름을 누르면 그 회원의 관리자 상세로 — 비회원은 이 메뉴 자체가 없다(uuid 가 없어 갈 곳이 없다)",
                                                    "type": "click",
                                                    "event": "onItemClick",
                                                    "handler": "switch",
                                                    "cases": {
                                                        "view_user_info": {
                                                            "handler": "navigate",
                                                            "params": {
                                                                "path": "/admin/users/{{comment?.author?.uuid}}"
                                                            }
                                                        }
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "triggerLabel": "{{comment?.author?.name}}",
                                                "triggerIconName": "",
                                                "triggerClassName": "font-semibold text-gray-900 dark:text-white",
                                                "position": "right",
                                                "items": [
                                                    {
                                                        "id": "view_user_info",
                                                        "label": "$t:sirsoft-board.admin.posts.detail.user_info",
                                                        "iconName": "user"
                                                    }
                                                ]
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{comment?.author?.is_guest}}",
