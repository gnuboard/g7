                                        },
                                        "restore": {
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "restore_modal_data": {
                                                            "id": "{{comment?.id}}",
                                                            "slug": "{{route.slug}}",
                                                            "type": "comment"
                                                        }
                                                    }
                                                },
                                                {
                                                    "handler": "openModal",
                                                    "target": "restore_modal"
                                                }
                                            ]
                                        },
                                        "delete": {
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "modal_data": {
                                                            "id": "{{comment?.id}}",
                                                            "type": "comment"
                                                        }
                                                    }
                                                },
