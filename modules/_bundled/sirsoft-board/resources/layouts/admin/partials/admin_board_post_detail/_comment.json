                                            },
                                            "text": "{{comment?.author?.name}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{comment?.author?.email}}",
                                            "props": {
                                                "className": "text-tertiary"
                                            },
                                            "text": "({{comment?.author?.email}})"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{comment?.author.is_guest}}",
                                            "props": {
                                                "className": "inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300"
                                            },
                                            "text": "$t:sirsoft-board.admin.posts.guest"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{comment?.author.is_admin}}",
                                            "props": {
                                                "className": "inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400"
                                            },
                                            "text": "$t:sirsoft-board.admin.posts.detail.admin_badge"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-tertiary"
                                            },
                                            "text": "· {{comment?.created_at}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{comment?.ip_address}}",
                                            "props": {
                                                "className": "text-tertiary"
                                            },
                                            "text": "· IP: {{comment?.ip_address}}"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "comment_right_section_{{comment.id}}",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex-center gap-2 flex-shrink-0"
                    },
                    "children": [
                        {
                            "id": "reply_button_{{comment.id}}",
                            "type": "basic",
                            "name": "Button",
                            "if": "{{post?.data?.board?.use_reply && (comment?.depth ?? 0) < (post?.data?.board?.max_comment_depth ?? 10) && comment?.status !== 'blinded' && comment?.status !== 'deleted' && !comment?.deleted_at && post?.data?.status !== 'blinded' && post?.data?.status !== 'deleted' && !post?.data?.deleted_at}}",
                            "actions": [
                                {
                                    "comment": "이 댓글 아래에 답글 칸을 열고 닫는다(같은 버튼을 다시 누르면 닫힌다). 열면서 편집 중이던 다른 댓글은 닫는다 — 한 화면에서 편집과 답글이 동시에 열려 있으면 어느 쪽이 저장되는지 알기 어렵다",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "replyingTo": "{{_local.replyingTo === comment?.id ? null : comment?.id}}",
                                        "editingComment": null,
                                        "replySubmitting": false,
                                        "reply_comment_content": ""
                                    }
                                }
                            ],
                            "props": {
                                "className": "text-tertiary inline-flex items-center gap-1 px-2 py-1 font-medium hover:text-gray-700 dark:hover:text-gray-300 hover:bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-700 rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed",
                                "disabled": "{{post?.data?.abilities?.can_write_comments !== true}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "comment",
                                        "className": "text-sm"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-board.admin.posts.detail.reply"
                                }
                            ]
                        },
                        {
                            "comment": "신고 버튼 — 미신고 상태 (모달 오픈)",
                            "id": "report_button_{{comment.id}}",
                            "type": "basic",
                            "name": "Button",
                            "if": "{{post?.data?.board?.use_report && comment?.author?.uuid !== current_user?.data?.uuid && comment?.status !== 'blinded' && comment?.status !== 'deleted' && !comment?.deleted_at && !comment?.is_already_reported}}",
                            "actions": [
                                {
                                    "comment": "이 댓글을 신고 대상으로 지목한 «뒤» 신고 창을 연다 — 모달은 별도 컨텍스트라 `comment` 를 볼 수 없어 전역에 실어 건네야 한다. 글쓴이 이름도 함께 넘겨 창에서 「누구의 댓글」인지 보여준다",
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "modal_data": {
                                                    "id": "{{comment?.id}}",
                                                    "type": "comment",
                                                    "author": "{{comment?.author?.name}}"
                                                }
                                            }
                                        },
                                        {
                                            "handler": "openModal",
                                            "target": "report_modal"
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "className": "text-tertiary inline-flex items-center gap-1 px-2 py-1 font-medium hover:text-gray-700 dark:hover:text-gray-300 hover:bg-gray-100 dark:bg-gray-700 dark:hover:bg-gray-700 rounded transition-colors"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "flag",
                                        "className": "text-sm"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-board.admin.posts.detail.report"
                                }
                            ]
                        },
                        {
                            "comment": "신고 버튼 — 이미 신고한 상태 (클릭 불가)",
                            "type": "basic",
                            "name": "Button",
                            "if": "{{post?.data?.board?.use_report && comment?.author?.uuid !== current_user?.data?.uuid && comment?.status !== 'blinded' && comment?.status !== 'deleted' && !comment?.deleted_at && comment?.is_already_reported}}",
                            "props": {
                                "disabled": true,
                                "className": "text-hint inline-flex items-center gap-1 px-2 py-1 font-medium rounded cursor-not-allowed opacity-60"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "flag",
                                        "className": "text-sm"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-board.admin.posts.detail.reported"
                                }
                            ]
                        },
                        {
                            "id": "comment_action_menu_{{comment.id}}",
                            "type": "composite",
                            "name": "ActionMenu",
                            "actions": [
                                {
                                    "comment": "댓글 점 메뉴 — 편집만 이 자리에서 바로 열고(지역 상태), 가리기·되살리기·삭제 셋은 대상을 전역에 실은 뒤 각자의 확인 창을 연다. 세 창이 서로 다른 키를 쓰는 이유는 겹쳐 열릴 때 대상이 섞이지 않게 하기 위해서다",
                                    "type": "click",
                                    "event": "onItemClick",
                                    "handler": "switch",
                                    "cases": {
                                        "edit": {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "editingComment": "{{comment?.id}}",
                                                "editingCommentPostId": "{{comment?.post_id}}",
                                                "edit_comment_content": "{{comment?.content}}",
                                                "replyingTo": null,
                                                "editSubmitting": false
                                            }
                                        },
                                        "blind": {
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "blind_modal_data": {
                                                            "id": "{{comment?.id}}",
                                                            "slug": "{{route.slug}}",
                                                            "type": "comment"
                                                        }
                                                    }
                                                },
                                                {
                                                    "handler": "openModal",
                                                    "target": "blind_modal"
                                                }
