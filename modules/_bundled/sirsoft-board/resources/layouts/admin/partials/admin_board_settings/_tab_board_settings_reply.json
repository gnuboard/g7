{
    "comment": "「기본값」 탭의 답변글 구획 — 새 게시판이 답글을 받을지, 받는다면 몇 단까지 이어 붙일지. 댓글 깊이와는 다른 축이다(이쪽은 글이 글에 달리는 것)",
    "meta": {
        "is_partial": true,
        "description": "게시판 설정 > 답변글 탭"
    },
    "id": "reply",
    "type": "basic",
    "name": "Div",
    "if": "{{(_global.activeBoardSettingsTab || query.tab || 'general') === 'basic_defaults'}}",
    "classMap": {
        "key": "{{_computed.isReadOnly ? 'readonly' : 'normal'}}",
        "variants": {
            "readonly": "opacity-60",
            "normal": ""
        }
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "id": "section_reply",
                    "type": "layout",
                    "name": "SectionLayout",
                    "props": {
                        "className": "admin-card"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "H3",
                            "props": {
                                "className": "card-title"
                            },
                            "text": "$t:sirsoft-board.admin.settings.sections.reply"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "row-stack"
                            },
                            "children": [
                                {
                                    "id": "field_use_reply",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": ""
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-center gap-4"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Label",
                                                    "props": {
                                                        "className": "flex-start gap-2 text-heading flex-1 cursor-pointer"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Input",
                                                            "actions": [
                                                                {
                                                                    "comment": "「답변글 사용 여부」를 일괄 적용 대상에 넣었다 뺐다 한다",
                                                                    "type": "change",
                                                                    "handler": "setState",
                                                                    "params": {
                                                                        "target": "local",
                                                                        "bulkApplyFields": "{{(_local.bulkApplyFields ?? []).includes('use_reply') ? (_local.bulkApplyFields ?? []).filter(f => f !== 'use_reply') : [...(_local.bulkApplyFields ?? []), 'use_reply']}}"
                                                                    }
                                                                }
                                                            ],
                                                            "props": {
                                                                "type": "checkbox",
                                                                "className": "checkbox-aligned",
                                                                "checked": "{{(_local.bulkApplyFields ?? []).includes('use_reply')}}",
                                                                "disabled": "{{!_computed.canBulkApply}}"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Div",
                                                            "children": [
                                                                {
                                                                    "type": "basic",
                                                                    "name": "Span",
                                                                    "text": "$t:sirsoft-board.admin.settings.fields.use_reply"
                                                                },
                                                                {
                                                                    "type": "basic",
                                                                    "name": "P",
                                                                    "props": {
                                                                        "className": "text-field-hint"
                                                                    },
                                                                    "text": "$t:sirsoft-board.admin.settings.fields.descriptions.use_reply"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "composite",
                                                    "name": "Toggle",
                                                    "props": {
                                                        "name": "basic_defaults.use_reply",
                                                        "className": "flex-shrink-0",
                                                        "disabled": "{{_computed.isReadOnly}}"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "field_max_reply_depth",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": ""
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-center gap-4"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Label",
                                                    "props": {
                                                        "className": "flex-start gap-2 text-body font-medium flex-1 cursor-pointer"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Input",
                                                            "actions": [
                                                                {
                                                                    "comment": "「답변글을 몇 단까지 이어 붙일지」를 일괄 적용 대상에 넣었다 뺐다 한다",
                                                                    "type": "change",
                                                                    "handler": "setState",
                                                                    "params": {
                                                                        "target": "local",
                                                                        "bulkApplyFields": "{{(_local.bulkApplyFields ?? []).includes('max_reply_depth') ? (_local.bulkApplyFields ?? []).filter(f => f !== 'max_reply_depth') : [...(_local.bulkApplyFields ?? []), 'max_reply_depth']}}"
                                                                    }
                                                                }
                                                            ],
                                                            "props": {
                                                                "type": "checkbox",
                                                                "className": "checkbox-aligned",
                                                                "checked": "{{(_local.bulkApplyFields ?? []).includes('max_reply_depth')}}",
                                                                "disabled": "{{!_computed.canBulkApply}}"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Div",
                                                            "children": [
                                                                {
                                                                    "type": "basic",
                                                                    "name": "Span",
                                                                    "text": "$t:sirsoft-board.admin.settings.fields.max_reply_depth"
                                                                },
                                                                {
                                                                    "type": "basic",
                                                                    "name": "P",
                                                                    "props": {
                                                                        "className": "text-field-hint"
                                                                    },
                                                                    "text": "$t:sirsoft-board.admin.settings.fields.descriptions.max_reply_depth|min={{_local?.form?._meta?.limits?.max_reply_depth_min ?? 1}}|max={{_local?.form?._meta?.limits?.max_reply_depth_max ?? 10}}"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "props": {
                                                        "className": "flex-shrink-0"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Input",
                                                            "props": {
                                                                "type": "number",
                                                                "name": "basic_defaults.max_reply_depth",
                                                                "min": "{{_local?.form?._meta?.limits?.max_reply_depth_min ?? 1}}",
                                                                "max": "{{_local?.form?._meta?.limits?.max_reply_depth_max ?? 10}}",
                                                                "className": "{{(_local.errors?.['basic_defaults.max_reply_depth']) ? 'w-32 input-error' : 'w-32'}}",
                                                                "disabled": "{{_computed.isReadOnly}}"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "if": "{{_local.errors?.['basic_defaults.max_reply_depth']}}",
                                                            "props": {
                                                                "className": "text-xs text-red-600 dark:text-red-400 block mt-1"
                                                            },
                                                            "text": "{{(Array.isArray(_local.errors?.['basic_defaults.max_reply_depth']) ? _local.errors['basic_defaults.max_reply_depth'][0] : _local.errors?.['basic_defaults.max_reply_depth']) ?? ''}}"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "field_reply_delete_policy",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": ""
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-center gap-4"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Label",
                                                    "props": {
                                                        "className": "flex-start gap-2 text-body font-medium flex-1 cursor-pointer"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Input",
                                                            "actions": [
                                                                {
                                                                    "comment": "이 항목을 일괄 적용 대상에 넣고 뺀다. 배열에서 빼고 다시 넣는 식이라 같은 값이 두 번 들어가지 않는다",
                                                                    "type": "change",
                                                                    "handler": "setState",
                                                                    "params": {
                                                                        "target": "local",
                                                                        "bulkApplyFields": "{{(_local.bulkApplyFields ?? []).includes('reply_delete_policy') ? (_local.bulkApplyFields ?? []).filter(f => f !== 'reply_delete_policy') : [...(_local.bulkApplyFields ?? []), 'reply_delete_policy']}}"
                                                                    }
                                                                }
                                                            ],
                                                            "props": {
                                                                "type": "checkbox",
                                                                "className": "checkbox-aligned",
                                                                "checked": "{{(_local.bulkApplyFields ?? []).includes('reply_delete_policy')}}",
                                                                "disabled": "{{!_computed.canBulkApply}}"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Div",
                                                            "children": [
                                                                {
                                                                    "type": "basic",
                                                                    "name": "Span",
                                                                    "text": "$t:sirsoft-board.admin.settings.fields.reply_delete_policy"
                                                                },
                                                                {
                                                                    "type": "basic",
                                                                    "name": "P",
                                                                    "props": {
                                                                        "className": "text-field-hint"
                                                                    },
                                                                    "text": "$t:sirsoft-board.admin.settings.fields.descriptions.reply_delete_policy"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Select",
                                                    "props": {
                                                        "name": "basic_defaults.reply_delete_policy",
                                                        "className": "w-48 flex-shrink-0 text-sm",
                                                        "disabled": "{{_computed.isReadOnly}}",
                                                        "options": [
                                                            {
                                                                "value": "cascade",
                                                                "label": "$t:sirsoft-board.admin.settings.options.reply_delete_policy.cascade"
                                                            },
                                                            {
                                                                "value": "block",
                                                                "label": "$t:sirsoft-board.admin.settings.options.reply_delete_policy.block"
                                                            }
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
