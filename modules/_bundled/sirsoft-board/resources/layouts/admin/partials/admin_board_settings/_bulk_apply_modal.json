                            "props": {
                                "className": "max-h-48 overflow-y-auto"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{!(_global.bulkApplySnapshot?.fields ?? []).length}}",
                                    "props": {
                                        "className": "block p-3 text-sm text-gray-400 dark:text-gray-500 italic"
                                    },
                                    "text": "$t:sirsoft-board.admin.settings.bulk_apply_modal.no_fields"
                                },
                                {
                                    "comment": "섹션별 그루핑 iteration. 표현식 평가기는 콜백 안의 멤버 대입(grouped[sk] = [] / .push())을 허용하지 않는다 — 쓰면 식 전체가 평가에 실패해 iteration source 가 배열이 아니게 되고, 이 목록이 오류 없이 통째로 렌더되지 않는다. 누산기 없이 map + filter 로만 구성한다.",
                                    "type": "basic",
                                    "name": "Div",
                                    "iteration": {
                                        "source": "(function() { const fields = _global.bulkApplySnapshot?.fields ?? []; const sectionMap = { type:'basic', show_view_count:'basic', secret_mode:'basic', use_comment:'basic', use_reply:'basic', use_report:'basic', use_reaction:'basic', use_comment_reaction:'basic', use_scrap:'basic', per_page:'list', per_page_mobile:'list', order_by:'list', order_direction:'list', min_title_length:'post', max_title_length:'post', min_content_length:'post', max_content_length:'post', max_reply_depth:'post', blocked_keywords:'post', new_display_hours:'post', comment_order:'comment', min_comment_length:'comment', max_comment_length:'comment', max_comment_depth:'comment', use_file_upload:'attachment', max_file_size:'attachment', max_file_count:'attachment', allowed_extensions:'attachment', notify_admin_on_post:'notification', notify_author:'notification', manager:'permissions' }; const sectionOrder = ['basic','list','post','comment','attachment','notification','permissions']; return sectionOrder.map(sk => ({ sectionKey: sk, items: fields.filter(k => (k.includes('.') ? 'permissions' : (sectionMap[k] ?? 'basic')) === sk) })).filter(g => g.items.length > 0); })()",
                                        "item_var": "sectionGroup"
                                    },
                                    "props": {
                                        "className": "border-b board-bulk-apply-group last:border-b-0"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "px-3 py-1.5 bg-gray-100 dark:bg-gray-700"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-xs font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wide"
                                                    },
                                                    "text": "$t:sirsoft-board.admin.settings.sections.{{sectionGroup.sectionKey}}"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "px-3 py-2 flex flex-wrap gap-1.5"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "iteration": {
                                                        "source": "sectionGroup.items",
                                                        "item_var": "fieldKey"
                                                    },
                                                    "props": {
                                                        "className": "inline-flex items-center px-2 py-0.5 bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-200 text-xs rounded"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "if": "{{!fieldKey.includes('.') && fieldKey !== 'manager'}}",
                                                            "text": "$t:sirsoft-board.admin.settings.bulk_apply.field_labels.{{fieldKey}}"
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "if": "{{fieldKey.includes('.') || fieldKey === 'manager'}}",
                                                            "text": "$t:sirsoft-board.board.permissions.{{fieldKey}}"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "comment": "선택된 게시판 목록 (전체/선택 무관 항상 표시)",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "toggle-group"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "px-4 py-2.5 bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700 flex-center gap-2"
