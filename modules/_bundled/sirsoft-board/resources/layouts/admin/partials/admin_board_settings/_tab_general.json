        {
            "id": "general_section",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "admin-card"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                        "className": "card-title"
                    },
                    "text": "$t:sirsoft-board.admin.settings.sections.general"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "card-description"
                    },
                    "text": "$t:sirsoft-board.admin.settings.sections.general_description"
                },
                {
                    "id": "date_display_format_field",
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
