                        {
                            "id": "privacy_guest_retention_days_field",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-center"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "form-label"
                                            },
                                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.guest_retention_days"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-tertiary"
                                    },
                                    "text": "$t:sirsoft-board.admin.settings.privacy_retention.guest_retention_days_hint"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "number",
                                        "name": "privacy_retention.guest_retention_days",
                                        "min": "{{_local?.form?._meta?.limits?.privacy_guest_retention_days_min ?? 0}}",
                                        "max": "{{_local?.form?._meta?.limits?.privacy_guest_retention_days_max ?? 3650}}",
                                        "className": "input w-40 {{_local.errors?.['privacy_retention.guest_retention_days'] ? 'input-error' : ''}}",
                                        "disabled": "{{_computed.isReadOnly}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{_local.errors?.['privacy_retention.guest_retention_days']}}",
                                    "props": {
                                        "className": "form-error"
                                    },
                                    "text": "{{_local.errors?.['privacy_retention.guest_retention_days']?.[0] ?? ''}}"
                                }
                            ]
                        },
                        {
                            "id": "privacy_guest_mode_field",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "space-y-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:sirsoft-board.admin.settings.privacy_retention.guest_mode"
                                },
                                {
                                    "type": "composite",
                                    "name": "RadioGroup",
                                    "props": {
                                        "name": "privacy_retention.guest_mode",
                                        "inline": true,
                                        "size": "md",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "options": [
                                            {
                                                "value": "anonymize",
                                                "label": "$t:sirsoft-board.admin.settings.privacy_retention.modes.anonymize"
                                            },
                                            {
                                                "value": "delete",
                                                "label": "$t:sirsoft-board.admin.settings.privacy_retention.modes.delete"
                                            }
                                        ]
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-tertiary"
                                    },
                                    "text": "$t:sirsoft-board.admin.settings.privacy_retention.guest_mode_hint"
                                },
                                {
                                    "id": "privacy_guest_delete_warning",
                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{_local.form?.privacy_retention?.guest_mode === 'delete'}}",
                                    "props": {
                                        "className": "text-error-soft"
                                    },
                                    "text": "$t:sirsoft-board.admin.settings.privacy_retention.delete_warning"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-hint"
                            },
                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.preview_hint"
                        }
                    ]
                },
                {
                    "id": "privacy_withdrawn_notice",
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-hint mt-4"
                    },
                    "text": "$t:sirsoft-board.admin.settings.privacy_retention.withdrawn_notice"
                }
            ]
        }
    ]
}
