                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-1 min-w-0"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-primary block text-sm font-semibold"
                                                    },
                                                    "text": "$t:sirsoft-board.admin.settings.options.date_display_format.standard"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "block text-tertiary mt-0.5"
                                                    },
                                                    "text": "$t:sirsoft-board.admin.settings.options.date_display_format.standard_description"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "block text-xs font-mono text-blue-600 dark:text-blue-400 mt-1.5 bg-blue-50 dark:bg-blue-900/30 rounded px-2 py-1"
                                                    },
                                                    "text": "$t:sirsoft-board.admin.settings.options.date_display_format.standard_example"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "date_format_option_relative",
                                    "type": "basic",
                                    "name": "Div",
                                    "actions": [
                                        {
                                            "comment": "날짜를 「3일 전」처럼 지금과의 사이로 적는 방식 — 위 카드와 같은 짜임이고 담기는 값만 다르다",
                                            "type": "click",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "hasChanges": true,
                                                "form.display.date_display_format": "relative"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "className": "{{(_local.form?.display?.date_display_format ?? 'standard') === 'relative' ? 'flex items-start gap-4 p-4 rounded-lg border-2 border-blue-500 bg-blue-50 dark:bg-blue-900/20 cursor-pointer' : 'flex items-start gap-4 p-4 rounded-lg border-2 border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 cursor-pointer hover:border-gray-300 dark:hover:border-gray-600'}}"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "actions": [
                                                {
                                                    "comment": "날짜를 「3일 전」 같은 상대 표기로 보여 준다",
                                                    "type": "change",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "hasChanges": true,
                                                        "form.display.date_display_format": "relative"
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "type": "radio",
                                                "name": "display.date_display_format",
                                                "value": "relative",
                                                "className": "radio mt-0.5",
                                                "disabled": "{{_computed.isReadOnly}}",
                                                "checked": "{{(_local.form?.display?.date_display_format ?? 'standard') === 'relative'}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-1 min-w-0"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-primary block text-sm font-semibold"
                                                    },
                                                    "text": "$t:sirsoft-board.admin.settings.options.date_display_format.relative"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "block text-tertiary mt-0.5"
                                                    },
                                                    "text": "$t:sirsoft-board.admin.settings.options.date_display_format.relative_description"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "block text-xs font-mono text-blue-600 dark:text-blue-400 mt-1.5 bg-blue-50 dark:bg-blue-900/30 rounded px-2 py-1"
                                                    },
                                                    "text": "$t:sirsoft-board.admin.settings.options.date_display_format.relative_example"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "attachment_cleanup_section",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "admin-card mt-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                        "className": "card-title"
                    },
                    "text": "$t:sirsoft-board.admin.settings.sections.attachment_cleanup"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "card-description"
                    },
                    "text": "$t:sirsoft-board.admin.settings.sections.attachment_cleanup_description"
                },
                {
                    "id": "attachment_purge_enabled_field",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "mt-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "form-label"
                            },
                            "text": "$t:sirsoft-board.admin.settings.fields.attachment_purge_enabled"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-tertiary"
                            },
                            "text": "$t:sirsoft-board.admin.settings.fields.attachment_purge_enabled_hint"
                        },
                        {
                            "type": "composite",
                            "name": "Toggle",
                            "actions": [
                                {
                                    "comment": "오래된 첨부 자동 정리 사용 여부. 켜야 아래 보관 일수가 쓰인다",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "hasChanges": true,
                                        "form.attachment_settings.purge_enabled": "{{$event.target.checked}}"
                                    }
                                }
                            ],
                            "props": {
                                "name": "attachment_settings.purge_enabled",
                                "disabled": "{{_computed.isReadOnly}}",
                                "checked": "{{!!_local.form?.attachment_settings?.purge_enabled}}"
                            }
                        }
                    ]
                },
                {
                    "id": "attachment_purge_retention_days_field",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "mt-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "form-label"
                            },
                            "text": "$t:sirsoft-board.admin.settings.fields.attachment_purge_retention_days"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-tertiary"
                            },
                            "text": "$t:sirsoft-board.admin.settings.fields.attachment_purge_retention_days_hint"
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "actions": [
                                {
                                    "comment": "첨부 보관 일수. 이 기간이 지난 첨부가 정리 대상이 된다",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "hasChanges": true,
                                        "form.attachment_settings.purge_retention_days": "{{$event.target.value}}"
                                    }
                                }
                            ],
                            "props": {
                                "type": "number",
                                "name": "attachment_settings.purge_retention_days",
                                "min": "{{_local?.form?._meta?.limits?.attachment_purge_retention_days_min ?? 1}}",
                                "max": "{{_local?.form?._meta?.limits?.attachment_purge_retention_days_max ?? 3650}}",
                                "className": "input w-40",
                                "disabled": "{{_computed.isReadOnly}}",
                                "value": "{{_local.form?.attachment_settings?.purge_retention_days ?? 30}}"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "comment": "개인정보 보유기간 (이슈 #636) — 네 칸 모두 `name` 바인딩만 쓴다(코어 개인정보 탭과 같은 패턴). 토글에만 명시 set-state 를 섞으면 방식 라디오의 이름 바인딩이 그 카테고리를 옛 값으로 되써 토글이 꺼지고 기간 칸이 사라진다(E2E 실측). 작성 IP 축(회원 글 포함 전 게시물)과 비회원 작성자 정보 축을 기간을 따로 두어 나눈다. 켜는 순간부터 되돌릴 수 없는 파기가 일어나므로 처리방침 사전 안내 의무와 삭제 방식의 연쇄 영향을 함께 적는다. 대상 건수는 저장된 설정 기준(코어 보유기간 커맨드의 dry-run 과 같은 조건식)이고, 꺼진 축도 서버가 세어 뱃지가 보인다 — 뱃지가 숨는 것은 응답을 받기 전(fallback null)뿐이다",
            "id": "privacy_retention_section",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "admin-card mt-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                        "className": "card-title"
                    },
                    "text": "$t:sirsoft-board.admin.settings.privacy_retention.title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "card-description"
                    },
                    "text": "$t:sirsoft-board.admin.settings.privacy_retention.description"
                },
                {
                    "id": "privacy_retention_enabled_field",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "mt-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "form-label"
                            },
                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.enabled"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-tertiary"
                            },
                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.enabled_hint"
                        },
                        {
                            "type": "composite",
                            "name": "Toggle",
                            "props": {
                                "name": "privacy_retention.enabled",
                                "disabled": "{{_computed.isReadOnly}}"
                            }
                        }
                    ]
                },
                {
                    "comment": "두 축의 대상 건수 — 꺼져 있어도 보인다(켜기 전에 규모를 본다, #636). 기간 칸은 켰을 때만 보이므로 건수를 그 안에 두지 않는다.\n        옆 버튼은 대상 창을 여는데, 게시판 관리 읽기 권한이 있으면 대상이 0건이어도 그린다(빈 명단은 창이 안내한다). 비회원 기간 0(미적용)이면 비회원 건수는 0 이다.",
                    "id": "privacy_retention_targets",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{boardPrivacyRetentionPreview?.data?.ip !== null && boardPrivacyRetentionPreview?.data?.ip !== undefined}}",
                    "props": {
                        "className": "mt-3 flex flex-wrap items-center gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "badge badge-yellow"
                            },
                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.targets.ip_count|count={{boardPrivacyRetentionPreview?.data?.ip ?? 0}}"
                        },
                        {
                            "id": "view_ip_targets",
                            "type": "basic",
                            "name": "Button",
                            "if": "{{boardPrivacyRetentionPreview?.data?.can_view_targets}}",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "privacyTargets": "{{({ path: 'retention-targets/sirsoft-board.ip', currentPage: 1, hasMore: true, isLoadingMore: false })}}"
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "privacyTargets.title": "$t:sirsoft-board.admin.settings.privacy_retention.targets.title_ip"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "privacyTargets"
                                            }
                                        },
                                        {
                                            "handler": "openModal",
                                            "target": "privacy_targets_modal"
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "btn btn-sm btn-outline"
                            },
                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.targets.view_ip"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "badge badge-yellow"
                            },
                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.targets.guest_count|count={{boardPrivacyRetentionPreview?.data?.guest ?? 0}}"
                        },
                        {
                            "id": "view_guest_targets",
                            "type": "basic",
                            "name": "Button",
                            "if": "{{boardPrivacyRetentionPreview?.data?.can_view_targets}}",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "privacyTargets": "{{({ path: 'retention-targets/sirsoft-board.guest', currentPage: 1, hasMore: true, isLoadingMore: false })}}"
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "privacyTargets.title": "$t:sirsoft-board.admin.settings.privacy_retention.targets.title_guest"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "privacyTargets"
                                            }
                                        },
                                        {
                                            "handler": "openModal",
                                            "target": "privacy_targets_modal"
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "btn btn-sm btn-outline"
                            },
                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.targets.view_guest"
                        }
                    ]
                },
                {
                    "id": "privacy_retention_axes",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{!!_local.form?.privacy_retention?.enabled}}",
                    "props": {
                        "className": "mt-4 space-y-6"
                    },
                    "children": [
                        {
                            "id": "privacy_ip_retention_days_field",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-center"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "form-label"
                                            },
                                            "text": "$t:sirsoft-board.admin.settings.privacy_retention.ip_retention_days"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-tertiary"
                                    },
                                    "text": "$t:sirsoft-board.admin.settings.privacy_retention.ip_retention_days_hint"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "number",
                                        "name": "privacy_retention.ip_retention_days",
                                        "min": "{{_local?.form?._meta?.limits?.privacy_ip_retention_days_min ?? 1}}",
                                        "max": "{{_local?.form?._meta?.limits?.privacy_ip_retention_days_max ?? 3650}}",
                                        "className": "input w-40 {{_local.errors?.['privacy_retention.ip_retention_days'] ? 'input-error' : ''}}",
                                        "disabled": "{{_computed.isReadOnly}}"
                                    }
