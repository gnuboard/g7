{
    "comment": "설정의 「스팸·보안」 탭 — 도배·자동 글쓰기를 막는 값들과, 맨 아래에 게시판 모듈이 쥐고 있는 캐시를 비우는 버튼이 하나 붙어 있다(위 SEO 탭의 캐시와는 다른 것)",
    "meta": {
        "is_partial": true,
        "description": "게시판 환경설정 스팸/보안 탭 콘텐츠"
    },
    "id": "tab_content_spam_security",
    "type": "basic",
    "name": "Div",
    "if": "{{(_global.activeBoardSettingsTab || query.tab || 'general') === 'spam_security'}}",
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "comment": "========== 섹션: 쿨다운 ==========",
                    "id": "section_cooldown",
                    "type": "layout",
                    "name": "SectionLayout",
                    "props": {
                        "className": "board-admin-card"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "H3",
                            "props": {
                                "className": "board-card-title"
                            },
                            "text": "$t:sirsoft-board.admin.settings.sections.spam_security"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "board-row-stack"
                            },
                            "children": [
                                {
                                    "id": "field_post_cooldown_seconds",
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "board-form-label"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-board.admin.settings.fields.post_cooldown_seconds"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "props": {
                                                "type": "number",
                                                "name": "spam_security.post_cooldown_seconds",
                                                "min": "{{_local?.form?._meta?.limits?.post_cooldown_seconds_min ?? 0}}",
                                                "max": "{{_local?.form?._meta?.limits?.post_cooldown_seconds_max ?? 3600}}",
                                                "className": "{{(_local.errors?.['spam_security.post_cooldown_seconds']) ? 'board-input-error' : ''}}",
                                                "disabled": "{{_computed.isReadOnly}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{_local.errors?.['spam_security.post_cooldown_seconds']}}",
                                            "props": {
                                                "className": "board:text-xs board:text-red-600 board:dark:text-red-400 board:block"
                                            },
                                            "text": "{{(Array.isArray(_local.errors?.['spam_security.post_cooldown_seconds']) ? _local.errors['spam_security.post_cooldown_seconds'][0] : _local.errors?.['spam_security.post_cooldown_seconds']) ?? ''}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "board-text-tertiary board:block"
                                            },
                                            "text": "$t:sirsoft-board.admin.settings.fields.post_cooldown_seconds_hint"
                                        }
                                    ]
                                },
                                {
                                    "id": "field_comment_cooldown_seconds",
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "board-form-label"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-board.admin.settings.fields.comment_cooldown_seconds"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "props": {
                                                "type": "number",
                                                "name": "spam_security.comment_cooldown_seconds",
                                                "min": "{{_local?.form?._meta?.limits?.comment_cooldown_seconds_min ?? 0}}",
                                                "max": "{{_local?.form?._meta?.limits?.comment_cooldown_seconds_max ?? 3600}}",
                                                "className": "{{(_local.errors?.['spam_security.comment_cooldown_seconds']) ? 'board-input-error' : ''}}",
                                                "disabled": "{{_computed.isReadOnly}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{_local.errors?.['spam_security.comment_cooldown_seconds']}}",
                                            "props": {
                                                "className": "board:text-xs board:text-red-600 board:dark:text-red-400 board:block"
                                            },
                                            "text": "{{(Array.isArray(_local.errors?.['spam_security.comment_cooldown_seconds']) ? _local.errors['spam_security.comment_cooldown_seconds'][0] : _local.errors?.['spam_security.comment_cooldown_seconds']) ?? ''}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "board-text-tertiary board:block"
                                            },
                                            "text": "$t:sirsoft-board.admin.settings.fields.comment_cooldown_seconds_hint"
                                        }
                                    ]
                                },
                                {
                                    "id": "field_view_count_cache_ttl",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": ""
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Label",
                                                    "props": {
                                                        "className": "board-form-label"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "text": "$t:sirsoft-board.admin.settings.fields.view_count_cache_ttl"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Input",
                                                    "props": {
                                                        "type": "number",
                                                        "name": "spam_security.view_count_cache_ttl",
                                                        "min": "{{_local?.form?._meta?.limits?.view_count_cache_ttl_min ?? 60}}",
                                                        "max": "{{_local?.form?._meta?.limits?.view_count_cache_ttl_max ?? 604800}}",
                                                        "className": "{{(_local.errors?.['spam_security.view_count_cache_ttl']) ? 'board-input-error' : ''}}",
                                                        "disabled": "{{_computed.isReadOnly}}"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "if": "{{_local.errors?.['spam_security.view_count_cache_ttl']}}",
                                                    "props": {
                                                        "className": "board:text-xs board:text-red-600 board:dark:text-red-400 board:block"
                                                    },
                                                    "text": "{{(Array.isArray(_local.errors?.['spam_security.view_count_cache_ttl']) ? _local.errors['spam_security.view_count_cache_ttl'][0] : _local.errors?.['spam_security.view_count_cache_ttl']) ?? ''}}"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "board-text-tertiary board:block"
                                                    },
                                                    "text": "$t:sirsoft-board.admin.settings.fields.view_count_cache_ttl_hint"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "spam_security_identifier_info",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "board-alert-info"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "board-flex-center board:gap-2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "circle-info",
                                                "className": "board:text-blue-600 board:dark:text-blue-400 board:flex-shrink-0",
                                                "size": "sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "board:text-xs board-tone-info"
                                            },
                                            "text": "$t:sirsoft-board.admin.settings.fields.spam_security_identifier_info"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "comment": "========== 섹션: 캐시 초기화 ==========",
                    "id": "section_cache",
                    "type": "layout",
                    "name": "SectionLayout",
                    "props": {
                        "className": "board-admin-card"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "board-flex-between"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "board-section-header"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "H3",
                                            "text": "$t:sirsoft-board.admin.settings.fields.clear_cache"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "text": "$t:sirsoft-board.admin.settings.fields.clear_cache_description"
                                        }
                                    ]
                                },
                                {
                                    "id": "clear_cache_button",
                                    "type": "basic",
                                    "name": "Button",
                                    "actions": [
                                        {
                                            "comment": "차단 낱말 추가. 빈 값이나 이미 있는 낱말은 담지 않으며, 담은 뒤 입력칸을 비워 연속 입력을 이어 갈 수 있게 한다",
                                            "type": "click",
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "isClearingCache": true
                                                    }
                                                },
                                                {
                                                    "handler": "apiCall",
                                                    "target": "/api/modules/sirsoft-board/admin/settings/clear-cache",
                                                    "auth_required": true,
                                                    "params": {
                                                        "method": "POST"
                                                    },
                                                    "onSuccess": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "isClearingCache": false
                                                            }
                                                        },
                                                        {
                                                            "handler": "toast",
                                                            "params": {
                                                                "type": "success",
                                                                "message": "$t:sirsoft-board.admin.settings.fields.clear_cache_success"
                                                            }
                                                        }
                                                    ],
                                                    "onError": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "isClearingCache": false
                                                            }
                                                        },
                                                        {
                                                            "handler": "toast",
                                                            "params": {
                                                                "type": "error",
                                                                "message": "{{error.message ?? '$t:sirsoft-board.admin.settings.fields.clear_cache_error'}}"
                                                            }
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "disabled": "{{_computed.isReadOnly || _local.isClearingCache}}",
                                        "className": "board-flex-center board:gap-1.5 board:px-4 board:py-2 board:bg-red-600 board:dark:bg-red-700 board:text-white board:rounded-lg board:hover:bg-red-700 board:dark:hover:bg-red-600 board:font-medium board:transition-colors board:disabled:opacity-50 board:disabled:cursor-not-allowed"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{_local.isClearingCache}}",
                                            "props": {
                                                "name": "spinner",
                                                "className": "board:animate-spin",
                                                "size": "sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{!_local.isClearingCache}}",
                                            "props": {
                                                "name": "trash-can",
                                                "size": "sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:sirsoft-board.admin.settings.fields.clear_cache"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
