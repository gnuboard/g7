{
    "comment": "알림 정의를 처음 상태로 되돌리는 확인 창 — 손으로 고쳐 둔 문안이 사라지므로 어느 정의인지(`resetTargetName`)를 이름으로 먼저 보여주고 경고를 함께 세운다",
    "meta": {
        "is_partial": true,
        "description": "게시판 알림 정의 기본값 복원 확인 모달 (스피너 포함)"
    },
    "id": "modal_board_notification_definition_reset",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-board.admin.settings.notification_definitions.reset_modal.title",
        "size": "sm",
        "footer": [
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "closeModal",
                        "target": "modal_board_notification_definition_reset"
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "board:px-4 board:py-2 board:bg-white board:dark:bg-gray-800 board:text-gray-700 board:dark:text-gray-300 board:border board:border-gray-300 board:dark:border-gray-600 board:rounded-lg board:hover:bg-gray-50 board:dark:hover:bg-gray-700 board:disabled:opacity-50 board:disabled:cursor-not-allowed",
                    "disabled": "{{_global.isResettingNotification}}"
                },
                "text": "$t:common.cancel"
            },
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "comment": "복원 실행 — 성공하면 대상 id·이름을 함께 비워 다음에 열릴 때 지난 대상이 남지 않게 하고, 목록을 다시 읽어 되돌아간 문안을 보여준다",
                        "type": "click",
                        "handler": "sequence",
                        "actions": [
                            {
                                "handler": "setState",
                                "params": {
                                    "target": "global",
                                    "isResettingNotification": true
                                }
                            },
                            {
                                "handler": "apiCall",
                                "target": "/api/admin/notification-definitions/{{_global.resetTargetId}}/reset",
                                "auth_required": true,
                                "params": {
                                    "method": "POST"
                                },
                                "onSuccess": [
                                    {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "isResettingNotification": false,
                                            "resetTargetId": null,
                                            "resetTargetName": ""
                                        }
                                    },
                                    {
                                        "handler": "refetchDataSource",
                                        "params": {
                                            "dataSourceId": "boardNotificationDefinitions"
                                        }
                                    },
                                    {
                                        "handler": "toast",
                                        "params": {
                                            "type": "success",
                                            "message": "$t:sirsoft-board.admin.settings.notification_definitions.reset_success"
                                        }
                                    },
                                    {
                                        "handler": "closeModal",
                                        "target": "modal_board_notification_definition_reset"
                                    }
                                ],
                                "onError": [
                                    {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "isResettingNotification": false
                                        }
                                    },
                                    {
                                        "handler": "toast",
                                        "params": {
                                            "type": "error",
                                            "message": "{{error.message ?? '$t:sirsoft-board.admin.settings.notification_definitions.reset_failed'}}"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "board-flex-center board:gap-2 board:px-4 board:py-2 board:bg-orange-700 board:dark:bg-orange-700 board:text-white board:rounded-lg board:hover:bg-orange-800 board:dark:hover:bg-orange-800 board:disabled:opacity-50 board:disabled:cursor-not-allowed",
                    "disabled": "{{_global.isResettingNotification}}"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Icon",
                        "if": "{{_global.isResettingNotification}}",
                        "props": {
                            "name": "spinner",
                            "className": "board-spinner-sm"
                        }
                    },
                    {
                        "type": "basic",
                        "name": "Span",
                        "text": "{{_global.isResettingNotification ? '$t:sirsoft-board.admin.settings.notification_definitions.reset_modal.btn_confirming' : '$t:sirsoft-board.admin.settings.notification_definitions.reset_modal.btn_confirm'}}"
                    }
                ]
            }
        ]
    },
    "children": [
        {
            "type": "basic",
            "name": "P",
            "props": {
                "className": "board:text-gray-700 board:dark:text-gray-300"
            },
            "text": "$t:sirsoft-board.admin.settings.notification_definitions.reset_modal.confirm_message"
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "board:mt-4 board:p-3 board:bg-gray-100 board:dark:bg-gray-700 board:rounded-lg"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "board-form-sub-label"
                    },
                    "text": "$t:sirsoft-board.admin.settings.notification_definitions.reset_modal.target_label"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "board-text-primary board:font-medium"
                    },
                    "text": "{{_global.resetTargetName ?? ''}}"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "board-alert-danger"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "board-text-error-soft"
                    },
                    "text": "$t:sirsoft-board.admin.settings.notification_definitions.reset_modal.warning_message"
                }
            ]
        }
    ]
}
