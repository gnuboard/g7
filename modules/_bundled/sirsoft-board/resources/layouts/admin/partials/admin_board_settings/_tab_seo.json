                        {
                            "id": "cache_section",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "form-label"
                                            },
                                            "text": "$t:sirsoft-board.admin.settings.seo.seo_friendly.cache_management"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "text-label-subtle"
                                            },
                                            "text": "$t:sirsoft-board.admin.settings.seo.seo_friendly.cache_description"
                                        },
                                        {
                                            "comment": "코어 SEO 캐시 API(core.settings.update) 를 부른다 — 그 권한이 없으면 잠그고 이유를 아래에 적는다",
                                            "id": "seo_clear_cache_button",
                                            "type": "basic",
                                            "name": "Button",
                                            "actions": [
                                                {
                                                    "comment": "SEO 캐시 비우기 — 게시판이 가진 화면 셋(`board/boards` → `board/index` → `board/show`)을 차례로 비운다. 한 엔드포인트가 레이아웃 하나씩만 받으므로 중첩해 이어 붙였고, 앞이 실패하면 뒤는 돌지 않는다. 성공 토스트는 마지막 하나가 끝난 뒤에야 뜬다",
                                                    "type": "click",
                                                    "handler": "sequence",
                                                    "actions": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "clearingCache": true
                                                            }
                                                        },
                                                        {
                                                            "handler": "apiCall",
                                                            "target": "/api/admin/seo/clear-cache",
                                                            "auth_required": true,
                                                            "params": {
                                                                "method": "POST",
                                                                "body": {
                                                                    "layout": "board/boards"
                                                                }
                                                            },
                                                            "onSuccess": {
                                                                "handler": "apiCall",
                                                                "target": "/api/admin/seo/clear-cache",
                                                                "auth_required": true,
                                                                "params": {
                                                                    "method": "POST",
                                                                    "body": {
                                                                        "layout": "board/index"
                                                                    }
                                                                },
                                                                "onSuccess": {
                                                                    "handler": "apiCall",
                                                                    "target": "/api/admin/seo/clear-cache",
                                                                    "auth_required": true,
                                                                    "params": {
                                                                        "method": "POST",
                                                                        "body": {
                                                                            "layout": "board/show"
                                                                        }
                                                                    },
                                                                    "onSuccess": [
                                                                        {
                                                                            "handler": "setState",
                                                                            "params": {
                                                                                "target": "local",
                                                                                "clearingCache": false
                                                                            }
                                                                        },
                                                                        {
                                                                            "handler": "toast",
                                                                            "params": {
                                                                                "type": "success",
                                                                                "message": "$t:sirsoft-board.admin.settings.seo.seo_friendly.clear_cache_success"
                                                                            }
                                                                        }
                                                                    ],
                                                                    "onError": [
                                                                        {
                                                                            "handler": "setState",
                                                                            "params": {
                                                                                "target": "local",
                                                                                "clearingCache": false
                                                                            }
                                                                        },
                                                                        {
                                                                            "handler": "toast",
                                                                            "params": {
                                                                                "type": "error",
                                                                                "message": "{{error.message ?? '$t:sirsoft-board.admin.settings.seo.seo_friendly.clear_cache_error'}}"
                                                                            }
                                                                        }
                                                                    ]
                                                                },
                                                                "onError": [
                                                                    {
                                                                        "handler": "setState",
                                                                        "params": {
                                                                            "target": "local",
                                                                            "clearingCache": false
                                                                        }
                                                                    },
                                                                    {
                                                                        "handler": "toast",
                                                                        "params": {
                                                                            "type": "error",
                                                                            "message": "{{error.message ?? '$t:sirsoft-board.admin.settings.seo.seo_friendly.clear_cache_error'}}"
                                                                        }
                                                                    }
                                                                ]
                                                            },
                                                            "onError": [
                                                                {
                                                                    "handler": "setState",
                                                                    "params": {
                                                                        "target": "local",
                                                                        "clearingCache": false
                                                                    }
                                                                },
                                                                {
                                                                    "handler": "toast",
                                                                    "params": {
                                                                        "type": "error",
                                                                        "message": "{{error.message ?? '$t:sirsoft-board.admin.settings.seo.seo_friendly.clear_cache_error'}}"
                                                                    }
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ],
                                            "props": {
                                                "type": "button",
                                                "className": "btn btn-danger",
                                                "disabled": "{{!_computed.canClearSeoCache || (_local.clearingCache ?? false)}}"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "if": "{{_local.clearingCache ?? false}}",
                                                    "props": {
                                                        "name": "circle-notch",
                                                        "spin": true,
                                                        "className": "mr-2"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:sirsoft-board.admin.settings.seo.seo_friendly.clear_cache"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "seo_clear_cache_no_permission",
                                            "type": "basic",
                                            "name": "P",
                                            "if": "{{!_computed.canClearSeoCache}}",
                                            "props": {
                                                "className": "form-hint"
                                            },
                                            "text": "$t:sirsoft-board.admin.settings.seo.seo_friendly.clear_cache_no_permission"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
