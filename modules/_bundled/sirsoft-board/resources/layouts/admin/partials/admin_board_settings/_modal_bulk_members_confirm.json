{
    "comment": "게시판 관리자·스텝 일괄 지정 확인 창. 무엇을(구분·작업·회원) 어디에(전체/고른 게시판) 적용할지 다시 보여 주고 실행한다.\n  성공하면 회원 칸만 비우고 대상·구분·작업은 남긴다 — 같은 게시판들에 다른 회원을 이어서 지정하기 쉽게. 결과(변경 수·제외 사유)는\n  카드에 남긴다. 실패는 창 안에 문구로 남긴다. 연타는 실행 버튼의 디바운스가 한 번으로 모은다.",
    "meta": {
        "is_partial": true,
        "description": "게시판 관리자·스텝 일괄 지정 확인 모달",
        "editor_label": "$t:sirsoft-board.admin.settings.bulk_members.confirm_title"
    },
    "id": "bulk_members_confirm_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:sirsoft-board.admin.settings.bulk_members.confirm_title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "space-y-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-label"
                    },
                    "text": "{{_global.boardBulkMembers?.mode === 'remove' ? ((_global.boardBulkMembers?.type ?? 'manager') === 'step' ? $t:sirsoft-board.admin.settings.bulk_members.confirm_remove_step : $t:sirsoft-board.admin.settings.bulk_members.confirm_remove_manager) : ((_global.boardBulkMembers?.type ?? 'manager') === 'step' ? $t:sirsoft-board.admin.settings.bulk_members.confirm_add_step : $t:sirsoft-board.admin.settings.bulk_members.confirm_add_manager)}}"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "text-sm text-gray-700 dark:text-gray-300"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "font-medium"
                            },
                            "text": "$t:sirsoft-board.admin.settings.bulk_members.target_label"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_global.boardBulkMembers?.all !== false}}",
                            "props": {
                                "className": "ml-2"
                            },
                            "text": "$t:sirsoft-board.admin.settings.bulk_members.target_all"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_global.boardBulkMembers?.all === false}}",
                            "props": {
                                "className": "ml-2"
                            },
                            "text": "$t:sirsoft-board.admin.settings.bulk_members.boards_count|count={{(_global.boardBulkMembers?.boardIds ?? []).length}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex flex-wrap gap-1"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "iteration": {
                                "source": "{{(_global.boardBulkMembers?.users ?? []).slice(0, 10)}}",
                                "item_var": "member"
                            },
                            "props": {
                                "className": "px-2 py-0.5 text-xs bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded"
                            },
                            "text": "{{member.name}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "P",
                    "if": "{{_global.boardBulkMembers?.mode === 'remove' && (_global.boardBulkMembers?.type ?? 'manager') === 'manager'}}",
                    "props": {
                        "className": "text-tertiary"
                    },
                    "text": "$t:sirsoft-board.admin.settings.bulk_members.hint"
                },
                {
                    "id": "bulk_members_confirm_error",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{!!_global.boardBulkMembers?.error}}",
                    "props": {
                        "className": "alert-danger text-sm"
                    },
                    "text": "{{_global.boardBulkMembers?.error}}"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "modal-footer-buttons"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "closeModal"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "disabled": "{{_global.boardBulkMembers?.isApplying === true}}",
                        "className": "btn btn-secondary disabled:opacity-50 disabled:cursor-not-allowed"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "id": "bulk_members_confirm_button",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "일괄 지정 실행. 진행 표시는 성공·실패·403 어느 갈래에서든 끈다. 버튼 잠금만으로는 같은 틱의 두 번째 클릭을 못 막아 300ms 디바운스로 연타를 한 번으로 모은다",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "boardBulkMembers.isApplying": true,
                                        "boardBulkMembers.error": null
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/modules/sirsoft-board/admin/boards/bulk-members",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST",
                                        "body": {
                                            "apply_all": "{{_global.boardBulkMembers?.all !== false}}",
                                            "board_ids": "{{_global.boardBulkMembers?.all === false ? (_global.boardBulkMembers?.boardIds ?? []) : undefined}}",
                                            "user_uuids": "{{_global.boardBulkMembers?.userUuids ?? []}}",
                                            "member_type": "{{_global.boardBulkMembers?.type ?? 'manager'}}",
                                            "mode": "{{_global.boardBulkMembers?.mode ?? 'add'}}"
                                        }
                                    },
                                    "onSuccess": {
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "global",
                                                    "boardBulkMembers.isApplying": false,
                                                    "boardBulkMembers.result": "{{response.data}}",
                                                    "boardBulkMembers.userUuids": [],
                                                    "boardBulkMembers.users": []
                                                }
                                            },
                                            {
                                                "handler": "toast",
                                                "params": {
                                                    "type": "success",
                                                    "message": "{{response.message}}"
                                                }
                                            },
                                            {
                                                "handler": "closeModal"
                                            }
                                        ]
                                    },
                                    "onError": {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "boardBulkMembers.isApplying": false,
                                            "boardBulkMembers.error": "{{error.errors?.user_uuids?.[0] ?? error.errors?.board_ids?.[0] ?? error.message ?? '$t:sirsoft-board.admin.settings.bulk_members.failed'}}"
                                        }
                                    },
                                    "errorHandling": {
                                        "403": {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "boardBulkMembers.isApplying": false,
                                                "boardBulkMembers.error": "{{error.message ?? '$t:auth.permission_denied'}}"
                                            }
                                        }
                                    }
                                }
                            ],
                            "debounce": 300
                        }
                    ],
                    "props": {
                        "type": "button",
                        "disabled": "{{_global.boardBulkMembers?.isApplying === true}}",
                        "className": "flex-center gap-1.5 px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.boardBulkMembers?.isApplying === true}}",
                            "props": {
                                "name": "spinner",
                                "size": "sm",
                                "spin": true
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:sirsoft-board.admin.settings.bulk_members.apply"
                        }
                    ]
                }
            ]
        }
    ]
}
