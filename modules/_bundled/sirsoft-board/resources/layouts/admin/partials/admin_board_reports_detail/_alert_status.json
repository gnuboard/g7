{
    "comment": "신고 상세 맨 위의 상태 배너와 조치 버튼들. 색·아이콘·문구가 전부 현재 상태 하나에서 갈리고, 버튼은 «서버가 허용한 것»(`available_actions`)만 선다 — 어떤 전환이 가능한지를 화면이 스스로 판단하지 않는다. 각 버튼은 갈래를 전역에 적어 두고 부모 화면의 확인 모달을 여는 두 단으로 되어 있다",
    "meta": {
        "is_partial": true,
        "description": "Status Stats Grid and Alert Box with Dynamic Actions for Admin Report Detail View"
    },
    "id": "status_wrapper",
    "type": "basic",
    "name": "Div",
    "if": "{{report_detail?.data}}",
    "props": {
        "className": "board:mb-6"
    },
    "children": [
        {
            "id": "status_alert",
            "type": "basic",
            "name": "Div",
            "responsive": {
                "portable": {
                    "props": {
                        "className": "board:px-6 board:py-4 board:border board:rounded-lg {{report_detail?.data?.status === 'pending' || report_detail?.data?.status === 'review' || report_detail?.data?.status === 'rejected' || report_detail?.data?.status === 'suspended' || report_detail?.data?.status === 'deleted' ? 'board-row-stack' : ''}} {{report_detail?.data?.status === 'pending' ? 'board:bg-yellow-50 board:dark:bg-yellow-900 board:border-yellow-300 board:dark:border-yellow-800' : report_detail?.data?.status === 'review' ? 'board:bg-blue-50 board:dark:bg-blue-900 board:border-blue-300 board:dark:border-blue-800' : report_detail?.data?.status === 'rejected' ? 'board:bg-purple-50 board:dark:bg-purple-900 board:border-purple-200 board:dark:border-purple-700' : report_detail?.data?.status === 'deleted' ? 'board:bg-gray-200 board:dark:bg-gray-700 board:border-gray-400 board:dark:border-gray-600' : 'board:bg-red-50 board:dark:bg-red-900 board:border-red-300 board:dark:border-red-800'}}"
                    }
                }
            },
            "props": {
                "className": "board:px-6 board:py-4 board:border board:rounded-lg {{report_detail?.data?.status === 'pending' || report_detail?.data?.status === 'review' || report_detail?.data?.status === 'rejected' || report_detail?.data?.status === 'suspended' || report_detail?.data?.status === 'deleted' ? 'board:flex board:flex-row board:items-end board:justify-between board:gap-4' : ''}} {{report_detail?.data?.status === 'pending' ? 'board:bg-yellow-50 board:dark:bg-yellow-900 board:border-yellow-300 board:dark:border-yellow-800' : report_detail?.data?.status === 'review' ? 'board:bg-blue-50 board:dark:bg-blue-900 board:border-blue-300 board:dark:border-blue-800' : report_detail?.data?.status === 'rejected' ? 'board:bg-purple-50 board:dark:bg-purple-900 board:border-purple-200 board:dark:border-purple-700' : report_detail?.data?.status === 'deleted' ? 'board:bg-gray-200 board:dark:bg-gray-700 board:border-gray-400 board:dark:border-gray-600' : 'board:bg-red-50 board:dark:bg-red-900 board:border-red-300 board:dark:border-red-800'}}"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "{{report_detail?.data?.status === 'pending' || report_detail?.data?.status === 'review' || report_detail?.data?.status === 'rejected' || report_detail?.data?.status === 'suspended' ? 'board:flex board:items-start board:gap-3 board:flex-1' : 'board:flex board:items-start board:gap-3'}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "board-flex-center board:gap-2 board:mb-1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{report_detail?.data?.status === 'pending'}}",
                                            "props": {
                                                "name": "exclamation-circle",
                                                "className": "board:text-xl board:text-yellow-700 board:dark:text-yellow-400"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{report_detail?.data?.status === 'review'}}",
                                            "props": {
                                                "name": "clock",
                                                "className": "board:text-xl {{report_detail?.data?.status === 'review' ? 'board:text-blue-600 board:dark:text-blue-400' : ''}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{report_detail?.data?.status === 'rejected'}}",
                                            "props": {
                                                "name": "times-circle",
                                                "className": "board:text-xl board:text-purple-600 board:dark:text-purple-400"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{report_detail?.data?.status === 'suspended'}}",
                                            "props": {
                                                "name": "exclamation-triangle",
                                                "className": "board:text-xl {{report_detail?.data?.status === 'suspended' ? 'board:text-red-600 board:dark:text-red-400' : ''}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{report_detail?.data?.status === 'deleted'}}",
                                            "props": {
                                                "name": "ban",
                                                "className": "board:text-xl board:text-gray-700 board:dark:text-gray-300"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "H3",
                                            "responsive": {
                                                "portable": {
                                                    "props": {
                                                        "className": "board:font-semibold board:text-sm {{report_detail?.data?.status === 'pending' ? 'board-tone-warning' : report_detail?.data?.status === 'review' ? 'board-tone-info' : report_detail?.data?.status === 'rejected' ? 'board:text-purple-700 board:dark:text-purple-200' : report_detail?.data?.status === 'deleted' ? 'board:text-gray-900 board:dark:text-gray-300' : 'board-tone-danger'}}"
                                                    }
                                                }
                                            },
                                            "props": {
                                                "className": "board:font-semibold board:text-base {{report_detail?.data?.status === 'pending' ? 'board-tone-warning' : report_detail?.data?.status === 'review' ? 'board-tone-info' : report_detail?.data?.status === 'rejected' ? 'board:text-purple-700 board:dark:text-purple-200' : report_detail?.data?.status === 'deleted' ? 'board:text-gray-900 board:dark:text-gray-300' : 'board-tone-danger'}}"
                                            },
                                            "text": "$t:sirsoft-board.admin.reports.detail.alert_title_{{report_detail?.data?.status}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "responsive": {
                                        "portable": {
                                            "props": {
                                                "className": "board:text-xs {{report_detail?.data?.status === 'pending' ? 'board:text-yellow-800 board:dark:text-yellow-400' : report_detail?.data?.status === 'review' ? 'board:text-blue-700 board:dark:text-blue-300' : report_detail?.data?.status === 'rejected' ? 'board:text-purple-700 board:dark:text-purple-300' : report_detail?.data?.status === 'deleted' ? 'board:text-gray-600 board:dark:text-gray-300' : 'board:text-red-700 board:dark:text-red-300'}}"
                                            }
                                        }
                                    },
                                    "props": {
                                        "className": "board:text-sm {{report_detail?.data?.status === 'pending' ? 'board:text-yellow-800 board:dark:text-yellow-400' : report_detail?.data?.status === 'review' ? 'board:text-blue-700 board:dark:text-blue-300' : report_detail?.data?.status === 'rejected' ? 'board:text-purple-700 board:dark:text-purple-300' : report_detail?.data?.status === 'deleted' ? 'board:text-gray-600 board:dark:text-gray-300' : 'board:text-red-700 board:dark:text-red-300'}}"
                                    },
                                    "text": "$t:sirsoft-board.admin.reports.detail.alert_message_{{report_detail?.data?.status}}"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{report_detail?.data?.available_actions?.length > 0}}",
                    "props": {
                        "className": "board:flex board:flex-wrap board:gap-2 board:items-end"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "if": "{{report_detail?.data?.available_actions?.includes('pending') && report_detail?.data?.status !== 'rejected' && report_detail?.data?.status !== 'suspended'}}",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "board-flex-center board:gap-2 board:px-3 board:py-2 board:bg-yellow-700 board:dark:bg-yellow-700 board:text-white board:rounded-lg board:hover:bg-yellow-800 board:dark:hover:bg-yellow-800 board:text-xs board:font-medium board:transition-colors"
                                    }
                                }
                            },
                            "actions": [
                                {
                                    "comment": "「대기로 되돌리기」 — 서버가 허용해도 기각·정지 상태에서는 이 버튼을 감춘다(결론이 난 건을 손대지 않은 상태로 되돌리는 길은 열어 두지 않는다). 직전 사유는 비워 다음 창에 묻어오지 않게 한다",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "actionType": "pending",
                                        "actionReason": ""
                                    }
                                },
                                {
                                    "type": "click",
                                    "handler": "openModal",
                                    "target": "status_action_modal"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "disabled": "{{report_detail?.data?.abilities?.can_manage !== true}}",
                                "className": "board-flex-center board:gap-2 board:px-3 board:py-2 board:bg-yellow-700 board:dark:bg-yellow-700 board:text-white board:rounded-lg board:hover:bg-yellow-800 board:dark:hover:bg-yellow-800 board:text-sm board:font-medium board:transition-colors board:disabled:opacity-50 board:disabled:cursor-not-allowed"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "responsive": {
                                        "portable": {
                                            "props": {
                                                "name": "chevron-left",
                                                "className": "board:text-sm"
                                            }
                                        }
                                    },
                                    "props": {
                                        "name": "chevron-left",
                                        "className": "board:text-base"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-board.admin.reports.detail.actions.back_to_pending"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "if": "{{report_detail?.data?.available_actions?.includes('review')}}",
                            "responsive": {
                                "portable": {
                                    "classMerge": "board:text-xs"
                                }
                            },
                            "actions": [
                                {
                                    "comment": "「검토 시작」 또는 「재검토」 — 같은 전환이지만 지금이 대기 상태인지에 따라 아이콘과 글자가 갈린다",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "actionType": "review",
                                        "actionReason": ""
                                    }
                                },
                                {
                                    "type": "click",
                                    "handler": "openModal",
                                    "target": "status_action_modal"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "disabled": "{{report_detail?.data?.abilities?.can_manage !== true}}",
                                "className": "board-flex-center board-btn board-btn-primary board:px-3"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "responsive": {
                                        "portable": {
                                            "props": {
                                                "name": "{{report_detail?.data?.status === 'pending' ? 'check-circle' : 'clock'}}",
                                                "className": "board:text-sm"
                                            }
                                        }
                                    },
                                    "props": {
                                        "name": "{{report_detail?.data?.status === 'pending' ? 'check-circle' : 'clock'}}",
                                        "className": "board:text-base"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "{{report_detail?.data?.status === 'pending' ? '$t:sirsoft-board.admin.reports.detail.actions.start_review' : '$t:sirsoft-board.admin.reports.detail.actions.re_review'}}"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "if": "{{report_detail?.data?.available_actions?.includes('rejected')}}",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "board-flex-center board:gap-2 board:px-3 board:py-2 board:bg-purple-600 board:dark:bg-purple-600 board:text-white board:rounded-lg board:hover:bg-purple-700 board:dark:hover:bg-purple-700 board:text-xs board:font-medium board:transition-colors"
                                    }
                                }
                            },
                            "actions": [
                                {
                                    "comment": "「기각」 — 신고를 받아들이지 않는다. 대상이 이미 가려져 있었다면 다시 공개되므로 확인 창이 그 사실을 따로 알린다",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "actionType": "rejected",
                                        "actionReason": ""
                                    }
                                },
                                {
                                    "type": "click",
                                    "handler": "openModal",
                                    "target": "status_action_modal"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "disabled": "{{report_detail?.data?.abilities?.can_manage !== true}}",
                                "className": "board-flex-center board:gap-2 board:px-3 board:py-2 board:bg-purple-600 board:dark:bg-purple-600 board:text-white board:rounded-lg board:hover:bg-purple-700 board:dark:hover:bg-purple-700 board:text-sm board:font-medium board:transition-colors board:disabled:opacity-50 board:disabled:cursor-not-allowed"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "responsive": {
                                        "portable": {
                                            "props": {
                                                "name": "times-circle",
                                                "className": "board:text-sm"
                                            }
                                        }
                                    },
                                    "props": {
                                        "name": "times-circle",
                                        "className": "board:text-base"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-board.admin.reports.detail.actions.reject"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "if": "{{report_detail?.data?.available_actions?.includes('suspended')}}",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "board-flex-center board:gap-2 board:px-3 board:py-2 board:bg-red-600 board:dark:bg-red-600 board:text-white board:rounded-lg board:hover:bg-red-700 board:dark:hover:bg-red-700 board:text-xs board:font-medium board:transition-colors"
                                    }
                                }
                            },
                            "actions": [
                                {
                                    "comment": "「정지」 — 신고를 받아들여 대상 글·댓글을 가린다. 글 자체는 남는다",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "actionType": "suspended",
                                        "actionReason": ""
                                    }
                                },
                                {
                                    "type": "click",
                                    "handler": "openModal",
                                    "target": "status_action_modal"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "disabled": "{{report_detail?.data?.abilities?.can_manage !== true}}",
                                "className": "board-flex-center board:gap-2 board:px-3 board:py-2 board:bg-red-600 board:dark:bg-red-600 board:text-white board:rounded-lg board:hover:bg-red-700 board:dark:hover:bg-red-700 board:text-sm board:font-medium board:transition-colors board:disabled:opacity-50 board:disabled:cursor-not-allowed"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "responsive": {
                                        "portable": {
                                            "props": {
                                                "name": "exclamation-triangle",
                                                "className": "board:text-sm"
                                            }
                                        }
                                    },
                                    "props": {
                                        "name": "exclamation-triangle",
                                        "className": "board:text-base"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-board.admin.reports.detail.actions.suspend"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "if": "{{report_detail?.data?.available_actions?.includes('deleted')}}",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "board-flex-center board:gap-2 board:px-3 board:py-2 board:bg-gray-800 board:text-white board:rounded-lg board:hover:bg-gray-900 board:dark:bg-gray-700 board:dark:hover:bg-gray-600 board:text-xs board:font-medium board:transition-colors"
                                    }
                                }
                            },
                            "actions": [
                                {
                                    "comment": "「삭제」 — 다섯 갈래 중 유일하게 대상을 지우는 쪽이라 되돌릴 수 없다",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "actionType": "deleted",
                                        "actionReason": ""
                                    }
                                },
                                {
                                    "type": "click",
                                    "handler": "openModal",
                                    "target": "status_action_modal"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "disabled": "{{report_detail?.data?.abilities?.can_manage !== true}}",
                                "className": "board-flex-center board:gap-2 board:px-3 board:py-2 board:bg-gray-800 board:text-white board:rounded-lg board:hover:bg-gray-900 board:dark:bg-gray-700 board:dark:hover:bg-gray-600 board:text-sm board:font-medium board:transition-colors board:disabled:opacity-50 board:disabled:cursor-not-allowed"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "responsive": {
                                        "portable": {
                                            "props": {
                                                "name": "trash",
                                                "className": "board:text-sm"
                                            }
                                        }
                                    },
                                    "props": {
                                        "name": "trash",
                                        "className": "board:text-base"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:sirsoft-board.admin.reports.detail.actions.delete"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
