{
    "comment": "신고 한 건의 상세. 본문은 조각 셋(현재 상태 배너 · 신고 내용 · 처리 이력)이고, 상태 전환은 다섯 갈래(대기·검토·기각·정지·삭제)를 모달 하나가 겸한다 — 어느 갈래인지는 `_global.actionType` 이 들고 있어 제목·문구·버튼색·보낼 값이 그 하나에서 갈린다",
    "version": "1.0.0",
    "layout_name": "admin_board_reports_detail",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:sirsoft-board.admin.reports.detail.page_title",
        "description": "$t:sirsoft-board.admin.reports.detail.page_description"
    },
    "data_sources": [
        {
            "id": "report_detail",
            "label_key": "$t:sirsoft-board.editor.data_source.report_detail",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/admin/reports/{{route.id}}",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "refetchOnMount": true,
            "errorHandling": {
                "404": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                },
                "403": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                }
            },
            "comment": "신고 본문·대상 글·현재 상태. 없는 신고(404)와 권한 없음(403) 둘 다 화면 자리에 오류 페이지를 세운다 — 이 화면은 신고 하나가 전부라 부분만 비워 둘 수 없다"
        },
        {
            "id": "reporters_list",
            "label_key": "$t:sirsoft-board.editor.data_source.reporters_list",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/admin/reports/{{route.id}}/reporters",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "params": {
                "page": "{{_local.reporters_page}}",
                "per_page": 10
            },
            "comment": "같은 대상을 신고한 사람들 — 한 신고에 여럿이 붙을 수 있어 따로 페이지를 넘긴다. `progressive` 라 본문이 먼저 뜨고 이 목록만 늦게 채워진다"
        }
    ],
    "initLocal": {
        "_local": {
            "reporters_page": 1,
            "reporters_loading": false
        },
        "_global": {
            "actionReason": "",
            "isSaving": false,
            "actionType": ""
        }
    },
    "permissions": [
        "sirsoft-board.reports.view"
    ],
    "transition_overlay": {
        "wait_for": [
            "report_detail",
            "reporters_list"
        ]
    },
    "slots": {
        "content": [
            {
                "id": "report_detail_wrapper",
                "type": "basic",
                "name": "Div",
                "responsive": {
                    "portable": {
                        "props": {
                            "className": "admin-page-content-fluid-compact"
                        }
                    }
                },
                "props": {
                    "className": "admin-page-content-fluid"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:sirsoft-board.admin.reports.detail.page_title",
                            "description": "$t:sirsoft-board.admin.reports.detail.page_description"
                        },
                        "children": [
                            {
                                "id": "refresh_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "comment": "같은 신고로 다시 들어가 본문·신고자 목록을 새로 읽는다 — 신고자 페이지도 함께 1 로 돌아간다",
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/boards/reports/{{route.id}}",
                                            "mergeQuery": true,
                                            "query": {}
                                        }
                                    }
                                ],
                                "props": {
                                    "type": "button",
                                    "aria-label": "$t:common.refresh",
                                    "title": "$t:common.refresh",
                                    "className": "btn-icon"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "arrows-rotate",
                                            "className": "text-xl"
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "back_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "comment": "신고 목록으로. 보던 목록 상태를 이고 간다",
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/boards/reports",
                                            "mergeQuery": true,
                                            "query": {}
                                        }
                                    }
                                ],
                                "props": {
                                    "className": "flex-center gap-2 btn btn-secondary"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "arrow-left",
                                            "className": "text-base"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:common.back"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "partial": "partials/admin_board_reports_detail/_alert_status.json"
                    },
                    {
                        "partial": "partials/admin_board_reports_detail/_card_report_info.json"
                    },
                    {
                        "partial": "partials/admin_board_reports_detail/_card_history.json"
                    }
                ]
            }
        ]
    },
    "modals": [
        {
            "comment": "상태 전환 확인 — 다섯 갈래를 겸한다. 「기각」이면서 대상이 이미 가려져 있으면 그 글이 다시 공개된다는 것을 별도 문구로 먼저 알린다(기각은 되돌리는 동작이라 눈에 안 띄게 노출이 일어날 수 있다)",
            "id": "status_action_modal",
            "type": "composite",
            "name": "Modal",
            "props": {
                "title": "{{_global.actionType === 'pending' ? '$t:sirsoft-board.admin.reports.modals.status_change_pending_title' : _global.actionType === 'review' ? '$t:sirsoft-board.admin.reports.modals.status_change_review_title' : _global.actionType === 'rejected' ? '$t:sirsoft-board.admin.reports.modals.status_change_rejected_title' : _global.actionType === 'deleted' ? '$t:sirsoft-board.admin.reports.modals.status_change_deleted_title' : '$t:sirsoft-board.admin.reports.modals.status_change_suspended_title'}}",
                "size": "medium"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "py-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-gray-700 dark:text-gray-300 mb-4"
                            },
                            "text": "{{_global.actionType === 'pending' ? '$t:sirsoft-board.admin.reports.modals.status_change_pending_confirm_single' : _global.actionType === 'review' ? '$t:sirsoft-board.admin.reports.modals.status_change_review_confirm_single' : _global.actionType === 'rejected' ? '$t:sirsoft-board.admin.reports.modals.status_change_rejected_confirm_single' : _global.actionType === 'deleted' ? '$t:sirsoft-board.admin.reports.modals.status_change_deleted_confirm_single' : '$t:sirsoft-board.admin.reports.modals.status_change_suspended_confirm_single'}}"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "if": "{{_global.actionType === 'rejected' && report_detail.data?.target_status === 'blinded'}}",
                            "props": {
                                "className": "mb-4 flex-center gap-2 p-2.5 bg-orange-50 dark:bg-orange-900/20 rounded-md"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "eye",
                                        "className": "text-base text-orange-600 dark:text-orange-400 flex-shrink-0"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-xs text-orange-700 dark:text-orange-300"
                                    },
                                    "text": "$t:sirsoft-board.admin.reports.modals.blinded_will_be_public|count=1"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "form-label"
                            },
                            "text": "$t:sirsoft-board.admin.reports.modals.reason_label"
                        },
                        {
                            "type": "basic",
                            "name": "Textarea",
                            "actions": [
                                {
                                    "comment": "처리 사유를 전역에 담는다 — 아래 확인 버튼이 이 값을 `process_note` 로 보내고, 처리 이력 카드에 그대로 남는다",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "actionReason": "{{$event.target.value}}"
                                    }
                                }
                            ],
                            "props": {
                                "className": "text-primary w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800",
                                "rows": 4,
                                "placeholder": "$t:sirsoft-board.admin.reports.modals.reason_placeholder",
                                "value": "{{_global.actionReason || ''}}"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "modal-footer-buttons"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "closeModal"
                                },
                                {
                                    "comment": "닫으면서 적어 둔 사유도 비운다 — 남겨 두면 다음에 다른 갈래로 열었을 때 앞선 사유가 그대로 실려 나간다",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "actionReason": ""
                                    }
                                }
                            ],
                            "props": {
                                "className": "px-4 py-2 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed",
                                "disabled": "{{_global.isSaving}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:common.cancel"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "확인 ①  저장 중 표시를 켜 두 번 눌리는 것을 막는다(취소 버튼도 같은 값으로 함께 잠긴다)",
                                    "type": "click",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isSaving": true
                                    }
                                },
                                {
                                    "comment": "확인 ②  고른 갈래를 상태 값으로 풀어 보낸다. 성공 뒤 화면에 머무는 대신 같은 주소로 다시 들어가는 이유는 상태·이력·배너가 한꺼번에 달라지기 때문이다",
                                    "type": "click",
                                    "handler": "apiCall",
                                    "target": "/api/modules/sirsoft-board/admin/reports/{{route.id}}/status",
                                    "auth_required": true,
                                    "params": {
                                        "method": "PATCH",
                                        "body": {
                                            "status": "{{_global.actionType === 'pending' ? 'pending' : _global.actionType === 'review' ? 'review' : _global.actionType === 'rejected' ? 'rejected' : _global.actionType === 'deleted' ? 'deleted' : 'suspended'}}",
                                            "process_note": "{{_global.actionReason}}"
                                        }
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "actionReason": "",
                                                "isSaving": false
                                            }
                                        },
                                        {
                                            "handler": "closeModal"
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:sirsoft-board.admin.reports.modals.status_change_success"
                                            }
                                        },
                                        {
                                            "handler": "navigate",
                                            "params": {
                                                "path": "/admin/boards/reports/{{route.id}}",
                                                "mergeQuery": true,
                                                "query": {}
                                            }
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isSaving": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message}}"
                                            }
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "className": "px-4 py-2 text-white rounded-lg disabled:opacity-50 disabled:cursor-not-allowed {{_global.actionType === 'pending' ? 'bg-yellow-600 hover:bg-yellow-700' : _global.actionType === 'review' ? 'bg-blue-600 hover:bg-blue-700' : _global.actionType === 'rejected' ? 'bg-purple-600 hover:bg-purple-700' : _global.actionType === 'suspended' ? 'bg-red-600 hover:bg-red-700' : _global.actionType === 'deleted' ? 'bg-gray-600 hover:bg-gray-700 dark:bg-gray-700 dark:hover:bg-gray-600' : 'bg-blue-600 hover:bg-blue-700'}}",
                                "disabled": "{{_global.isSaving}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "{{_global.isSaving ? $t:common.saving : $t:common.confirm}}"
                                }
                            ]
                        }
                    ]
                }
            ],
            "meta": {
                "editor_label": "$t:sirsoft-board.admin.reports.modals.status_action_editor_label"
            }
        }
    ]
}
