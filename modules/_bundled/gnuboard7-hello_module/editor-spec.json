{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "moduleId": "gnuboard7-hello_module",
  "version": "0.2.0",
  "description": "레이아웃 편집기 스펙 — Hello 모듈이 제공하는 컴포넌트의 팔레트 등재 예시. 확장이 자기 컴포넌트를 편집기에 노출하는 최소 사례이며, 등재하지 않으면 작성자가 편집기에서 그 컴포넌트를 꺼낼 수 없다. 팔레트/능력 선언은 모듈 → 플러그인 → 템플릿 순으로 병합된다.",
  "componentPalette": {
    "comment": "확장 컴포넌트는 레지스트리 등록 이름(`{모듈식별자}.{이름}`)을 그대로 키로 쓴다 — 마크업 태그의 프리픽스와 같은 좌표다. 라벨은 이 모듈의 언어팩 네임스페이스를 쓴다(코어 `editor.*` 네임스페이스를 침범하지 않는다).",
    "groups": [
      {
        "label": "$t:gnuboard7-hello_module.editor.palette.group",
        "kind": "content",
        "components": ["gnuboard7-hello_module.MemoCard"]
      }
    ],
    "entries": {
      "gnuboard7-hello_module.MemoCard": {
        "label": "$t:gnuboard7-hello_module.editor.palette.memo_card.label",
        "requiresDefaultNode": true,
        "defaultNode": {
          "type": "composite",
          "name": "gnuboard7-hello_module.MemoCard",
          "props": {
            "title": "$t:gnuboard7-hello_module.editor.palette.memo_card.sample_title",
            "body": "$t:gnuboard7-hello_module.editor.palette.memo_card.sample_body"
          }
        }
      }
    }
  },
  "componentCapabilities": {
    "gnuboard7-hello_module.MemoCard": {
      "label": "$t:gnuboard7-hello_module.editor.palette.memo_card.label",
      "coreProps": ["id"],
      "styleControls": ["marginAll", "width"]
    }
  }
}
