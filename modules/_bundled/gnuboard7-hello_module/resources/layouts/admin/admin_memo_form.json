{
    "comment": "관리자 메모 작성·수정 화면 — 한 장이 두 모드를 겸하며 route.id 유무가 모드를 가른다.",
    "version": "1.0.0",
    "layout_name": "admin_memo_form",
    "extends": "_admin_base",
    "meta": {
        "title": "{{route?.id ? '$t:gnuboard7-hello_module.admin.memos.form.title_edit' : '$t:gnuboard7-hello_module.admin.memos.form.title_create'}}"
    },
    "data_sources": [
        {
            "id": "memoData",
            "label_key": "$t:gnuboard7-hello_module.editor.data_source.memoData",
            "type": "api",
            "endpoint": "/api/modules/gnuboard7-hello_module/admin/memos/{{route?.id}}",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "if": "{{route?.id}}",
            "initLocal": "form",
            "fallback": {
                "data": null
            },
            "comment": "수정 모드에서만 기존 메모를 받아 폼 초기값으로 넣는다(initLocal=form). 생성 모드는 data-if 가 요청 자체를 걸러 낸다."
        },
        {
            "id": "memoCreateAbility",
            "label_key": "$t:gnuboard7-hello_module.editor.data_source.memoCreateAbility",
            "type": "api",
            "endpoint": "/api/modules/gnuboard7-hello_module/admin/memos",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "if": "{{!route?.id}}",
            "params": {
                "per_page": 1
            },
            "fallback": {
                "data": null
            },
            "comment": "생성 모드의 등록 권한 — 목록 응답의 컬렉션 abilities(can_create)를 한 건만 받아 읽는다. 수정 모드는 memoData 의 can_update 를 본다"
        }
    ],
    "computed": {
        "isReadOnly": "{{route?.id ? memoData?.data?.abilities?.can_update !== true : memoCreateAbility?.data?.abilities?.can_create !== true}}",
        "readOnlyNoticeVisible": "{{route?.id ? (!!memoData?.data && memoData?.data?.abilities?.can_update !== true) : (!!memoCreateAbility?.data && memoCreateAbility?.data?.abilities?.can_create !== true)}}"
    },
    "permissions": [
        "gnuboard7-hello_module.memos.read"
    ],
    "init_actions": [
        {
            "comment": "생성 모드에서 폼 기본값 초기화",
            "handler": "setState",
            "if": "{{!route?.id}}",
            "params": {
                "target": "local",
                "form": {
                    "title": "",
                    "content": ""
                }
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "memo_form_wrapper",
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "admin-page-content"
                },
                "children": [
                    {
                        "id": "memo_form_card",
                        "type": "basic",
                        "name": "Div",
                        "dataKey": "form",
                        "props": {
                            "className": "max-w-2xl mx-auto p-6 bg-white dark:bg-gray-800 rounded-lg shadow"
                        },
                        "children": [
                            {
                                "id": "memo_read_only_banner",
                                "type": "basic",
                                "name": "P",
                                "if": "{{_computed.readOnlyNoticeVisible}}",
                                "props": {
                                    "className": "mb-4 p-3 rounded-lg bg-amber-50 dark:bg-amber-900/20 text-sm text-amber-700 dark:text-amber-300"
                                },
                                "text": "$t:gnuboard7-hello_module.admin.memos.form.read_only"
                            },
                            {
                                "id": "memo_form_title",
                                "type": "basic",
                                "name": "H1",
                                "props": {
                                    "className": "text-page-heading mb-6"
                                },
                                "text": "{{route?.id ? '$t:gnuboard7-hello_module.admin.memos.form.title_edit' : '$t:gnuboard7-hello_module.admin.memos.form.title_create'}}"
                            },
                            {
                                "id": "memo_field_title",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "mb-4"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Label",
                                        "props": {
                                            "className": "form-label-block"
                                        },
                                        "text": "$t:gnuboard7-hello_module.admin.memos.form.fields.title"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Input",
                                        "props": {
                                            "type": "text",
                                            "name": "title",
                                            "className": "",
                                            "disabled": "{{_computed.isReadOnly}}"
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "memo_field_content",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "mb-6"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Label",
                                        "props": {
                                            "className": "form-label-block"
                                        },
                                        "text": "$t:gnuboard7-hello_module.admin.memos.form.fields.content"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Textarea",
                                        "props": {
                                            "name": "content",
                                            "rows": 6,
                                            "className": "",
                                            "disabled": "{{_computed.isReadOnly}}"
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "memo_form_actions",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex-center justify-end gap-2"
                                },
                                "children": [
                                    {
                                        "id": "memo_cancel_button",
                                        "type": "basic",
                                        "name": "Button",
                                        "actions": [
                                            {
                                                "comment": "취소하고 목록으로. 목록 상태를 그대로 넘겨 보던 페이지로 돌아간다",
                                                "type": "click",
                                                "handler": "navigate",
                                                "params": {
                                                    "path": "/admin/memos",
                                                    "mergeQuery": true,
                                                    "query": {}
                                                }
                                            }
                                        ],
                                        "props": {
                                            "type": "button",
                                            "className": "px-4 py-2 bg-white dark:bg-gray-700 text-gray-700 dark:text-gray-200 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 font-medium transition-colors"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "$t:gnuboard7-hello_module.admin.memos.form.actions.cancel"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "memo_save_button",
                                        "type": "basic",
                                        "name": "Button",
                                        "actions": [
                                            {
                                                "comment": "저장 — route.id 유무로 생성(POST)과 수정(PUT)을 같은 버튼에서 가른다. 성공하면 목록으로 돌아간다.",
                                                "type": "click",
                                                "handler": "apiCall",
                                                "target": "{{route?.id ? '/api/modules/gnuboard7-hello_module/admin/memos/' + route?.id : '/api/modules/gnuboard7-hello_module/admin/memos'}}",
                                                "auth_required": true,
                                                "params": {
                                                    "method": "{{route?.id ? 'PUT' : 'POST'}}",
                                                    "body": "{{_local.form}}"
                                                },
                                                "onSuccess": [
                                                    {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "success",
                                                            "message": "{{route?.id ? '$t:gnuboard7-hello_module.admin.memos.form.title_edit' : '$t:gnuboard7-hello_module.admin.memos.form.title_create'}}"
                                                        }
                                                    },
                                                    {
                                                        "handler": "navigate",
                                                        "params": {
                                                            "path": "/admin/memos",
                                                            "mergeQuery": true,
                                                            "query": {}
                                                        }
                                                    }
                                                ],
                                                "onError": {
                                                    "handler": "toast",
                                                    "params": {
                                                        "type": "error",
                                                        "message": "{{error.message ?? 'error'}}"
                                                    }
                                                }
                                            }
                                        ],
                                        "props": {
                                            "type": "button",
                                            "className": "px-4 py-2 bg-blue-600 dark:bg-blue-500 text-white rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed",
                                            "disabled": "{{_computed.isReadOnly}}"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "text": "$t:gnuboard7-hello_module.admin.memos.form.actions.save"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
