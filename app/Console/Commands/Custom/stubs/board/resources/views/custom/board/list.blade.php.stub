@extends('custom.layout')

@section('title', $board['name'] ?? $slug)
@section('footer_note', __('custom::board.list_footer'))

@section('content')
<div class="cx-wrap cx-stack">
    <div class="cx-title-row">
        <div class="cx-stack-tight">
            <h1 class="cx-h1">{{ $board['name'] ?? $slug }}</h1>
            @php($total = (int) ($pagination['total'] ?? 0))
            <p class="cx-muted">{{ trans_choice('custom::board.total', $total, ['count' => number_format($total)]) }}</p>
        </div>
        <a class="cx-button" href="{{ $writeUrl }}">{{ __('custom::board.write') }}</a>
    </div>

    <div class="cx-card cx-table" role="table" aria-label="{{ $board['name'] ?? $slug }}">
        <div class="cx-row cx-row-head" role="row">
            <span role="columnheader">{{ __('custom::board.col_no') }}</span>
            <span role="columnheader">{{ __('custom::board.col_title') }}</span>
            <span role="columnheader" class="cx-hide-sm">{{ __('custom::board.col_author') }}</span>
            <span role="columnheader" class="cx-hide-sm">{{ __('custom::board.col_date') }}</span>
            <span role="columnheader" class="cx-right cx-hide-sm">{{ __('custom::board.col_views') }}</span>
        </div>
        @forelse($posts as $post)
            <div class="cx-row" role="row" data-post-id="{{ $post['id'] }}">
                <span role="cell" class="cx-muted">
                    @if(!empty($post['is_notice']))
                        <span class="cx-chip-notice">{{ __('custom::board.notice') }}</span>
                    @else
                        {{ $post['number'] ?? $post['id'] }}
                    @endif
                </span>
                <span role="cell" class="cx-title-cell">
                    @if(!empty($post['is_secret']))
                        <span class="cx-lock" role="img" aria-label="{{ __('custom::board.secret') }}">&#128274;</span>
                    @endif
                    <a class="cx-post-title" href="/board/{{ $slug }}/{{ $post['id'] }}">{{ $post['title'] }}</a>
                    @if(($post['comment_count'] ?? 0) > 0)
                        <span class="cx-comments">[{{ $post['comment_count'] }}]</span>
                    @endif
                </span>
                <span role="cell" class="cx-muted cx-hide-sm">{{ $post['author']['name'] ?? '' }}</span>
                <span role="cell" class="cx-muted cx-hide-sm">{{ $post['created_at_formatted'] ?? '' }}</span>
                <span role="cell" class="cx-muted cx-right cx-hide-sm">{{ $post['view_count'] ?? 0 }}</span>
            </div>
        @empty
            <div class="cx-row cx-empty">{{ __('custom::board.empty') }}</div>
        @endforelse
    </div>

    @php($current = (int) ($pagination['current_page'] ?? 1))
    @php($last = (int) ($pagination['last_page'] ?? 1))
    @if($last > 1)
        <nav class="cx-pages" aria-label="{{ __('custom::board.pages') }}">
            @if($current > 1)
                <a href="?page={{ $current - 1 }}" aria-label="{{ __('custom::board.prev_page') }}">&lsaquo;</a>
            @endif
            @for($p = max(1, $current - 2); $p <= min($last, $current + 2); $p++)
                <a href="?page={{ $p }}" @if($p === $current) aria-current="page" @endif>{{ $p }}</a>
            @endfor
            @if($current < $last)
                <a href="?page={{ $current + 1 }}" aria-label="{{ __('custom::board.next_page') }}">&rsaquo;</a>
            @endif
        </nav>
    @endif
</div>
@endsection
