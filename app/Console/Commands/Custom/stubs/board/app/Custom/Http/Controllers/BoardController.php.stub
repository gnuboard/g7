<?php

namespace App\Custom\Http\Controllers;

use App\Seo\HtmlSanitizer;
use App\Services\Screen\InternalApiClient;
use App\Services\Screen\InternalApiResponse;
use App\Services\Screen\ScreenAuth;
use App\Support\ScreenUrl;
use App\Support\SiteUrl;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Routing\Controller;
use Symfony\Component\HttpFoundation\Response;

/**
 * 게시판 목록·글보기 견본 (custom:example board)
 *
 * 로그인 판정은 ScreenAuth(서버 세션 + 그 로그인의 토큰), 데이터는 InternalApiClient 로 게시판 공개 API 를 그 회원
 * 자격으로 불러 채운다. API 가 403·404 를 주면 같은 상태 코드의 오류 화면을, 401 이면 로그인 화면으로 보낸다.
 */
class BoardController extends Controller
{
    /**
     * 게시판 글 목록.
     *
     * @param  Request  $request  요청
     * @param  InternalApiClient  $api  내부 API 도구
     * @param  string  $slug  게시판 슬러그
     * @return Response|RedirectResponse 응답
     */
    public function index(Request $request, InternalApiClient $api, string $slug): Response|RedirectResponse
    {
        $this->applyLocale($request);
        $page = max(1, (int) $request->query('page', 1));

        $res = $api->get("/api/modules/sirsoft-board/boards/{$slug}/posts", ['page' => $page]);
        if (! $res->ok()) {
            return $this->failure($res, $slug, $request);
        }

        return response()->view('custom.board.list', [
            'slug' => $slug,
            'board' => $res->json('data.board', []),
            'posts' => $res->json('data.data', []),
            'pagination' => $res->json('data.pagination', []),
            'user' => ScreenAuth::user(),
            'writeUrl' => ScreenUrl::path('board.write', '/board/{slug}/write', ['slug' => $slug]),
        ]);
    }

    /**
     * 글보기.
     *
     * @param  Request  $request  요청
     * @param  InternalApiClient  $api  내부 API 도구
     * @param  HtmlSanitizer  $sanitizer  본문 HTML 정리(코어 SEO 렌더와 같은 정리기)
     * @param  string  $slug  게시판 슬러그
     * @param  int  $id  게시글 ID
     * @return Response|RedirectResponse 응답
     */
    public function show(Request $request, InternalApiClient $api, HtmlSanitizer $sanitizer, string $slug, int $id): Response|RedirectResponse
    {
        $this->applyLocale($request);

        $res = $api->get("/api/modules/sirsoft-board/boards/{$slug}/posts/{$id}");
        if (! $res->ok()) {
            return $this->failure($res, $slug, $request);
        }

        $post = $res->json('data', []);

        // 비밀글을 볼 권한이 없으면 API 는 200 에 본문을 null 로 준다 — 견본은 「권한 없음」 화면으로 바꾼다
        if (! empty($post['is_secret']) && ($post['content'] ?? null) === null) {
            return $this->errorView(403, $slug);
        }

        return response()->view('custom.board.show', [
            'slug' => $slug,
            'post' => $post,
            'board' => $post['board'] ?? [],
            'contentHtml' => ($post['content_mode'] ?? 'html') === 'html'
                ? $sanitizer->sanitize((string) ($post['content'] ?? ''))
                : nl2br(e((string) ($post['content'] ?? ''))),
            'user' => ScreenAuth::user(),
            'editUrl' => ScreenUrl::path('board.edit', '/board/{slug}/{id}/edit', ['slug' => $slug, 'id' => $id]),
            'listUrl' => ScreenUrl::path('board.list', '/board/{slug}', ['slug' => $slug]),
        ]);
    }

    /**
     * 로그아웃 — 서버 세션과 그 로그인의 토큰을 함께 끝낸다 (그누보드7 화면도 로그아웃된다).
     *
     * @param  Request  $request  요청
     * @return RedirectResponse 이전 화면으로
     */
    public function logout(Request $request): RedirectResponse
    {
        ScreenAuth::logout();

        // 돌아갈 주소는 이 사이트 안 경로만 — 다른 사이트로 보내는 열린 리다이렉트를 막는다
        $return = (string) $request->input('return', '/');
        if (! str_starts_with($return, '/') || str_starts_with($return, '//') || str_contains($return, '\\')) {
            $return = '/';
        }

        // 상대 경로를 그대로 넘기면 요청 Host 로 절대화된다 — 사이트 주소로 만든다
        return redirect(SiteUrl::absolute($return));
    }

    /**
     * API 실패를 화면 응답으로 바꿉니다.
     *
     * @param  InternalApiResponse  $res  API 응답
     * @param  string  $slug  게시판 슬러그
     * @param  Request  $request  요청
     * @return Response|RedirectResponse 응답
     */
    private function failure(InternalApiResponse $res, string $slug, Request $request): Response|RedirectResponse
    {
        if ($res->status() === 401) {
            $login = ScreenUrl::path('auth.login', '/login');

            // 주소 필터가 쿼리를 붙인 경로를 돌려줄 수 있다 — 이미 ? 가 있으면 & 로 잇는다
            $separator = str_contains($login, '?') ? '&' : '?';

            return redirect(SiteUrl::absolute($login.$separator.'redirect='.rawurlencode($request->getRequestUri())));
        }

        if (! in_array($res->status(), [403, 404], true)) {
            abort($res->status() >= 400 ? $res->status() : 500);
        }

        return $this->errorView($res->status(), $slug);
    }

    /**
     * 403·404 오류 화면을 그 상태 코드로 돌려줍니다.
     *
     * @param  int  $status  상태 코드
     * @param  string  $slug  게시판 슬러그
     * @return Response 응답
     */
    private function errorView(int $status, string $slug): Response
    {
        return response()->view('custom.board.error', [
            'status' => $status,
            'slug' => $slug,
            'user' => ScreenAuth::user(),
        ], $status);
    }

    /**
     * `?locale=` 로 화면 언어를 고릅니다 (지원 로케일만).
     *
     * @param  Request  $request  요청
     * @return void 반환값 없음
     */
    private function applyLocale(Request $request): void
    {
        $locale = (string) $request->query('locale', '');
        if ($locale !== '' && in_array($locale, (array) config('app.supported_locales', ['ko', 'en']), true)) {
            app()->setLocale($locale);
        }
    }
}
