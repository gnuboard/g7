<?php

namespace App\Custom\Http\Controllers;

use App\Services\Screen\InternalApiClient;
use App\Services\Screen\ScreenAuth;
use App\Support\Custom\CustomStatus;
use Illuminate\Routing\Controller;
use Illuminate\View\View;

/**
 * 관리자 화면 견본 (custom:example board) — routes/custom.php 에서 custom.admin 미들웨어로 막는다.
 *
 * 사이트 이름은 관리자 공개 설정 API(`/api/admin/frontend-config`)에서, custom 라우트·패키지 현황은
 * `php artisan custom:check` 와 같은 함수(CustomStatus)에서 읽는다.
 */
class AdminExampleController extends Controller
{
    /**
     * 관리자 견본 화면.
     *
     * @param  InternalApiClient  $api  내부 API 도구
     * @return View 화면
     */
    public function index(InternalApiClient $api): View
    {
        $config = $api->get('/api/admin/frontend-config');

        return view('custom.admin.example', [
            'siteName' => (string) $config->json('data.settings.general.site_name', config('app.name')),
            'admin' => ScreenAuth::user(),
            'status' => CustomStatus::collect(),
        ]);
    }
}
