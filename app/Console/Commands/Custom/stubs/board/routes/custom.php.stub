<?php

/*
|--------------------------------------------------------------------------
| 개발자 화면 라우트 (custom 예약 자리)
|--------------------------------------------------------------------------
|
| 이 파일은 그누보드7 코어 업데이트가 덮지도 지우지도 않습니다. 여기 등록한 GET 주소는 그누보드7 화면보다
| 먼저 처리되고, 등록하지 않은 주소는 그누보드7 화면이 그대로 그립니다.
|
| - web 미들웨어(세션·CSRF·로케일)와 custom.screen(정식 주소 이동·방문 통계·봇 기록)이 자동으로 붙습니다.
| - 회원 필수: ->middleware('custom.auth') / 관리자 필수: ->middleware('custom.admin')
| - /api·/plugins·/modules·/build·/storage·/install 와 정적 파일 확장자 주소는 등록되지 않습니다.
| - 확인: php artisan custom:check
|
| 이 견본은 `php artisan custom:example board` 가 만들었습니다.
*/

use App\Custom\Http\Controllers\AdminExampleController;
use App\Custom\Http\Controllers\BoardController;
use Illuminate\Support\Facades\Route;

// 게시판 목록·글보기를 서버(Blade)가 그린다. 글쓰기(/board/{slug}/write)·수정은 등록하지 않아 그누보드7 화면이 그린다.
Route::get('/board/{slug}', [BoardController::class, 'index'])
    ->where('slug', '[A-Za-z0-9_-]+')
    ->name('custom.board.index');
Route::get('/board/{slug}/{id}', [BoardController::class, 'show'])
    ->where('slug', '[A-Za-z0-9_-]+')
    ->whereNumber('id')
    ->name('custom.board.show');
Route::post('/custom-example/logout', [BoardController::class, 'logout'])
    ->name('custom.example.logout');

// HTML + jQuery 견본 — 서버는 .html 파일을 그대로 내보내고, 데이터는 브라우저의 jQuery 가 API 로 가져온다.
Route::get('/custom-jquery-example', fn () => view('custom.jquery.index'))
    ->name('custom.jquery.example');

// 관리자 화면 견본 — 관리자만(비로그인은 관리자 로그인으로, 일반 회원은 403)
Route::get('/admin/custom-example', [AdminExampleController::class, 'index'])
    ->middleware('custom.admin')
    ->name('custom.admin.example');
