/* custom:example board 견본 스타일 — 견본 화면(cx-*)에만 쓰인다. 지우거나 바꿔도 그누보드7 화면에는 영향이 없다. */
:root {
  --cx-bg: #f6f7f9;
  --cx-surface: #ffffff;
  --cx-text: #1f2328;
  --cx-muted: #656d76;
  --cx-border: #d8dee4;
  --cx-accent: #2563eb;
  --cx-accent-text: #ffffff;
  --cx-ok: #1a7f37;
  --cx-bad: #cf222e;
  --cx-radius: 10px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --cx-bg: #0d1117;
    --cx-surface: #161b22;
    --cx-text: #e6edf3;
    --cx-muted: #8d96a0;
    --cx-border: #30363d;
    --cx-accent: #4c8dff;
    --cx-ok: #3fb950;
    --cx-bad: #f85149;
  }
}

* { box-sizing: border-box; }
/* display 를 지정한 클래스가 hidden 속성을 덮지 않게 한다(jQuery 견본이 hidden 으로 영역을 숨긴다) */
[hidden] { display: none !important; }

.cx-body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--cx-bg);
  color: var(--cx-text);
  font: 15px/1.6 system-ui, -apple-system, "Segoe UI", "Malgun Gothic", sans-serif;
}

.cx-body a { color: inherit; }
.cx-wrap { width: 100%; max-width: 1040px; margin: 0 auto; padding: 0 16px; }
.cx-narrow { max-width: 820px; }
.cx-main { flex: 1; padding: 32px 0; }
.cx-stack { display: flex; flex-direction: column; gap: 20px; }
.cx-stack-tight { display: flex; flex-direction: column; gap: 6px; }
.cx-push { margin-left: auto; }
.cx-right { text-align: right; }
.cx-muted { color: var(--cx-muted); }
.cx-h1 { margin: 0; font-size: 1.5rem; line-height: 1.3; }
.cx-h2 { margin: 0; font-size: 1.05rem; }
.cx-pad { padding: 16px 20px; }
.cx-inline { display: inline; margin: 0; }
.cx-ok { color: var(--cx-ok); }
.cx-bad { color: var(--cx-bad); }

/* 머리말·꼬리말 */
.cx-header { background: var(--cx-surface); border-bottom: 1px solid var(--cx-border); }
.cx-header-row { display: flex; align-items: center; gap: 20px; min-height: 60px; flex-wrap: wrap; }
.cx-brand { font-weight: 700; text-decoration: none; }
.cx-nav { display: flex; gap: 16px; }
.cx-nav a { text-decoration: none; color: var(--cx-muted); }
.cx-nav a[aria-current="page"] { color: var(--cx-text); font-weight: 600; }
.cx-account { margin-left: auto; display: flex; align-items: center; gap: 12px; }
.cx-member { font-weight: 600; }
.cx-footer { border-top: 1px solid var(--cx-border); background: var(--cx-surface); padding: 16px 0; font-size: 0.85rem; color: var(--cx-muted); }
.cx-footer-row { display: flex; gap: 12px; align-items: flex-start; }
.cx-badge, .cx-chip { display: inline-block; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--cx-border); font-size: 0.75rem; white-space: nowrap; }
.cx-chip-notice { display: inline-block; padding: 0 6px; border-radius: 4px; background: var(--cx-accent); color: var(--cx-accent-text); font-size: 0.75rem; }

/* 버튼·입력 */
.cx-button, .cx-button-outline, .cx-link-button {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 14px; border-radius: 8px; font: inherit; cursor: pointer; text-decoration: none;
}
.cx-button { background: var(--cx-accent); color: var(--cx-accent-text) !important; border: 1px solid var(--cx-accent); }
.cx-button-outline { background: transparent; color: var(--cx-text); border: 1px solid var(--cx-border); }
.cx-link-button { padding: 0; border: 0; background: none; color: var(--cx-muted); }
.cx-input { width: 100%; padding: 8px 10px; border: 1px solid var(--cx-border); border-radius: 8px; background: var(--cx-bg); color: var(--cx-text); font: inherit; }
.cx-error-text { margin: 0; color: var(--cx-bad); }

/* 카드·목록 */
.cx-card { background: var(--cx-surface); border: 1px solid var(--cx-border); border-radius: var(--cx-radius); }
.cx-title-row { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
.cx-title-row .cx-button { margin-left: auto; }
.cx-table { overflow: hidden; }
.cx-row { display: grid; grid-template-columns: 64px 1fr 120px 110px 64px; gap: 12px; padding: 12px 20px; border-top: 1px solid var(--cx-border); align-items: center; }
.cx-row:first-child { border-top: 0; }
.cx-row-head { font-size: 0.8rem; color: var(--cx-muted); background: var(--cx-bg); }
.cx-row-3 { grid-template-columns: 1fr 140px 1fr; }
.cx-row-4 { grid-template-columns: 110px 1fr 1fr 140px; }
.cx-empty { display: block; text-align: center; color: var(--cx-muted); padding: 32px; }
.cx-title-cell { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cx-post-title { text-decoration: none; }
.cx-post-title:hover { text-decoration: underline; }
.cx-comments { color: var(--cx-accent); font-size: 0.85rem; }
.cx-pages { display: flex; justify-content: center; gap: 6px; }
.cx-pages a { min-width: 36px; padding: 6px 10px; text-align: center; border: 1px solid var(--cx-border); border-radius: 8px; text-decoration: none; background: var(--cx-surface); }
.cx-pages a[aria-current="page"] { background: var(--cx-accent); border-color: var(--cx-accent); color: var(--cx-accent-text); }
.cx-list { list-style: none; margin: 0; padding: 0; }
.cx-list-item { display: grid; grid-template-columns: 1fr auto auto; gap: 12px; padding: 12px 20px; border-top: 1px solid var(--cx-border); }

/* 글 보기 */
.cx-crumb { display: flex; gap: 8px; font-size: 0.85rem; color: var(--cx-muted); }
.cx-post { padding: 24px; display: flex; flex-direction: column; gap: 20px; }
.cx-post-head { display: flex; flex-direction: column; gap: 8px; padding-bottom: 16px; border-bottom: 1px solid var(--cx-border); }
.cx-meta { display: flex; gap: 14px; flex-wrap: wrap; font-size: 0.85rem; color: var(--cx-muted); }
.cx-content { overflow-wrap: anywhere; }
.cx-content img { max-width: 100%; height: auto; }
.cx-attachments { display: flex; flex-direction: column; gap: 4px; padding: 12px; border-radius: 8px; background: var(--cx-bg); }
.cx-actions { display: flex; gap: 8px; align-items: center; }
.cx-comments-box { padding: 20px; display: flex; flex-direction: column; gap: 12px; }
.cx-comment { display: flex; flex-direction: column; gap: 2px; padding-top: 12px; border-top: 1px solid var(--cx-border); }
.cx-comment-author { font-weight: 600; font-size: 0.9rem; }
.cx-prevnext { display: flex; flex-direction: column; }
.cx-prevnext a { padding: 12px 20px; text-decoration: none; border-top: 1px solid var(--cx-border); }
.cx-prevnext a:first-child { border-top: 0; }

/* 오류 */
.cx-center { display: flex; justify-content: center; }
.cx-error { max-width: 520px; width: 100%; padding: 40px 28px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
.cx-error-icon { font-size: 2rem; }
.cx-error-code { font-size: 0.85rem; color: var(--cx-muted); letter-spacing: 0.1em; }
.cx-center-actions { justify-content: center; margin-top: 8px; }

/* jQuery 견본 */
.cx-jq-grid { display: grid; grid-template-columns: 320px 1fr; gap: 20px; align-items: start; }
.cx-code-note { margin-top: 8px; padding: 10px; border-radius: 8px; background: var(--cx-bg); font: 0.8rem/1.5 ui-monospace, Consolas, monospace; color: var(--cx-muted); }

/* 관리자 견본 */
.cx-admin { flex-direction: row; }
.cx-sidebar { width: 220px; flex-shrink: 0; padding: 20px 16px; background: var(--cx-surface); border-right: 1px solid var(--cx-border); display: flex; flex-direction: column; gap: 16px; }
.cx-sidebar-brand { font-weight: 700; }
.cx-sidebar-nav { display: flex; flex-direction: column; gap: 4px; }
.cx-sidebar-nav a { padding: 6px 10px; border-radius: 6px; text-decoration: none; color: var(--cx-muted); }
.cx-sidebar-nav a[aria-current="page"] { background: var(--cx-bg); color: var(--cx-text); font-weight: 600; }
.cx-sidebar-note { margin: auto 0 0; font-size: 0.8rem; color: var(--cx-muted); }
.cx-admin-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.cx-admin-header { display: flex; align-items: center; gap: 12px; padding: 14px 24px; background: var(--cx-surface); border-bottom: 1px solid var(--cx-border); }
.cx-admin-main { padding: 24px; }
.cx-grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.cx-stat { padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
.cx-stat-value { font-size: 1.25rem; font-weight: 700; }
.cx-admin code { font-size: 0.85rem; overflow-wrap: anywhere; }

/* 좁은 화면 */
@media (max-width: 720px) {
  .cx-hide-sm { display: none; }
  .cx-row { grid-template-columns: 48px 1fr; }
  .cx-row-3, .cx-row-4 { grid-template-columns: 1fr; gap: 4px; }
  .cx-list-item { grid-template-columns: 1fr; gap: 2px; }
  .cx-nav { order: 3; width: 100%; }
  .cx-jq-grid, .cx-grid-2 { grid-template-columns: 1fr; }
  .cx-admin { flex-direction: column; }
  .cx-sidebar { width: 100%; border-right: 0; border-bottom: 1px solid var(--cx-border); }
  .cx-footer-row { flex-direction: column; }
}
