/*
 * HTML + jQuery 견본 스크립트 (custom:example board)
 *
 * 로그인 API 로 받은 토큰을 localStorage('auth_token')에 두고, 게시판 공개 API 를 Bearer 로 부른다.
 * 그누보드7 화면과 같은 저장 키라 같은 브라우저에서 로그인 상태를 공유한다.
 */
(function ($) {
  'use strict';

  var TOKEN_KEY = 'auth_token';
  var BOARD = 'free';

  function token() {
    try { return window.localStorage.getItem(TOKEN_KEY); } catch (e) { return null; }
  }

  function api(method, url, data) {
    var headers = { Accept: 'application/json' };
    var t = token();
    if (t) { headers.Authorization = 'Bearer ' + t; }
    return $.ajax({
      method: method,
      url: url,
      headers: headers,
      contentType: data ? 'application/json' : undefined,
      data: data ? JSON.stringify(data) : undefined,
      dataType: 'json'
    });
  }

  function renderPosts() {
    var $list = $('#jq-posts').empty();
    $('#jq-list-note').text(token() ? '회원 토큰으로 불러옴' : '비회원으로 불러옴');
    return api('GET', '/api/modules/sirsoft-board/boards/' + BOARD + '/posts').done(function (res) {
      var posts = (res && res.data && res.data.data) || [];
      $.each(posts, function (_, post) {
        var $li = $('<li class="cx-list-item"/>').attr('data-post-id', post.id);
        $('<a class="cx-post-title"/>').attr('href', '/board/' + BOARD + '/' + post.id).text(post.title).appendTo($li);
        $('<span class="cx-muted"/>').text((post.author && post.author.name) || '').appendTo($li);
        $('<span class="cx-muted cx-date"/>').text(post.created_at_formatted || '').appendTo($li);
        $list.append($li);
      });
    });
  }

  function renderAccount() {
    if (!token()) {
      $('#jq-account').prop('hidden', true);
      $('#jq-logged-in').prop('hidden', true);
      $('#jq-login-form').prop('hidden', false);
      return $.Deferred().resolve().promise();
    }
    return api('GET', '/api/auth/user').done(function (res) {
      var user = (res && res.data) || {};
      $('#jq-member').text((user.nickname || user.name || '') + '님');
      $('#jq-account').prop('hidden', false);
      $('#jq-logged-in').prop('hidden', false);
      $('#jq-login-form').prop('hidden', true);
    }).fail(function () {
      try { window.localStorage.removeItem(TOKEN_KEY); } catch (e) { /* 무시 */ }
      $('#jq-account').prop('hidden', true);
      $('#jq-login-form').prop('hidden', false);
    });
  }

  $('#jq-login-form').on('submit', function (event) {
    event.preventDefault();
    $('#jq-error').prop('hidden', true).text('');
    api('POST', '/api/auth/login', { email: $('#jq-email').val(), password: $('#jq-password').val() })
      .done(function (res) {
        try { window.localStorage.setItem(TOKEN_KEY, res.data.token); } catch (e) { /* 무시 */ }
        renderAccount();
        renderPosts();
      })
      .fail(function (xhr) {
        var message = (xhr.responseJSON && xhr.responseJSON.message) || '로그인에 실패했습니다.';
        $('#jq-error').text(message).prop('hidden', false);
      });
  });

  $('#jq-logout').on('click', function () {
    api('POST', '/api/auth/logout').always(function () {
      try { window.localStorage.removeItem(TOKEN_KEY); } catch (e) { /* 무시 */ }
      renderAccount();
      renderPosts();
    });
  });

  renderAccount();
  renderPosts();
})(window.jQuery);
