{
    "render_policy": {
        "version": 1,
        "forbid_tags": [
            "script",
            "noscript",
            "iframe",
            "frame",
            "frameset",
            "object",
            "embed",
            "applet",
            "portal",
            "form",
            "input",
            "textarea",
            "select",
            "button",
            "style",
            "link",
            "meta",
            "base",
            "body",
            "head",
            "html",
            "title",
            "svg",
            "math",
            "audio",
            "video",
            "source",
            "track",
            "canvas",
            "details",
            "dialog",
            "plaintext",
            "xmp",
            "listing",
            "marquee",
            "noframes",
            "noembed",
            "template",
            "slot"
        ],
        "extra_tags": [
            "figure",
            "figcaption",
            "oembed"
        ],
        "attributes": {
            "figure": [
                "class"
            ],
            "figcaption": [
                "class"
            ],
            "oembed": [
                "url"
            ]
        },
        "custom_tags": [],
        "media_src_patterns": [
            "^/api/(?:modules|plugins)/[a-z0-9_-]+/(?:[a-z0-9_-]+/)*content-media/[A-Za-z0-9]{12}(?:\\?[^\"'<>\\s]*)?$"
        ],
        "allow_external_embed": true,
        "allow_uploaded_video": false,
        "allow_uploaded_audio": false,
        "embed_providers": [
            {
                "id": "youtube",
                "name": "YouTube",
                "source": "preset",
                "patterns": [
                    "^https?://(?:[^/?#.]+\\.)*youtube\\.com\\/watch\\?v=(?<id>[A-Za-z0-9_-]{11})/?(?:[?&#].*)?$",
                    "^https?://youtu\\.be\\/(?<id>[A-Za-z0-9_-]{11})/?(?:[?&#].*)?$",
                    "^https?://(?:[^/?#.]+\\.)*youtube\\.com\\/shorts\\/(?<id>[A-Za-z0-9_-]{11})/?(?:[?&#].*)?$",
                    "^https?://(?:[^/?#.]+\\.)*youtube\\.com\\/embed\\/(?<id>[A-Za-z0-9_-]{11})/?(?:[?&#].*)?$"
                ],
                "aspects": [
                    "16:9",
                    "16:9",
                    "9:16",
                    "16:9"
                ],
                "player_url": "https://www.youtube-nocookie.com/embed/{id}",
                "aspect": "16:9",
                "allow": [
                    "fullscreen",
                    "encrypted-media",
                    "picture-in-picture"
                ]
            },
            {
                "id": "vimeo",
                "name": "Vimeo",
                "source": "preset",
                "patterns": [
                    "^https?://vimeo\\.com\\/(?<id>[0-9]{1,64})/?(?:[?&#].*)?$",
                    "^https?://player\\.vimeo\\.com\\/video\\/(?<id>[0-9]{1,64})/?(?:[?&#].*)?$"
                ],
                "aspects": [
                    "16:9",
                    "16:9"
                ],
                "player_url": "https://player.vimeo.com/video/{id}",
                "aspect": "16:9",
                "allow": [
                    "fullscreen",
                    "encrypted-media",
                    "picture-in-picture"
                ]
            },
            {
                "id": "tiktok",
                "name": "TikTok",
                "source": "preset",
                "patterns": [
                    "^https?://(?:[^/?#.]+\\.)*tiktok\\.com\\/@[^/?#]*\\/video\\/(?<id>[0-9]{1,64})/?(?:[?&#].*)?$"
                ],
                "aspects": [
                    "9:16"
                ],
                "player_url": "https://www.tiktok.com/player/v1/{id}",
                "aspect": "9:16",
                "allow": [
                    "fullscreen",
                    "encrypted-media",
                    "picture-in-picture"
                ]
            },
            {
                "id": "chzzk_clip",
                "name": "치지직 클립",
                "source": "custom",
                "patterns": [
                    "^https?://chzzk\\.naver\\.com\\/clips\\/(?<id>[A-Za-z0-9_-]{1,64})/?(?:[?&#].*)?$"
                ],
                "aspects": [
                    "16:9"
                ],
                "player_url": "https://chzzk.naver.com/embed/clip/{id}",
                "aspect": "16:9",
                "allow": [
                    "fullscreen"
                ]
            }
        ]
    },
