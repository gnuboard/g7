APP_NAME=그누보드7
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_VERSION=7.2.1

# 리버스 프록시(AWS ALB, CloudFront, Cloudflare, nginx, ngrok) 뒤에서 HTTPS 를 인식하려면
# 신뢰할 프록시를 지정합니다. 미설정 시 아무 프록시도 신뢰하지 않습니다(기존 동작).
#   *  = 직전 호출 IP 만 신뢰 (동일 호스트 프록시·ALB. ** 도 동일하게 동작합니다)
#   IP,IP/CIDR = 지정 목록만 신뢰 (프록시가 여러 단이면 모든 단을 나열해야 합니다)
# * 은 앱이 프록시 없이는 도달 불가한 구성에서만 사용하세요 — docs/backend/reverse-proxy.md
# TRUSTED_PROXIES=*

# 요청 Host 가 APP_URL 의 도메인(하위 도메인 포함)이 아니면 요청을 받지 않습니다(설치 완료 후, 운영 환경).
# APP_URL 의 www 쌍(www.example.com <-> example.com)은 자동으로 허용되고 화면 요청은 APP_URL 로 이동합니다.
# 다른 도메인으로도 접속한다면 콤마로 나열하세요. 접속이 막혔을 때의 비상 스위치: TRUSTED_HOSTS_ENABLED=false
# TRUSTED_HOSTS=example.org,www.example.org
# APP_URL 이 아닌 주소(하위 도메인·다른 포트·위 별칭)로 들어온 화면 요청은 APP_URL 주소로 이동합니다(301). 끄려면:
# CANONICAL_HOST_REDIRECT=false

# 메일·알림·문자에 싣는 화면 링크(회원용·관리자용)의 주소. 비우면 APP_URL 을 씁니다.
# 같은 DB 를 쓰는 서버를 공개 주소와 다른 주소로 띄울 때(예: 검수용 사이트) 그 서버가 보내는 메일의 링크가
# 공개 주소를 가리키게 하려면 공개 주소를 적습니다. 환경설정 「사용자 화면 URL」을 정했으면 회원용 링크는 그 값이 우선합니다.
# 결제·본인인증·소셜 로그인 콜백·웹훅 주소와 결제·본인인증 뒤 브라우저가 돌아가는 주소는 이 값을 따르지 않고
# APP_URL(회원 화면은 「사용자 화면 URL」)을 씁니다.
# G7_PUBLIC_LINK_URL=https://example.com

# HTTPS 사이트에서 세션 쿠키에 Secure 속성을 강제합니다(미설정 시 요청 스킴으로 자동 판정).
# SESSION_SECURE_COOKIE=true

APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_FAKER_LOCALE=ko_KR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

PHP_BINARY=php
COMPOSER_BINARY=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 설치 직후 기본값은 운영 기준(error). 관리자 환경설정 > 고급에서 조정하며,
# 그 값이 이 항목보다 우선합니다. debug 로 두면 정상 동작 기록까지 매 요청 쌓입니다.
LOG_LEVEL=error

DB_CONNECTION=mysql

# Write Database Connection (Primary)
DB_WRITE_HOST=127.0.0.1
DB_WRITE_PORT=3306
DB_WRITE_DATABASE=g7
DB_WRITE_USERNAME=root
DB_WRITE_PASSWORD=

# Database Table Prefix (optional)
DB_PREFIX=g7_

# Read Database Connection (Optional)
# 비워두면 각 항목이 대응하는 DB_WRITE_* 값으로 대체됩니다 (config/database.php).
# Read 전용 DB(리플리카)를 쓸 때만 값을 채우세요.
DB_READ_HOST=
DB_READ_PORT=
DB_READ_DATABASE=
DB_READ_USERNAME=
DB_READ_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=g7-session

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# 긴 작업 전용 연결(database-long·redis-long)의 retry_after(초) — 최장 잡 3600 + 여유 300
DB_QUEUE_LONG_RETRY_AFTER=3900
REDIS_QUEUE_LONG_RETRY_AFTER=3900

# 알림 대량 발송 — 수신자가 이 수를 넘으면 묶음별 자식 잡으로 나눠 보낸다
NOTIFICATION_FANOUT_CHUNK_SIZE=100
# 수신자 한 명에게 보내는 동안 다른 사본이 손대지 못하게 잡아 두는 시간(초) — SMTP 1건 최장 응답보다 길게
NOTIFICATION_DELIVERY_CLAIM_LEASE=60
# 수신자별 발송 기록(notification_deliveries) 보관 일수
NOTIFICATION_DELIVERY_RETENTION_DAYS=7

# Laravel Scout (검색엔진)
SCOUT_DRIVER=mysql-fulltext

# Laravel Reverb (WebSocket)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=https
REVERB_VERIFY_SSL=true

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
CACHE_PREFIX=g7-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PREFIX=g7-database-
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# 아래 3키는 사용할 때만 주석을 해제하세요 — 값 없는 `KEY=` 는 "미설정" 이 아니라
# 빈 문자열로 적용됩니다 (S3 공개 URL / S3 호환 엔드포인트 / 첨부 디스크 강제 지정)
# AWS_URL=
# AWS_ENDPOINT=
# ATTACHMENT_DISK=

# 이미지 썸네일 서버 보호 값 (선택) — 관리자 환경설정 > 업로드 「고급」 칸과 같은 값입니다.
# 화면 칸을 비워 두면 여기 값을, 여기에도 없으면 기본값을 씁니다. 화면에 값을 저장하면 그 값이 이기고,
# 아래 G7_ENV_PRIORITY=true 를 켜면 여기 적은 항목이 이기고 화면 칸은 잠깁니다.
#   G7_THUMBNAIL_GENERATE_PER_MINUTE  IP 하나가 1분에 새로 만드는 썸네일 수 (기본 120, 1~10000)
#   G7_THUMBNAIL_LOCK_WAIT_SECONDS    같은 썸네일을 다른 요청이 만들 때 기다리는 초 (기본 10, 1~30)
#   G7_THUMBNAIL_MAX_SOURCE_PIXELS    썸네일을 만들 원본의 최대 픽셀 수 (기본 16000000, 1000000~100000000)
#   G7_THUMBNAIL_PREGENERATE_BATCH    「기존 이미지 썸네일 만들기」 한 번에 처리하는 원본 수 (기본 20, 1~500)
#   G7_THUMBNAIL_PREGENERATE_TIME_BUDGET  위 작업 한 번 호출의 시간 예산 초 (기본 15, 1~60)
#   G7_THUMBNAIL_PURGE_TIME_BUDGET    썸네일 「비우기」 한 번 호출의 시간 예산 초 (기본 10, 1~60)
# G7_THUMBNAIL_GENERATE_PER_MINUTE=120
# G7_THUMBNAIL_LOCK_WAIT_SECONDS=10
# G7_THUMBNAIL_MAX_SOURCE_PIXELS=16000000
# G7_THUMBNAIL_PREGENERATE_BATCH=20
# G7_THUMBNAIL_PREGENERATE_TIME_BUDGET=15
# G7_THUMBNAIL_PURGE_TIME_BUDGET=10

# 웹서버 파일 위임 (선택) — 관리자 환경설정 > 드라이버 「웹서버 파일 위임」과 같은 값입니다(none / x-sendfile / x-accel-redirect).
# 웹서버 설정이 함께 필요합니다(docs/backend/file-serving-delegation.md). 화면 저장값이 이기며, G7_ENV_PRIORITY=true 면 여기 값이 이깁니다.
# G7_FILE_DELEGATION=none
# G7_FILE_DELEGATION_ACCEL_PREFIX=/_g7_sendfile/

VITE_APP_NAME="${APP_NAME}"

# ── .env 키 단위 우선 (선택) ────────────────────────────────────────────────
# 기본값은 관리자 환경설정(admin UI)이 운영 SSoT 이고, 저장된 값이 아래 항목들의
# .env 값을 덮습니다. 이 스위치를 켜면 .env 에 **값이 명시된 항목만** 그 덮어쓰기에서
# 빠져 .env 가 권위를 갖고, 관리자 화면의 해당 필드는 편집 불가로 표시됩니다.
# 켜지 않으면 아무 것도 달라지지 않습니다(기존 설치 무영향).
# 주의: 이 파일은 값을 채워 배포되므로, 켜는 즉시 APP_NAME·LOG_LEVEL·
#       G7_UPDATE_GITHUB_URL 같은 이미 채워진 항목이 함께 잠깁니다.
#       .env 만 편집한 뒤에는 php artisan config:cache 를 다시 실행해야 반영됩니다.
#       대상 항목과 규약: docs/backend/admin-settings-access.md
# G7_ENV_PRIORITY=true

# bootstrap/cache 의 캐시 파일(확장 오토로드·훅·설정·라우트)이 없을 때 스스로 다시 만든다(기본 켬).
# 훅·설정·라우트 캐시는 운영 환경(APP_ENV=production, 디버그 꺼짐)의 웹 요청에서만 만든다.
# 캐시를 일부러 두지 않는 운영이라면 false 로 끈다.
# G7_CACHE_SELF_HEAL=false

# 코어 업데이트
G7_UPDATE_GITHUB_URL=https://github.com/gnuboard/g7
G7_UPDATE_GITHUB_TOKEN=
G7_UPDATE_PENDING_PATH=

# spawn 자식 프로세스 실패 시 동작 모드 (기본: abort)
#   - abort    : 즉시 abort + 운영자에게 수동 명령 안내 (안전 우선, stale 메모리 fatal 차단)
#   - fallback : in-process fallback 진행 (proc_open 미지원 공유 호스팅 호환, stale 메모리 위험 잔존)
# G7_UPDATE_SPAWN_FAILURE_MODE=abort

# 점검 모드(php artisan down) 중에도 들어올 수 있는 클라이언트 IP — 쉼표 구분, CIDR 허용 (신뢰 프록시 기준 IP)
# 비밀 주소(down --secret=…)·아래 통과 경로와 함께 쓸 수 있습니다.
# G7_MAINTENANCE_ALLOW_IPS=

# 점검 모드 중에도 통과시키는 경로 — 쉼표 구분, * 와일드카드 (예: api/health,webhooks/*)
# php artisan down 에는 경로 예외 옵션이 없어 이 값으로 정합니다.
# G7_MAINTENANCE_EXCEPT=

# 실행 역할 — live(기본) | stage. stage 는 같은 DB·캐시를 쓰는 검수 서버로, 스케줄·큐 워커·사이트맵·SEO 캐시·방문 분석을
# 돌리지 않고 관리자 화면의 확장·코어·언어팩 변경을 막습니다(CLI 는 허용). 공유 설정보다 우선합니다.
# G7_RUNTIME_ROLE=live

# 이 서버가 스케줄을 실행하는지 — on(기본) | off. 여러 서버가 같은 DB 를 쓸 때 한 대만 on 으로 둡니다.
# 공유 설정 system.cron_mode 는 서버마다 다르게 둘 수 없으므로 서버별 구분은 이 값으로 합니다.
# G7_SCHEDULER=on

# 부트스트랩 리소스 정적 게시 (public/build/ext) — 끄면 전면 API 폴백(종전 동작).
# 상태·수동 복구: php artisan ext-static:status / 관리자 > 환경설정 > 일반 「초기 화면 정적 파일」
# G7_STATIC_CACHE=true

# SEO 봇 캐시 상한 (config/core.php seo_cache_limits). 봇 판정은 User-Agent 뿐이라 위장이
# 가능하고, 캐시 키에 쿼리가 들어가므로 값만 바꾼 반복 요청이 매번 렌더·저장을 유발한다.
# 렌더 예산을 넘긴 요청은 오류가 아니라 일반 SPA 응답(X-SEO-Cache: BYPASS)을 받는다.
# G7_SEO_CACHE_MAX_QUERY_PARAMS=10
# G7_SEO_CACHE_MAX_QUERY_LENGTH=512
# G7_SEO_CACHE_MAX_VARIANTS_PER_PATH=50
# G7_SEO_CACHE_MAX_ENTRIES=20000
# G7_SEO_RENDER_MISSES_PER_MINUTE=60
# G7_SEO_STATS_RECORDS_PER_MINUTE=300

# 코어 업데이트 경로 목록 (선택). 재정의 시 **전체 목록을 다시 적는다** — 부분값은 기본 항목을
# 통째로 대체한다 (예: excludes 에서 build/ext 가 빠지면 --prune 이 정적 게시본을 지운다).
# 기본값은 config/app.php 의 update 절과 같다.
# G7_UPDATE_EXCLUDES=node_modules,.git,bootstrap/cache,build/ext
# G7_UPDATE_TARGETS=app,bootstrap,config,database,docs,lang,lang-packs/_bundled,resources,routes,public,tests,upgrades,scripts,artisan,g7-install,composer.json,composer.json.default,composer.lock,package.json,package-lock.json,vite.config.js,vite.config.core.js,vite.config.editor.js,vite.config.devtools.js,vite.config.devdashboard.js,vitest.config.ts,playwright.config.ts,tsconfig.json,tsconfig.app.json,tsconfig.test.json,phpunit.xml,pint.json,.editorconfig,.gitattributes,.gitignore,README.md,README.ko.md,CHANGELOG.md,modules/_bundled,plugins/_bundled,templates/_bundled
# G7_UPDATE_PROTECTED_PATHS=   (기본 목록은 config/app.php 의 update.protected_paths — 재정의할 때 그 목록을 그대로 옮겨 적고 항목을 덧붙인다)
# G7_UPDATE_RESTORE_OWNERSHIP=storage/logs,storage/framework,storage/app/core_pending,storage/app/extension_backups,storage/app/core_backups,storage/app/core_update,bootstrap/cache,vendor,modules,modules/_pending,plugins,plugins/_pending,templates,templates/_pending,lang-packs,lang-packs/_pending,public/build/ext
# G7_UPDATE_RESTORE_OWNERSHIP_GROUP_WRITABLE=storage/logs,storage/framework,storage/app/core_pending,storage/app/extension_backups,storage/app/core_backups,storage/app/core_update,storage/app/core-update,bootstrap/cache,vendor,modules,modules/_pending,plugins,plugins/_pending,templates,templates/_pending,lang-packs,lang-packs/_pending,public/build/ext

# 레이아웃 설치 소스 (기본: auto)
#   - auto : `.g7.html` 소스 파일이 있으면 그것을 설치 시점에 컴파일해 등록, 없으면 `.json` 사용
#   - json : 짝 `.json` 이 있으면 항상 그것을 등록 (`.g7.html` 무시)
# 커맨드별 1회 오버라이드는 `{module|plugin|template}:{install|update|refresh-layout} --layout-source=` 사용.
# LAYOUT_INSTALL_SOURCE=auto

# 스케줄 Shell 유형 (기본: 꺼짐). 스케줄 권한만 받은 관리자 계정이 서버에서 임의 OS 명령을
# 실행하지 못하게 기본 차단하며, 관리자 화면에서는 켤 수 없습니다. ENABLED=true 이고 허용 실행 파일이
# 1개 이상이어야 스케줄 등록 창에서 Shell 을 고를 수 있습니다. 실행 파일은 basename 을 쉼표로 적습니다.
# 셸 기호(| ; $ 리다이렉션 등)는 켜도 거부되므로 복합 명령은 래퍼 스크립트로 등록하세요.
# 바꾼 뒤 설정 캐시를 쓰면 php artisan config:clear (규약: docs/backend/scheduling.md)
# SCHEDULE_SHELL_ENABLED=false
# SCHEDULE_SHELL_ALLOWED_BINARIES=php,python3
