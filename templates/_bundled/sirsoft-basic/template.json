{
    "identifier": "sirsoft-basic",
    "vendor": "sirsoft",
    "name": {
        "ko": "Basic",
        "en": "Basic"
    },
    "version": "1.2.0",
    "license": "MIT",
    "description": {
        "ko": "그누보드7 기본 사용자 템플릿",
        "en": "Gnuboard7 default user template"
    },
    "type": "user",
    "locales": [
        "ko",
        "en"
    ],
    "author": {
        "name": "sirsoft",
        "email": "contact@sirsoft.com",
        "url": "https://sirsoft.com"
    },
    "release_date": "2026-10-10",
    "g7_version": ">=7.1.0",
    "dependencies": {
        "modules": {
            "sirsoft-board": ">=1.2.0",
            "sirsoft-ecommerce": ">=1.3.0",
            "sirsoft-page": ">=1.2.0"
        },
        "plugins": {
            "sirsoft-daum_postcode": ">=1.0.0"
        }
    },
    "assets": {
        "css": [
            "dist/css/components.css"
        ],
        "js": [
            "dist/js/components.iife.js"
        ],
        "fonts": [],
        "images": []
    },
    "components": {
        "basic": [
            "a",
            "button",
            "checkbox",
            "div",
            "form",
            "h1",
            "h2",
            "h3",
            "h4",
            "hr",
            "icon",
            "img",
            "input",
            "label",
            "li",
            "nav",
            "p",
            "section",
            "select",
            "span",
            "svg",
            "table",
            "tbody",
            "td",
            "textarea",
            "th",
            "thead",
            "tr",
            "ul"
        ],
        "composite": [
            "header",
            "footer",
            "mobile-nav",
            "product-card",
            "rich-text-editor",
            "image-gallery",
            "quantity-selector",
            "social-login-buttons",
            "file-uploader",
            "card",
            "modal",
            "toast",
            "pagination",
            "stat-card",
            "status-badge",
            "tab-navigation",
            "empty-state",
            "loading-spinner",
            "breadcrumb",
            "search-bar",
            "dropdown"
        ],
        "layout": [
            "container",
            "flex",
            "grid",
            "section"
        ]
    },
    "error_config": {
        "layouts": {
            "401": "errors/401",
            "403": "errors/403",
            "404": "errors/404",
            "500": "errors/500",
            "503": "errors/503",
            "maintenance": "errors/maintenance"
        }
    },
    "features": {
        "dark_mode": true,
        "responsive": true,
        "multi_language": true,
        "multi_currency": true
    },
    "github_url": "https://github.com/gnuboard/g7-template-sirsoft-basic",
    "github_changelog_url": "https://github.com/gnuboard/g7-template-sirsoft-basic/blob/main/CHANGELOG.md",
    "externals": [
        {
            "id": "fontawesome",
            "type": "style",
            "asset": "vendor/font-awesome/6.4.0/css/all.inlined.css"
        },
        {
            "id": "pretendard",
            "type": "webfont",
            "asset": "vendor/pretendard/1.3.9/pretendard-variable.css"
        }
    ],
    "state_contracts": {
        "shopBase": {
            "description": {
                "ko": "쇼핑몰 경로 앞머리 (예: /shop, 루트면 빈 문자열) — 쇼핑몰 경로 설정에서 온다",
                "en": "Shop path prefix (e.g. /shop, empty string when mounted at root) — derived from the shop route setting"
            },
            "schema": {
                "type": "string"
            },
            "writers": []
        },
        "selectedAddressId": {
            "description": {
                "ko": "배송지 변경 창에서 고른 배송지 ID",
                "en": "Address chosen in the change-address dialog"
            },
            "schema": {
                "type": [
                    "integer",
                    "null"
                ]
            },
            "writers": []
        },
        "changeAddressMode": {
            "description": {
                "ko": "배송지 변경 창의 모드 (목록·새 배송지 등)",
                "en": "Mode of the change-address dialog"
            },
            "schema": {
                "type": "string"
            },
            "writers": []
        },
        "editingShippingAddress": {
            "description": {
                "ko": "배송지 변경 창에서 고치는 중인 주소",
                "en": "Address being edited in the change-address dialog"
            },
            "schema": {
                "type": [
                    "object",
                    "null"
                ]
            },
            "writers": []
        }
    }
}
