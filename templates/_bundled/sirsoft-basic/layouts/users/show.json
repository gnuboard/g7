                        "type": "layout",
                        "name": "Container",
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "py-4"
                                }
                            }
                        },
                        "props": {
                            "className": "py-8"
                        },
                        "children": [
                            {
                                "comment": "로딩/에러 상태 처리",
                                "type": "basic",
                                "name": "Div",
                                "if": "{{profile.loading}}",
                                "props": {
                                    "className": "flex justify-center items-center py-20"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900 dark:border-white"
                                        }
                                    }
                                ]
                            },
                            {
                                "comment": "프로필 내용",
                                "type": "basic",
                                "name": "Div",
                                "if": "{{profile.data && !profile.loading && !profile.error}}",
