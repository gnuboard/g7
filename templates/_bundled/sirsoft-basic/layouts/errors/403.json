{
    "comment": "403 권한 없음 — 로그인은 했지만 볼 자격이 없을 때다. 비공개 게시판 등이 본문 자리(content)에만 이 화면을 세우기도 하므로 헤더·푸터는 그대로 남는다.",
    "version": "1.0.0",
    "layout_name": "errors/403",
    "extends": "_user_base",
    "meta": {
        "title": "$t:error.403.title",
        "description": "$t:error.403.description"
    },
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "min-h-[60vh] flex items-center justify-center"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "text-center px-4"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "text-8xl font-bold text-gray-200 dark:text-gray-700 mb-4"
                                },
                                "text": "403"
                            },
                            {
                                "type": "basic",
                                "name": "H1",
                                "props": {
                                    "className": "text-2xl font-bold text-gray-900 dark:text-white mb-2"
                                },
                                "text": "$t:error.403.title"
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "text-gray-600 dark:text-gray-400 mb-8"
                                },
                                "text": "$t:error.403.description"
                            },
                            {
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/"
                                        }
                                    }
                                ],
                                "props": {
                                    "className": "inline-flex items-center gap-2 px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors cursor-pointer"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "home",
                                            "className": "text-xl"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:error.403.back_to_home"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
