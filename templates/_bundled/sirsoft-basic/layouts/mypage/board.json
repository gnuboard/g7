{
    "comment": "마이페이지 «게시판 활동» 탭 — 내가 쓴 글과 댓글을 하위 탭으로 나눠 본다. 이 탭의 조건들이\n     `_global` 에 사는 이유는 하위 탭을 오갈 때 각자의 검색·쪽수가 남아 있어야 하기 때문이다.",
    "version": "1.0.0",
    "layout_name": "mypage/board",
    "extends": "_user_base",
    "data_sources": [
        {
            "id": "myActivityStats",
            "label_key": "$t:editor.data_source.myActivityStats",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/me/activity-stats",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "lazy": true,
            "blur_until_loaded": true,
            "comment": "글·댓글·받은 좋아요 요약 숫자. 목록보다 먼저 보이는 값이라 따로 받는다"
        },
        {
            "id": "myPosts",
            "label_key": "$t:editor.data_source.myPosts",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/me/board-activities?page={{_global.myPostsPage ?? 1}}&board_slug={{_global.myPostsBoard ?? ''}}&search={{_global.myPostsSearch ?? ''}}&search_field={{_global.myPostsSearchField ?? 'title_content'}}&sort={{_global.myPostsSort ?? 'latest'}}&activity_type=authored&per_page=10",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "lazy": true,
            "blur_until_loaded": true,
            "comment": "내가 쓴 글. 첫 하위 탭이라 바로 받는다(`auto_fetch`)"
        },
        {
            "id": "myComments",
            "label_key": "$t:editor.data_source.myComments",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-board/me/my-comments?page={{_global.myCommentsPage ?? 1}}&board_slug={{_global.myCommentsBoard ?? ''}}&search={{_global.myCommentsSearch ?? ''}}&search_field={{_global.myCommentsSearchField ?? 'content'}}&sort={{_global.myCommentsSort ?? 'latest'}}&per_page=10",
            "method": "GET",
            "auto_fetch": false,
            "auth_required": true,
            "loading_strategy": "progressive",
            "lazy": true,
            "blur_until_loaded": true,
            "comment": "내가 쓴 댓글 — `auto_fetch=false` 다. 두 번째 하위 탭이라 그 탭을 실제로 열 때 처음 받는다"
        }
    ],
    "initGlobal": {
        "boardActivitySubTab": "my-posts",
        "myPostsPage": 1,
        "myPostsBoard": "",
        "myPostsSearch": "",
        "myPostsSearchField": "title_content",
        "myPostsSort": "latest",
        "myCommentsPage": 1,
        "myCommentsSearchField": "content",
        "myCommentsBoard": "",
        "myCommentsSearch": "",
        "myCommentsSort": "latest"
    },
    "computed": {
        "currentTab": "board"
    },
    "permissions": [],
    "transition_overlay": {
        "enabled": true,
        "style": "spinner",
        "target": "mypage_tab_content",
        "fallback_target": "main_content_area",
        "spinner": {
            "component": "PageLoading"
        }
    },
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "min-h-screen bg-gray-50 dark:bg-gray-900"
                },
                "children": [
                    {
                        "type": "layout",
                        "name": "Container",
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "py-4"
                                }
                            }
                        },
                        "props": {
                            "className": "py-8"
                        },
                        "children": [
                            {
                                "comment": "페이지 제목",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex items-center gap-2 mb-6"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "user",
                                            "size": "xl",
                                            "className": "text-gray-900 dark:text-white"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "H1",
                                        "props": {
                                            "className": "text-2xl font-bold text-gray-900 dark:text-white"
                                        },
                                        "text": "$t:mypage.title"
                                    }
                                ]
                            },
                            {
                                "comment": "탭 네비게이션",
                                "partial": "partials/mypage/_tab_navigation.json"
                            },
                            {
                                "comment": "탭 컨텐츠 영역 (스켈레톤 타겟)",
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "comment": "게시판 활동",
                                        "partial": "partials/mypage/board/_list.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
