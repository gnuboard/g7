{
    "comment": "마이페이지 «리뷰» 탭 — 내가 쓴 상품 리뷰 목록과 삭제. 리뷰 수정은 하지 않는다(수정 API 가 없다).\n     목록·쪽은 URL 쿼리에 있어 쪽을 넘기면 다시 받는다. 삭제는 확인 창을 거친다.",
    "version": "1.0.0",
    "layout_name": "mypage/reviews",
    "extends": "_user_base",
    "data_sources": [
        {
            "id": "myReviews",
            "label_key": "$t:editor.data_source.myReviews",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/reviews",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "blur_until_loaded": true,
            "params": {
                "page": "{{query.page ?? 1}}",
                "per_page": 10
            },
            "comment": "내 리뷰 목록"
        }
    ],
    "computed": {
        "currentTab": "reviews"
    },
    "permissions": [],
    "transition_overlay": {
        "enabled": true,
        "style": "spinner",
        "target": "mypage_tab_content",
        "fallback_target": "main_content_area",
        "spinner": {
            "component": "PageLoading"
        }
    },
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "min-h-screen bg-gray-50 dark:bg-gray-900"
                },
                "children": [
                    {
                        "type": "layout",
                        "name": "Container",
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "py-4"
                                }
                            }
                        },
                        "props": {
                            "className": "py-8"
                        },
                        "children": [
                            {
                                "comment": "페이지 제목",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex items-center gap-2 mb-6"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "user",
                                            "size": "xl",
                                            "className": "text-gray-900 dark:text-white"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "H1",
                                        "props": {
                                            "className": "text-2xl font-bold text-gray-900 dark:text-white"
                                        },
                                        "text": "$t:mypage.title"
                                    }
                                ]
                            },
                            {
                                "comment": "탭 네비게이션",
                                "partial": "partials/mypage/_tab_navigation.json"
                            },
                            {
                                "comment": "탭 컨텐츠 영역 (스켈레톤 타겟)",
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "partial": "partials/mypage/reviews/_list.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "modals": [
        {
            "comment": "리뷰 삭제 확인",
            "partial": "partials/mypage/reviews/_modal_review_delete.json"
        }
    ]
}
