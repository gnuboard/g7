{
  "version": "1.0.0",
  "layout_name": "mypage/orders",
  "extends": "_user_base",
  "permissions": [],
  "transition_overlay": {
    "enabled": true,
    "style": "spinner",
    "target": "mypage_tab_content",
    "fallback_target": "main_content_area",
    "spinner": {
      "component": "PageLoading"
    }
  },
  "computed": {
    "currentTab": "orders"
  },
  "data_sources": [
    {
      "id": "orders",
      "label_key": "$t:editor.data_source.orders",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-ecommerce/user/orders",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "loading_strategy": "progressive",
      "blur_until_loaded": true,
      "comment": "with_items=1 — 이 화면은 주문마다 아이템을 전부 나열한다(partials/mypage/orders/_list.json 의 order.items 순회). 서버 기본은 대표 1건 + 개수이므로 전량을 명시적으로 요청한다 (#76). 주석은 params 밖에 둔다 — params 의 키는 전부 쿼리스트링으로 전송된다.",
      "params": {
        "page": "{{query.page ?? 1}}",
        "status": "{{query.status}}",
        "with_items": 1
      }
    }
  ],
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "ordersPage": "{{query.page ?? 1}}",
        "ordersStatus": "{{query.status ?? ''}}"
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "min-h-screen bg-gray-50 dark:bg-gray-900"
        },
        "children": [
          {
            "type": "layout",
            "name": "Container",
            "props": {
              "className": "py-8"
            },
            "responsive": {
              "portable": {
                "props": {
                  "className": "py-4"
                }
              }
            },
            "children": [
              {
                "comment": "페이지 제목",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex items-center gap-2 mb-6"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "user",
                      "size": "xl",
                      "className": "text-gray-900 dark:text-white"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "H1",
                    "props": {
                      "className": "text-2xl font-bold text-gray-900 dark:text-white"
                    },
                    "text": "$t:mypage.title"
                  }
                ]
              },
              {
                "comment": "탭 네비게이션",
                "partial": "partials/mypage/_tab_navigation.json"
              },
              {
                "comment": "탭 컨텐츠 영역 (스켈레톤 타겟)",
                "type": "basic",
                "name": "Div",
                "id": "mypage_tab_content",
                "children": [
                  {
                    "comment": "주문내역",
                    "partial": "partials/mypage/orders/_list.json"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}