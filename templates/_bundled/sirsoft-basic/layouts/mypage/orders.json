{
    "comment": "마이페이지 «주문 내역» 탭. 상태 필터와 쪽수를 URL 쿼리에 두어 뒤로가기와 링크 공유가 성립한다\n     (다른 탭들이 `_local` 을 쓰는 것과 갈리는 자리다 — 주문 목록은 밖에서 링크로 들어오는 일이 있다).",
    "version": "1.0.0",
    "layout_name": "mypage/orders",
    "extends": "_user_base",
    "data_sources": [
        {
            "id": "orders",
            "label_key": "$t:editor.data_source.orders",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/orders",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "blur_until_loaded": true,
            "params": {
                "page": "{{query.page ?? 1}}",
                "status": "{{query.status}}"
            },
            "comment": "내 주문 목록"
        }
    ],
    "computed": {
        "currentTab": "orders"
    },
    "permissions": [],
    "transition_overlay": {
        "enabled": true,
        "style": "spinner",
        "target": "mypage_tab_content",
        "fallback_target": "main_content_area",
        "spinner": {
            "component": "PageLoading"
        }
    },
    "init_actions": [
        {
            "handler": "setState",
            "params": {
                "target": "local",
                "ordersPage": "{{query.page ?? 1}}",
                "ordersStatus": "{{query.status ?? ''}}"
            }
        }
    ],
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "min-h-screen bg-gray-50 dark:bg-gray-900"
                },
                "children": [
                    {
                        "type": "layout",
                        "name": "Container",
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "py-4"
                                }
                            }
                        },
                        "props": {
                            "className": "py-8"
                        },
                        "children": [
                            {
                                "comment": "페이지 제목",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex items-center gap-2 mb-6"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "user",
                                            "size": "xl",
                                            "className": "text-gray-900 dark:text-white"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "H1",
                                        "props": {
                                            "className": "text-2xl font-bold text-gray-900 dark:text-white"
                                        },
                                        "text": "$t:mypage.title"
                                    }
                                ]
                            },
                            {
                                "comment": "탭 네비게이션",
                                "partial": "partials/mypage/_tab_navigation.json"
                            },
                            {
                                "comment": "탭 컨텐츠 영역 (스켈레톤 타겟)",
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "comment": "주문내역",
                                        "partial": "partials/mypage/orders/_list.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
