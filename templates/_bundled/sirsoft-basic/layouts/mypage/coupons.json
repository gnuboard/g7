{
    "comment": "마이페이지 «쿠폰» 탭 — 받은 쿠폰을 사용가능·사용완료·만료로 나눠 본다. 탭 상태는 URL 쿼리(`?status=`)에 두어\n     새로고침과 공유 링크에서도 같은 탭이 열린다. 기본은 사용가능이다.",
    "version": "1.0.0",
    "layout_name": "mypage/coupons",
    "extends": "_user_base",
    "data_sources": [
        {
            "id": "user_coupons",
            "label_key": "$t:editor.data_source.user_coupons",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/coupons",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "blur_until_loaded": true,
            "params": {
                "status": "{{['available', 'used', 'expired'].includes(query.status) ? query.status : 'available'}}",
                "page": "{{query.page ?? 1}}",
                "per_page": "{{query.per_page ?? 10}}"
            },
            "comment": "쿠폰함 목록 — 탭·쪽이 URL 쿼리에 있어 바뀌면 다시 받는다. 카드가 그리는 쿠폰 정보는 서버가 `coupon` 블록으로 싣는다"
        }
    ],
    "computed": {
        "currentTab": "coupons",
        "couponStatus": "{{['available', 'used', 'expired'].includes(query.status) ? query.status : 'available'}}"
    },
    "permissions": [],
    "transition_overlay": {
        "enabled": true,
        "style": "spinner",
        "target": "mypage_tab_content",
        "fallback_target": "main_content_area",
        "spinner": {
            "component": "PageLoading"
        }
    },
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "min-h-screen bg-gray-50 dark:bg-gray-900"
                },
                "children": [
                    {
                        "type": "layout",
                        "name": "Container",
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "py-4"
                                }
                            }
                        },
                        "props": {
                            "className": "py-8"
                        },
                        "children": [
                            {
                                "comment": "페이지 제목",
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex items-center gap-2 mb-6"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "user",
                                            "size": "xl",
                                            "className": "text-gray-900 dark:text-white"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "H1",
                                        "props": {
                                            "className": "text-2xl font-bold text-gray-900 dark:text-white"
                                        },
                                        "text": "$t:mypage.title"
                                    }
                                ]
                            },
                            {
                                "comment": "탭 네비게이션",
                                "partial": "partials/mypage/_tab_navigation.json"
                            },
                            {
                                "comment": "탭 컨텐츠 영역 (스켈레톤 타겟)",
                                "id": "mypage_tab_content",
                                "type": "basic",
                                "name": "Div",
                                "children": [
                                    {
                                        "partial": "partials/mypage/coupons/_list.json"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
