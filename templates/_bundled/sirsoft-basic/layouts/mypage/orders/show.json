{
    "comment": "주문 상세 — 마이페이지 탭이 아니라 목록에서 들어가는 별도 화면이다. 비회원 주문 상세\n     (`shop/guest_order_show`)가 이 화면의 조각 다섯을 그대로 재사용하므로, 조각에는 회원 전용 값을\n     전제하는 코드를 두지 않는다.",
    "version": "1.0.0",
    "layout_name": "mypage/orders/show",
    "extends": "_user_base",
    "data_sources": [
        {
            "id": "order",
            "label_key": "$t:editor.data_source.order",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/orders/{{route.order_number}}",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "comment": "주문 본체 — 상태·결제·배송·항목이 모두 여기 담겨 온다. 취소·확정·배송지 변경 뒤에는 다시 받는다"
        },
        {
            "id": "userAddresses",
            "label_key": "$t:editor.data_source.userAddresses",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/addresses",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "comment": "저장된 배송지 — 배송지 변경 창에서 고르기 위해 미리 받아 둔다"
        },
        {
            "id": "refundReasons",
            "label_key": "$t:editor.data_source.refundReasons",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/user/claim-reasons",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "params": {
                "type": "refund"
            },
            "comment": "취소 사유 목록 — 운영자가 관리하는 값이라 화면에 적지 않고 받아서 고르게 한다"
        },
        {
            "id": "reviewSettings",
            "label_key": "$t:editor.data_source.reviewSettings",
            "type": "api",
            "endpoint": "/api/modules/sirsoft-ecommerce/settings/review",
            "method": "GET",
            "auto_fetch": true,
            "comment": "리뷰 작성 규칙(사진 필수 여부·글자수 등). 로그인 없이도 읽히는 설정이라 인증을 걸지 않는다"
        }
    ],
    "initLocal": {
        "isSubmittingAddress": false,
        "selectedItemIds": [],
        "selectAllItems": false,
        "showCancelModal": false,
        "cancelItems": [],
        "cancelSelectAll": false,
        "cancelReason": "",
        "refundEstimate": null,
        "refundLoading": false,
        "isCancelling": false,
        "cancelError": null,
        "confirmTarget": null,
        "isConfirming": false,
        "reviewTarget": null,
        "reviewRating": 5,
        "reviewContent": "",
        "reviewImages": [],
        "isSubmittingReview": false,
        "reviewError": null
    },
    "permissions": [],
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "min-h-screen bg-gray-50 dark:bg-gray-900"
                },
                "children": [
                    {
                        "type": "layout",
                        "name": "Container",
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "py-4"
                                }
                            }
                        },
                        "props": {
                            "className": "py-8"
                        },
                        "children": [
                            {
                                "comment": "뒤로가기 헤더",
                                "type": "basic",
                                "name": "Div",
                                "responsive": {
                                    "portable": {
                                        "props": {
                                            "className": "flex items-center gap-2 mb-4"
                                        }
                                    }
                                },
                                "props": {
                                    "className": "flex items-center gap-2 mb-6"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Button",
                                        "actions": [
                                            {
                                                "type": "click",
                                                "handler": "navigate",
                                                "params": {
                                                    "path": "/mypage/orders",
                                                    "mergeQuery": true,
                                                    "query": {}
                                                }
                                            }
                                        ],
                                        "props": {
                                            "className": "flex items-center gap-1 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Icon",
                                                "props": {
                                                    "name": "chevron-left",
                                                    "size": "md"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "props": {
                                                    "className": "text-base font-medium"
                                                },
                                                "text": "$t:mypage.order_detail.back"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "comment": "주문 상세 카드 컨테이너",
                                "type": "basic",
                                "name": "Div",
                                "responsive": {
                                    "portable": {
                                        "props": {
                                            "className": "space-y-3"
                                        }
                                    }
                                },
                                "props": {
                                    "className": "max-w-3xl mx-auto space-y-4"
                                },
                                "children": [
                                    {
                                        "partial": "partials/mypage/orders/_status_header.json"
                                    },
                                    {
                                        "partial": "partials/mypage/orders/_items.json"
                                    },
                                    {
                                        "partial": "partials/mypage/orders/_orderer.json"
                                    },
                                    {
                                        "partial": "partials/mypage/orders/_shipping.json"
                                    },
                                    {
                                        "partial": "partials/mypage/orders/_payment.json"
                                    },
                                    {
                                        "partial": "partials/mypage/orders/_history.json"
                                    },
                                    {
                                        "comment": "액션 버튼 영역",
                                        "type": "basic",
                                        "name": "Div",
                                        "responsive": {
                                            "portable": {
                                                "props": {
                                                    "className": "flex flex-col gap-3"
                                                }
                                            }
                                        },
                                        "props": {
                                            "className": "flex flex-row gap-4"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Button",
                                                "actions": [
                                                    {
                                                        "comment": "audit:allow layout-list-context-navigate-merge-query 쇼핑 계속하기 — 주문 목록이 아니라 상품 목록으로 나가는 이동이다.",
                                                        "type": "click",
                                                        "handler": "navigate",
                                                        "params": {
                                                            "path": "{{_global.shopBase}}/products"
                                                        }
                                                    }
                                                ],
                                                "props": {
                                                    "className": "flex-1 flex items-center justify-center gap-2 px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors cursor-pointer"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Icon",
                                                        "props": {
                                                            "name": "shopping-bag",
                                                            "size": "md"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "$t:mypage.order_detail.continue_shopping"
                                                    }
                                                ]
                                            },
                                            {
                                                "comment": "재주문 버튼 - 취소된 주문만 표시",
                                                "type": "basic",
                                                "name": "Button",
                                                "if": "{{order.data.order_status === 'cancelled'}}",
                                                "actions": [
                                                    {
                                                        "comment": "audit:allow layout-list-context-navigate-merge-query 재주문 — 주문서 작성 흐름으로 넘어가는 이동이므로 주문 목록 상태를 물려주지 않는다.",
                                                        "type": "click",
                                                        "handler": "navigate",
                                                        "params": {
                                                            "path": "{{_global.shopBase}}/reorder/{{order.data.id ?? ''}}"
                                                        }
                                                    }
                                                ],
                                                "props": {
                                                    "className": "flex-1 flex items-center justify-center gap-2 px-6 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors cursor-pointer"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Icon",
                                                        "props": {
                                                            "name": "refresh-cw",
                                                            "size": "md"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "$t:mypage.order_detail.reorder"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "modals": [
        {
            "comment": "주문 취소 — 전체 취소와 항목별 취소를 한 창이 맡는다",
            "partial": "partials/mypage/orders/_modal_cancel.json"
        },
        {
            "comment": "배송지 변경 — 배송이 시작되기 전까지만 열린다",
            "partial": "partials/mypage/orders/_modal_change_address.json"
        },
        {
            "comment": "구매 확정 — 확정하면 취소·반품이 닫히므로 한 번 묻는다",
            "partial": "partials/mypage/orders/_modal_confirm_purchase.json"
        },
        {
            "comment": "리뷰 작성 — 산 항목별로 따로 쓴다",
            "partial": "partials/mypage/orders/_modal_write_review.json"
        },
        {
            "comment": "배송지를 새로 저장하려는데 자리가 꽉 찼을 때. 배송지 화면·주문서와 같은 창을 쓴다",
            "partial": "partials/mypage/addresses/_modal_confirm_overwrite.json"
        }
    ]
}
