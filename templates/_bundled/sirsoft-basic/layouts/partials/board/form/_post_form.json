{
    "comment": "글 입력 본체 — 입력값을 폼 자동바인딩이 아니라 _local.form 한 덩어리로 모아 두고 저장할 때 통째로 보낸다(수정 시 서버가 준 기존 값을 그대로 이어받기 위해서다). 첨부는 임시 키(tempKey)로 먼저 올려 두었다가 저장에 그 키를 실어 글에 붙인다. 틀 응답이 오기 전에는 폼 전체를 흐리고 잠근다.",
    "meta": {
        "is_partial": true,
        "description": "게시글 작성/수정 폼"
    },
    "type": "basic",
    "name": "Form",
    "props": {
        "id": "form",
        "className": "{{!form_meta?.data || !form_data?.data ? 'space-y-6 opacity-50 pointer-events-none' : 'space-y-6'}}"
    },
    "children": [
        {
            "comment": "전체 에러 메시지 박스",
            "type": "basic",
            "name": "Div",
            "if": "{{_local.errors && (typeof _local.errors === 'string' || Object.keys(_local.errors).length > 0)}}",
            "props": {
                "className": "bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 mb-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex items-start gap-3"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "triangle-exclamation",
                                "className": "text-red-600 dark:text-red-400 mt-0.5",
                                "size": "lg"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-1"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "H3",
                                    "props": {
                                        "className": "text-sm font-semibold text-red-800 dark:text-red-200 mb-2"
                                    },
                                    "text": "$t:common.validation_errors"
                                },
                                {
                                    "type": "basic",
                                    "name": "Ul",
                                    "iteration": {
                                        "source": "typeof _local.errors === 'string' ? [_local.errors] : Object.entries(_local.errors ?? {}).flatMap(([field, messages]) => Array.isArray(messages) ? messages : [messages])",
                                        "item_var": "message"
                                    },
                                    "props": {
                                        "className": "list-disc list-inside space-y-1 text-sm text-red-700 dark:text-red-300"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Li",
                                            "props": {
                                                "className": "text-sm text-red-700 dark:text-red-300"
                                            },
                                            "text": "{{message}}"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "comment": "수정 모드일 때 작성자 정보 표시 (Avatar + UserInfo)",
            "type": "basic",
            "name": "Div",
            "if": "{{route.id && form_data?.data?.author}}",
            "props": {
                "className": "flex items-center gap-3 p-4 bg-gray-50 dark:bg-gray-800/50 rounded-lg border border-gray-200 dark:border-gray-700"
            },
            "children": [
                {
                    "type": "composite",
                    "name": "Avatar",
                    "props": {
                        "author": "{{form_data?.data?.author}}",
                        "size": "md"
                    }
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "composite",
                            "name": "UserInfo",
                            "props": {
                                "userId": "{{form_data?.data?.author?.uuid}}",
                                "name": "{{form_data?.data?.author?.name}}",
                                "isGuest": "{{!form_data?.data?.author?.uuid}}",
                                "showDropdown": false,
                                "clickable": false,
                                "className": "text-sm font-medium"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-xs text-gray-500 dark:text-gray-400 mt-0.5"
                            },
                            "text": "$t:board.created_at: {{form_data?.data?.created_at}}"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "게시글 옵션 (공지사항/비밀글) — 공지는 게시판 관리 또는 공지 등록 권한, 비밀글은 게시판 비밀글 모드가 켜진 경우에만 카드가 생긴다",
            "type": "basic",
            "name": "Div",
            "if": "{{form_meta?.data?.board?.user_abilities?.can_manage || form_meta?.data?.board?.user_abilities?.can_write_notice || form_meta?.data?.board?.secret_mode === 'enabled' || form_meta?.data?.board?.secret_mode === 'always'}}",
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "grid grid-cols-1 md:grid-cols-2 gap-4"
                    },
                    "children": [
                        {
                            "comment": "공지사항 카드 (게시판 관리 권한 또는 공지 등록 권한 보유자 전용 — 서버도 같은 권한으로 판정한다)",
                            "type": "basic",
                            "name": "Label",
                            "if": "{{(form_meta?.data?.board?.user_abilities?.can_manage || form_meta?.data?.board?.user_abilities?.can_write_notice) && !_local.form?.parent_id}}",
                            "props": {
                                "className": "block bg-white dark:bg-gray-800 rounded-lg p-3 border border-gray-200 dark:border-gray-700 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex items-start gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "props": {
                                                "type": "checkbox",
                                                "name": "is_notice",
                                                "className": "mt-0.5 w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-1"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "props": {
                                                        "className": "flex items-center gap-2 mb-1"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Icon",
                                                            "props": {
                                                                "name": "bell",
                                                                "size": "sm",
                                                                "className": "text-blue-600 dark:text-blue-400"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-sm font-semibold text-gray-900 dark:text-white"
                                                            },
                                                            "text": "$t:board.form.is_notice"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "P",
                                                    "props": {
                                                        "className": "text-xs text-gray-500 dark:text-gray-400"
                                                    },
                                                    "text": "$t:board.form.notice_description"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "comment": "비밀글 카드 (enabled 모드)",
                            "type": "basic",
                            "name": "Label",
                            "if": "{{form_meta?.data?.board?.secret_mode === 'enabled'}}",
                            "props": {
                                "className": "block bg-white dark:bg-gray-800 rounded-lg p-3 border border-gray-200 dark:border-gray-700 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex items-start gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "props": {
                                                "type": "checkbox",
                                                "name": "is_secret",
                                                "className": "mt-0.5 w-4 h-4 text-amber-600 bg-gray-100 border-gray-300 rounded focus:ring-amber-500 dark:focus:ring-amber-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-1"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "props": {
                                                        "className": "flex items-center gap-2 mb-1"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Icon",
                                                            "props": {
                                                                "name": "lock",
                                                                "size": "sm",
                                                                "className": "text-amber-600 dark:text-amber-400"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-sm font-semibold text-gray-900 dark:text-white"
                                                            },
                                                            "text": "$t:board.form.secret_post"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "P",
                                                    "props": {
                                                        "className": "text-xs text-gray-500 dark:text-gray-400"
                                                    },
                                                    "text": "$t:board.form.secret_description"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "comment": "비밀글 카드 (always 모드 - 비활성 상태)",
                            "type": "basic",
                            "name": "Div",
                            "if": "{{form_meta?.data?.board?.secret_mode === 'always'}}",
                            "props": {
                                "className": "bg-gray-100 dark:bg-gray-800 rounded-lg p-3 border border-gray-200 dark:border-gray-700 opacity-75"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "hidden",
                                        "name": "is_secret",
                                        "value": "true"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex items-start gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "props": {
                                                "type": "checkbox",
                                                "checked": true,
                                                "disabled": true,
                                                "className": "mt-0.5 w-4 h-4 text-amber-600 bg-gray-100 border-gray-300 rounded dark:bg-gray-700 dark:border-gray-600 opacity-50 cursor-not-allowed"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-1"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "props": {
                                                        "className": "flex items-center gap-2 mb-1"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Icon",
                                                            "props": {
                                                                "name": "lock",
                                                                "size": "sm",
                                                                "className": "text-amber-600 dark:text-amber-400"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-sm font-semibold text-gray-900 dark:text-white"
                                                            },
                                                            "text": "$t:board.form.secret_post"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "P",
                                                    "props": {
                                                        "className": "text-xs text-gray-500 dark:text-gray-400"
                                                    },
                                                    "text": "$t:board.form.secret_always_description"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "comment": "비회원 작성자 정보 입력 (이름/비밀번호) - 신규 작성 시에만 표시 (비로그인 + 수정모드가 아닐 때)",
            "type": "basic",
            "name": "Div",
            "if": "{{form_meta?.data && !_global.currentUser?.uuid && !route.id}}",
            "props": {
                "className": "grid grid-cols-1 sm:grid-cols-2 gap-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:board.guest_author_name"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-red-500 ml-1"
                                    },
                                    "text": "*"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "text",
                                "name": "author_name",
                                "placeholder": "$t:board.guest_author_name_placeholder",
                                "className": "w-full px-4 py-2 border rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 {{_local.errors?.author_name ? 'border-red-500 dark:border-red-500 focus:ring-red-500' : 'border-gray-300 dark:border-gray-600 focus:ring-blue-500'}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "if": "{{_local.errors?.author_name}}",
                            "props": {
                                "className": "mt-1 text-sm text-red-600 dark:text-red-400"
                            },
                            "text": "{{_local.errors?.author_name?.[0] ?? _local.errors?.author_name}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:board.guest_password"
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-red-500 ml-1"
                                    },
                                    "text": "*"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "password",
                                "name": "password",
                                "placeholder": "$t:board.guest_password_placeholder",
                                "className": "w-full px-4 py-2 border rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 {{_local.errors?.password ? 'border-red-500 dark:border-red-500 focus:ring-red-500' : 'border-gray-300 dark:border-gray-600 focus:ring-blue-500'}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "if": "{{_local.errors?.password}}",
                            "props": {
                                "className": "mt-1 text-sm text-red-600 dark:text-red-400"
                            },
                            "text": "{{_local.errors?.password?.[0] ?? _local.errors?.password}}"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "카테고리 선택 (카테고리가 있는 게시판만)",
            "type": "basic",
            "name": "Div",
            "if": "{{form_meta?.data?.board?.categories?.length > 0}}",
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                    },
                    "text": "$t:board.form.category"
                },
                {
                    "type": "basic",
                    "name": "Select",
                    "actions": [
                        {
                            "comment": "분류 선택 — 값을 담으면서 «고친 것이 있다» 표시도 함께 세운다(그 표시를 이탈 경고가 본다).",
                            "event": "change",
                            "handler": "setState",
                            "params": {
                                "target": "local",
                                "hasChanges": true,
                                "form": {
                                    "category": "{{$event.target.value}}"
                                }
                            }
                        }
                    ],
                    "props": {
                        "name": "category",
                        "value": "{{_local.form?.category ?? ''}}",
                        "className": "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500",
                        "options": "{{[{value: '', label: $t('board.form.select_category')}, ...(form_meta?.data?.board?.categories ?? []).map(c => ({value: c, label: c}))]}}"
                    }
                }
            ]
        },
        {
            "comment": "제목 입력",
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:board.form.title"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-red-500 ml-1"
                            },
                            "text": "*"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Input",
                    "props": {
                        "type": "text",
                        "name": "title",
                        "placeholder": "$t:board.form.title_placeholder",
                        "className": "w-full px-4 py-2 border rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 {{_local.errors?.title ? 'border-red-500 dark:border-red-500 focus:ring-red-500' : 'border-gray-300 dark:border-gray-600 focus:ring-blue-500'}}"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "if": "{{_local.errors?.title}}",
                    "props": {
                        "className": "mt-1 text-sm text-red-600 dark:text-red-400"
                    },
                    "text": "{{_local.errors?.title?.[0] ?? _local.errors?.title}}"
                }
            ]
        },
        {
            "comment": "내용 에디터 래퍼 (에러 테두리용) — 비회원 비밀글은 비밀번호를 맞힌 뒤 다시 받은 폼 값(검증 토큰이 실려 옴)이 올 때까지 편집기를 띄우지 않는다. 편집기는 처음 세워질 때의 값만 들고 있어, 먼저 뜨면 빈 본문으로 세워지고 입력·저장 시 원문이 지워진다.",
            "type": "basic",
            "name": "Div",
            "if": "{{!(_local.form?.is_secret && _local.passwordVerified && !_local.form?.verification_token)}}",
            "props": {
                "className": "{{_local.errors?.content ? '[&_textarea]:!border-red-500 [&_textarea]:dark:!border-red-500 [&_textarea]:focus:!ring-red-500' : ''}}"
            },
            "children": [
                {
                    "comment": "내용 에디터",
                    "id": "content_section",
                    "type": "extension_point",
                    "name": "html_editor",
                    "props": {
                        "content": "{{_local.form?.content ?? ''}}",
                        "isHtml": "{{(_local.form?.content_mode ?? 'text') === 'html'}}",
                        "rows": 15,
                        "placeholder": "$t:board.form.content_placeholder",
                        "label": "$t:board.form.content",
                        "showHtmlModeToggle": true,
                        "name": "content"
                    },
                    "default": [
                        {
                            "type": "composite",
                            "name": "HtmlEditor",
                            "actions": [
                                {
                                    "comment": "편집기의 HTML/일반텍스트 전환 — 본문 글자는 그대로 두고 «어떻게 읽을지»(content_mode)만 바꾼다. 이 값이 상세 화면에서 본문을 HTML 로 풀지 그대로 보일지를 가른다.",
                                    "type": "change",
                                    "event": "onIsHtmlChange",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "form": {
                                            "content_mode": "{{$args[0].target.checked ? 'html' : 'text'}}"
                                        }
                                    }
                                }
                            ],
                            "props": {
                                "name": "content",
                                "content": "{{_local.form?.content ?? ''}}",
                                "isHtml": "{{(_local.form?.content_mode ?? 'text') === 'html'}}",
                                "rows": 15,
                                "placeholder": "$t:board.form.content_placeholder",
                                "label": "$t:board.form.content",
                                "showHtmlModeToggle": true
                            }
                        }
                    ]
                }
            ]
        },
        {
            "comment": "내용 필드 에러 메시지",
            "type": "basic",
            "name": "P",
            "if": "{{_local.errors?.content}}",
            "props": {
                "className": "mt-1 text-sm text-red-600 dark:text-red-400"
            },
            "text": "{{_local.errors?.content?.[0] ?? _local.errors?.content}}"
        },
        {
            "comment": "파일 첨부 (게시판 설정 + 권한 체크)",
            "type": "basic",
            "name": "Div",
            "if": "{{form_meta?.data?.board?.use_file_upload === true && form_meta?.data?.board?.user_abilities?.can_upload}}",
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "paperclip",
                                "size": "sm",
                                "className": "inline mr-1"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:board.form.attachments"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-xs text-gray-500 dark:text-gray-400 mb-2"
                    },
                    "text": "$t:board.form.attachments_desc|count={{form_meta?.data?.board?.max_file_count ?? 5}}|maxFiles={{form_meta?.data?.board?.max_file_count ?? 5}}|maxSize={{form_meta?.data?.board?.max_file_size ?? 10}}"
                },
                {
                    "type": "composite",
                    "name": "FileUploader",
                    "actions": [
                        {
                            "comment": "첨부 목록이 바뀜 — 이미 서 있는 표시를 다시 세우지 않도록 조건을 건다(파일을 고를 때마다 상태를 갈아 끼우면 목록이 통째로 다시 그려진다).",
                            "type": "change",
                            "event": "onFilesChange",
                            "handler": "setState",
                            "if": "{{!_local.hasChanges}}",
                            "params": {
                                "target": "local",
                                "hasChanges": true
                            }
                        },
                        {
                            "comment": "첨부 올리기 실패 — 저장 잠금을 반드시 푼다. 저장 버튼이 업로드를 먼저 발화시키므로, 여기서 풀지 않으면 버튼이 잠긴 채 남는다.",
                            "type": "change",
                            "event": "onUploadError",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "uploadError": "{{$args[0]}}",
                                        "isSaving": false
                                    }
                                },
                                {
                                    "handler": "toast",
                                    "params": {
                                        "type": "error",
                                        "message": "{{$args[0]}}",
                                        "icon": "triangle-exclamation"
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "collection": "post_attachments",
                        "maxFiles": "{{form_meta?.data?.board?.max_file_count ?? 5}}",
                        "maxSize": "{{form_meta?.data?.board?.max_file_size ?? 10}}",
                        "accept": "{{form_meta?.data?.board?.allowed_extensions?.length ? '.' + form_meta?.data?.board?.allowed_extensions?.join(',.') : '.jpg,.jpeg,.png,.gif,.pdf,.zip'}}",
                        "initialFiles": "{{form_meta?.data?.attachments ?? []}}",
                        "autoUpload": false,
                        "uploadTriggerEvent": "upload:board_attachments",
                        "confirmBeforeRemove": true,
                        "confirmRemoveTitle": "$t:board.posts.form.confirm_remove_attachment_title",
                        "confirmRemoveMessage": "$t:board.posts.form.confirm_remove_attachment_message",
                        "uploadParams": {
                            "temp_key": "{{_local.tempKey}}"
                        },
                        "apiEndpoints": {
                            "upload": "/api/modules/sirsoft-board/boards/{{route.slug}}/attachments",
                            "delete": "/api/modules/sirsoft-board/boards/{{route.slug}}/attachments/:id",
                            "reorder": "/api/modules/sirsoft-board/boards/{{route.slug}}/attachments/reorder"
                        }
                    }
                }
            ]
        },
        {
            "comment": "버튼 영역",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex justify-end gap-3 pt-4 border-t border-gray-200 dark:border-gray-700"
            },
            "children": [
                {
                    "comment": "취소 버튼 (등록: 목록, 수정: 상세)",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "navigate",
                            "params": {
                                "path": "{{route.id ? '/board/' + route.slug + '/' + route.id : '/board/' + route.slug}}",
                                "mergeQuery": true,
                                "query": {}
                            }
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer"
                    },
                    "text": "$t:common.cancel"
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "저장. 아직 올라가지 않은 첨부를 먼저 올리라고 알린 뒤 글을 보낸다 — 둘을 잇는 것이 임시 키이고, 주소와 방식은 글 번호 유무로 갈린다",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "isSaving": true,
                                        "errors": null
                                    }
                                },
                                {
                                    "handler": "emitEvent",
                                    "params": {
                                        "event": "upload:board_attachments"
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "{{route.id ? '/api/modules/sirsoft-board/boards/' + route.slug + '/posts/' + route.id : '/api/modules/sirsoft-board/boards/' + route.slug + '/posts'}}",
                                    "auth_required": true,
                                    "params": {
                                        "method": "{{route.id ? 'PUT' : 'POST'}}",
                                        "body": "{{Object.assign({}, _local.form, { temp_key: _local?.tempKey })}}"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "isSaving": false,
                                                "hasChanges": false,
                                                "errors": null
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "{{route?.id ? '$t:board.post_updated' : '$t:board.post_created'}}"
                                            }
                                        },
                                        {
                                            "handler": "navigate",
                                            "params": {
                                                "path": "/board/{{route?.slug}}/{{result?.data?.id}}",
                                                "mergeQuery": true,
                                                "query": {}
                                            }
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "isSaving": false,
                                                "errors": "{{error?.errors ?? null}}"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error?.message ?? '$t:common.error_occurred'}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "disabled": "{{_local?.isSaving}}",
                        "className": "flex items-center gap-2 px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_local?.isSaving}}",
                            "props": {
                                "name": "spinner",
                                "size": "sm",
                                "className": "animate-spin"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_local?.isSaving ? '$t:common.saving' : (route?.id ? '$t:common.save' : '$t:board.form.submit')}}"
                        }
                    ]
                }
            ]
        }
    ]
}
