{
    "meta": {
        "is_partial": true,
        "description": "비회원 비밀번호 검증 모달",
        "editor_label": "$t:user.modal_label.board_show.board_guest_password_modal"
    },
    "comment": "비회원 게시글/댓글 수정/삭제 시 비밀번호 검증",
    "id": "board_guest_password_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "{{_global.guestPasswordModal?.action === 'edit' ? (_global.guestPasswordModal?.targetType === 'comment' ? '$t:board.modals.edit_comment_title' : '$t:board.modals.edit_post_title') : (_global.guestPasswordModal?.targetType === 'comment' ? '$t:board.modals.delete_comment_title' : '$t:board.modals.delete_post_title')}}",
        "icon": "{{_global.guestPasswordModal?.action === 'edit' ? 'pen' : 'trash'}}",
        "iconClassName": "{{_global.guestPasswordModal?.action === 'edit' ? 'text-blue-500' : 'text-red-500'}}",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "space-y-4"
            },
            "children": [
                {
                    "comment": "안내 메시지",
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-sm text-gray-600 dark:text-gray-400"
                    },
                    "text": "$t:board.password_verify.description"
                },
                {
                    "comment": "비밀번호 입력",
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex items-center gap-1.5 mb-1"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "lock",
                                        "size": "xs",
                                        "className": "text-gray-500 dark:text-gray-400"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                                    },
                                    "text": "$t:board.guest_password"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "actions": [
                                {
                                    "comment": "비밀번호 입력 — 삭제 창과 달리 값을 _local 에 담는다(비밀번호는 확인이 끝나면 버릴 값이라 전역에 남길 이유가 없다). 대상 정보만 전역에서 읽는다.",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "guestPasswordForm": {
                                            "password": "{{$event.target.value}}"
                                        }
                                    }
                                }
                            ],
                            "props": {
                                "type": "password",
                                "placeholder": "$t:board.guest_password_placeholder",
                                "className": "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500",
                                "value": "{{_local.guestPasswordForm?.password ?? ''}}"
                            }
                        }
                    ]
                },
                {
                    "comment": "에러 메시지",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.guestPasswordError}}",
                    "props": {
                        "className": "text-sm text-red-500"
                    },
                    "text": "{{_local.guestPasswordError}}"
                },
                {
                    "comment": "버튼 영역",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex justify-end gap-3"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "취소 — 입력한 비밀번호와 오류 문구, 그리고 무엇을 하려던 것인지(대상·행동)까지 모두 비우고 닫는다.",
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "guestPasswordForm": null,
                                                "guestPasswordError": ""
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "guestPasswordModal": null
                                            }
                                        },
                                        {
                                            "handler": "closeModal"
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "className": "px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer"
                            },
                            "text": "$t:common.cancel"
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "비밀번호 확인. 확인 뒤 무엇을 할지는 창을 연 쪽이 정해 준다 — 댓글 수정 모드로 들어가거나 지정된 주소로 이동한다",
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "comment": "댓글 수정 모드 진입 (global 상태로 저장)\n                       페이지 이동 (redirectPath가 있는 경우). audit:allow layout-list-context-navigate-merge-query — redirectPath 는 모달을 연 쪽이 지정하는 임의 경로라 목적지를 정적으로 알 수 없다 (현재 저장소의 유일한 설정처인 _comment_item.json 은 null 을 넣어 이 분기를 쓰지 않는다).\n                       로컬 상태 초기화\n                       모달 상태 초기화",
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "guestPasswordModal": {
                                                    "targetType": "{{_global.guestPasswordModal?.targetType}}",
                                                    "action": "{{_global.guestPasswordModal?.action}}",
                                                    "apiEndpoint": "{{_global.guestPasswordModal?.apiEndpoint}}",
                                                    "storageKey": "{{_global.guestPasswordModal?.storageKey}}",
                                                    "redirectPath": "{{_global.guestPasswordModal?.redirectPath}}",
                                                    "commentEdit": "{{_global.guestPasswordModal?.commentEdit}}",
                                                    "isVerifying": true
                                                }
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "guestPasswordError": ""
                                            }
                                        },
                                        {
                                            "handler": "apiCall",
                                            "target": "{{_global.guestPasswordModal?.apiEndpoint}}",
                                            "auth_mode": "optional",
                                            "params": {
                                                "method": "POST",
                                                "body": {
                                                    "password": "{{_local.guestPasswordForm?.password}}"
                                                }
                                            },
                                            "onSuccess": [
                                                {
                                                    "handler": "setState",
                                                    "if": "{{!_global.guestPasswordModal.redirectPath && _global.guestPasswordModal.commentEdit}}",
                                                    "params": {
                                                        "target": "global",
                                                        "commentEdit": "{{_global.guestPasswordModal?.commentEdit}}",
                                                        "verifiedGuestPassword": "{{_local.guestPasswordForm?.password}}"
                                                    }
                                                },
                                                {
                                                    "comment": "audit:allow layout-list-context-navigate-merge-query 목적지를 호출자가 심어 둔다(redirectPath) — 글 상세일 수도 수정 폼일 수도 있어 이 자리에서는 목록 클러스터 안인지 알 수 없다. 승계 여부는 그 경로를 심은 쪽이 정한다.",
                                                    "handler": "navigate",
                                                    "if": "{{_global.guestPasswordModal.redirectPath}}",
                                                    "params": {
                                                        "path": "{{_global.guestPasswordModal.redirectPath}}"
                                                    }
                                                },
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "guestPasswordForm": null,
                                                        "guestPasswordError": ""
                                                    }
                                                },
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "guestPasswordModal": null
                                                    }
                                                },
                                                {
                                                    "handler": "closeModal"
                                                }
                                            ],
                                            "onError": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "guestPasswordModal": {
                                                            "targetType": "{{_global.guestPasswordModal?.targetType}}",
                                                            "action": "{{_global.guestPasswordModal?.action}}",
                                                            "apiEndpoint": "{{_global.guestPasswordModal?.apiEndpoint}}",
                                                            "storageKey": "{{_global.guestPasswordModal?.storageKey}}",
                                                            "redirectPath": "{{_global.guestPasswordModal?.redirectPath}}",
                                                            "commentEdit": "{{_global.guestPasswordModal?.commentEdit}}",
                                                            "isVerifying": false
                                                        }
                                                    }
                                                },
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "guestPasswordError": "$t:board.password_verify.incorrect"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "disabled": "{{_global.guestPasswordModal?.isVerifying || !_local.guestPasswordForm?.password}}",
                                "className": "px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "if": "{{_global.guestPasswordModal?.isVerifying}}",
                                    "props": {
                                        "name": "spinner",
                                        "size": "sm",
                                        "className": "animate-spin mr-2"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:board.password_verify.confirm"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
