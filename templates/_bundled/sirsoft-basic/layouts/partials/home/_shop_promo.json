{
    "comment": "쇼핑 안내 카드 — 이커머스가 설치돼 있을 때만 뜻이 있어 부르는 쪽이 조건으로 감싼다. 이동 경로 앞머리는 전역 shopBase 를 쓴다.",
    "meta": {
        "is_partial": true,
        "description": "쇼핑몰 홍보 카드"
    },
    "type": "basic",
    "name": "Button",
    "actions": [
        {
            "type": "click",
            "handler": "navigate",
            "params": {
                "path": "{{_global.shopBase}}/products"
            }
        }
    ],
    "props": {
        "className": "block w-full text-left bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl p-5 text-white hover:shadow-lg transition-shadow cursor-pointer"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex items-center gap-2 mb-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "shopping-cart",
                        "className": "text-xl"
                    }
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "font-semibold"
                    },
                    "text": "$t:home.shop"
                }
            ]
        },
        {
            "type": "basic",
            "name": "P",
            "props": {
                "className": "text-sm opacity-90"
            },
            "text": "$t:home.shop_description"
        }
    ]
}
