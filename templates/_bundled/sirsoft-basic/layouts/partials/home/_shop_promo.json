{
    "comment": "쇼핑 안내 카드 — 쇼핑몰 모듈이 켜져 있을 때만 뜻이 있어 카드 뿌리에 쇼핑몰 가드를 단다. 이동 경로 앞머리는 전역 shopBase 를 쓴다.",
    "meta": {
        "is_partial": true,
        "description": "쇼핑몰 홍보 카드"
    },
    "type": "basic",
    "name": "A",
    "if": "{{_global.activeModules?.includes('sirsoft-ecommerce') ?? true}}",
    "actions": [
        {
            "type": "click",
            "handler": "navigate"
        }
    ],
    "props": {
        "href": "{{_global.shopBase}}/products",
        "className": "block w-full text-left bg-gradient-to-br from-emerald-700 to-teal-700 rounded-xl p-5 text-white hover:shadow-lg transition-shadow cursor-pointer"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex items-center gap-2 mb-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "shopping-cart",
                        "className": "text-xl"
                    }
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "font-semibold"
                    },
                    "text": "$t:home.shop"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "text-sm opacity-90"
            },
            "text": "$t:home.shop_description"
        }
    ]
}
