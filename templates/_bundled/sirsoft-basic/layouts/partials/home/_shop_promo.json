            "type": "click",
            "handler": "navigate"
        }
    ],
    "props": {
        "href": "{{_global.shopBase}}/products",
        "className": "flex flex-col justify-center w-full text-left bg-gradient-to-br from-emerald-700 to-teal-700 rounded-xl p-5 text-white hover:shadow-lg transition-shadow cursor-pointer"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex items-center gap-2 mb-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "shopping-cart",
                        "className": "text-xl"
                    }
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "font-semibold"
                    },
                    "text": "$t:home.shop"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "text-sm opacity-90"
            },
            "text": "$t:home.shop_description"
        }
    ]
