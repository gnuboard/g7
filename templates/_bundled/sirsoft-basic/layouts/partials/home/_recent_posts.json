{
    "comment": "최근 글 카드 — 게시판을 가리지 않고 새로 올라온 순서 다섯 건이다.",
    "meta": {
        "is_partial": true,
        "description": "최근 게시글 카드"
    },
    "type": "basic",
    "name": "Div",
    "props": {
        "className": "bg-white dark:bg-gray-800 rounded-xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 h-full flex flex-col"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex items-center justify-between mb-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "clock",
                                "className": "text-xl text-gray-500 dark:text-gray-400"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:home.recent_posts"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "A",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "navigate"
                        }
                    ],
                    "props": {
                        "href": "/boards/popular",
                        "className": "text-sm text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 cursor-pointer"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.more"
                        },
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "arrow-right",
                                "className": "text-base"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{recent_posts.data && recent_posts.data.length > 0}}",
            "iteration": {
                "source": "{{recent_posts.data ?? []}}",
                "item_var": "post"
            },
            "props": {
                "className": "space-y-2 mb-1"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "A",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "navigate"
                        }
                    ],
                    "props": {
                        "href": "/board/{{post.board_slug}}/{{post.id}}",
                        "className": "block w-full text-left hover:bg-gray-50 dark:hover:bg-gray-700/50 rounded-lg py-2 transition-colors cursor-pointer"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex items-center justify-between gap-2 text-xs"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex items-center gap-2 flex-1 min-w-0"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-blue-600 dark:text-blue-400 shrink-0 truncate max-w-32"
                                            },
                                            "text": "{{post.board_name}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{post.is_secret}}",
                                            "props": {
                                                "name": "lock",
                                                "className": "text-sm text-gray-500 dark:text-gray-400 shrink-0"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "min-w-0 wrap-anywhere text-sm font-medium text-gray-900 dark:text-white text-left line-clamp-1"
                                            },
                                            "text": "{{post.title}}"
                                        },
                                        {
                                            "comment": "확장 자리 — 확장이 글마다 배지를 붙인다(#149). 조각은 extensionPointProps.postId 등으로 이 행의 글을 읽는다",
                                            "type": "extension_point",
                                            "name": "board_post_row_badges",
                                            "props": {
                                                "className": "contents",
                                                "data-extension-point": "board_post_row_badges",
                                                "post": "{{post}}",
                                                "postId": "{{post.id}}",
                                                "boardSlug": "{{post.board_slug}}",
                                                "context": "home_recent"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{post.is_new}}",
                                            "props": {
                                                "className": "px-1.5 py-0.5 text-xs bg-red-600 dark:bg-red-600 text-white rounded shrink-0"
                                            },
                                            "text": "N"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{post.comment_count > 0}}",
                                            "props": {
                                                "className": "text-xs font-medium text-blue-600 dark:text-blue-400 shrink-0"
                                            },
                                            "text": "[{{post.comment_count}}]"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{(post.reaction_total ?? 0) > 0}}",
                                            "props": {
                                                "className": "text-rose-700 dark:text-rose-300 text-xs font-medium shrink-0 inline-flex items-center gap-0.5"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "fa-solid fa-thumbs-up",
                                                        "className": "text-xs"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{post.reaction_total}}"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-xs text-gray-500 dark:text-gray-400 shrink-0",
                                        "title": "{{post.created_at ?? ''}}"
                                    },
                                    "text": "{{post.created_at_formatted ?? ''}}"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{recent_posts !== undefined && (!recent_posts.data || recent_posts.data.length === 0)}}",
            "props": {
                "className": "text-center py-8 text-gray-800 dark:text-gray-300 flex-grow flex flex-col items-center justify-center"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "inbox",
                        "className": "text-[2rem] mx-auto mb-2 opacity-50"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-sm"
                    },
                    "text": "$t:home.no_posts"
                }
            ]
        }
    ]
}
