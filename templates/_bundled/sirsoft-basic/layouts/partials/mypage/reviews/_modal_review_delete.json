{
    "comment": "내 리뷰 삭제 확인 창 (#952) — 지우면 사진도 함께 지워지고 되돌릴 수 없다. 대상은 창 고유 전역 이름 공간 `_global.reviewDeleteModal`\n     (reviewId·productName·isDeleting)에 있고 여는 쪽이 매번 비운다. 성공하면 목록을 다시 받는다.",
    "meta": {
        "is_partial": true,
        "description": "내 리뷰 삭제 확인 모달",
        "editor_label": "$t:user.modal_label.mypage_reviews.reviewDeleteModal"
    },
    "id": "reviewDeleteModal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:mypage.reviews.delete_modal.title",
        "size": "sm",
        "footer": [
            {
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "type": "click",
                        "handler": "closeModal"
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors",
                    "disabled": "{{_global.reviewDeleteModal?.isDeleting === true}}"
                },
                "text": "$t:common.cancel"
            },
            {
                "id": "review_delete_confirm",
                "type": "basic",
                "name": "Button",
                "actions": [
                    {
                        "comment": "삭제 — 버튼을 잠그고, 성공하면 창을 닫고 목록을 다시 받는다(실패하면 잠금을 푼다)",
                        "type": "click",
                        "handler": "sequence",
                        "actions": [
                            {
                                "handler": "setState",
                                "params": {
                                    "target": "global",
                                    "reviewDeleteModal.isDeleting": true
                                }
                            },
                            {
                                "handler": "apiCall",
                                "target": "/api/modules/sirsoft-ecommerce/user/reviews/{{_global.reviewDeleteModal?.reviewId}}",
                                "auth_required": true,
                                "params": {
                                    "method": "DELETE"
                                },
                                "onSuccess": [
                                    {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "reviewDeleteModal.isDeleting": false
                                        }
                                    },
                                    {
                                        "handler": "closeModal"
                                    },
                                    {
                                        "handler": "refetchDataSource",
                                        "params": {
                                            "dataSourceId": "myReviews"
                                        }
                                    },
                                    {
                                        "handler": "toast",
                                        "params": {
                                            "type": "success",
                                            "message": "$t:mypage.reviews.delete_modal.success"
                                        }
                                    }
                                ],
                                "onError": [
                                    {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "reviewDeleteModal.isDeleting": false
                                        }
                                    },
                                    {
                                        "handler": "toast",
                                        "params": {
                                            "type": "error",
                                            "message": "{{error.message ?? '$t:mypage.reviews.delete_modal.failed'}}"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "props": {
                    "type": "button",
                    "className": "inline-flex items-center justify-center gap-2 px-4 py-2 bg-red-600 dark:bg-red-500 text-white rounded-lg hover:bg-red-700 dark:hover:bg-red-600 disabled:opacity-50 disabled:cursor-not-allowed",
                    "disabled": "{{_global.reviewDeleteModal?.isDeleting === true}}"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Icon",
                        "if": "{{_global.reviewDeleteModal?.isDeleting === true}}",
                        "props": {
                            "name": "spinner",
                            "size": "sm",
                            "className": "animate-spin"
                        }
                    },
                    {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:mypage.reviews.delete"
                    }
                ]
            }
        ]
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "py-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-sm text-gray-700 dark:text-gray-300"
                    },
                    "text": "$t:mypage.reviews.delete_modal.message|product={{_global.reviewDeleteModal?.productName ?? ''}}"
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "mt-2 text-xs text-gray-500 dark:text-gray-400"
                    },
                    "text": "$t:mypage.reviews.delete_modal.warning"
                }
            ]
        }
    ]
}
