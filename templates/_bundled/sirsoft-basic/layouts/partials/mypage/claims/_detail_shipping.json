                            },
                            "props": {
                                "className": "text-xs text-gray-600 dark:text-gray-400"
                            },
                            "text": "{{row.product_name ?? ''}}{{row.option_name ? ' (' + row.option_name + ')' : ''}} × {{row.quantity ?? 0}}"
                        }
                    ]
                },
                {
                    "comment": "전체 재발송 완료 — 모든 상품이 도착했을 때만 찍힌다(S2).",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{!!claim.data?.claim?.redelivered_at_formatted}}",
                    "props": {
                        "className": "flex items-baseline justify-between gap-3"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-sm text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:claim.detail.redelivered_at"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-sm text-gray-900 dark:text-white"
                            },
                            "text": "{{claim.data?.claim?.redelivered_at_formatted}}"
                        }
                    ]
                }
            ]
        }
    ]
}
