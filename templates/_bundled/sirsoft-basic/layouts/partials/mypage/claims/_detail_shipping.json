                                "className": "text-sm text-gray-500 dark:text-gray-400 flex-shrink-0"
                            },
                            "text": "$t:claim.detail.collection_address"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-sm text-gray-900 dark:text-white text-right"
                            },
                            "text": "({{claim.data?.claim?.return_addresses?.[0]?.address_snapshot?.zipcode ?? ''}}) {{claim.data?.claim?.return_addresses?.[0]?.address_snapshot?.address1 ?? ''}} {{claim.data?.claim?.return_addresses?.[0]?.address_snapshot?.address2 ?? ''}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{(claim.data?.claim?.return_addresses ?? []).length > 1}}",
