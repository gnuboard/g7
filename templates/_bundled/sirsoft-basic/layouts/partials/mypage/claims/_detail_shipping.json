                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400 flex-shrink-0"
                                            },
                                            "text": "$t:claim.detail.collection_address_n|n={{addressIdx + 1}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-900 dark:text-white text-right"
                                            },
                                            "text": "({{address.address_snapshot?.zipcode ?? ''}}) {{address.address_snapshot?.address1 ?? ''}} {{address.address_snapshot?.address2 ?? ''}}"
                                        }
                                    ]
