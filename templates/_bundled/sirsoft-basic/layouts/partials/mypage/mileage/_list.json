                                    "name": "Div",
                                    "props": {
                                        "className": "flex items-center justify-between mb-1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "classMap": {
                                                "base": "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium",
                                                "key": "{{tx.user_display_category}}",
                                                "variants": {
                                                    "earn": "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400",
                                                    "use": "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400",
                                                    "expire": "bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300",
                                                    "adjust": "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400"
                                                },
                                                "default": "bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300"
                                            },
                                            "text": "$t:mypage.mileage.category.{{tx.user_display_category}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "classMap": {
                                                "base": "font-semibold text-sm",
                                                "key": "{{tx.amount >= 0 ? 'plus' : 'minus'}}",
                                                "variants": {
                                                    "plus": "text-green-600 dark:text-green-400",
                                                    "minus": "text-blue-600 dark:text-blue-400"
                                                },
                                                "default": "text-gray-700 dark:text-gray-300"
                                            },
                                            "text": "{{tx.amount >= 0 ? '+' : ''}}{{Number(tx.amount ?? 0).toLocaleString()}} P"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-sm text-gray-700 dark:text-gray-300"
                                    },
                                    "text": "{{tx.description ?? ''}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex items-center justify-between mt-1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-xs text-gray-400 dark:text-gray-500"
                                            },
                                            "text": "{{tx.created_at_formatted ?? ''}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{tx.expires_at_formatted}}",
                                            "props": {
                                                "className": "text-xs text-gray-400 dark:text-gray-500"
                                            },
                                            "text": "$t:mypage.mileage.expires_label|date={{tx.expires_at_formatted}}"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "comment": "내역 없음",
            "type": "basic",
            "name": "Div",
            "if": "{{mileage_balance?.data?.mileage?.enabled && (!mileage_history.data.transactions.data || mileage_history.data.transactions.data.length === 0)}}",
            "responsive": {
                "portable": {
                    "props": {
                        "className": "bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6 text-center"
                    }
                }
            },
            "props": {
                "className": "bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-8 text-center"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "responsive": {
                        "portable": {
                            "props": {
                                "name": "coins",
                                "size": "2x",
                                "className": "mx-auto text-gray-300 dark:text-gray-600 mb-2"
                            }
                        }
                    },
                    "props": {
                        "name": "coins",
                        "size": "3x",
                        "className": "mx-auto text-gray-300 dark:text-gray-600 mb-3"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "text-sm text-gray-500 dark:text-gray-400"
                            }
                        }
                    },
                    "props": {
                        "className": "text-gray-500 dark:text-gray-400"
                    },
                    "text": "$t:mypage.mileage.empty"
                }
            ]
        },
        {
            "comment": "페이지네이션",
            "type": "composite",
            "name": "Pagination",
            "if": "{{((mileage_history.data.transactions.pagination.last_page ?? 0) > 1) || (mileage_history.data.transactions.pagination.has_more_pages === true) || ((mileage_history.data.transactions.pagination.current_page ?? 1) > 1)}}",
            "responsive": {
                "portable": {
                    "props": {
                        "currentPage": "{{mileage_history.data.transactions.pagination.current_page}}",
                        "totalPages": "{{mileage_history.data.transactions.pagination.last_page ?? null}}",
                        "hasMorePages": "{{mileage_history.data.transactions.pagination.has_more_pages ?? false}}",
                        "className": "mt-3"
                    }
                }
            },
            "actions": [
                {
                    "event": "onPageChange",
                    "handler": "sequence",
                    "actions": [
                        {
                            "handler": "setState",
                            "params": {
                                "target": "local",
                                "mileagePage": "{{$args[0]}}"
                            }
                        },
                        {
                            "handler": "navigate",
                            "params": {
                                "path": "/mypage/mileage",
                                "mergeQuery": true,
                                "replace": true,
                                "query": {
                                    "page": "{{$args[0]}}"
                                }
                            }
                        }
                    ]
                }
            ],
            "props": {
                "currentPage": "{{mileage_history.data.transactions.pagination.current_page}}",
                "totalPages": "{{mileage_history.data.transactions.pagination.last_page ?? null}}",
                "hasMorePages": "{{mileage_history.data.transactions.pagination.has_more_pages ?? false}}",
                "className": "mt-4"
            }
        }
    ]
}
