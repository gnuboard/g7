{
    "comment": "게시판 활동의 「내 글」 하위 탭. 조건이 URL 이 아니라 `_global.myPosts*` 에 살기 때문에 이 조각은\n     조건을 바꾼 뒤 **스스로 refetch 를 걸어야** 한다 — 목록 화면들이 `navigate` 만으로 끝나는 것과 갈리는 자리다.\n     상태 이름에 `myPosts` 접두어가 붙는 것은 옆 「내 댓글」 탭이 같은 모양의 조건을 따로 들고 있기 때문이다.",
    "meta": {
        "is_partial": true,
        "description": "마이페이지 내 게시글 활동 - 내가 쓴 글 탭"
    },
    "type": "basic",
    "name": "Div",
    "children": [
        {
            "comment": "필터 영역",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex flex-col sm:flex-row gap-3 mb-4"
            },
            "children": [
                {
                    "comment": "게시판 필터",
                    "type": "basic",
                    "name": "Select",
                    "actions": [
                        {
                            "type": "change",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "myPostsBoard": "{{$event.target.value}}",
                                        "myPostsPage": 1
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "myPosts"
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "value": "{{_global.myPostsBoard ?? ''}}",
                        "className": "min-w-[120px] px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Option",
                            "props": {
                                "value": ""
                            },
                            "text": "$t:mypage.board_activities.filter.all_boards"
                        },
                        {
                            "type": "basic",
                            "name": "Option",
                            "iteration": {
                                "source": "{{boards?.data ?? []}}",
                                "item_var": "board"
                            },
                            "props": {
                                "value": "{{board.slug}}"
                            },
                            "text": "{{board.name}}"
                        }
                    ]
                },
                {
                    "comment": "정렬 필터",
                    "type": "basic",
                    "name": "Select",
                    "actions": [
                        {
                            "type": "change",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "myPostsSort": "{{$event.target.value}}",
                                        "myPostsPage": 1
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "myPosts"
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "value": "{{_global.myPostsSort ?? 'latest'}}",
                        "className": "min-w-[100px] px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Option",
                            "props": {
                                "value": "latest"
                            },
                            "text": "$t:mypage.board_activities.sort.latest"
                        },
                        {
                            "type": "basic",
                            "name": "Option",
                            "props": {
                                "value": "oldest"
                            },
                            "text": "$t:mypage.board_activities.sort.oldest"
                        },
                        {
                            "type": "basic",
                            "name": "Option",
                            "props": {
                                "value": "views"
                            },
                            "text": "$t:mypage.board_activities.sort.views"
                        }
                    ]
                },
                {
                    "comment": "검색 영역",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex-1 flex gap-2"
                    },
                    "children": [
                        {
                            "comment": "검색 대상 — 제목만/내용만을 백엔드가 갈라 준다. 담아만 두고 조회는 검색 버튼이 한다",
                            "id": "my_posts_search_field_select",
                            "type": "basic",
                            "name": "Select",
                            "actions": [
                                {
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "myPostsSearchField": "{{$event.target.value}}"
                                    }
                                }
                            ],
                            "props": {
                                "value": "{{_global.myPostsSearchField ?? 'title_content'}}",
                                "className": "px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white",
                                "options": [
                                    {
                                        "value": "title_content",
                                        "label": "$t:mypage.board_activities.search_fields.title_content"
                                    },
                                    {
                                        "value": "title",
                                        "label": "$t:mypage.board_activities.search_fields.title"
                                    },
                                    {
                                        "value": "content",
                                        "label": "$t:mypage.board_activities.search_fields.content"
                                    }
                                ]
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "actions": [
                                {
                                    "comment": "글 제목·본문 검색어 — 타이핑은 담기만 하고 조회는 옆 검색 버튼이 한다",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "myPostsSearch": "{{$event.target.value}}"
                                    }
                                },
                                {
                                    "comment": "Enter 검색 — 검색 버튼과 같은 순서를 탄다. 적용 검색어는 입력칸 값에서 바로 읽는다(상태가 아직 따라오지 않은 마지막 글자도 빠지지 않게). 한글 조합 중 Enter 는 엔진 키 필터가 건너뛴다",
                                    "type": "keypress",
                                    "key": "Enter",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "myPostsPage": 1,
                                                "myPostsSearch": "{{$event.target.value}}",
                                                "myPostsSearchApplied": "{{$event.target.value}}"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "myPosts"
                                            }
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "type": "text",
                                "placeholder": "$t:mypage.board_activities.search_placeholder",
                                "value": "{{_global.myPostsSearch ?? ''}}",
                                "className": "flex-1 min-w-0 px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "검색 — 조건이 URL 이 아니라 전역 상태에 있어 스스로 refetch 를 걸어야 한다. 쪽수를 1 로 되돌리지 않으면 3쪽을 보던 중 검색했을 때 빈 쪽이 뜬다",
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "myPostsPage": 1,
                                                "myPostsSearchApplied": "{{_global.myPostsSearch ?? ''}}"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "myPosts"
                                            }
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "className": "px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg text-sm font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors"
                            },
                            "text": "$t:common.search"
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "초기화 — 게시판·검색어·정렬·쪽수를 한꺼번에 되돌린 뒤 다시 받는다",
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "myPostsBoard": "",
                                                "myPostsSearch": "",
                                                "myPostsSearchApplied": "",
                                                "myPostsSearchField": "title_content",
                                                "myPostsSort": "latest",
                                                "myPostsPage": 1
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "myPosts"
                                            }
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "className": "px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                            },
                            "text": "$t:common.reset"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "검색 조건 표시 영역 (API 응답의 query 값 기반)",
            "type": "basic",
            "name": "Div",
            "if": "{{myPosts?.data?.query?.search || myPosts?.data?.query?.board_slug}}",
            "props": {
                "className": "mb-4 p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg flex items-center justify-between"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex items-center gap-2 text-sm text-blue-700 dark:text-blue-300"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "search",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:mypage.board_activities.search_result"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{myPosts?.data?.query?.search}}",
                            "props": {
                                "className": "font-medium"
                            },
                            "text": "\"{{myPosts?.data?.query?.search}}\""
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "({{myPosts?.data?.total ?? 0}}$t:mypage.board_activities.search_result_unit|count={{myPosts?.data?.total ?? 0}}"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": ")"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "초기화 — 게시판·검색어·정렬·쪽수를 한꺼번에 되돌린 뒤 다시 받는다",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "myPostsBoard": "",
                                        "myPostsSearch": "",
                                        "myPostsSearchApplied": "",
                                        "myPostsSearchField": "title_content",
                                        "myPostsSort": "latest",
                                        "myPostsPage": 1
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "myPosts"
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-200 text-sm"
                    },
                    "text": "$t:common.reset"
                }
            ]
        },
        {
            "comment": "게시글 목록",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "space-y-3"
            },
            "children": [
                {
                    "comment": "게시글 카드 반복",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{myPosts?.data?.data && myPosts.data.data.length > 0}}",
                    "iteration": {
                        "source": "{{myPosts?.data?.data ?? []}}",
                        "item_var": "post"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "navigate",
                                    "params": {
                                        "path": "/board/{{post.board_slug}}/{{post.id}}"
                                    }
                                }
                            ],
                            "props": {
                                "className": "w-full text-left block bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-4 hover:border-gray-300 dark:hover:border-gray-600 transition-colors cursor-pointer"
                            },
                            "children": [
                                {
                                    "comment": "상단: [게시판명] 제목 + 비밀글 아이콘 (한 줄)",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex items-center justify-between gap-3"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-1 min-w-0 flex items-center gap-2"
                                            },
                                            "children": [
                                                {
                                                    "comment": "게시판 이름",
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "inline-flex items-center px-2 py-0.5 text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 rounded flex-shrink-0"
                                                    },
                                                    "text": "{{post.board_name}}"
                                                },
                                                {
                                                    "comment": "제목",
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-base font-medium text-gray-900 dark:text-white truncate"
                                                    },
                                                    "text": "{{post.title}}"
                                                },
                                                {
                                                    "comment": "비밀글 아이콘",
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "if": "{{post.is_secret}}",
                                                    "props": {
                                                        "name": "lock",
                                                        "size": "xs",
                                                        "className": "text-gray-400 dark:text-gray-500 flex-shrink-0"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "comment": "작성일시",
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-xs text-gray-500 dark:text-gray-400 flex-shrink-0 whitespace-nowrap",
                                                "title": "{{post.created_at ?? ''}}"
                                            },
                                            "text": "{{post.created_at_formatted ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "comment": "게시글 내용 요약 (2줄, HTML 태그 제거된 plain text 사용)",
                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{post.content_plain}}",
                                    "props": {
                                        "className": "mt-2 text-sm text-gray-600 dark:text-gray-300 line-clamp-2"
                                    },
                                    "text": "{{post.content_plain}}"
                                },
                                {
                                    "comment": "하단: 조회수 + 댓글수",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex items-center gap-4 mt-2 text-xs text-gray-500 dark:text-gray-400"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "flex items-center gap-1"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:mypage.board_activities.meta.views"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{post.view_count ?? 0}}"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "flex items-center gap-1"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:mypage.board_activities.meta.comments"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{post.comment_count ?? 0}}$t:mypage.board_activities.meta.comments_unit"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "comment": "게시글 없음",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{!myPosts?.data?.data || myPosts.data.data.length === 0}}",
                    "props": {
                        "className": "bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-8 text-center"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "file-text",
                                "size": "3x",
                                "className": "mx-auto text-gray-300 dark:text-gray-600 mb-3"
                            }
                        },
                        {
                            "comment": "검색어·조건을 건 채 0건이면 「아직 없음」이 아니라 조건에 맞는 것이 없다는 뜻이다 — 둘을 섞으면 있는 항목이 사라진 것으로 읽힌다",
                            "type": "basic",
                            "name": "P",
                            "if": "{{!(!!_global.myPostsSearchApplied || !!_global.myPostsBoard)}}",
                            "props": {
                                "className": "text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:mypage.board_activities.empty_posts"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "if": "{{!!_global.myPostsSearchApplied || !!_global.myPostsBoard}}",
                            "props": {
                                "className": "text-gray-500 dark:text-gray-400"
                            },
                            "text": "$t:board.no_search_results"
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "navigate",
                                    "params": {
                                        "path": "/boards"
                                    }
                                }
                            ],
                            "props": {
                                "className": "inline-block mt-4 px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg text-sm font-medium cursor-pointer hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors"
                            },
                            "text": "$t:mypage.board_activities.go_boards"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "페이지네이션",
            "type": "composite",
            "name": "Pagination",
            "if": "{{((myPosts?.data?.last_page ?? 0) > 1) || (myPosts?.data?.has_more_pages === true) || ((myPosts?.data?.current_page ?? 1) > 1)}}",
            "actions": [
                {
                    "event": "onPageChange",
                    "handler": "sequence",
                    "actions": [
                        {
                            "handler": "setState",
                            "params": {
                                "target": "global",
                                "myPostsPage": "{{$args[0]}}"
                            }
                        },
                        {
                            "handler": "refetchDataSource",
                            "params": {
                                "dataSourceId": "myPosts"
                            }
                        }
                    ]
                }
            ],
            "props": {
                "currentPage": "{{myPosts?.data?.current_page ?? 1}}",
                "totalPages": "{{myPosts?.data?.last_page ?? null}}",
                "hasMorePages": "{{myPosts?.data?.has_more_pages ?? false}}",
                "className": "mt-4 flex justify-center"
            }
        }
    ]
}
