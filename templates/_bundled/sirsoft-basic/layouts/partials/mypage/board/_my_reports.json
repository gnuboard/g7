                {
                    "event": "onPageChange",
                    "handler": "sequence",
                    "actions": [
                        {
                            "handler": "setState",
                            "params": {
                                "target": "global",
                                "myReportsPage": "{{$args[0]}}"
                            }
                        },
                        {
                            "handler": "refetchDataSource",
                            "params": {
                                "dataSourceId": "myReports"
                            }
                        }
                    ]
                }
            ],
            "props": {
                "currentPage": "{{myReports?.data?.pagination?.current_page ?? 1}}",
                "totalPages": "{{myReports?.data?.pagination?.last_page ?? null}}",
                "hasMorePages": "{{myReports?.data?.pagination?.has_more_pages ?? false}}",
                "className": "mt-4 flex justify-center"
            }
        }
    ]
}
