{
    "comment": "마이페이지 탭 줄 — 탭이 각각 독립 레이아웃이라 «지금 어디인가» 를 스스로 알 수 없다. 각 화면이\n     `currentTab` 계산값으로 알려 주고 이 조각은 그 값만 읽어 강조한다.",
    "meta": {
        "is_partial": true,
        "description": "마이페이지 공통 탭 네비게이션"
    },
    "id": "mypageTabNavigation",
    "type": "composite",
    "name": "TabNavigation",
    "actions": [
        {
            "type": "change",
            "event": "onTabChange",
            "handler": "navigate",
            "params": {
                "path": "{{`/mypage/${$args[0]}`}}"
            }
        }
    ],
    "props": {
        "variant": "underline",
        "className": "mb-6",
        "hiddenTabIds": "{{_global.modules?.['sirsoft-ecommerce']?.inquiry?.board_slug ? [] : ['inquiries']}}",
        "activeTabId": "{{_computed?.currentTab}}",
        "tabs": [
            {
                "id": "profile",
                "label": "$t:mypage.tabs.profile",
                "iconName": "user"
            },
            {
                "id": "board",
                "label": "$t:mypage.tabs.board",
                "iconName": "message-square"
            },
            {
                "id": "orders",
                "label": "$t:mypage.tabs.orders",
                "iconName": "package"
            },
            {
                "id": "mileage",
                "label": "$t:mypage.tabs.mileage",
                "iconName": "coins"
            },
            {
                "id": "wishlist",
                "label": "$t:mypage.tabs.wishlist",
                "iconName": "heart"
            },
            {
                "id": "addresses",
                "label": "$t:mypage.tabs.addresses",
                "iconName": "map-pin"
            },
            {
                "id": "notifications",
                "label": "$t:mypage.tabs.notifications",
                "iconName": "bell"
            },
            {
                "id": "inquiries",
                "label": "$t:mypage.tabs.inquiries",
                "iconName": "comment"
            }
        ]
    }
}
