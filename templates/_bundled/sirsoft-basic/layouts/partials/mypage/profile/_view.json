                    "text": "$t:mypage.profile.section_signature_bio"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "iteration": {
                        "source": "{{($computed.profileFieldGroups ?? []).filter(function(g) { return g.key === 'profile'; })}}",
                        "item_var": "memberFieldGroup"
                    },
                    "children": [
                        {
                            "partial": "partials/member/_member_fields_view.json"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "확장별 카드 — 모듈과 플러그인이 회원 항목으로 선언한 값(게시판 알림, 결제 통화, 배송 국가, 마케팅 동의 등)을 확장마다 한 카드로 보인다. 카드 제목은 그 확장의 이름이다.",
            "id": "profile_view_extension_card_{{memberFieldGroup.key}}",
            "type": "basic",
            "name": "Div",
            "iteration": {
                "source": "{{$computed.profileExtensionGroups ?? []}}",
                "item_var": "memberFieldGroup"
            },
            "responsive": {
                "portable": {
                    "classMerge": "p-4"
                }
            },
            "props": {
                "className": "bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "text-base font-semibold text-gray-900 dark:text-white mb-4 pb-3 border-b border-gray-200 dark:border-gray-700 break-words"
                    },
                    "text": "{{memberFieldGroup.title}}"
                },
                {
                    "partial": "partials/member/_member_fields_view.json"
                }
            ]
        },
        {
            "comment": "회원 탈퇴 섹션 - 탈퇴 상태가 아닌 경우만 표시",
            "type": "basic",
            "name": "Div",
            "if": "{{user.data?.status !== 'withdrawn'}}",
            "responsive": {
                "portable": {
                    "classMerge": "p-4"
                }
            },
            "props": {
                "className": "bg-red-50 dark:bg-gray-800 rounded-lg shadow-sm border border-red-200 dark:border-red-900/50 p-6"
            },
            "children": [
                {
                    "comment": "제목 (아이콘 인라인)",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex items-center gap-2 mb-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "triangle-exclamation",
                                "size": "lg",
                                "className": "text-red-500"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "H3",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "text-base font-semibold text-red-700 dark:text-red-400"
                                    }
                                }
                            },
                            "props": {
                                "className": "text-lg font-semibold text-red-700 dark:text-red-400"
                            },
                            "text": "$t:mypage.profile.withdraw"
                        }
                    ]
                },
                {
                    "comment": "경고 메시지 박스 (슈퍼관리자 제외)",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{!user.data?.is_super}}",
                    "props": {
                        "className": "bg-red-100 dark:bg-red-950/80 rounded-lg p-4 mb-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-sm text-red-700 dark:text-red-200"
                            },
                            "text": "$t:mypage.profile.withdraw_warning"
                        }
                    ]
                },
                {
                    "comment": "슈퍼관리자 안내 메시지",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{user.data?.is_super}}",
                    "props": {
                        "className": "flex items-start gap-3 p-4 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "info",
                                "size": "md",
                                "className": "text-yellow-700 dark:text-yellow-400 mt-0.5 flex-shrink-0"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-sm text-yellow-800 dark:text-yellow-200"
                            },
                            "text": "$t:mypage.profile.admin_cannot_withdraw"
                        }
                    ]
                },
                {
                    "comment": "탈퇴 버튼 (슈퍼관리자 제외)",
                    "type": "basic",
                    "name": "Button",
                    "if": "{{!user.data?.is_super}}",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "comment": "탈퇴 창 상태(«알고 있다» 체크·처리 중)는 창 고유 전역 이름 공간에 두고 열 때마다 비운 뒤 다시 쓴다 — 페이지 _local 에 쓰면\n               영구 마운트된 창이 쥔 앞 체크에 가려 닿지 않아, 체크 → 취소 → 다시 열기에서 체크된 채 탈퇴 단추가 열려 있었다(7.1.1)",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "profileWithdrawModal": null
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "profileWithdrawModal": {
                                            "confirm": false,
                                            "isWithdrawing": false
                                        }
                                    }
                                },
                                {
                                    "handler": "openModal",
                                    "target": "withdrawModal"
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 border border-red-500 text-red-700 dark:text-red-400 rounded-lg text-sm font-medium hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "trash-can",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:mypage.profile.withdraw_button"
                        }
                    ]
                }
            ]
        }
    ]
}
