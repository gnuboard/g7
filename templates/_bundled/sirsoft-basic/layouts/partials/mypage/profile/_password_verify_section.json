{
    "meta": {
        "is_partial": true,
        "description": "프로필 편집 전 비밀번호 검증 섹션"
    },
    "type": "basic",
    "name": "Div",
    "if": "{{!_local?.isPasswordVerified}}",
    "props": {
        "className": "max-w-lg mx-auto mt-16"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "p-8 border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-800 shadow-sm"
            },
            "children": [
                {
                    "comment": "헤더 영역",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "text-center mb-8"
                    },
                    "children": [
                        {
                            "comment": "Lock 아이콘",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "inline-flex items-center justify-center w-12 h-12 mb-4 rounded-full bg-gray-100 dark:bg-gray-700"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "lock",
                                        "size": "lg",
                                        "className": "text-gray-600 dark:text-gray-400"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "H2",
                            "props": {
                                "className": "text-lg font-semibold text-gray-900 dark:text-white mb-2"
                            },
                            "text": "$t:mypage.profile.verify_password_title"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-sm text-gray-600 dark:text-gray-400"
                            },
                            "text": "$t:mypage.profile.verify_password_message"
                        }
                    ]
                },
                {
                    "comment": "비밀번호 검증 폼",
                    "type": "basic",
                    "name": "Form",
                    "actions": [
                        {
                            "type": "submit",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "isVerifyingPassword": true,
                                        "verifyPasswordError": false
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/me/verify-password",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST",
                                        "body": {
                                            "password": "{{_local.verifyPassword}}"
                                        }
                                    },
                                    "onSuccess": {
                                        "handler": "setState",
                                        "params": {
                                            "target": "local",
                                            "isVerifyingPassword": false,
                                            "isPasswordVerified": true,
                                            "verifyPassword": ""
                                        }
                                    },
                                    "onError": {
                                        "handler": "setState",
                                        "params": {
                                            "target": "local",
                                            "isVerifyingPassword": false,
                                            "verifyPasswordError": true
                                        }
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "id": "verifyPasswordForm",
                        "className": "space-y-5"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "PasswordInput",
                                    "actions": [
                                        {
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "verifyPassword": "{{$event.target.value}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "name": "password",
                                        "value": "{{_local?.verifyPassword ?? ''}}",
                                        "placeholder": "$t:mypage.profile.verify_password_placeholder",
                                        "showToggle": true,
                                        "className": "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-gray-900 dark:focus:ring-white focus:border-transparent transition-colors"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{_local?.verifyPasswordError}}",
                                    "props": {
                                        "className": "mt-2 text-sm text-red-600 dark:text-red-400"
                                    },
                                    "text": "$t:mypage.profile.verify_password_error"
                                }
                            ]
                        },
                        {
                            "comment": "버튼 영역",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex gap-3 pt-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Button",
                                    "actions": [
                                        {
                                            "type": "click",
                                            "handler": "navigate",
                                            "params": {
                                                "path": "/mypage/profile"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "className": "flex-1 px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                                    },
                                    "text": "$t:common.cancel"
                                },
                                {
                                    "type": "basic",
                                    "name": "Button",
                                    "props": {
                                        "type": "submit",
                                        "form": "verifyPasswordForm",
                                        "loading": "{{_local.isVerifyingPassword}}",
                                        "disabled": "{{_local.isVerifyingPassword || !_local.verifyPassword}}",
                                        "className": "flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{_local.isVerifyingPassword}}",
                                            "props": {
                                                "name": "spinner",
                                                "size": "sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:mypage.profile.verify_password_button"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
