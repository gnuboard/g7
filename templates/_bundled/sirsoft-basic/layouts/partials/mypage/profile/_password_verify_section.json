{
    "comment": "내 정보를 고치기 전에 본인 확인을 한 번 더 받는 칸 — 로그인 세션이 남의 손에 있을 때 개인정보가\n     그대로 바뀌지 않게 하는 자리다. 확인을 통과해야 아래 편집 폼이 열린다.",
    "meta": {
        "is_partial": true,
        "description": "프로필 편집 전 비밀번호 검증 섹션"
    },
    "type": "basic",
    "name": "Div",
    "if": "{{!_local?.isPasswordVerified}}",
    "props": {
        "className": "max-w-lg mx-auto mt-16"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "p-8 border border-gray-200 dark:border-gray-700 rounded-xl bg-white dark:bg-gray-800 shadow-sm"
            },
            "children": [
                {
                    "comment": "헤더 영역",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "text-center mb-8"
                    },
                    "children": [
                        {
                            "comment": "Lock 아이콘",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "inline-flex items-center justify-center w-12 h-12 mb-4 rounded-full bg-gray-100 dark:bg-gray-700"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "lock",
                                        "size": "lg",
                                        "className": "text-gray-600 dark:text-gray-400"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "H2",
                            "props": {
                                "className": "text-lg font-semibold text-gray-900 dark:text-white mb-2"
                            },
                            "text": "$t:mypage.profile.verify_password_title"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-sm text-gray-600 dark:text-gray-400"
                            },
                            "text": "$t:mypage.profile.verify_password_message"
                        }
                    ]
                },
                {
                    "comment": "비밀번호 검증 폼 — 비밀번호가 있는 회원",
                    "type": "basic",
                    "name": "Form",
                    "if": "{{(user?.data?.has_password ?? _global.currentUser?.has_password) !== false}}",
                    "actions": [
                        {
                            "type": "submit",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "isVerifyingPassword": true,
                                        "verifyPasswordError": false
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/me/verify-password",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST",
                                        "body": {
                                            "password": "{{_local.verifyPassword}}"
                                        }
                                    },
                                    "onSuccess": {
                                        "handler": "setState",
                                        "params": {
                                            "target": "local",
                                            "isVerifyingPassword": false,
                                            "isPasswordVerified": true,
                                            "verifyPassword": ""
                                        }
                                    },
                                    "onError": {
                                        "handler": "setState",
                                        "params": {
                                            "target": "local",
                                            "isVerifyingPassword": false,
                                            "verifyPasswordError": true
                                        }
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "id": "verifyPasswordForm",
                        "className": "space-y-5"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "PasswordInput",
                                    "actions": [
                                        {
                                            "comment": "확인용 비밀번호 — 담기만 하고 대조는 확인 버튼이 서버에 묻는다",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "verifyPassword": "{{$event.target.value}}"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "name": "password",
                                        "value": "{{_local?.verifyPassword ?? ''}}",
                                        "placeholder": "$t:mypage.profile.verify_password_placeholder",
                                        "showToggle": true,
                                        "className": "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-300 focus:ring-2 focus:ring-gray-900 dark:focus:ring-white focus:border-transparent transition-colors"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{_local?.verifyPasswordError}}",
                                    "props": {
                                        "className": "mt-2 text-sm text-red-600 dark:text-red-400"
                                    },
                                    "text": "$t:mypage.profile.verify_password_error"
                                }
                            ]
                        },
                        {
                            "comment": "버튼 영역",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex gap-3 pt-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "A",
                                    "actions": [
                                        {
                                            "type": "click",
                                            "handler": "navigate"
                                        }
                                    ],
                                    "props": {
                                        "href": "/mypage/profile",
                                        "className": "inline-flex items-center justify-center flex-1 px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                                    },
                                    "text": "$t:common.cancel"
                                },
                                {
                                    "type": "basic",
                                    "name": "Button",
                                    "props": {
                                        "type": "submit",
                                        "form": "verifyPasswordForm",
                                        "loading": "{{_local.isVerifyingPassword}}",
                                        "disabled": "{{_local.isVerifyingPassword || !_local.verifyPassword}}",
                                        "className": "flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{_local.isVerifyingPassword}}",
                                            "props": {
                                                "name": "spinner",
                                                "size": "sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:mypage.profile.verify_password_button"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "comment": "이메일 인증번호 확인 — 비밀번호가 없는 회원(소셜 로그인 등 외부 인증으로만 가입). 코어 본인인증(목적 `sensitive_action`)으로\n           인증번호를 받아 확인하면 받은 확인 토큰을 비밀번호 확인 API 에 실어 보낸다 — 서버가 본인 것인지·한 번만 쓰는지 확인한다.",
                    "id": "reauth_email_code_section",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{(user?.data?.has_password ?? _global.currentUser?.has_password) === false}}",
                    "props": {
                        "className": "space-y-5"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "p-3 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 text-sm text-blue-700 dark:text-blue-300",
                                "role": "status"
                            },
                            "text": "$t:mypage.profile.reauth_notice"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "if": "{{!!_local?.reauthChallengeId}}",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
                                    },
                                    "text": "$t:mypage.profile.reauth_code_label"
                                },
                                {
                                    "comment": "자동바인딩을 쓰지 않는다 — 다시 받으면 입력값을 비워야 하므로 상태가 값을 소유한다",
                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "event": "onChange",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "reauthCode": "{{$event.target.value}}",
                                                "reauthError": null
                                            }
                                        }
                                    ],
                                    "props": {
                                        "type": "text",
                                        "name": "reauth_code",
                                        "value": "{{_local?.reauthCode ?? ''}}",
                                        "inputMode": "numeric",
                                        "autoComplete": "one-time-code",
                                        "maxLength": "10",
                                        "placeholder": "$t:mypage.profile.reauth_code_placeholder",
                                        "className": "w-full px-4 py-3 text-center text-xl tracking-widest font-mono border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-gray-900 dark:focus:ring-white focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed",
                                        "disabled": "{{_local?.isVerifyingReauth ?? false}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{_local?.reauthExpiresAt}}",
                                    "props": {
                                        "className": "mt-2 text-xs text-gray-500 dark:text-gray-400"
                                    },
                                    "text": "$t:mypage.profile.reauth_valid_until|until={{_local?.reauthExpiresAt | datetime}}"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "if": "{{_local?.reauthError}}",
                            "props": {
                                "className": "text-sm text-red-600 dark:text-red-400",
                                "role": "alert"
                            },
                            "text": "{{_local?.reauthError ?? ''}}"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex flex-col sm:flex-row gap-3 pt-2"
                            },
                            "children": [
                                {
                                    "id": "reauth_request_code_button",
                                    "type": "basic",
                                    "name": "Button",
                                    "actions": [
                                        {
                                            "comment": "인증번호 받기 — 진행 표시를 켜고 본인(로그인 회원) 대상 재확인 요청을 메일 수단으로 보낸다. 다시 받으면 새 요청으로 바꾸고 입력값을 비운다.",
                                            "type": "click",
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "isRequestingReauthCode": true,
                                                        "reauthError": null
                                                    }
                                                },
                                                {
                                                    "handler": "apiCall",
                                                    "target": "/api/identity/challenges",
                                                    "auth_required": true,
                                                    "params": {
                                                        "method": "POST",
                                                        "body": {
                                                            "purpose": "sensitive_action",
                                                            "provider_id": "g7:core.mail"
                                                        }
                                                    },
                                                    "onSuccess": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "isRequestingReauthCode": false,
                                                                "reauthChallengeId": "{{response.data?.id}}",
                                                                "reauthExpiresAt": "{{response.data?.expires_at}}",
                                                                "reauthCode": ""
                                                            }
                                                        },
                                                        {
                                                            "handler": "toast",
                                                            "params": {
                                                                "type": "info",
                                                                "message": "$t:mypage.profile.reauth_code_sent"
                                                            }
                                                        }
                                                    ],
                                                    "onError": {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isRequestingReauthCode": false,
                                                            "reauthError": "{{error.message}}"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "className": "flex-1 px-4 py-2.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer",
                                        "disabled": "{{(_local?.isRequestingReauthCode ?? false) || (_local?.isVerifyingReauth ?? false)}}"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{!_local?.reauthChallengeId}}",
                                            "text": "$t:mypage.profile.reauth_request_code"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{!!_local?.reauthChallengeId}}",
                                            "text": "$t:mypage.profile.reauth_resend_code"
                                        }
                                    ]
                                },
                                {
                                    "id": "reauth_confirm_button",
                                    "type": "basic",
                                    "name": "Button",
                                    "actions": [
                                        {
                                            "comment": "확인 — 인증번호를 확인해 받은 토큰을 비밀번호 확인 API 에 보낸다. 통과하면 편집 폼을 연다. 실패 문구는 이 칸 아래에 싣는다.",
                                            "type": "click",
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "isVerifyingReauth": true,
                                                        "reauthError": null
                                                    }
                                                },
                                                {
                                                    "handler": "apiCall",
                                                    "target": "/api/identity/challenges/{{_local.reauthChallengeId}}/verify",
                                                    "auth_required": true,
                                                    "params": {
                                                        "method": "POST",
                                                        "body": {
                                                            "code": "{{_local.reauthCode}}"
                                                        }
                                                    },
                                                    "onSuccess": {
                                                        "handler": "apiCall",
                                                        "target": "/api/me/verify-password",
                                                        "auth_required": true,
                                                        "params": {
                                                            "method": "POST",
                                                            "body": {
                                                                "verification_token": "{{response.data?.verification_token}}"
                                                            }
                                                        },
                                                        "onSuccess": {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "isVerifyingReauth": false,
                                                                "isPasswordVerified": true,
                                                                "reauthCode": "",
                                                                "reauthChallengeId": null
                                                            }
                                                        },
                                                        "onError": {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "isVerifyingReauth": false,
                                                                "reauthError": "{{error.message}}"
                                                            }
                                                        }
                                                    },
                                                    "onError": {
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "isVerifyingReauth": false,
                                                            "reauthError": "{{error.message}}"
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    ],
                                    "props": {
                                        "type": "button",
                                        "className": "flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer",
                                        "disabled": "{{!_local?.reauthChallengeId || !_local?.reauthCode || _local.reauthCode.length < 4 || (_local?.isVerifyingReauth ?? false)}}"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "if": "{{_local?.isVerifyingReauth}}",
                                            "props": {
                                                "name": "spinner",
                                                "size": "sm"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:mypage.profile.reauth_confirm"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "navigate",
                                    "params": {
                                        "path": "/mypage/profile"
                                    }
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "w-full px-4 py-2.5 text-sm text-gray-600 dark:text-gray-400 hover:underline cursor-pointer"
                            },
                            "text": "$t:common.cancel"
                        }
                    ]
                }
            ]
        }
    ]
}
