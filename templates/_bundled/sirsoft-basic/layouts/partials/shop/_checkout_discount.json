{
    "comment": "주문서의 할인 칸. 고른 쿠폰·할인코드는 화면에서 금액을 깎지 않고 **주문서를 통째로 서버에 다시\n     보내(PUT)** 계산된 결과를 받아 온다 — 쿠폰·적립금·배송비가 서로 물려 있어 한 조각만 계산할 수 없다.",
    "meta": {
        "is_partial": true,
        "description": "할인/쿠폰 적용 섹션 - 쿠폰 선택 및 할인코드 입력 (PC/모바일 반응형). 카드 전체가 회원 전용 — 비회원은 쿠폰(회원 발급) 미지원이며 할인코드 시스템도 백엔드 미구현 상태"
    },
    "type": "basic",
    "name": "Div",
    "if": "{{_global.currentUser?.uuid}}",
    "responsive": {
        "portable": {
            "props": {
                "className": "bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-4"
            }
        }
    },
    "props": {
        "className": "bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6"
    },
    "children": [
        {
            "comment": "섹션 헤더",
            "type": "basic",
            "name": "Div",
            "responsive": {
                "portable": {
                    "props": {
                        "className": "flex-between mb-3 pb-3 border-b border-gray-200 dark:border-gray-700"
                    }
                }
            },
            "props": {
                "className": "flex-between mb-4 pb-4 border-b border-gray-200 dark:border-gray-700"
            },
            "children": [
                {
                    "comment": "좌측: 아이콘 + 타이틀",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex items-center gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "tag",
                                "className": "text-gray-700 dark:text-gray-300",
                                "size": "md"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "H2",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "text-base font-semibold text-gray-900 dark:text-white"
                                    }
                                }
                            },
                            "props": {
                                "className": "text-lg font-semibold text-gray-900 dark:text-white"
                            },
                            "text": "$t:shop.checkout.discount_section_title"
                        }
                    ]
                },
                {
                    "comment": "우측: 쿠폰 다운로드 버튼 (로그인 사용자만)",
                    "type": "basic",
                    "name": "Button",
                    "if": "{{_global.currentUser?.uuid}}",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "downloadableCouponsLoading": true,
                                        "downloadableCouponsPage": 1
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/modules/sirsoft-ecommerce/user/coupons/downloadable?page=1&per_page=8",
                                    "auth_mode": "required",
                                    "params": {
                                        "method": "GET"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "downloadableCoupons": "{{response.data}}",
                                                "downloadableCouponsLoading": false
                                            }
                                        },
                                        {
                                            "handler": "openModal",
                                            "target": "coupon_download_modal"
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "downloadableCouponsLoading": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message ?? '$t:shop.coupon_download.fetch_failed'}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20 rounded-lg hover:bg-blue-100 dark:hover:bg-blue-900/30 transition-colors"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "download",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:shop.checkout.coupon_download_btn"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "주문 쿠폰 선택 (로그인 사용자만)",
            "type": "basic",
            "name": "Div",
            "if": "{{_global.currentUser?.uuid}}",
            "responsive": {
                "portable": {
                    "props": {
                        "className": "mb-3"
                    }
                }
            },
            "props": {
                "className": "mb-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:shop.checkout.order_coupon_select"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{(checkoutData.data.available_coupons ?? []).filter(c => c.target_type === 'order_amount').length > 0}}",
                            "props": {
                                "className": "ml-2 text-xs text-blue-600 dark:text-blue-400"
                            },
                            "text": "({{(checkoutData.data.available_coupons ?? []).filter(c => c.target_type === 'order_amount').length}}$t:shop.checkout.coupon_count_suffix)"
                        }
                    ]
                },
                {
                    "comment": "주문 쿠폰 드롭다운",
                    "type": "basic",
                    "name": "Select",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm"
                            }
                        }
                    },
                    "actions": [
                        {
                            "type": "change",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "checkout": "{{Object.assign({}, _local.checkout, { order_coupon_issue_id: $event.target.value || null })}}"
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/modules/sirsoft-ecommerce/checkout",
                                    "auth_mode": "optional",
                                    "params": {
                                        "method": "PUT",
                                        "body": "{{_local.checkout}}"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "updateDataSource",
                                            "params": {
                                                "dataSourceId": "checkoutData",
                                                "data": "{{response}}"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "{{$event.target.value ? '$t:shop.checkout.order_coupon_applied' : '$t:shop.checkout.order_coupon_removed'}}"
                                            }
                                        }
                                    ],
                                    "onError": {
                                        "handler": "toast",
                                        "params": {
                                            "type": "error",
                                            "message": "{{error.message}}"
                                        }
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "name": "order_coupon_issue_id",
                        "value": "{{_local.checkout?.order_coupon_issue_id ?? ''}}",
                        "className": "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Option",
                            "props": {
                                "value": ""
                            },
                            "text": "{{(checkoutData.data.available_coupons ?? []).filter(c => c.target_type === 'order_amount').length > 0 ? '$t:shop.checkout.order_coupon_placeholder' : '$t:shop.checkout.order_coupon_no_available'}}"
                        },
                        {
                            "type": "basic",
                            "name": "Option",
                            "iteration": {
                                "source": "{{(checkoutData.data.available_coupons ?? []).filter(c => c.target_type === 'order_amount')}}",
                                "item_var": "coupon",
                                "index_var": "couponIdx"
                            },
                            "props": {
                                "value": "{{coupon.id}}"
                            },
                            "text": "{{'[' + coupon.target_type_short_label + '] ' + coupon.localized_name + ' (' + (coupon.multi_currency_benefit_formatted?.[_global.preferredCurrency ?? _global.defaultCurrency] ?? coupon.benefit_formatted) + ')'}}"
                        }
                    ]
                },
                {
                    "comment": "적용된 주문 쿠폰 정보",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.checkout?.order_coupon_issue_id && (checkoutData.data.calculation?.summary?.order_coupon_discount ?? 0) > 0}}",
                    "props": {
                        "className": "mt-2 text-sm text-green-600 dark:text-green-400 flex items-center gap-1"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "check-circle",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "-{{checkoutData.data.calculation?.summary?.multi_currency?.[_global.preferredCurrency ?? _global.defaultCurrency]?.order_coupon_discount_formatted ?? checkoutData.data.calculation?.summary?.order_coupon_discount_formatted}}"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "배송비 쿠폰 선택 (로그인 사용자만)",
            "type": "basic",
            "name": "Div",
            "if": "{{_global.currentUser?.uuid}}",
            "responsive": {
                "portable": {
                    "props": {
                        "className": "mb-3"
                    }
                }
            },
            "props": {
                "className": "mb-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:shop.checkout.shipping_coupon_select"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{(checkoutData.data.available_coupons ?? []).filter(c => c.target_type === 'shipping_fee').length > 0}}",
                            "props": {
                                "className": "ml-2 text-xs text-blue-600 dark:text-blue-400"
                            },
                            "text": "({{(checkoutData.data.available_coupons ?? []).filter(c => c.target_type === 'shipping_fee').length}}$t:shop.checkout.coupon_count_suffix)"
                        }
                    ]
                },
                {
                    "comment": "배송비 쿠폰 드롭다운",
                    "type": "basic",
                    "name": "Select",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm"
                            }
                        }
                    },
                    "actions": [
                        {
                            "type": "change",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "checkout": "{{Object.assign({}, _local.checkout, { shipping_coupon_issue_id: $event.target.value || null })}}"
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/modules/sirsoft-ecommerce/checkout",
                                    "auth_mode": "optional",
                                    "params": {
                                        "method": "PUT",
                                        "body": "{{_local.checkout}}"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "updateDataSource",
                                            "params": {
                                                "dataSourceId": "checkoutData",
                                                "data": "{{response}}"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "{{$event.target.value ? '$t:shop.checkout.shipping_coupon_applied' : '$t:shop.checkout.shipping_coupon_removed'}}"
                                            }
                                        }
                                    ],
                                    "onError": {
                                        "handler": "toast",
                                        "params": {
                                            "type": "error",
                                            "message": "{{error.message}}"
                                        }
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "name": "shipping_coupon_issue_id",
                        "value": "{{_local.checkout?.shipping_coupon_issue_id ?? ''}}",
                        "className": "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Option",
                            "props": {
                                "value": ""
                            },
                            "text": "{{(checkoutData.data.available_coupons ?? []).filter(c => c.target_type === 'shipping_fee').length > 0 ? '$t:shop.checkout.shipping_coupon_placeholder' : '$t:shop.checkout.shipping_coupon_no_available'}}"
                        },
                        {
                            "type": "basic",
                            "name": "Option",
                            "iteration": {
                                "source": "{{(checkoutData.data.available_coupons ?? []).filter(c => c.target_type === 'shipping_fee')}}",
                                "item_var": "coupon",
                                "index_var": "couponIdx"
                            },
                            "props": {
                                "value": "{{coupon.id}}"
                            },
                            "text": "{{'[' + coupon.target_type_short_label + '] ' + coupon.localized_name + ' (' + (coupon.multi_currency_benefit_formatted?.[_global.preferredCurrency ?? _global.defaultCurrency] ?? coupon.benefit_formatted) + ')'}}"
                        }
                    ]
                },
                {
                    "comment": "적용된 배송비 쿠폰 정보",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_local.checkout?.shipping_coupon_issue_id && (checkoutData.data.calculation?.summary?.shipping_discount ?? 0) > 0}}",
                    "props": {
                        "className": "mt-2 text-sm text-green-600 dark:text-green-400 flex items-center gap-1"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "check-circle",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "-{{checkoutData.data.calculation?.summary?.multi_currency?.[_global.preferredCurrency ?? _global.defaultCurrency]?.shipping_discount_formatted ?? checkoutData.data.calculation?.summary?.shipping_discount_formatted ?? ($t('sirsoft-ecommerce.currency.krw_prefix') + checkoutData.data.calculation?.summary?.shipping_discount + $t('sirsoft-ecommerce.currency.krw_suffix'))}}"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "할인코드 입력",
            "type": "basic",
            "name": "Div",
            "children": [
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
                    },
                    "text": "$t:shop.checkout.discount_code"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Input",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "flex-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm"
                                    }
                                }
                            },
                            "actions": [
                                {
                                    "comment": "코드는 담기만 하고 적용은 옆 버튼이 한다. `Object.assign` 으로 통째 교체하는 이유는\n                 주문서 상태가 한 객체이고 그 객체 전체가 다음 PUT 의 본문이 되기 때문이다",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "checkout": "{{Object.assign({}, _local.checkout, { discount_code: $event.target.value || null })}}"
                                    }
                                }
                            ],
                            "props": {
                                "type": "text",
                                "name": "discount_code",
                                "value": "{{_local.checkout?.discount_code ?? ''}}",
                                "placeholder": "$t:shop.checkout.discount_code_placeholder",
                                "className": "flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500"
                            }
                        },
                        {
                            "comment": "할인코드 적용. 서버가 코드의 유효성과 이 주문에 쓸 수 있는지를 함께 판정하므로 화면에서 미리 거르지 않는다",
                            "type": "basic",
                            "name": "Button",
                            "responsive": {
                                "portable": {
                                    "props": {
                                        "className": "px-3 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium text-sm hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors disabled:opacity-50"
                                    }
                                }
                            },
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "apiCall",
                                    "target": "/api/modules/sirsoft-ecommerce/checkout",
                                    "auth_mode": "optional",
                                    "params": {
                                        "method": "PUT",
                                        "body": "{{_local.checkout}}"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "updateDataSource",
                                            "params": {
                                                "dataSourceId": "checkoutData",
                                                "data": "{{response}}"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:shop.checkout.discount_code_applied"
                                            }
                                        }
                                    ],
                                    "onError": {
                                        "handler": "toast",
                                        "params": {
                                            "type": "error",
                                            "message": "{{error.message ?? '$t:shop.checkout.discount_code_invalid'}}"
                                        }
                                    }
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors disabled:opacity-50",
                                "disabled": "{{!_local.checkout?.discount_code}}"
                            },
                            "text": "$t:shop.checkout.discount_code_apply"
                        }
                    ]
                },
                {
                    "comment": "적용된 할인코드 정보",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{(checkoutData.data.calculation?.summary?.code_discount ?? 0) > 0}}",
                    "props": {
                        "className": "mt-2 text-sm text-green-600 dark:text-green-400 flex items-center gap-1"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "check-circle",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "-{{checkoutData.data.calculation?.summary?.multi_currency?.[_global.preferredCurrency ?? _global.defaultCurrency]?.code_discount_formatted ?? checkoutData.data.calculation?.summary?.code_discount_formatted}}"
                        }
                    ]
                }
            ]
        }
    ]
}
