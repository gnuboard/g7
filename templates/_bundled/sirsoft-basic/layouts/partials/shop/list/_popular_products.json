{
    "comment": "인기 상품 가로 줄 — 신상품·최근 본·관련 상품 줄과 같은 짜임이다. 넘기기(손가락 넘김·이전/다음 단추)는\n     ProductRail 컴포넌트가 맡는다. 줄이 비면 통째로 그리지 않는다.",
    "meta": {
        "is_partial": true,
        "description": "인기 상품 섹션"
    },
    "type": "composite",
    "name": "ProductRail",
    "if": "{{popularProducts.data && popularProducts.data.length > 0}}",
    "props": {
        "className": "mb-12",
        "title": "$t:shop.popular_products",
        "icon": "flame",
        "iconClassName": "text-xl text-orange-600 dark:text-orange-400",
        "prevLabel": "$t:common.prev",
        "nextLabel": "$t:common.next",
        "roleDescription": "$t:shop.product_rail.roledescription"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "iteration": {
                "source": "{{popularProducts.data ?? []}}",
                "item_var": "product"
            },
            "children": [
                {
                    "type": "composite",
                    "name": "ProductCard",
                    "props": {
                        "product": "{{product}}",
                        "shopBase": "{{_global.shopBase ?? '/shop'}}"
                    }
                }
            ]
        }
    ]
}
