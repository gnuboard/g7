{
    "comment": "신상품 가로 줄 — 인기·최근 본·관련 상품 줄과 같은 짜임이다. 넘기기는 ProductRail 컴포넌트가 맡는다.",
    "meta": {
        "is_partial": true,
        "description": "신상품 섹션"
    },
    "type": "composite",
    "name": "ProductRail",
    "if": "{{newProducts.data && newProducts.data.length > 0}}",
    "props": {
        "className": "mb-12",
        "title": "$t:shop.new_products",
        "icon": "sparkles",
        "iconClassName": "text-xl text-yellow-700 dark:text-yellow-600",
        "prevLabel": "$t:common.prev",
        "nextLabel": "$t:common.next",
        "roleDescription": "$t:shop.product_rail.roledescription"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "iteration": {
                "source": "{{newProducts.data ?? []}}",
                "item_var": "product"
            },
            "children": [
                {
                    "type": "composite",
                    "name": "ProductCard",
                    "props": {
                        "product": "{{product}}",
                        "shopBase": "{{_global.shopBase ?? '/shop'}}"
                    }
                }
            ]
        }
    ]
}
