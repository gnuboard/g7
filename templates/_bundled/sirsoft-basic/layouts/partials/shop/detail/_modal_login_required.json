{
    "comment": "회원만 되는 동작(쿠폰 받기·찜하기·문의 작성)을 비회원이 눌렀을 때 뜨는 안내 창. 곧바로 로그인으로\n     보내지 않고 한 번 알리는 이유는 상품을 보던 흐름이 예고 없이 끊기지 않게 하기 위해서다.",
    "meta": {
        "is_partial": true,
        "description": "로그인 필요 안내 모달 - 비로그인 사용자가 쿠폰 다운로드 시도 시",
        "editor_label": "$t:user.modal_label.shop_detail.login_required_modal"
    },
    "id": "login_required_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:shop.coupon_download.login_required_title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "text-center py-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "user",
                        "className": "text-3xl text-gray-400 dark:text-gray-500 mb-3"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-sm text-gray-600 dark:text-gray-400 mb-6"
                    },
                    "text": "$t:shop.coupon_download.login_required_message"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex justify-center gap-3"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "closeModal"
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "px-4 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                            },
                            "text": "$t:common.cancel"
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "comment": "로그인으로 — 보고 있던 상품 주소를 `redirect` 로 실어 보내 로그인 후 제자리로 돌아오게 한다",
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "closeModal"
                                        },
                                        {
                                            "handler": "navigate",
                                            "params": {
                                                "path": "/login",
                                                "query": {
                                                    "redirect": "{{location.pathname}}"
                                                }
                                            }
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "type": "button",
                                "className": "px-4 py-2 text-sm bg-blue-600 dark:bg-blue-500 text-white rounded-lg font-medium hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors"
                            },
                            "text": "$t:shop.coupon_download.go_login"
                        }
                    ]
                }
            ]
        }
    ]
}
