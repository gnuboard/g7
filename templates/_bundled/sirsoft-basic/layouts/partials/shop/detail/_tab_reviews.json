{
    "comment": "리뷰 탭 — 별점 분포와 리뷰 목록. 정렬·사진만·별점 조건은 `_local` 에 살고 `reviews` 소스가 그 값을\n     읽어 다시 받는다(조건이 URL 에 남지 않는 이유는 탭 안에서만 쓰는 값이기 때문).\n     e2e:allow 회원 없이 등록한 후기의 작성자 이름·HTML 본문 표시 — 이관 도구가 넣는 데이터라 화면 조작 흐름이 없다. 레이아웃 소비 계약은 이커머스 importedReviewDisplay.test.ts, 응답은 PHPUnit ImportedProductReviewTest 가 고정",
    "meta": {
        "is_partial": true,
        "description": "상품 상세 리뷰 탭"
    },
    "type": "basic",
    "name": "Div",
    "if": "{{(_local.activeTab ?? 'info') === 'reviews'}}",
    "props": {
        "className": "py-6"
    },
    "children": [
        {
            "comment": "리뷰 요약 (이미지1: 좌측 평균 별점 + 우측 분포 바)",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex items-center gap-6 mb-4 px-16 py-6 bg-gray-50 dark:bg-gray-700/50 rounded-lg"
            },
            "children": [
                {
                    "comment": "평균 별점 (좌측)",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "text-center shrink-0 min-w-24"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-4xl font-bold text-gray-900 dark:text-white"
                            },
                            "text": "{{reviews.data?.rating_stats?.avg ?? 0}}"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex items-center justify-center gap-0.5 my-1"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "iteration": {
                                        "source": "{{_local.starList}}",
                                        "item_var": "star"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "star",
                                                "size": "sm",
                                                "className": "{{star <= (reviews.data?.rating_stats?.avg ?? 0) ? 'text-yellow-700 dark:text-yellow-600' : 'text-muted'}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-xs text-muted"
                            },
                            "text": "$t:shop.product.rating_out_of_5|count={{reviews.data?.total_count ?? 0}}|total={{reviews.data?.total_count ?? 0}}"
                        }
                    ]
                },
                {
                    "comment": "구분선",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "w-px h-16 bg-gray-200 dark:bg-gray-600 shrink-0"
                    }
                },
                {
                    "comment": "별점 분포 바 (우측)",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex-1 space-y-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "iteration": {
                                "source": "{{_local.starNums}}",
                                "item_var": "starNum"
                            },
                            "props": {
                                "className": "flex items-center gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-xs text-muted w-3 shrink-0 text-right"
                                    },
                                    "text": "{{starNum}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "star",
                                        "size": "sm",
                                        "className": "text-yellow-700 dark:text-yellow-400 shrink-0"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-1 bg-gray-200 dark:bg-gray-600 rounded-full h-2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "bg-yellow-400 dark:bg-yellow-400 h-2 rounded-full",
                                                "style": {
                                                    "width": "{{(reviews.data?.rating_stats?.[starNum + '']?.percent ?? 0) + '%'}}"
                                                }
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-xs text-muted w-5 text-right shrink-0"
                                    },
                                    "text": "{{reviews.data?.rating_stats?.[starNum + '']?.count ?? 0}}"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "comment": "옵션 필터 행 (옵션 키별 동적 Select들 + 별점 Select + 초기화)",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex flex-wrap items-center gap-2 mb-4 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg"
            },
            "children": [
                {
                    "comment": "옵션 키별 Select (동적 생성, 건수 포함)",
                    "type": "basic",
                    "name": "Select",
                    "iteration": {
                        "source": "{{reviews.data?.option_filters ?? []}}",
                        "item_var": "optionFilter"
                    },
                    "actions": [
                        {
                            "type": "change",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewOptionFilters": "{{Object.assign(Object.create(null), _local.reviewOptionFilters, { [optionFilter.key]: $event.target.value })}}",
                                        "reviewsPage": 1,
                                        "reviewsLoading": true
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "reviews",
                                        "sync": true
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewsLoading": false
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "aria-label": "{{optionFilter.key}}",
                        "value": "{{_local.reviewOptionFilters?.[optionFilter.key] ?? ''}}",
                        "options": "{{[{ value: '', label: optionFilter.key }].concat((optionFilter.values ?? []).map(v => ({ value: v.value, label: v.value + ' (' + v.count + ')' })))}}",
                        "className": "text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-1.5 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300"
                    }
                },
                {
                    "comment": "별점 필터 Select (정적, min-w는 가장 긴 항목 기준으로 고정)",
                    "type": "basic",
                    "name": "Select",
                    "actions": [
                        {
                            "type": "change",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewRating": "{{$event.target.value}}",
                                        "reviewsPage": 1,
                                        "reviewsLoading": true
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "reviews",
                                        "sync": true
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewsLoading": false
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "aria-label": "$t:shop.product.rating",
                        "value": "{{_local.reviewRating ?? ''}}",
                        "className": "w-40 text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-1.5 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300",
                        "options": [
                            {
                                "value": "",
                                "label": "$t:shop.product.filter_all_rating"
                            },
                            {
                                "value": "5",
                                "label": "$t:shop.product.filter_rating_5"
                            },
                            {
                                "value": "4",
                                "label": "$t:shop.product.filter_rating_4"
                            },
                            {
                                "value": "3",
                                "label": "$t:shop.product.filter_rating_3"
                            },
                            {
                                "value": "2",
                                "label": "$t:shop.product.filter_rating_2"
                            },
                            {
                                "value": "1",
                                "label": "$t:shop.product.filter_rating_1"
                            }
                        ]
                    }
                },
                {
                    "comment": "초기화 버튼",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "깊은 병합(기본)은 빈 객체 {} 로 이전 값을 지우지 못한다 — null 로 먼저 지우고 {} 로 다시 쓴다(7.1.1). 종전에는 초기화를 눌러도 옵션 필터가 「블랙 (0)」 으로 남고 요청도 걸러진 채였다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewOptionFilters": null
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewOptionFilters": {},
                                        "reviewRating": "",
                                        "reviewPhotoOnly": false,
                                        "reviewsPage": 1,
                                        "reviewsLoading": true
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "reviews",
                                        "sync": true
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewsLoading": false
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "ml-auto text-sm px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                    },
                    "text": "$t:shop.product.filter_reset"
                }
            ]
        },
        {
            "comment": "정렬 + 포토리뷰 필터 행",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex items-center justify-between mb-4 gap-3"
            },
            "children": [
                {
                    "comment": "포토리뷰 필터 토글",
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewPhotoOnly": "{{!(_local.reviewPhotoOnly ?? false)}}",
                                        "reviewsPage": 1,
                                        "reviewsLoading": true
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "reviews",
                                        "sync": true
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewsLoading": false
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-lg border transition-colors {{(_local.reviewPhotoOnly ?? false) ? 'bg-gray-900 dark:bg-white text-white dark:text-gray-900 border-gray-900 dark:border-white' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-300 dark:border-gray-600'}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "image",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:shop.product.photo_reviews_only"
                        }
                    ]
                },
                {
                    "comment": "정렬 선택",
                    "type": "basic",
                    "name": "Select",
                    "actions": [
                        {
                            "type": "change",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewSortBy": "{{$event.target.value}}",
                                        "reviewsPage": 1,
                                        "reviewsLoading": true
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "reviews",
                                        "sync": true
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewsLoading": false
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "aria-label": "$t:common.sort_order",
                        "value": "{{_local.reviewSortBy ?? 'created_at_desc'}}",
                        "className": "text-sm border border-gray-300 dark:border-gray-600 rounded-lg px-3 py-1.5 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300",
                        "options": [
                            {
                                "value": "created_at_desc",
                                "label": "$t:shop.product.sort_latest"
                            },
                            {
                                "value": "rating_desc",
                                "label": "$t:shop.product.sort_rating_high"
                            },
                            {
                                "value": "rating_asc",
                                "label": "$t:shop.product.sort_rating_low"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "comment": "목록·빈 안내·쪽 번호 묶음 — 조건을 바꾼 뒤 새 목록이 올 때까지 흐리게 둔다. 이 탭은 주소 이동 없이 소스만\n         다시 받는데, 다시 받기는 엔진의 「받는 중」 표시를 세우지 않으므로 조건 조작이 켜고 끄는 `reviewsLoading` 을\n         읽는다(조건 단추·칸은 묶음 밖이라 누른 상태가 또렷하다). 종전에는 단추만 바로 켜지고 앞 목록이 그대로 보이다 바뀌었다",
            "id": "review_tab_list",
            "type": "basic",
            "name": "Div",
            "blur_until_loaded": "{{_local.reviewsLoading ?? false}}",
            "children": [
                {
                    "comment": "리뷰 목록 (이미지3: 카드 레이아웃 수정)",
                    "type": "basic",
                    "name": "Div",
                    "iteration": {
                        "source": "{{reviews.data?.reviews?.data ?? []}}",
                        "item_var": "review"
                    },
                    "children": [
                        {
                            "partial": "partials/shop/detail/_review_card.json"
                        }
                    ]
                },
                {
                    "comment": "리뷰 없음",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{reviews !== undefined && (!reviews.data?.reviews?.data || reviews.data.reviews.data.length === 0)}}",
                    "props": {
                        "className": "text-center py-12 text-gray-800 dark:text-gray-300"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "comment-dots",
                                "size": "3x",
                                "className": "mx-auto mb-3 opacity-50"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "text": "$t:shop.product.no_reviews"
                        }
                    ]
                },
                {
                    "comment": "리뷰 페이지네이션",
                    "type": "composite",
                    "name": "Pagination",
                    "actions": [
                        {
                            "event": "onPageChange",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewsPage": "{{$args[0]}}",
                                        "reviewsLoading": true
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "reviews",
                                        "sync": true
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "reviewsLoading": false
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "currentPage": "{{reviews.data?.reviews?.meta?.current_page ?? 1}}",
                        "totalPages": "{{reviews.data?.reviews?.meta?.last_page ?? null}}",
                        "hasMorePages": "{{reviews.data?.reviews?.meta?.has_more_pages ?? false}}",
                        "className": "mt-6 flex justify-center"
                    }
                }
            ]
        }
    ]
}
