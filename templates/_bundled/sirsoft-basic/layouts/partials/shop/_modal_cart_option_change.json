                            "name": "Div",
                            "iteration": {
                                "source": "{{$parent._local.optionProduct?.additional_options ?? []}}",
                                "item_var": "addGroup"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "mb-2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "block text-sm text-gray-600 dark:text-gray-400 mb-1"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{addGroup.name}}"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "if": "{{addGroup.is_required}}",
                                                    "props": {
                                                        "className": "text-red-500 dark:text-red-400 ml-0.5"
                                                    },
                                                    "text": "*"
