                    "comment": "상품 정보",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex gap-4 mb-6 pb-4 border-b border-gray-200 dark:border-gray-700"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "w-20 h-20 rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-700 flex-shrink-0"
                            },
                            "children": [
