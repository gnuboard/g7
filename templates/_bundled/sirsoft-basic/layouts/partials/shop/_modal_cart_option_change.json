                        {
                            "comment": "추가옵션 추가금 합계 (선택된 추가금이 있을 때)",
                            "type": "basic",
                            "name": "Div",
                            "if": "{{($parent._local.optionProduct?.additional_options ?? []).reduce((sum, g) => sum + (((g.values ?? []).find(v => v.id === Number($parent._local.additionalSelections?.[g.id]))?.price_adjustment) ?? 0), 0) > 0}}",
                            "props": {
                                "className": "flex justify-between items-center mt-2 pt-2 border-t border-blue-100 dark:border-blue-800 text-xs text-gray-600 dark:text-gray-300"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:shop.additional_options_amount"
                                },
                                {
                                    "comment": "추가금은 기본통화 기준 저장값이므로 서버가 준 표시통화 환산값을 우선 합산한다 (없으면 기본통화 값으로 폴백)",
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "{{(() => { const code = _global.preferredCurrency ?? _global.defaultCurrency; const total = ($parent._local.optionProduct?.additional_options ?? []).reduce((sum, g) => { const v = (g.values ?? []).find(v => v.id === Number($parent._local.additionalSelections?.[g.id])); if (!v) return sum; return sum + (v.multi_currency_price_adjustment?.[code]?.price ?? v.price_adjustment ?? 0); }, 0); const cur = (_global.availableCurrencies ?? []).find(x => x.code === code) ?? (_global.availableCurrencies ?? []).find(x => x.is_default); const dp = cur?.decimal_places ?? 0; const n = total.toLocaleString(undefined, { minimumFractionDigits: dp, maximumFractionDigits: dp }); const s = cur?.symbol ?? '₩'; return '+' + ((cur?.code === 'KRW' || s === '₩' || s === '원') ? ($t('sirsoft-ecommerce.currency.krw_prefix') + n + $t('sirsoft-ecommerce.currency.krw_suffix')) : (s + n)); })()}}"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "if": "{{$parent._local.matchedOption?.stock_quantity <= 10}}",
                            "props": {
                                "className": "{{$parent._local.matchedOption?.stock_quantity <= 0 ? 'text-xs text-red-500 dark:text-red-400 mt-1 font-medium' : 'text-xs text-gray-500 dark:text-gray-400 mt-1'}}"
                            },
                            "text": "{{$parent._local.matchedOption?.stock_quantity <= 0 ? '$t:shop.cart.option_modal.out_of_stock' : '$t:shop.cart.option_modal.stock_count|count=' + ($parent._local.matchedOption?.stock_quantity ?? 0)}}"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "if": "{{$parent._local.matchedOption?.stock_quantity > 10}}",
                            "props": {
                                "className": "text-xs text-gray-500 dark:text-gray-400 mt-1"
                            },
                            "text": "$t:shop.cart.option_modal.stock_count|count={{$parent._local.matchedOption?.stock_quantity ?? 0}}"
                        }
                    ]
                },
                {
                    "comment": "수량 변경",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "space-y-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "block text-sm font-medium text-gray-700 dark:text-gray-300"
                            },
                            "text": "$t:shop.cart.option_modal.quantity"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "{{$parent._local.optionErrors?.quantity ? 'ring-2 ring-red-500 rounded-lg' : ''}}"
                            },
                            "children": [
                                {
                                    "type": "composite",
                                    "name": "QuantitySelector",
                                    "actions": [
                                        {
                                            "comment": "수량을 손대면 지난 검증 오류 표시를 먼저 걷는다 — 고쳤는데도 빨간 테두리가 남는 것을 막는다",
                                            "event": "onChange",
                                            "handler": "sequence",
                                            "actions": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "$parent._local",
                                                        "optionErrors": null
                                                    }
                                                },
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "$parent._local",
                                                        "selectedQuantity": "{{$args[0]}}"
                                                    }
                                                }
                                            ]
                                        }
                                    ],
                                    "props": {
                                        "value": "{{$parent._local.selectedQuantity ?? $parent._local.optionModal.targetItem?.quantity ?? 1}}",
                                        "min": 1,
                                        "max": "{{$parent._local.matchedOption?.stock_quantity ?? $parent._local.optionModal.targetItem?.stock ?? 999}}",
                                        "size": "md"
                                    }
                                }
                            ]
                        },
                        {
                            "comment": "수량 필드 에러 메시지",
                            "type": "basic",
                            "name": "P",
                            "if": "{{$parent._local.optionErrors?.quantity}}",
                            "props": {
                                "className": "text-sm text-red-600 dark:text-red-400 mt-1"
                            },
                            "text": "{{Array.isArray($parent._local.optionErrors.quantity) ? $parent._local.optionErrors.quantity[0] : $parent._local.optionErrors.quantity}}"
                        }
                    ]
                }
            ]
        },
        {
            "comment": "모달 푸터",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex justify-end gap-3 p-4 border-t border-gray-200 dark:border-gray-700"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "취소해도 오류 표시는 남으므로 걷어 낸 뒤 닫는다 — 다음에 열었을 때 지난 빨간 줄이 그대로 뜨지 않게",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "$parent._local",
                                        "optionErrors": null
                                    }
                                },
                                {
                                    "handler": "closeModal"
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer",
                        "disabled": "{{_global.isUpdatingOption}}"
                    },
                    "text": "$t:common.cancel"
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "옵션 교체 확정. 진행 표시를 `_global` 에 두는 이유는 이 창과 뒤 장바구니 목록이 함께 잠겨야\n               하기 때문이다(창 안 `_local` 로는 뒤 화면이 그 사실을 모른다)",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isUpdatingOption": true
                                    }
                                },
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "$parent._local",
                                        "optionErrors": null
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/modules/sirsoft-ecommerce/cart/{{$parent._local.optionModal.targetItem?.id}}/option",
                                    "auth_mode": "optional",
                                    "params": {
                                        "method": "PUT",
                                        "body": {
                                            "product_option_id": "{{$parent._local.matchedOption?.id ?? $parent._local.optionModal.targetItem?.product_option_id}}",
                                            "quantity": "{{$parent._local.selectedQuantity ?? $parent._local.optionModal.targetItem?.quantity}}",
                                            "additional_option_selections": "{{Object.entries($parent._local.additionalSelections ?? {}).filter(([, vid]) => vid != null).map(([gid, vid]) => ({ additional_option_id: Number(gid), value_id: Number(vid), custom_text: $parent._local.additionalCustomTexts?.[Number(gid)] }))}}"
                                        },
                                        "headers": {
                                            "X-Cart-Key": "{{_global.cartKey}}"
                                        }
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isUpdatingOption": false
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "$parent._local",
                                                "selectedQuantity": null,
                                                "optionErrors": null,
                                                "optionModal": {
                                                    "visible": false,
                                                    "targetItem": null
                                                }
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "cartItems"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:shop.cart.option_updated"
                                            }
                                        },
                                        {
                                            "handler": "closeModal"
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isUpdatingOption": false
                                            }
                                        },
                                        {
                                            "comment": "도메인 거절(재고 부족·판매 중지 등)은 errors 에 code·message·unavailable_items(객체)·has_*(참거짓)를 함께 준다 — 통째로 펼치면 내부 코드와 객체가 목록에 그려지므로 사유 문장 하나만 담는다. 필드 검증 오류는 종전대로",
                                            "handler": "setState",
                                            "params": {
                                                "target": "$parent._local",
                                                "optionErrors": "{{error.errors?.code ? { _general: error.errors.message ?? error.message } : (error.errors ?? { _general: error.message })}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "data-testid": "modal-apply",
                        "className": "flex items-center gap-2 px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer",
                        "disabled": "{{_global.isUpdatingOption || ($parent._local.optionProduct?.has_options && !$parent._local.matchedOption)}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isUpdatingOption}}",
                            "props": {
                                "name": "spinner",
                                "spin": true,
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isUpdatingOption ? '$t:common.processing' : '$t:shop.cart.option_modal.apply'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
