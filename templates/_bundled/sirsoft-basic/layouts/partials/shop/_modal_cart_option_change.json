                                                "item_var": "message"
                                            },
                                            "props": {
                                                "className": "list-disc list-inside space-y-1"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Li",
                                                    "props": {
                                                        "className": "text-sm text-red-700 dark:text-red-300"
                                                    },
                                                    "text": "{{message}}"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
