                {
                    "comment": "선택된 옵션 정보",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{$parent._local.matchedOption}}",
                    "props": {
                        "className": "bg-blue-50 dark:bg-blue-900/20 rounded-lg p-3 mb-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex justify-between items-start"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "props": {
                                        "className": "text-sm text-gray-700 dark:text-gray-300"
                                    },
                                    "text": "{{$parent._local.matchedOption?.option_name_localized ?? $parent._local.matchedOption?.option_name?.ko ?? ''}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "text-right"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "text-sm font-bold text-gray-900 dark:text-white"
                                            },
                                            "text": "{{$parent._local.matchedOption?.multi_currency_selling_price?.[_global.preferredCurrency ?? _global.defaultCurrency]?.formatted ?? $parent._local.matchedOption?.selling_price_formatted ?? ''}}"
                                        },
                                        {
                                            "comment": "보조 통화들",
                                            "type": "basic",
                                            "name": "Div",
                                            "iteration": {
                                                "source": "{{Object.entries($parent._local.matchedOption?.multi_currency_selling_price ?? {}).filter(([code]) => code !== (_global.preferredCurrency ?? _global.defaultCurrency))}}",
                                                "item_var": "currency"
                                            },
                                            "props": {
                                                "className": "flex flex-wrap gap-x-2 justify-end"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-xs text-gray-500 dark:text-gray-400"
                                                    },
                                                    "text": "{{currency[1]?.formatted}}"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
