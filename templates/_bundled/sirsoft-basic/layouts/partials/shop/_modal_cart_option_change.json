                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "block text-sm text-gray-600 dark:text-gray-400 mb-1"
                                            },
                                            "text": "{{group.name_localized ?? group.name}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Select",
                                            "actions": [
                                                {
                                                    "comment": "옵션을 한 칸 고를 때마다 조합을 다시 찾는다. 방금 고른 값을 상태에서 읽지 않고 그 자리에서\n                     합쳐 넘기는 이유는, 바로 위 `set-state` 가 아직 반영되기 전이라 상태를 읽으면 한 박자 뒤진\n                     값이 잡히기 때문이다",
                                                    "type": "change",
                                                    "handler": "sequence",
                                                    "actions": [
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "$parent._local",
                                                                "optionErrors": null
                                                            }
                                                        },
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "$parent._local",
                                                                "selectedOptions": "{{Object.assign({}, $parent._local.selectedOptions ?? {}, { [group.name_localized]: $event.target.value })}}"
                                                            }
                                                        },
                                                        {
                                                            "comment": "업데이트된 selectedOptions로 매칭 옵션 찾기 (stale state 방지)",
                                                            "handler": "findMatchingOption",
                                                            "params": {
                                                                "selectedOptions": "{{Object.assign({}, $parent._local.selectedOptions ?? {}, { [group.name_localized]: $event.target.value })}}",
                                                                "optionGroups": "{{$parent._local.optionProduct?.option_groups ?? []}}",
                                                                "options": "{{$parent._local.optionProduct?.options ?? []}}"
                                                            }
                                                        },
                                                        {
