                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{!!_global.settings?.security?.password_block_identifier}}",
                            "text": "$t:auth.password_rules.identifier"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{!!_global.settings?.security?.password_block_repeated_chars}}",
                            "text": "$t:auth.password_rules.repeated|count={{_global.settings?.security?.password_repeated_chars_length ?? 4}}"
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{!!_global.settings?.security?.password_block_sequential_chars}}",
                            "text": "$t:auth.password_rules.sequential|count={{_global.settings?.security?.password_sequential_chars_length ?? 4}}"
                        }
                    ]
                }
            ]
        },
