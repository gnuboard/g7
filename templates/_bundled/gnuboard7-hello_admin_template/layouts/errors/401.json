{
    "comment": "관리자 401 화면 — 로그인이 필요한 상태. 리다이렉트는 코어가 하므로 이 화면은 안내만 한다",
    "version": "1.0.0",
    "layout_name": "errors/401",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:errors.401.title",
        "is_error_layout": true,
        "error_code": 401
    },
    "slots": {
        "content": [
            {
                "id": "error_container",
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "flex-center flex-col justify-center min-h-[60vh] text-center p-8"
                },
                "children": [
                    {
                        "id": "error_code",
                        "type": "basic",
                        "name": "H1",
                        "props": {
                            "className": "text-primary text-6xl font-bold mb-4"
                        },
                        "text": "401"
                    },
                    {
                        "id": "error_title",
                        "type": "basic",
                        "name": "H2",
                        "props": {
                            "className": "text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-2"
                        },
                        "text": "$t:errors.401.title"
                    },
                    {
                        "id": "error_message",
                        "type": "basic",
                        "name": "Span",
                        "props": {
                            "className": "text-gray-500 dark:text-gray-400"
                        },
                        "text": "$t:errors.401.message"
                    }
                ]
            }
        ]
    }
}
