{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "templateId": "gnuboard7-hello_user_template",
    "version": "0.2.0",
    "components": {
        "basic": [
            {
                "name": "Div",
                "type": "basic",
                "description": "HTML div element wrapper",
                "path": "src/components/basic/Div.tsx",
                "props": {
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    }
                }
            },
            {
                "name": "Button",
                "type": "basic",
                "description": "HTML button element wrapper",
                "path": "src/components/basic/Button.tsx",
                "props": {
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    }
                }
            },
            {
                "name": "H1",
                "type": "basic",
                "description": "HTML h1 element wrapper",
                "path": "src/components/basic/H1.tsx",
                "props": {
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    }
                }
            },
            {
                "name": "H2",
                "type": "basic",
                "description": "HTML h2 element wrapper",
                "path": "src/components/basic/H2.tsx",
                "props": {
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    }
                }
            },
            {
                "name": "H3",
                "type": "basic",
                "description": "HTML h3 element wrapper",
                "path": "src/components/basic/H3.tsx",
                "props": {
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    }
                }
            },
            {
                "name": "A",
                "type": "basic",
                "description": "HTML a element wrapper",
                "path": "src/components/basic/A.tsx",
                "props": {
                    "href": {
                        "type": "string",
                        "required": false,
                        "description": "링크 URL"
                    },
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    }
                }
            },
            {
                "name": "Span",
                "type": "basic",
                "description": "HTML span element wrapper",
                "path": "src/components/basic/Span.tsx",
                "props": {
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    }
                }
            },
            {
                "name": "Img",
                "type": "basic",
                "description": "HTML img element wrapper",
                "path": "src/components/basic/Img.tsx",
                "props": {
                    "src": {
                        "type": "string",
                        "required": true,
                        "description": "이미지 URL"
                    },
                    "alt": {
                        "type": "string",
                        "required": false,
                        "description": "대체 텍스트"
                    },
                    "className": {
                        "type": "string",
                        "required": false,
                        "description": "사용자 정의 클래스"
                    }
                }
            }
        ],
        "composite": [],
        "layout": []
    },
    "overrides": [
        {
            "target": "gnuboard7-hello_module",
            "targetVersion": "^0.2",
            "name": "MemoCard",
            "exportName": "HelloModuleMemoCard",
            "type": "composite",
            "description": "Hello 모듈의 MemoCard 를 이 템플릿 서식으로 대체",
            "path": "src/components/overrides/gnuboard7-hello_module/MemoCard.tsx",
            "props": {
                "title": {
                    "type": "string",
                    "required": false,
                    "description": "메모 제목"
                },
                "body": {
                    "type": "string",
                    "required": false,
                    "description": "메모 본문"
                },
                "highlighted": {
                    "type": "boolean",
                    "required": false,
                    "description": "강조 표시 여부"
                },
                "accent": {
                    "type": "string",
                    "required": false,
                    "description": "왼쪽 강조선 색 (이 템플릿 판본 전용 prop)"
                },
                "className": {
                    "type": "string",
                    "required": false,
                    "description": "사용자 정의 클래스"
                }
            }
        }
    ]
}
