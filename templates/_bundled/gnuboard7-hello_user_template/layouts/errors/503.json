{
    "comment": "사용자 503 화면 — 일시적으로 처리할 수 없는 상태.\n  활성 템플릿이 요구하는 모듈·플러그인이 없거나 꺼져 있거나 버전이 모자라면 서버가 errorData.modules/plugins 로 미충족 목록을 넘긴다\n  (항목: name·identifier·required_version·installed_version·status). 템플릿을 만들 때 이 블록을 남겨 두면 방문자·운영자가 원인을 본다.",
    "version": "1.0.0",
    "layout_name": "errors/503",
    "extends": "_user_base",
    "meta": {
        "title": "$t:error.503.title",
        "description": "$t:error.503.description"
    },
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "flex-center min-h-[50vh] justify-center"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "text-center px-4"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "text-6xl font-bold text-gray-500 dark:text-gray-500 mb-4"
                                },
                                "text": "503"
                            },
                            {
                                "type": "basic",
                                "name": "H1",
                                "props": {
                                    "className": "text-2xl font-bold text-gray-900 dark:text-white mb-2"
                                },
                                "text": "$t:error.503.title"
                            },
                            {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                    "className": "block text-gray-600 dark:text-gray-300 mb-6"
                                },
                                "text": "$t:error.503.description"
                            },
                            {
                                "id": "dependency_info",
                                "type": "basic",
                                "name": "Div",
                                "if": "{{(_global.errorData?.modules?.length ?? 0) > 0 || (_global.errorData?.plugins?.length ?? 0) > 0}}",
                                "props": {
                                    "className": "text-left border border-gray-200 dark:border-gray-700 rounded-lg p-4 mb-6"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "props": {
                                            "className": "block text-sm font-medium text-gray-800 dark:text-gray-200 mb-3"
                                        },
                                        "text": "$t:error.503.unmet_dependencies"
                                    },
                                    {
                                        "id": "modules_list",
                                        "type": "basic",
                                        "name": "Div",
                                        "if": "{{(_global.errorData?.modules?.length ?? 0) > 0}}",
                                        "props": {
                                            "className": "mb-3"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "props": {
                                                    "className": "block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1"
                                                },
                                                "text": "$t:error.503.required_modules"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "iteration": {
                                                    "source": "_global.errorData?.modules ?? []",
                                                    "item_var": "mod"
                                                },
                                                "props": {
                                                    "className": "text-sm text-gray-700 dark:text-gray-300"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "block"
                                                        },
                                                        "text": "{{mod.name || mod.identifier}} ({{mod.required_version}})"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{mod.status === 'version_mismatch'}}",
                                                        "props": {
                                                            "className": "block text-xs text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:error.503.reason_version_mismatch|installed={{mod.installed_version}}|required={{mod.required_version}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{mod.status === 'inactive'}}",
                                                        "props": {
                                                            "className": "block text-xs text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:error.503.reason_inactive"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{mod.status === 'not_installed'}}",
                                                        "props": {
                                                            "className": "block text-xs text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:error.503.reason_not_installed"
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "plugins_list",
                                        "type": "basic",
                                        "name": "Div",
                                        "if": "{{(_global.errorData?.plugins?.length ?? 0) > 0}}",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "props": {
                                                    "className": "block text-xs font-semibold text-gray-600 dark:text-gray-400 mb-1"
                                                },
                                                "text": "$t:error.503.required_plugins"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "iteration": {
                                                    "source": "_global.errorData?.plugins ?? []",
                                                    "item_var": "plug"
                                                },
                                                "props": {
                                                    "className": "text-sm text-gray-700 dark:text-gray-300"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "block"
                                                        },
                                                        "text": "{{plug.name || plug.identifier}} ({{plug.required_version}})"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{plug.status === 'version_mismatch'}}",
                                                        "props": {
                                                            "className": "block text-xs text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:error.503.reason_version_mismatch|installed={{plug.installed_version}}|required={{plug.required_version}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{plug.status === 'inactive'}}",
                                                        "props": {
                                                            "className": "block text-xs text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:error.503.reason_inactive"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "if": "{{plug.status === 'not_installed'}}",
                                                        "props": {
                                                            "className": "block text-xs text-gray-500 dark:text-gray-400"
                                                        },
                                                        "text": "$t:error.503.reason_not_installed"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Span",
                                "if": "{{(_global.errorData?.modules?.length ?? 0) > 0 || (_global.errorData?.plugins?.length ?? 0) > 0}}",
                                "props": {
                                    "className": "block text-sm text-gray-500 dark:text-gray-400"
                                },
                                "text": "$t:error.503.contact_admin"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
