{
    "comment": "사용자 점검 안내 화면 — 점검 모드가 켜졌을 때 대신 뜬다",
    "version": "1.0.0",
    "layout_name": "errors/maintenance",
    "extends": "_user_base",
    "meta": {
        "title": "$t:error.maintenance.title",
        "description": "$t:error.maintenance.description"
    },
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "flex-center min-h-[50vh] justify-center"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "text-center px-4"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H1",
                                "props": {
                                    "className": "text-3xl font-bold text-gray-900 dark:text-white mb-3"
                                },
                                "text": "$t:error.maintenance.title"
                            },
                            {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                    "className": "block text-gray-600 dark:text-gray-300"
                                },
                                "text": "$t:error.maintenance.description"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
