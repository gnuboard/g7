{
    "comment": "사용자 403 화면 — 권한이 없는 상태",
    "version": "1.0.0",
    "layout_name": "errors/403",
    "extends": "_user_base",
    "meta": {
        "title": "$t:error.403.title",
        "description": "$t:error.403.description"
    },
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "flex-center min-h-[50vh] justify-center"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "text-center px-4"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "text-6xl font-bold text-gray-200 dark:text-gray-700 mb-4"
                                },
                                "text": "403"
                            },
                            {
                                "type": "basic",
                                "name": "H1",
                                "props": {
                                    "className": "text-2xl font-bold text-gray-900 dark:text-white mb-2"
                                },
                                "text": "$t:error.403.title"
                            },
                            {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                    "className": "block text-gray-600 dark:text-gray-300 mb-6"
                                },
                                "text": "$t:error.403.description"
                            },
                            {
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/"
                                        }
                                    }
                                ],
                                "props": {
                                    "className": "px-5 py-2 rounded bg-blue-600 text-white hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 cursor-pointer"
                                },
                                "text": "$t:error.back_to_home"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
