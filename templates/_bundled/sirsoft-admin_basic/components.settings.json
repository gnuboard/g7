{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "identifier": "sirsoft-admin_basic",
    "version": "1.2.0",
    "lang": [
        "settings",
        "attachment",
        "common"
    ],
    "components": {
        "basic": [],
        "composite": [
            {
                "name": "TemplateSettingsScreen",
                "type": "composite",
                "description": "템플릿 설정 화면 — 머리·안내·섹션 탭·저장 결과·칸·저장 바·확인 창",
                "path": "templates/_bundled/sirsoft-admin_basic/src/settings/TemplateSettingsScreen.tsx",
                "props": {
                    "data": {
                        "type": "object",
                        "required": false,
                        "description": "설정 조회 응답 data (name·type·is_active·sections·abilities)"
                    },
                    "value": {
                        "type": "object",
                        "required": false,
                        "description": "폼 값 (섹션 중첩)"
                    },
                    "errors": {
                        "type": "object",
                        "required": false,
                        "description": "서버 검증 오류 ({경로: [문구]})"
                    },
                    "activeSection": {
                        "type": "string",
                        "required": false,
                        "description": "지금 섹션 키"
                    },
                    "readOnly": {
                        "type": "boolean",
                        "required": false,
                        "description": "읽기 전용 (저장 권한 없음)"
                    },
                    "dirty": {
                        "type": "boolean",
                        "required": false,
                        "description": "저장하지 않은 변경 있음"
                    },
                    "saving": {
                        "type": "boolean",
                        "required": false,
                        "description": "저장 중"
                    },
                    "resetting": {
                        "type": "boolean",
                        "required": false,
                        "description": "기본값으로 되돌리는 중"
                    },
                    "status": {
                        "type": "object",
                        "required": false,
                        "description": "마지막 결과 {type: success|error, action?: save|reset, message?}"
                    },
                    "uploadTriggerEvent": {
                        "type": "string",
                        "required": false,
                        "description": "첨부 칸 업로드 신호 이름"
                    },
                    "onChange": {
                        "type": "function",
                        "required": false,
                        "description": "칸 값이 바뀜 — 폼 전체"
                    },
                    "onDirty": {
                        "type": "function",
                        "required": false,
                        "description": "파일만 골라 둠"
                    },
                    "onTabChange": {
                        "type": "function",
                        "required": false,
                        "description": "섹션 옮기기 (섹션, 저장하지 않은 변경을 버렸는가)"
                    },
                    "onSave": {
                        "type": "function",
                        "required": false,
                        "description": "저장"
                    },
                    "onReset": {
                        "type": "function",
                        "required": false,
                        "description": "기본값으로 되돌리기 (확인 창을 거친 뒤)"
                    },
                    "onBack": {
                        "type": "function",
                        "required": false,
                        "description": "목록으로"
                    },
                    "onUploadError": {
                        "type": "function",
                        "required": false,
                        "description": "업로드 실패 문구"
                    }
                }
            }
        ],
        "layout": []
    }
}
