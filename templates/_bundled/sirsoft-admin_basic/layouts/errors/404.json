{
    "comment": "라우트가 없거나 대상 자원이 사라졌을 때의 에러 화면.\n  의존 확장이 없어 못 뜨는 경우는 여기가 아니라 `errors/503` 이 맡는다 — 그쪽만 미충족 의존\n  목록을 화면에 싣는다.",
    "version": "1.0.0",
    "layout_name": "errors/404",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:errors.404.title",
        "is_error_layout": true,
        "error_code": 404
    },
    "slots": {
        "content": [
            {
                "id": "error_container",
                "type": "basic",
                "name": "Div",
                "props": {
                    "className": "flex-center flex-col justify-center min-h-[60vh] text-center p-8"
                },
                "children": [
                    {
                        "id": "error_icon",
                        "type": "basic",
                        "name": "Icon",
                        "props": {
                            "name": "file-circle-xmark",
                            "className": "text-8xl text-gray-400 dark:text-gray-500 mb-6"
                        }
                    },
                    {
                        "id": "error_code",
                        "type": "basic",
                        "name": "H1",
                        "props": {
                            "className": "text-primary text-6xl font-bold mb-4"
                        },
                        "text": "404"
                    },
                    {
                        "id": "error_title",
                        "type": "basic",
                        "name": "H2",
                        "props": {
                            "className": "text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-2"
                        },
                        "text": "$t:errors.404.title"
                    },
                    {
                        "id": "error_message",
                        "type": "basic",
                        "name": "P",
                        "props": {
                            "className": "text-gray-500 dark:text-gray-400 mb-8 max-w-md"
                        },
                        "text": "$t:errors.404.message"
                    },
                    {
                        "id": "back_button",
                        "type": "basic",
                        "name": "Button",
                        "actions": [
                            {
                                "type": "click",
                                "handler": "navigate",
                                "params": {
                                    "path": "/admin"
                                }
                            }
                        ],
                        "props": {
                            "className": "px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
                        },
                        "text": "$t:errors.back_home"
                    }
                ]
            }
        ]
    }
}
