                                                            "name": "trash",
                                                            "size": "sm"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "$t:admin.analytics.privacy_requests.delete_button"
                                                    }
                                                ]
