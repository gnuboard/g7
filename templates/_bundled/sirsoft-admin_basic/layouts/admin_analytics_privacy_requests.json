                                            "className": "flex-center gap-3"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Icon",
                                                "props": {
                                                    "name": "circle-info",
                                                    "className": "text-xl text-blue-600 dark:text-blue-400 flex-shrink-0"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-info-soft"
                                                },
                                                "text": "{{analytics_subjects?.data?.notice}}"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "id": "subjects_empty",
                                "type": "composite",
                                "name": "EmptyState",
                                "if": "{{!analytics_subjects?.loading && (analytics_subjects?.data?.visits ?? []).length === 0}}",
                                "props": {
                                    "iconName": "user-shield",
                                    "title": "$t:admin.analytics.privacy_requests.no_results",
                                    "className": "py-8"
                                }
                            },
                            {
                                "type": "basic",
                                "name": "Div",
                                "if": "{{(analytics_subjects?.data?.visits ?? []).length > 0}}",
                                "props": {
                                    "className": "overflow-x-auto"
                                },
                                "children": [
                                    {
                                        "id": "subjects_grid",
                                        "type": "composite",
                                        "name": "DataGrid",
                                        "props": {
                                            "data": "{{analytics_subjects?.data?.visits ?? []}}",
                                            "pagination": true,
                                            "pageSize": 25,
                                            "idField": "visit_id",
                                            "selectable": false,
                                            "sortable": false,
                                            "columns": [
                                                {
                                                    "field": "first_action_at",
                                                    "header": "$t:admin.analytics.privacy_requests.columns.visit_at",
                                                    "width": "170px",
                                                    "cellChildren": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-label"
                                                            },
                                                            "text": "{{row.first_action_at | datetime | default('-')}}"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "field": "visitor_key",
                                                    "header": "$t:admin.analytics.privacy_requests.columns.visitor_key",
                                                    "width": "140px",
                                                    "cellChildren": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Button",
