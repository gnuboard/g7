                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "results_card",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{!!query.value}}",
                        "blur_until_loaded": {
                            "enabled": true,
                            "data_sources": "analytics_subjects"
                        },
                        "props": {
                            "className": "admin-card"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex-between flex-wrap gap-3 mb-3"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H2",
                                                "props": {
                                                    "className": "section-heading"
                                                },
                                                "text": "$t:admin.analytics.privacy_requests.results_title"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "P",
                                                "props": {
                                                    "className": "text-label-subtle"
                                                },
                                                "text": "$t:admin.analytics.privacy_requests.results_summary|visits={{((analytics_subjects?.data?.visits ?? []).length) | number}}|actions={{((analytics_subjects?.data?.visits ?? []).reduce((s, v) => s + (Number(v.actions_count) || 0), 0)) | number}}"
                                            }
                                        ]
                                    },
                                    {
                                        "comment": "두 버튼은 검색 응답이 오면(서버만 싣는 export_filename) 방문이 0건이어도 켠다 — 코어 원장이 보존\n            기간으로 비었어도 확장은 자기 표에 이 사람의 기록을 가질 수 있고, 서버는 그때도 확장의 정보주체\n            필터를 부른다(DataSubjectService). 응답 전에는 잠가 저장 이름이 기본값으로 떨어지지 않게 한다.",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "flex-center gap-2"
                                        },
                                        "children": [
                                            {
                                                "id": "export_button",
                                                "type": "basic",
                                                "name": "Button",
                                                "actions": [
                                                    {
                                                        "comment": "열람권 이행 파일 — 서버가 파일로 흘려보내므로 토큰 동반 blob 요청으로 받는다(POST).\n                  저장 이름은 서버가 조회 응답에 실어 준 것을 쓴다 — 검색값(방문자 IP)을 파일명에 넣지 않고, 날짜는 사이트 기준이다.",
                                                        "type": "click",
                                                        "handler": "downloadAttachment",
                                                        "params": {
                                                            "url": "/api/admin/analytics/privacy/subjects/export",
                                                            "method": "POST",
                                                            "filename": "{{analytics_subjects?.data?.export_filename || 'analytics-subject.json'}}",
                                                            "body": {
                                                                "ip": "{{(query.subject || 'ip') === 'ip' ? query.value : undefined}}",
                                                                "user_id": "{{query.subject === 'user_id' ? query.value : undefined}}",
                                                                "visitor_key": "{{query.subject === 'visitor_key' ? query.value : undefined}}",
                                                                "from": "{{query.from || undefined}}",
                                                                "to": "{{query.to || undefined}}"
                                                            }
                                                        }
                                                    }
                                                ],
                                                "props": {
                                                    "type": "button",
                                                    "className": "btn btn-secondary btn-sm flex-center gap-1.5",
                                                    "disabled": "{{!analytics_subjects?.data?.export_filename}}"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Icon",
                                                        "props": {
                                                            "name": "file-export",
