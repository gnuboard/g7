                                                                "params": {
                                                                    "target": "local",
                                                                    "search.value": "{{$event.target.value}}"
                                                                }
                                                            },
                                                            {
                                                                "actionRef": "searchSubjects"
                                                            }
                                                        ]
                                                    }
                                                ],
                                                "props": {
                                                    "name": "analytics_subject_value",
                                                    "type": "text",
                                                    "className": "input w-80",
                                                    "placeholder": "{{(_local.search?.subject || 'ip') === 'ip' ? $t('admin.analytics.privacy_requests.search.placeholder_ip') : ((_local.search?.subject === 'user_id') ? $t('admin.analytics.privacy_requests.search.placeholder_user') : $t('admin.analytics.privacy_requests.search.placeholder_key'))}}",
                                                    "value": "{{_local.search?.value || ''}}"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "filter-row"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "props": {
                                                    "className": "filter-label w-32"
                                                },
                                                "text": "$t:admin.analytics.privacy_requests.search.period_label"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "flex-center gap-2 flex-wrap"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "actions": [
                                                            {
                                                                "type": "change",
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "search.from": "{{$event.target.value}}"
                                                                }
                                                            }
                                                        ],
                                                        "props": {
                                                            "name": "analytics_subject_from",
                                                            "type": "date",
                                                            "className": "input w-40",
                                                            "value": "{{_local.search?.from || ''}}"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "text-gray-400 dark:text-gray-500"
                                                        },
                                                        "text": "~"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "actions": [
                                                            {
                                                                "type": "change",
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "local",
                                                                    "search.to": "{{$event.target.value}}"
                                                                }
                                                            }
                                                        ],
                                                        "props": {
                                                            "name": "analytics_subject_to",
                                                            "type": "date",
                                                            "className": "input w-40",
                                                            "value": "{{_local.search?.to || ''}}"
                                                        }
                                                    }
                                                ]
                                            }
