                                                        "actions": [
                                                            {
                                                                "handler": "setState",
                                                                "params": {
                                                                    "target": "global",
                                                                    "analyticsSubjectAfter": "subjects",
                                                                    "analyticsSubjectConfirm": false,
                                                                    "analyticsSubject": {
                                                                        "ip": "{{(query.subject || 'ip') === 'ip' ? query.value : ''}}",
                                                                        "user_id": "{{query.subject === 'user_id' ? query.value : ''}}",
                                                                        "visitor_key": "{{query.subject === 'visitor_key' ? query.value : ''}}",
                                                                        "from": "{{query.from || ''}}",
                                                                        "to": "{{query.to || ''}}"
                                                                    }
                                                                }
                                                            },
                                                            {
                                                                "handler": "openModal",
                                                                "target": "analytics_subject_delete_modal"
                                                            }
