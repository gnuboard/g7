                                                            "search.subject": "{{$event.target.value}}"
                                                        }
                                                    }
                                                ],
                                                "props": {
                                                    "name": "analytics_subject_type",
                                                    "value": "{{_local.search?.subject || 'ip'}}",
                                                    "inline": true,
                                                    "options": [
                                                        {
                                                            "label": "$t:admin.analytics.privacy_requests.search.subject_ip",
                                                            "value": "ip"
                                                        },
                                                        {
                                                            "label": "$t:admin.analytics.privacy_requests.search.subject_user",
                                                            "value": "user_id"
                                                        },
                                                        {
                                                            "label": "$t:admin.analytics.privacy_requests.search.subject_key",
                                                            "value": "visitor_key"
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "filter-row"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Span",
                                                "props": {
                                                    "className": "filter-label w-32"
                                                },
                                                "text": "$t:admin.analytics.privacy_requests.search.value_label"
                                            },
                                            {
                                                "id": "subject_value",
                                                "type": "basic",
                                                "name": "Input",
                                                "actions": [
                                                    {
                                                        "type": "change",
                                                        "handler": "setState",
                                                        "params": {
                                                            "target": "local",
                                                            "search.value": "{{$event.target.value}}"
                                                        }
                                                    },
                                                    {
                                                        "type": "keydown",
                                                        "key": "Enter",
                                                        "handler": "sequence",
                                                        "actions": [
