                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-body"
                                                            },
                                                            "text": "{{(row.visits ?? 0) | number}}"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "field": "hits",
                                                    "header": "$t:admin.analytics.common.hits",
                                                    "width": "90px",
                                                    "align": "right",
                                                    "cellChildren": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-body"
                                                            },
