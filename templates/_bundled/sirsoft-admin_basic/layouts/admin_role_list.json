{
    "comment": "역할 목록. 회원 목록과 같은 방식으로 검색·페이지를 URL 에 두지만 정렬은 없다(서버 순서 고정).\n  행마다 할 수 있는 일은 서버가 실어 준 `abilities` 로 잠근다 — 이름으로 특별 취급하지 않는다.\n  상태 토글만 URL 을 거치지 않고 목록을 직접 다시 부른다(조건이 바뀐 게 아니라 값이 바뀐 것이라).",
    "version": "1.0.0",
    "layout_name": "admin_role_list",
    "extends": "_admin_base",
    "meta": {
        "title": "$t:admin.roles.page_title",
        "description": "$t:admin.roles.page_description"
    },
    "data_sources": [
        {
            "id": "roles",
            "label_key": "$t:editor.data_source.roles",
            "type": "api",
            "endpoint": "/api/admin/roles",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "required",
            "params": {
                "search": "{{query.search}}",
                "page": "{{query.page ?? 1}}",
                "per_page": 20
            },
            "errorHandling": {
                "403": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                },
                "default": {
                    "handler": "showErrorPage",
                    "params": {
                        "target": "content"
                    }
                }
            },
            "fallback": {
                "data": []
            },
            "comment": "역할 목록. 어떤 실패든 화면을 에러로 갈아끼운다 — 역할이 안 보이는 상태에서 \"역할 없음\" 으로\n       읽히면 새로 만들려 들기 때문이다."
        }
    ],
    "initLocal": {
        "searchQuery": ""
    },
    "permissions": [
        "core.permissions.read"
    ],
    "transition_overlay": {
        "wait_for": [
            "roles"
        ]
    },
    "init_actions": [
        {
            "handler": "setState",
            "params": {
                "target": "global",
                "_local": {
                    "searchQuery": "{{query.search || ''}}"
                }
            }
        }
    ],
    "slots": {
        "content": [
            {
                "id": "role_list_content",
                "type": "basic",
                "name": "Div",
                "responsive": {
                    "portable": {
                        "props": {
                            "className": "admin-page-content-compact"
                        }
                    }
                },
                "props": {
                    "className": "admin-page-content"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:admin.roles.title",
                            "description": "$t:admin.roles.description"
                        },
                        "children": [
                            {
                                "id": "refresh_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "refetchDataSource",
                                        "params": {
                                            "dataSourceId": "roles"
                                        }
                                    }
                                ],
                                "props": {
                                    "className": "btn-icon",
                                    "aria-label": "$t:admin.roles.refresh"
                                },
                                "children": [
                                    {
                                        "id": "refresh_icon",
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "refresh",
                                            "size": "md"
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "add_role_button",
                                "type": "basic",
                                "name": "Button",
                                "actions": [
                                    {
                                        "comment": "새 역할 만들기. 만들기를 취소하고 돌아왔을 때를 위해 목록 상태를 넘긴다",
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/roles/create",
                                            "mergeQuery": true,
                                            "query": {}
                                        }
                                    }
                                ],
                                "props": {
                                    "disabled": "{{roles?.data?.abilities?.can_create !== true}}",
                                    "className": "flex-center gap-2 px-4 h-10 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "plus",
                                            "size": "md"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:admin.roles.add_role"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "comment": "보호 역할 안내 — 행 메뉴의 삭제·수정과 사용 여부 스위치가 왜 잠겨 있는지 알려 준다.\n           잠금 자체는 서버가 행마다 실어 준 `abilities` 가 정한다(코어·확장 역할 삭제 불가,\n           수정·토글은 슈퍼 관리자만 — 서버 가드와 같은 판정).",
                        "id": "protected_roles_hint",
                        "type": "basic",
                        "name": "P",
                        "props": {
                            "className": "text-xs text-gray-500 dark:text-gray-400 mb-2"
                        },
                        "text": "$t:admin.roles.protected_roles_hint"
                    },
                    {
                        "id": "search_bar_wrapper",
                        "type": "basic",
                        "name": "Div",
                        "responsive": {
                            "portable": {
                                "props": {
                                    "className": "mb-6"
                                }
                            }
                        },
                        "props": {
                            "className": "flex justify-end mb-6"
                        },
                        "children": [
                            {
                                "id": "search_bar",
                                "type": "composite",
                                "name": "SearchBar",
                                "responsive": {
                                    "portable": {
                                        "props": {
                                            "className": "w-full"
                                        }
                                    }
                                },
                                "actions": [
                                    {
                                        "type": "change",
                                        "handler": "setState",
                                        "params": {
                                            "searchQuery": "{{$event.target.value}}"
                                        }
                                    },
                                    {
                                        "comment": "검색 실행. 검색어가 비면 `undefined` 로 쿼리에서 빼고(빈 문자열 검색 방지),\n                 페이지는 1로 되돌린다. 대기 표시는 표 본문에만 걸어 검색창이 가려지지 않게 한다.",
                                        "type": "submit",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/roles",
                                            "mergeQuery": true,
                                            "replace": true,
                                            "transition_overlay_target": "roles_data_grid__body",
                                            "query": {
                                                "search": "{{_local.searchQuery || undefined}}",
                                                "page": 1
                                            }
                                        }
                                    }
                                ],
                                "props": {
                                    "placeholder": "$t:admin.roles.search_placeholder",
                                    "value": "{{_local.searchQuery || ''}}",
                                    "className": "w-64"
                                }
                            }
                        ]
                    },
                    {
                        "id": "roles_data_grid",
                        "type": "composite",
                        "name": "DataGrid",
                        "blur_until_loaded": true,
                        "actions": [
                            {
                                "comment": "페이지 이동. `replace` 라 뒤로가기 이력에 페이지마다 쌓이지 않는다(검색은 이력에 남긴다).",
                                "type": "change",
                                "event": "onPageChange",
                                "handler": "navigate",
                                "params": {
                                    "path": "/admin/roles",
                                    "mergeQuery": true,
                                    "replace": true,
                                    "transition_overlay_target": "roles_data_grid__body",
                                    "query": {
                                        "page": "{{$args[0]}}"
                                    }
                                }
                            },
                            {
                                "comment": "행 메뉴. 복제는 등록 화면에 원본 id 를 쿼리로 넘겨 그쪽이 값을 끌어오게 한다\n               (여기서 복사본을 만들지 않는다). 삭제는 대상 id·이름을 전역에 담고 확인 창을 연다 —\n               이름까지 담는 것은 창이 무엇을 지우는지 되보여 주기 위해서다.",
                                "type": "action",
                                "event": "onRowAction",
                                "handler": "switch",
                                "cases": {
                                    "edit": {
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/roles/{{$args[1].id}}/edit",
                                            "mergeQuery": true,
                                            "query": {}
                                        }
                                    },
                                    "clone": {
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/admin/roles/create",
                                            "mergeQuery": true,
                                            "query": {
                                                "clone_from": "{{$args[1].id}}"
                                            }
                                        }
                                    },
                                    "delete": {
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": {
                                                    "target": "global",
                                                    "deleteTargetId": "{{$args[1].id}}",
                                                    "deleteTargetName": "{{$args[1].name}}"
                                                }
                                            },
                                            {
                                                "handler": "openModal",
                                                "target": "delete_confirm_modal"
                                            }
                                        ]
                                    }
                                }
                            }
                        ],
                        "props": {
                            "data": "{{roles?.data?.data}}",
                            "pagination": true,
                            "serverSidePagination": true,
                            "serverCurrentPage": "{{roles?.data?.pagination?.current_page ?? 1}}",
                            "serverTotalPages": "{{roles?.data?.pagination?.last_page ?? null}}",
                            "serverHasMorePages": "{{roles?.data?.pagination?.has_more_pages ?? false}}",
                            "pageSize": 20,
                            "alwaysShowPagination": true,
                            "idField": "id",
                            "responsiveBreakpoint": 768,
                            "actionsColumnHeader": "$t:common.actions",
                            "rowActions": [
                                {
                                    "id": "edit",
                                    "label": "$t:common.edit",
                                    "iconName": "pencil",
                                    "disabledField": "abilities.can_update"
                                },
                                {
                                    "id": "clone",
                                    "label": "$t:admin.roles.actions.clone",
                                    "iconName": "copy",
                                    "disabledField": "abilities.can_create"
                                },
                                {
                                    "id": "delete",
                                    "label": "$t:common.delete",
                                    "iconName": "trash",
                                    "variant": "danger",
                                    "disabledField": "abilities.can_delete"
                                }
                            ],
                            "columns": [
                                {
                                    "field": "name",
                                    "header": "$t:admin.roles.columns.name",
                                    "sortable": false,
                                    "cellChildren": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex-center gap-2"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "font-medium text-gray-900 dark:text-white"
                                                    },
                                                    "text": "{{row.name}}"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "if": "{{row.extension_type === 'core'}}",
                                                    "props": {
                                                        "className": "inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Icon",
                                                            "props": {
                                                                "name": "shield",
                                                                "size": "sm"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "text": "$t:admin.roles.badges.core"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "if": "{{row.extension_type === 'module'}}",
                                                    "props": {
                                                        "className": "inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Icon",
                                                            "props": {
                                                                "name": "cube",
                                                                "size": "sm"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "text": "{{row.extension_name ?? '$t:admin.roles.badges.module'}}"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Div",
                                                    "if": "{{row.extension_type === 'plugin'}}",
                                                    "props": {
                                                        "className": "inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Icon",
                                                            "props": {
                                                                "name": "plug",
                                                                "size": "sm"
                                                            }
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "text": "{{row.extension_name ?? '$t:admin.roles.badges.plugin'}}"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "field": "description",
                                    "header": "$t:admin.roles.columns.description",
                                    "sortable": false,
                                    "cellChildren": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-600 dark:text-gray-400 text-sm line-clamp-1"
                                            },
                                            "text": "{{row.description ?? '-'}}"
                                        }
                                    ]
                                },
                                {
                                    "field": "users_count",
                                    "header": "$t:admin.roles.columns.users_count",
                                    "sortable": false,
                                    "cellChildren": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex items-center gap-1 text-gray-600 dark:text-gray-400"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "users",
                                                        "size": "sm"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{row.users_count ?? 0}}"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "field": "permissions_count",
                                    "header": "$t:admin.roles.columns.permissions_count",
                                    "sortable": false,
                                    "cellChildren": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "props": {
                                                "className": "flex items-center gap-1 text-gray-600 dark:text-gray-400"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Icon",
                                                    "props": {
                                                        "name": "key",
                                                        "size": "sm"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "{{row.permissions_count ?? 0}}"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "field": "is_active",
                                    "header": "$t:admin.roles.columns.status",
                                    "sortable": false,
                                    "cellChildren": [
                                        {
                                            "type": "composite",
                                            "name": "Toggle",
                                            "actions": [
                                                {
                                                    "comment": "사용 여부 토글. 성공 문구는 **누른 뒤의 상태**(`$event.target.checked`)로 고르고,\n                     목록을 다시 받아 서버가 실제로 저장한 값으로 스위치를 되맞춘다.\n                     실패하면 목록을 다시 부르지 않으므로 스위치가 눌린 채로 남는다 — 다시 부르는 쪽이\n                     맞지만 지금은 그렇게 돼 있다(수정은 이 단락 범위 밖).",
                                                    "type": "change",
                                                    "handler": "apiCall",
                                                    "target": "/api/admin/roles/{{row.id}}/toggle-status",
                                                    "auth_required": true,
                                                    "params": {
                                                        "method": "PATCH"
                                                    },
                                                    "onSuccess": {
                                                        "handler": "parallel",
                                                        "actions": [
                                                            {
                                                                "handler": "toast",
                                                                "params": {
                                                                    "type": "success",
                                                                    "message": "{{$event.target.checked ? '$t:admin.roles.activate_success' : '$t:admin.roles.deactivate_success'}}"
                                                                }
                                                            },
                                                            {
                                                                "handler": "refetchDataSource",
                                                                "params": {
                                                                    "dataSourceId": "roles"
                                                                }
                                                            }
                                                        ]
                                                    },
                                                    "onError": {
                                                        "handler": "toast",
                                                        "params": {
                                                            "type": "error",
                                                            "message": "{{error.message ?? '$t:admin.roles.toggle_status_failed'}}"
                                                        }
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "checked": "{{row.is_active}}",
                                                "disabled": "{{row.abilities?.can_toggle_status !== true}}",
                                                "size": "sm"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "field": "created_at",
                                    "header": "$t:admin.roles.columns.created_at",
                                    "sortable": false
                                }
                            ]
                        }
                    }
                ]
            }
        ]
    },
    "modals": [
        {
            "comment": "역할 삭제 확인 창 — 대상은 위 행 메뉴가 전역에 담아 준 id·이름이다.",
            "partial": "partials/admin_role_list/_modal_delete.json"
        }
    ]
}
