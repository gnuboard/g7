{
    "comment": "언어팩을 새 판본으로 올리기 전 되묻는 창. 지금 판본과 올라갈 판본은 목록에서 미리 담아 준\n  값을 그대로 보여 준다(창이 서버를 다시 부르지 않는다).\n  안내 문구가 짚는 것은 하나다 — **손으로 고친 번역이 어떻게 되는가**. 그 사정 때문에 새 판본이\n  있어도 자동으로 올리지 않고 이 확인을 거친다.",
    "meta": {
        "is_partial": true,
        "editor_label": "$t:admin.modal_label.admin_language_pack_list.language_pack_update_modal",
        "description": "언어팩 업데이트 확인 모달 — 모듈/플러그인 update 모달과 동일 수준. 로딩 스피너, reloadExtensions 후속 호출 포함."
    },
    "id": "language_pack_update_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:admin.language_packs.modal.update.title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "py-2 space-y-3"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-body flex items-center gap-2"
                    },
                    "children": [
                        {
                            "id": "lp_update_icon",
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "inline-flex flex-shrink-0 w-6 h-6 bg-gray-100 dark:bg-gray-700 rounded items-center justify-center overflow-hidden"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Img",
                                    "if": "{{_local.updateIconUrl}}",
                                    "props": {
                                        "src": "{{_local.updateIconUrl}}",
                                        "alt": "",
                                        "loading": "lazy",
                                        "decoding": "async",
                                        "className": "w-5 h-5 object-contain"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "if": "{{!_local.updateIconUrl}}",
                                    "props": {
                                        "name": "fas fa-language",
                                        "className": "text-xs text-gray-600 dark:text-gray-400",
                                        "aria-hidden": "true"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:admin.language_packs.modal.update.body|current={{_local.updateCurrent}}|latest={{_local.updateLatest}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "text-secondary rounded-md border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 px-3 py-2 text-xs"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-start gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "fas fa-info-circle",
                                        "size": "sm",
                                        "className": "mt-0.5"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:admin.language_packs.modal.update.user_overrides_notice"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex justify-end gap-2 mt-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "event": "onClick",
                            "handler": "closeModal",
                            "target": "language_pack_update_modal"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "disabled": "{{_global.isLanguagePackUpdating}}",
                        "className": "px-4 py-2 bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 text-sm font-medium rounded-md disabled:opacity-50 disabled:cursor-not-allowed"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "올린 뒤 목록을 다시 받고 확장을 새로 읽어 바뀐 문구가 곧바로 화면에 나오게 한다. 실패해도 창은 열린 채라 다시 시도할 수 있다.",
                            "event": "onClick",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isLanguagePackUpdating": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/admin/language-packs/{{_local.updateId}}/update",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isLanguagePackUpdating": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.language_packs.messages.update_success"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "language_packs"
                                            }
                                        },
                                        {
                                            "handler": "reloadExtensions"
                                        },
                                        {
                                            "handler": "closeModal",
                                            "target": "language_pack_update_modal"
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isLanguagePackUpdating": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message ?? '$t:admin.language_packs.messages.update_failed'}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "disabled": "{{_global.isLanguagePackUpdating}}",
                        "className": "flex-center gap-2 px-4 py-2 bg-amber-600 dark:bg-amber-500 hover:bg-amber-700 dark:hover:bg-amber-600 text-white text-sm font-medium rounded-md disabled:opacity-50 disabled:cursor-not-allowed"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{!_global.isLanguagePackUpdating}}",
                            "props": {
                                "name": "fas fa-arrow-up",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isLanguagePackUpdating}}",
                            "props": {
                                "name": "fas fa-spinner",
                                "className": "animate-spin",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isLanguagePackUpdating ? '$t:admin.language_packs.updating' : '$t:admin.language_packs.actions.update_now'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
