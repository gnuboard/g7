                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{_global.pluginUninstallInfo.storage_directories && _global.pluginUninstallInfo.storage_directories.length > 0}}",
                                            "props": {
                                                "className": "text-tertiary"
                                            },
                                            "text": "($t:admin.plugins.modals.storage_total|size={{_global.pluginUninstallInfo.total_storage_size_formatted}})"
                                        }
                                    ]
                                },
