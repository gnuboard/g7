                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{!_global.pluginUninstallInfo.storage_directories || _global.pluginUninstallInfo.storage_directories.length === 0}}",
                                    "props": {
                                        "className": "text-tertiary ml-6"
                                    },
                                    "text": "$t:admin.plugins.modals.no_storage"
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{_global.pluginUninstallInfo.storage_directories && _global.pluginUninstallInfo.storage_directories.length > 0}}",
                                    "props": {
                                        "className": "ml-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg overflow-hidden"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "iteration": {
