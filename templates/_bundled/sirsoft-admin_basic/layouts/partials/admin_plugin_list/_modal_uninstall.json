                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-tertiary"
                                                    },
                                                    "text": "$t:admin.plugins.modals.shared_records_count|count={{rec.count}}"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
