                            "handler": "closeModal"
                        }
                    ],
                    "props": {
                        "className": "btn btn-secondary",
                        "disabled": "{{_global.isPluginUninstalling}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "if": "{{!(_global.pluginUninstallBackups?.length)}}",
                    "actions": [
                        {
                            "comment": "자료까지 지울지를 본문에 실어 보낸다(체크를 건드린 적 없으면 끔으로 친다). 끝난 뒤 목록·관리자 메뉴를 함께 다시 받아, 사라진 플러그인의 메뉴가 남지 않게 한다.\n               실어 둔 JS·CSS 를 걷어 낼 식별자는 고른 플러그인에서 읽는다 — 제거 응답에는 보존 백업 목록뿐이라 식별자가 없다. 그래서 선택을 비우는 setState 보다 앞에 둔다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isPluginUninstalling": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/admin/plugins/uninstall",
                                    "auth_required": true,
                                    "params": {
                                        "method": "DELETE",
                                        "body": {
                                            "plugin_name": "{{_global.selectedPlugin.identifier}}",
                                            "delete_data": "{{_global.deletePluginData || false}}"
                                        }
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isPluginUninstalling": false
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "pluginUninstallBackups": "{{response.data?.preserved_backups ?? []}}"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.plugins.uninstall_success"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "plugins"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "admin_menu"
                                            }
                                        },
                                        {
                                            "handler": "reloadExtensions",
                                            "params": {
                                                "pluginInfo": "{{_global.selectedPlugin}}",
                                                "action": "remove"
                                            }
                                        },
                                        {
                                            "handler": "closeModal",
                                            "if": "{{!(response.data?.preserved_backups?.length)}}"
                                        },
                                        {
                                            "handler": "setState",
                                            "if": "{{!(response.data?.preserved_backups?.length)}}",
                                            "params": {
                                                "target": "global",
                                                "selectedPlugin": null,
                                                "deletePluginData": false,
                                                "pluginUninstallInfo": null
                                            }
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isPluginUninstalling": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "flex-center gap-2 px-4 py-2 bg-red-600 dark:bg-red-500 text-white rounded-lg hover:bg-red-700 dark:hover:bg-red-600 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isPluginUninstalling}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isPluginUninstalling}}",
                            "props": {
                                "name": "spinner",
                                "className": "spinner-sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isPluginUninstalling ? '$t:admin.plugins.uninstalling' : '$t:admin.plugins.actions.uninstall'}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "if": "{{_global.pluginUninstallBackups?.length}}",
                    "actions": [
                        {
                            "comment": "보존된 백업 안내를 본 뒤 닫는다 — 대상·데이터 삭제 선택·안내·백업 목록을 전부 비워야 다음에 다른 플러그인을 지울 때 이전 백업 경로가 남아 보이지 않는다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "closeModal"
                                },
                                {
                                    "comment": "창을 먼저 닫고 선택을 비운다 — 먼저 비우면 닫히는 몇 초 동안 문구의 확장 이름 자리가 빈 표시로 보였다(7.1.0 O-G3-7).",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "selectedPlugin": null,
                                        "deletePluginData": false,
                                        "pluginUninstallInfo": null,
                                        "pluginUninstallBackups": null
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "btn btn-secondary"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.close"
                        }
                    ]
                }
            ]
        }
    ]
}
