                        "className": "flex-center justify-center py-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "spinner",
                                "className": "text-xl animate-spin text-gray-400 dark:text-gray-500"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_global.pluginUninstallInfo}}",
                    "props": {
                        "className": "mt-3 space-y-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-center gap-2 mb-2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "database",
                                                "className": "text-base text-gray-500"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-body font-medium"
                                            },
                                            "text": "$t:admin.plugins.modals.tables_section"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{_global.pluginUninstallInfo.tables && _global.pluginUninstallInfo.tables.length > 0}}",
                                            "props": {
                                                "className": "text-tertiary"
                                            },
                                            "text": "($t:admin.plugins.modals.tables_total|size={{_global.pluginUninstallInfo.total_table_size_formatted}})"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{!_global.pluginUninstallInfo.tables || _global.pluginUninstallInfo.tables.length === 0}}",
                                    "props": {
                                        "className": "text-tertiary ml-6"
                                    },
                                    "text": "$t:admin.plugins.modals.no_tables"
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{_global.pluginUninstallInfo.tables && _global.pluginUninstallInfo.tables.length > 0}}",
                                    "props": {
                                        "className": "ml-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg overflow-hidden"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "iteration": {
                                                "source": "_global.pluginUninstallInfo.tables",
                                                "item_var": "table"
                                            },
                                            "props": {
                                                "className": "flex-between px-3 py-1.5 border-b border-gray-100 dark:border-gray-700 last:border-b-0"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-xs font-mono text-gray-700 dark:text-gray-300"
                                                    },
                                                    "text": "{{table.name}}"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-tertiary"
                                                    },
                                                    "text": "{{table.size_formatted ?? '$t:admin.plugins.modals.size_unknown'}}"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "if": "{{_global.pluginUninstallInfo.shared_records && _global.pluginUninstallInfo.shared_records.length > 0}}",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-center gap-2 mb-2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "share-nodes",
                                                "className": "text-base text-gray-500"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-body font-medium"
