                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "filter.dateQuick": "{{$prev.preset}}",
                                                                "filter.dateFrom": "{{$prev.startDate}}",
                                                                "filter.dateTo": "{{$prev.endDate}}"
                                                            }
                                                        }
                                                    ]
                                                }
                                            ],
                                            "props": {
                                                "type": "button",
                                                "className": "{{_local.filter.dateQuick === '6months' ? 'btn-date active' : 'btn-date cursor-pointer'}}"
                                            },
                                            "text": "$t:admin.activity_log.filter.date_quick.six_months"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Button",
                                            "actions": [
                                                {
                                                    "comment": "한 해 전 같은 날 0시부터 — 이 화면이 한 번에 잡을 수 있는 가장 넓은 범위다.",
                                                    "type": "click",
                                                    "handler": "sequence",
                                                    "actions": [
                                                        {
                                                            "handler": "setDateRange",
                                                            "params": {
                                                                "preset": "1year"
                                                            }
                                                        },
                                                        {
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "filter.dateQuick": "{{$prev.preset}}",
                                                                "filter.dateFrom": "{{$prev.startDate}}",
                                                                "filter.dateTo": "{{$prev.endDate}}"
                                                            }
                                                        }
                                                    ]
                                                }
                                            ],
                                            "props": {
                                                "type": "button",
                                                "className": "{{_local.filter.dateQuick === '1year' ? 'btn-date active' : 'btn-date cursor-pointer'}}"
                                            },
                                            "text": "$t:admin.activity_log.filter.date_quick.one_year"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "filter_actions",
            "type": "basic",
            "name": "Div",
            "responsive": {
                "portable": {
                    "props": {
                        "className": "flex gap-3 mt-6"
                    }
                }
            },
            "props": {
                "className": "flex justify-center gap-3 mt-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "btn btn-primary flex-1"
                            }
                        }
                    },
                    "actions": [
                        {
                            "type": "click",
                            "actionRef": "searchActivityLogs"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-primary px-6"
                    },
                    "text": "$t:admin.activity_log.filter.search_button"
                },
                {
                    "comment": "검색 조건 초기화. 폼 상태와 주소를 함께 비운다 — 초기화는 걸린 조건을 없애는 것이라 지금 조건과 병합하지 않는다",
                    "type": "basic",
                    "name": "Button",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "btn btn-secondary flex-1"
                            }
                        }
                    },
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "actorSearchResults": [],
                                        "filter": {
                                            "searchType": "all",
                                            "search": "",
                                            "logTypes": [],
                                            "createdBy": "",
                                            "dateQuick": "",
                                            "dateFrom": "",
                                            "dateTo": ""
                                        }
                                    }
                                },
                                {
                                    "comment": "audit:allow layout-list-context-navigate-merge-query 필터 초기화 — 걸려 있던 조건을 전부 비우는 것이 이 버튼의 목적이므로 병합하지 않는다.",
                                    "handler": "navigate",
                                    "params": {
                                        "path": "/admin/activity-logs",
                                        "mergeQuery": false
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-secondary px-6"
                    },
                    "text": "$t:admin.activity_log.filter.reset_button"
                }
            ]
        }
    ]
}
