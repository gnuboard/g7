                                    "type": "basic",
                                    "name": "Input",
                                    "actions": [
                                        {
                                            "comment": "검색어는 담아 두기만 한다. 대상이 되는 값(대상 해시 등)은 원문이 아니라 저장된 형태 그대로 넣어야 맞는다.",
                                            "type": "change",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "filter.search": "{{$event.target.value}}"
                                            }
                                        },
                                        {
                                            "type": "keydown",
                                            "key": "Enter",
                                            "actionRef": "searchIdentityLogs"
                                        }
                                    ],
                                    "props": {
                                        "name": "search",
                                        "type": "text",
                                        "placeholder": "$t:admin.identity.logs.search_placeholder",
                                        "className": "input pl-10",
                                        "value": "{{_local.filter.search || ''}}"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "filter_grid",
