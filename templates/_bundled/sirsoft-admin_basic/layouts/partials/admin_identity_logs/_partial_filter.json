                            "text": "$t:admin.identity.logs.filter.source_identifier_label"
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "actions": [
                                {
                                    "comment": "위 구분을 좁힌 뒤 확장 식별자까지 직접 적는 칸이다. 고르는 목록이 아니라 자유 입력이라 철자가 정확해야 걸린다.",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "filter.sourceIdentifier": "{{$event.target.value}}"
                                    }
                                }
                            ],
                            "props": {
                                "type": "text",
                                "name": "sourceIdentifier",
                                "placeholder": "$t:admin.identity.logs.filter.source_identifier_placeholder",
                                "className": "input w-64",
                                "value": "{{_local.filter.sourceIdentifier || ''}}"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "filter_actions",
            "type": "basic",
            "name": "Div",
            "responsive": {
                "portable": {
                    "props": {
                        "className": "flex gap-3 mt-6"
                    }
                }
            },
            "props": {
                "className": "flex justify-center gap-3 mt-6"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "btn btn-primary flex-1"
                            }
                        }
                    },
                    "actions": [
                        {
                            "type": "click",
                            "actionRef": "searchIdentityLogs"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-primary px-6"
                    },
                    "text": "$t:admin.identity.logs.filter.search_button"
                },
                {
                    "comment": "검색 실행. 폼에 담아 둔 조건을 주소로 옮겨 목록을 다시 세운다",
                    "type": "basic",
                    "name": "Button",
                    "responsive": {
                        "portable": {
                            "props": {
                                "className": "btn btn-secondary flex-1"
                            }
                        }
                    },
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "filter": {
                                            "searchType": "auto",
                                            "search": "",
                                            "statuses": [],
                                            "purposes": [],
                                            "channels": [],
                                            "originTypes": [],
                                            "dateFrom": "",
                                            "dateTo": "",
                                            "sourceType": "",
                                            "sourceIdentifier": "",
                                            "advancedOpen": false
                                        }
                                    }
                                },
                                {
                                    "comment": "audit:allow layout-list-context-navigate-merge-query 필터 초기화 — 걸려 있던 조건을 전부 비우는 것이 이 버튼의 목적이므로 병합하지 않는다.",
                                    "handler": "navigate",
                                    "params": {
                                        "path": "/admin/identity/logs",
                                        "mergeQuery": false
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-secondary px-6"
                    },
                    "text": "$t:admin.identity.logs.filter.reset_button"
                }
            ]
        }
    ]
