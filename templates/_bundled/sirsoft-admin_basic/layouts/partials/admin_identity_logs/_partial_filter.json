                                "className": "filter-label w-32"
                            },
                            "text": "$t:admin.identity.logs.filter.status_label"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-center flex-wrap gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "inline-clickable"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "actions": [
                                                {
                                                    "comment": "상태 「전체」는 고른 것이 없는 상태 그 자체다 — 비우면 옆 칸들의 체크도 함께 풀린다.",
                                                    "type": "change",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "filter.statuses": "{{[]}}"
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "type": "checkbox",
                                                "className": "checkbox",
                                                "checked": "{{!_local.filter.statuses || _local.filter.statuses.length === 0}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-label"
                                            },
                                            "text": "$t:admin.identity.logs.filter.status_all"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "iteration": {
                                        "source": "{{['requested','sent','verified','failed','expired','cancelled','policy_violation_logged']}}",
                                        "item_var": "st"
                                    },
                                    "props": {
                                        "className": "inline-clickable"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "actions": [
                                                {
                                                    "comment": "상태 목록은 여기 박아 둔 일곱 개이고 라벨만 상태 이름으로 언어팩에서 찾아 붙인다.\n                  앞의 여섯은 인증 한 건이 지나는 단계(요청·발송·성공·실패·만료·취소)이고,\n                  마지막 「정책 위반 기록」만 성격이 다르다 — 어기면 막는 대신 남기기만 하도록 둔\n                  정책이 걸렸을 때 **요청은 통과시키고** 남긴 줄이라, 인증을 시도한 기록이 아니다.\n                  (수단 칸이 늘 「policy」로 찍히는 것도 그 때문이다.)",
                                                    "type": "change",
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "filter.statuses": "{{$event.target.checked ? [...(_local.filter.statuses || []).filter(s => s !== st), st] : (_local.filter.statuses || []).filter(s => s !== st)}}"
                                                    }
                                                }
                                            ],
                                            "props": {
                                                "type": "checkbox",
                                                "className": "checkbox",
                                                "checked": "{{(_local.filter.statuses || []).includes(st)}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-label"
                                            },
                                            "text": "{{$t('admin.identity.logs.status.' + st)}}"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
