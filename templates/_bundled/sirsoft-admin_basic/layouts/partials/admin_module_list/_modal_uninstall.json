                        {
                            "type": "click",
                            "handler": "closeModal"
                        }
                    ],
                    "props": {
                        "className": "btn btn-secondary",
                        "disabled": "{{_global.isModuleUninstalling}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "if": "{{!(_global.moduleUninstallBackups?.length)}}",
                    "actions": [
                        {
                            "comment": "삭제 실행. 데이터 삭제 여부를 함께 보낸다. 성공 갈래가 대상과 선택을 모두 비우므로 **요청 본문은 그 전에 조립된 값을 쓴다**. 사이드바 메뉴와 프론트 확장 번들도 함께 갱신한다 — 안 하면 죽은 모듈의 메뉴가 남는다.\n               실어 둔 JS·CSS 를 걷어 낼 식별자는 고른 모듈에서 읽는다 — 제거 응답에는 보존 백업 목록뿐이라 식별자가 없다. 그래서 선택을 비우는 setState 보다 앞에 둔다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isModuleUninstalling": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/admin/modules/uninstall",
                                    "auth_required": true,
                                    "params": {
                                        "method": "DELETE",
                                        "body": {
                                            "module_name": "{{_global.selectedModule.identifier}}",
                                            "delete_data": "{{_global.deleteModuleData || false}}"
                                        }
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isModuleUninstalling": false
                                            }
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "moduleUninstallBackups": "{{response.data?.preserved_backups ?? []}}"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.modules.uninstall_success"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "modules"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "admin_menu"
                                            }
                                        },
                                        {
                                            "handler": "reloadExtensions",
                                            "params": {
                                                "moduleInfo": "{{_global.selectedModule}}",
                                                "action": "remove"
                                            }
                                        },
                                        {
                                            "handler": "closeModal",
                                            "if": "{{!(response.data?.preserved_backups?.length)}}"
                                        },
                                        {
                                            "handler": "setState",
                                            "if": "{{!(response.data?.preserved_backups?.length)}}",
                                            "params": {
                                                "target": "global",
                                                "selectedModule": null,
                                                "deleteModuleData": false,
                                                "moduleUninstallInfo": null
                                            }
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isModuleUninstalling": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "flex-center gap-2 px-4 py-2 bg-red-600 dark:bg-red-500 text-white rounded-lg hover:bg-red-700 dark:hover:bg-red-600 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isModuleUninstalling}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isModuleUninstalling}}",
                            "props": {
                                "name": "spinner",
                                "className": "spinner-sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isModuleUninstalling ? '$t:admin.modules.uninstalling' : '$t:admin.modules.actions.uninstall'}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "if": "{{_global.moduleUninstallBackups?.length}}",
                    "actions": [
                        {
                            "comment": "보존된 백업 안내를 본 뒤 닫는다 — 대상·데이터 삭제 선택·안내·백업 목록을 전부 비워야 다음에 다른 모듈을 지울 때 이전 백업 경로가 남아 보이지 않는다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "closeModal"
                                },
                                {
                                    "comment": "창을 먼저 닫고 선택을 비운다 — 먼저 비우면 닫히는 몇 초 동안 문구의 확장 이름 자리가 빈 표시로 보였다(7.1.0 O-G3-7).",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "selectedModule": null,
                                        "deleteModuleData": false,
                                        "moduleUninstallInfo": null,
                                        "moduleUninstallBackups": null
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "btn btn-secondary"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.close"
                        }
                    ]
                }
            ]
        }
    ]
}
