                                                "className": "form-error"
                                            },
                                            "text": "{{_local.errors?.['privacy.dormant_withdraw_enabled']?.[0] ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "type": "composite",
                                    "name": "Toggle",
                                    "props": {
                                        "name": "privacy.dormant_withdraw_enabled",
                                        "size": "md",
                                        "disabled": "{{_computed.isReadOnly}}"
                                    }
                                }
                            ]
                        },
                        {
                            "id": "field_dormant_withdraw_days",
                            "type": "basic",
                            "name": "Div",
                            "if": "{{!!_local.form?.privacy?.dormant_enabled && _local.form?.privacy?.dormant_enabled !== '0' && !!_local.form?.privacy?.dormant_withdraw_enabled && _local.form?.privacy?.dormant_withdraw_enabled !== '0'}}",
                            "props": {
                                "className": ""
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:admin.settings.privacy.dormant.withdraw_days"
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "number",
                                        "name": "privacy.dormant_withdraw_days",
                                        "placeholder": "365",
                                        "min": "{{_local?.form?._meta?.limits?.privacy_retention_days_min ?? 1}}",
                                        "max": "{{_local?.form?._meta?.limits?.privacy_retention_days_max ?? 3650}}",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "className": "input input-w-md {{_local.errors?.['privacy.dormant_withdraw_days'] ? 'input-error' : ''}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{_local.errors?.['privacy.dormant_withdraw_days']}}",
                                    "props": {
                                        "className": "form-error"
                                    },
                                    "text": "{{_local.errors?.['privacy.dormant_withdraw_days']?.[0] ?? ''}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-hint mt-1"
                                    },
                                    "text": "$t:admin.settings.privacy.dormant.withdraw_days_hint"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-error-soft mt-1"
                                    },
                                    "text": "$t:admin.settings.privacy.dormant.withdraw_warning"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-hint"
                            },
                            "text": "$t:admin.settings.privacy.dormant.restore_hint"
                        }
                    ]
                }
            ]
        }
    ]
}
