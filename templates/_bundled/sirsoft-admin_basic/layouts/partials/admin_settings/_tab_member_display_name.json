                                                        "value": "{{(_local.form?.member?.display_name_areas ?? {})[area.key]?.kind ?? area.kind ?? ''}}",
                                                        "disabled": "{{_computed.isReadOnly}}",
                                                        "className": "w-full",
                                                        "options": "{{(memberDisplayNameOptions?.data?.kinds ?? []).map(function(k) { return { value: k.key, label: k.label ?? k.key }; })}}"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "P",
                                                    "if": "{{((_local.form?.member?.display_name_areas ?? {})[area.key]?.mode ?? area.mode ?? 'inherit') === 'member'}}",
                                                    "props": {
                                                        "data-testid": "{{'member-display-name-area-note-' + area.key}}",
                                                        "className": "text-label-subtle text-sm break-words"
                                                    },
                                                    "text": "{{$t('admin.settings.member.display_name.effective_member', { kind: ((memberDisplayNameOptions?.data?.kinds ?? []).find(function(k) { return k.key === _local.form?.member?.display_name_member_default_kind; })?.label ?? _local.form?.member?.display_name_member_default_kind ?? '') })}}"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "P",
                                                    "if": "{{((_local.form?.member?.display_name_areas ?? {})[area.key]?.mode ?? area.mode ?? 'inherit') === 'inherit'}}",
                                                    "props": {
                                                        "data-testid": "{{'member-display-name-area-note-' + area.key}}",
                                                        "className": "text-label-subtle text-sm break-words"
                                                    },
                                                    "text": "{{_local.hasChanges === true ? $t('admin.settings.member.display_name.effective_inherit_pending') : (area.effective?.mode === 'member' ? $t('admin.settings.member.display_name.effective_inherit_member') : $t('admin.settings.member.display_name.effective_inherit', { kind: ((memberDisplayNameOptions?.data?.kinds ?? []).find(function(k) { return k.key === area.effective?.kind; })?.label ?? area.effective?.kind ?? '') }))}}"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "if": "{{Object.keys(_local.errors ?? {}).some(function(k) { return k.indexOf('member.display_name_areas.' + area.key + '.') === 0; })}}",
                                                    "props": {
                                                        "className": "form-error"
                                                    },
                                                    "text": "{{(Object.entries(_local.errors ?? {}).find(function(entry) { return entry[0].indexOf('member.display_name_areas.' + area.key + '.') === 0; }) ?? [])[1]?.[0] ?? ''}}"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "form-hint break-words"
                            },
                            "text": "$t:admin.settings.member.display_name.extension_note"
                        }
                    ]
                },
                {
                    "id": "member_display_name_nickname_notice",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_computed.memberDisplayNamePending?.raised === true}}",
                    "props": {
                        "role": "alert",
                        "className": "alert-warning"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex gap-3"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "triangle-exclamation",
                                        "className": "text-xl text-yellow-700 dark:text-yellow-400 flex-shrink-0 mt-0.5"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "min-w-0 flex-1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "data-testid": "member-display-name-nickname-message",
                                                "className": "text-warning-soft break-words"
                                            },
                                            "text": "{{_computed.memberDisplayNamePending?.level === 'all' ? $t('admin.settings.member.display_name.nickname_notice.all') : $t('admin.settings.member.display_name.nickname_notice.chosen')}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "blur_until_loaded": {
                                                "enabled": true,
                                                "data_sources": "memberNicknameEmptyCount"
                                            },
                                            "props": {
                                                "data-testid": "member-display-name-nickname-empty-count",
                                                "className": "text-warning-soft break-words mt-1"
                                            },
                                            "text": "{{$t('admin.settings.member.display_name.nickname_notice.empty_count', { count: Number(memberNicknameEmptyCount?.data?.nickname_empty_count ?? 0) })}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "if": "{{memberNicknameEmptyCount !== undefined && _computed.memberDisplayNamePending?.level === 'all' && memberNicknameEmptyCount?.data?.nickname?.require_existing_members !== true}}",
                                            "props": {
                                                "className": "flex items-start gap-2 mt-3 text-sm text-gray-700 dark:text-gray-300"
                                            },
                                            "children": [
                                                {
                                                    "id": "member_display_name_require_existing",
                                                    "type": "basic",
                                                    "name": "Checkbox",
                                                    "actions": [
                                                        {
                                                            "comment": "로그인 시 닉네임 입력 요구. 저장하는 설정 값이 아니라 저장과 함께 처리할 지시다(저장 요청이 이 안내가 보일 때만 싣는다).",
                                                            "type": "change",
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "hasChanges": true,
                                                                "form.member.nickname_require_existing_members": "{{$event.target.checked}}"
                                                            }
                                                        }
                                                    ],
                                                    "props": {
                                                        "data-testid": "member-display-name-require-existing",
                                                        "checked": "{{_local.form?.member?.nickname_require_existing_members === true}}",
                                                        "disabled": "{{_computed.isReadOnly}}"
                                                    }
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "min-w-0 break-words"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "text-heading"
                                                            },
                                                            "text": "$t:admin.settings.member.display_name.nickname_notice.require_existing"
                                                        },
                                                        {
                                                            "type": "basic",
                                                            "name": "Span",
                                                            "props": {
                                                                "className": "block text-label-subtle"
                                                            },
                                                            "text": "$t:admin.settings.member.display_name.nickname_notice.require_existing_hint"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "if": "{{_computed.memberDisplayNamePending?.level === 'all' && memberNicknameEmptyCount?.data?.nickname?.require_existing_members === true}}",
                                            "props": {
                                                "data-testid": "member-display-name-require-existing-on",
                                                "className": "text-warning-soft break-words mt-1"
                                            },
                                            "text": "$t:admin.settings.member.display_name.nickname_notice.already_required"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
