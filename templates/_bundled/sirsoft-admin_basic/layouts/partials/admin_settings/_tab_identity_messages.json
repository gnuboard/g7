                                                    "name": "Div",
                                                    "props": {
                                                        "className": "flex-center gap-3 flex-shrink-0"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "composite",
                                                            "name": "Toggle",
                                                            "actions": [
                                                                {
                                                                    "comment": "사용 여부 토글 — **성공이든 실패든 목록을 다시 받는다**. 실패 쪽에서도 받는 것이\n                         요점이다(스위치가 눌린 모양으로 남지 않게 서버 값으로 되맞춘다).",
                                                                    "type": "change",
                                                                    "handler": "apiCall",
                                                                    "target": "{{'/api/admin/identity/messages/definitions/' + def.id + '/toggle-active'}}",
                                                                    "auth_required": true,
                                                                    "params": {
                                                                        "method": "PATCH"
                                                                    },
                                                                    "onSuccess": [
                                                                        {
                                                                            "handler": "toast",
                                                                            "params": {
                                                                                "message": "$t:admin.settings.identity.messages.toggle_success",
                                                                                "variant": "success"
                                                                            }
                                                                        },
                                                                        {
                                                                            "handler": "refetchDataSource",
                                                                            "params": {
                                                                                "dataSourceId": "identityMessages"
                                                                            }
                                                                        }
                                                                    ],
                                                                    "onError": [
                                                                        {
                                                                            "handler": "toast",
                                                                            "params": {
                                                                                "message": "{{error.message ?? '$t:admin.settings.identity.messages.toggle_failed'}}",
                                                                                "variant": "error"
                                                                            }
                                                                        },
                                                                        {
                                                                            "handler": "refetchDataSource",
                                                                            "params": {
                                                                                "dataSourceId": "identityMessages"
                                                                            }
                                                                        }
                                                                    ]
                                                                }
                                                            ],
                                                            "props": {
                                                                "size": "sm",
                                                                "checked": "{{def.is_active}}",
                                                                "disabled": "{{!(def.abilities?.can_update ?? false)}}"
