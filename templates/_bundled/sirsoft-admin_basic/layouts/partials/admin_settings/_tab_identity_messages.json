                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "identity_messages_empty",
            "type": "basic",
            "name": "Div",
            "if": "{{(identityMessages?.data?.data ?? []).length === 0}}",
            "props": {
                "className": "admin-card"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                        "name": "fa-solid fa-envelope",
                        "className": "text-4xl text-gray-300 dark:text-gray-600 mb-3"
                    }
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-label-subtle"
                    },
                    "text": "$t:admin.settings.identity.messages.empty"
                }
            ]
        },
        {
            "id": "identity_messages_pagination",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "flex justify-center mt-4"
            },
            "children": [
                {
                    "type": "composite",
                    "name": "Pagination",
                    "actions": [
                        {
                            "comment": "페이지 이동 — 자기 쿼리 키를 쓰고 나머지(탭·항목수)는 유지한다.",
                            "type": "action",
                            "event": "onPageChange",
                            "handler": "navigate",
                            "params": {
                                "path": "/admin/settings",
                                "replace": true,
                                "mergeQuery": true,
                                "query": {
                                    "messages_page": "{{$args[0]}}"
                                }
                            }
                        }
                    ],
                    "props": {
                        "currentPage": "{{identityMessages?.data?.meta?.current_page ?? identityMessages?.data?.pagination?.current_page ?? 1}}",
                        "totalPages": "{{identityMessages?.data?.meta?.last_page ?? identityMessages?.data?.pagination?.last_page ?? null}}",
                        "hasMorePages": "{{identityMessages?.data?.meta?.has_more_pages ?? identityMessages?.data?.pagination?.has_more_pages ?? false}}"
                    }
                }
            ]
        }
    ]
}
