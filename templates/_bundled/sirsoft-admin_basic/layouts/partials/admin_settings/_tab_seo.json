                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.meta_keywords"
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "text",
                    "name": "seo.meta_keywords",
                    "placeholder": "CMS, 그누보드7, 오픈소스",
