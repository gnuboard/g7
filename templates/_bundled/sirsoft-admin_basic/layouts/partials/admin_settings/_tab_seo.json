                      "text": "$t:admin.settings.seo.sitemap_enabled"
                    },
                    {
                      "type": "basic",
                      "name": "P",
                      "props": {
                        "className": "text-label-subtle"
                      },
                      "text": "$t:admin.settings.seo.sitemap_enabled_desc"
                    }
                  ]
                },
                {
                  "type": "composite",
                  "name": "Toggle",
                  "props": {
                    "name": "seo.sitemap_enabled",
                    "size": "md"
                  }
                }
              ]
            },
            {
              "id": "field_sitemap_schedule",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.sitemap_schedule"
                },
                {
                  "type": "composite",
                  "name": "Select",
                  "props": {
                    "name": "seo.sitemap_schedule",
                    "className": "w-full",
                    "options": [
                      {
                        "value": "hourly",
                        "label": "$t:admin.settings.seo.sitemap_schedule_hourly"
                      },
                      {
                        "value": "daily",
                        "label": "$t:admin.settings.seo.sitemap_schedule_daily"
                      },
                      {
                        "value": "weekly",
                        "label": "$t:admin.settings.seo.sitemap_schedule_weekly"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "field_sitemap_schedule_time",
              "type": "basic",
              "name": "Div",
              "if": "{{(_local.form?.['seo.sitemap_schedule'] ?? _local.form?.seo?.sitemap_schedule ?? 'daily') !== 'hourly'}}",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.sitemap_schedule_time"
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "text",
                    "name": "seo.sitemap_schedule_time",
                    "placeholder": "02:00",
                    "className": ""
                  }
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.seo.sitemap_schedule_time_hint"
                }
              ]
            },
            {
              "id": "field_sitemap_cache_ttl",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.sitemap_cache_ttl"
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "number",
                    "name": "seo.sitemap_cache_ttl",
                    "min": "{{_local?.form?._meta?.limits?.seo_sitemap_cache_ttl_min ?? 3600}}",
                    "max": "{{_local?.form?._meta?.limits?.seo_sitemap_cache_ttl_max ?? 604800}}",
                    "placeholder": "86400",
                    "className": ""
                  }
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.seo.sitemap_cache_ttl_hint"
                }
              ]
            },
            {
              "id": "field_sitemap_urls_per_file",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.sitemap_urls_per_file"
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "number",
                    "name": "seo.sitemap_urls_per_file",
                    "min": "{{_local?.form?._meta?.limits?.seo_sitemap_urls_per_file_min ?? 1000}}",
                    "max": "{{_local?.form?._meta?.limits?.seo_sitemap_urls_per_file_max ?? 50000}}",
                    "placeholder": "50000",
                    "className": ""
                  }
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.seo.sitemap_urls_per_file_hint"
                }
              ]
            },
            {
              "id": "field_sitemap_gzip",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex-between"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "$t:admin.settings.seo.sitemap_gzip"
                    },
                    {
                      "type": "basic",
                      "name": "P",
                      "props": {
                        "className": "text-label-subtle"
                      },
                      "text": "$t:admin.settings.seo.sitemap_gzip_desc"
                    }
                  ]
                },
                {
                  "type": "composite",
                  "name": "Toggle",
                  "props": {
                    "name": "seo.sitemap_gzip",
                    "size": "md"
                  }
                }
              ]
            },
            {
              "id": "field_sitemap_hreflang_enabled",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex-between"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "$t:admin.settings.seo.sitemap_hreflang_enabled"
                    },
                    {
                      "type": "basic",
                      "name": "P",
                      "props": {
                        "className": "text-label-subtle"
                      },
                      "text": "$t:admin.settings.seo.sitemap_hreflang_enabled_desc"
                    }
                  ]
                },
                {
                  "type": "composite",
                  "name": "Toggle",
                  "props": {
                    "name": "seo.sitemap_hreflang_enabled",
                    "size": "md"
                  }
                }
              ]
            },
            {
              "id": "sitemap_progress_block",
              "type": "basic",
              "name": "Div",
              "if": "{{['queued','running','writing','completed','failed'].includes(sitemap_status?.data?.progress?.status ?? '')}}",
              "props": {
                "className": "space-y-2 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 p-3"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex items-center gap-2"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "$t:admin.settings.seo.sitemap_progress"
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "px-2 py-0.5 rounded text-xs font-medium",
                        "classMap": {
                          "key": "{{sitemap_status?.data?.progress?.status ?? ''}}",
                          "variants": {
                            "queued": "bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-200",
                            "running": "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-200",
                            "writing": "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-200",
                            "completed": "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-200",
                            "failed": "bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-200"
                          }
                        }
                      },
                      "text": "{{(sitemap_status?.data?.progress?.status === 'queued' && $t('admin.settings.seo.sitemap_status_queued')) || (sitemap_status?.data?.progress?.status === 'running' && $t('admin.settings.seo.sitemap_status_running')) || (sitemap_status?.data?.progress?.status === 'writing' && $t('admin.settings.seo.sitemap_status_writing')) || (sitemap_status?.data?.progress?.status === 'completed' && $t('admin.settings.seo.sitemap_status_completed')) || (sitemap_status?.data?.progress?.status === 'failed' && $t('admin.settings.seo.sitemap_status_failed')) || ''}}"
                    }
                  ]
                },
                {
                  "type": "basic",
                  "name": "P",
                  "if": "{{sitemap_status?.data?.progress?.status === 'running' && (sitemap_status?.data?.progress?.phase ?? '') !== ''}}",
                  "props": {
                    "className": "text-label-subtle text-sm"
                  },
                  "text": "$t:admin.settings.seo.sitemap_progress_phase|phase={{sitemap_status?.data?.progress?.phase ?? ''}}"
                },
                {
                  "type": "basic",
                  "name": "P",
                  "if": "{{Number(sitemap_status?.data?.progress?.urls ?? 0) > 0}}",
                  "props": {
                    "className": "text-label-subtle text-sm"
                  },
                  "text": "$t:admin.settings.seo.sitemap_progress_urls|count={{sitemap_status?.data?.progress?.urls ?? 0}}"
                },
                {
                  "type": "basic",
                  "name": "P",
                  "if": "{{sitemap_status?.data?.progress?.status === 'failed' && (sitemap_status?.data?.progress?.message ?? '') !== ''}}",
                  "props": {
                    "className": "text-red-600 dark:text-red-400 text-sm break-words"
                  },
                  "text": "{{sitemap_status?.data?.progress?.message ?? ''}}"
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "text-label-subtle text-xs"
                  },
                  "text": "{{sitemap_status?.data?.realtime_enabled === true ? $t('admin.settings.seo.sitemap_realtime_connected') : $t('admin.settings.seo.sitemap_polling')}}"
                }
              ]
            },
            {
              "id": "sitemap_last_updated_block",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "space-y-2"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Span",
                  "props": {
                    "className": "text-heading block"
                  },
                  "text": "$t:admin.settings.seo.sitemap_last_updated_at"
                },
                {
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex flex-col gap-2 md:flex-row md:items-center md:"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Input",
                      "props": {
                        "type": "text",
                        "disabled": true,
                        "value": "{{sitemap_status?.data?.last_updated_at ?? _local.form?.seo?.sitemap_last_updated_at ?? '-'}}",
                        "className": "md:flex-1 dark:bg-gray-900 text-gray-700 dark:text-gray-300"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "Button",
                      "props": {
                        "type": "button",
                        "disabled": "{{_computed.isReadOnly || ['queued','running','writing'].includes(sitemap_status?.data?.progress?.status ?? '')}}",
                        "className": "w-full md:w-auto px-4 py-2 bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 disabled:bg-gray-400 dark:disabled:bg-gray-600 text-white dark:text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap"
                      },
                      "text": "{{['queued','running','writing'].includes(sitemap_status?.data?.progress?.status ?? '') ? $t('admin.settings.seo.sitemap_regenerating') : $t('admin.settings.seo.sitemap_manual_update')}}",
                      "actions": [
                        {
                          "type": "click",
                          "handler": "apiCall",
                          "auth_required": true,
                          "target": "/api/admin/seo/sitemap/regenerate",
                          "params": {
                            "method": "POST"
                          },
                          "onSuccess": [
                            {
                              "handler": "refetchDataSource",
                              "params": {
                                "dataSourceId": "sitemap_status"
                              }
                            },
                            {
                              "handler": "toast",
                              "params": {
                                "type": "success",
                                "message": "{{$t('admin.settings.seo.sitemap_update_success')}}"
                              }
                            }
                          ],
                          "onError": [
                            {
                              "handler": "toast",
                              "params": {
                                "type": "error",
                                "message": "{{error.message ?? $t('admin.settings.seo.sitemap_update_failed')}}"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "props": {}
}
