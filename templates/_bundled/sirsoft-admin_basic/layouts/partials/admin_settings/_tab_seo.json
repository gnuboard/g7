    {
      "id": "card_og_twitter_settings",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "admin-card"
      },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": {
            "className": "card-title"
          },
          "text": "$t:admin.settings.seo.og_twitter_settings"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "card-description"
          },
          "text": "$t:admin.settings.seo.og_twitter_settings_desc"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "row-stack"
          },
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.og_default_site_name"
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "text",
                    "name": "seo.og_default_site_name",
                    "placeholder": "GNUBOARD.NET",
                    "disabled": "{{_computed.isReadOnly}}",
                    "className": ""
                  }
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.seo.og_default_site_name_hint"
                }
              ]
            },
            {
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "grid-2col"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Label",
                      "props": {
                        "className": "form-label"
                      },
                      "text": "$t:admin.settings.seo.og_image_default_width"
                    },
                    {
                      "type": "basic",
                      "name": "Input",
                      "props": {
                        "type": "number",
                        "name": "seo.og_image_default_width",
                        "min": "{{_local?.form?._meta?.limits?.seo_og_image_default_width_min ?? 0}}",
                        "max": "{{_local?.form?._meta?.limits?.seo_og_image_default_width_max ?? 8000}}",
                        "placeholder": "1200",
                        "disabled": "{{_computed.isReadOnly}}",
                        "className": ""
                      }
                    }
                  ]
                },
                {
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Label",
                      "props": {
                        "className": "form-label"
                      },
                      "text": "$t:admin.settings.seo.og_image_default_height"
                    },
                    {
                      "type": "basic",
                      "name": "Input",
                      "props": {
                        "type": "number",
                        "name": "seo.og_image_default_height",
                        "min": "{{_local?.form?._meta?.limits?.seo_og_image_default_height_min ?? 0}}",
                        "max": "{{_local?.form?._meta?.limits?.seo_og_image_default_height_max ?? 8000}}",
                        "placeholder": "630",
                        "disabled": "{{_computed.isReadOnly}}",
                        "className": ""
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "text-tertiary"
              },
              "text": "$t:admin.settings.seo.og_image_default_size_hint"
            },
            {
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.og_image_default"
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "text-tertiary mb-2"
                  },
                  "text": "$t:admin.settings.seo.og_image_default_desc"
                },
                {
                  "id": "og_image_default_uploader",
                  "type": "composite",
                  "name": "FileUploader",
                  "props": {
                    "collection": "og_image_default",
                    "disabled": "{{_computed.isReadOnly}}",
                    "maxFiles": 1,
                    "maxSize": "{{_global.settings?.upload?.max_file_size ?? _global.uploadSettings?.max_file_size ?? 10}}",
                    "accept": "{{_global.settings?.upload?.allowed_extensions_formatted ?? _global.uploadSettings?.allowed_extensions_formatted ?? '.jpg,.jpeg,.png,.gif,.svg,.webp'}}",
                    "imageCompression": {
                      "maxSizeMB": 1,
                      "maxWidthOrHeight": "{{_global.settings?.upload?.image_max_width ?? _global.uploadSettings?.image_max_width ?? 1200}}"
                    },
                    "initialFiles": "{{settings?.data?.seo?.og_image_default ?? []}}",
                    "autoUpload": false,
                    "uploadTriggerEvent": "upload:og_image_default",
                    "confirmBeforeRemove": true
                  },
                  "actions": [
                    {
                      "event": "onFilesChange",
                      "type": "change",
                      "if": "{{$args[0] && $args[0].length > 0}}",
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "hasChanges": true
                      }
                    },
                    {
                      "event": "onUploadComplete",
                      "type": "change",
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "hasChanges": true,
                        "form.seo.og_image_default": "{{[...(_local.form?.seo?.og_image_default ?? []), ...$args[0]]}}"
                      }
                    },
                    {
                      "event": "onUploadComplete",
                      "type": "custom",
                      "handler": "toast",
                      "params": {
                        "type": "success",
                        "message": "$t:attachment.upload_success"
                      }
                    },
                    {
                      "event": "onUploadError",
                      "type": "custom",
                      "handler": "toast",
                      "params": {
                        "type": "error",
                        "message": "{{$args[0]}}"
                      }
                    },
                    {
                      "event": "onRemove",
                      "type": "change",
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "hasChanges": true,
                        "form.seo.og_image_default": "{{(_local.form?.seo?.og_image_default ?? []).filter(item => (item.hash || item.id) !== $args[0])}}"
                      }
                    },
                    {
                      "event": "onRemove",
                      "type": "custom",
                      "handler": "toast",
                      "params": {
                        "type": "info",
                        "message": "$t:attachment.deleted"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.twitter_default_card"
                },
                {
                  "type": "basic",
                  "name": "Select",
                  "props": {
                    "name": "seo.twitter_default_card",
                    "disabled": "{{_computed.isReadOnly}}",
                    "options": [
                      {
                        "value": "summary_large_image",
                        "label": "summary_large_image"
                      },
                      {
                        "value": "summary",
                        "label": "summary"
                      },
                      {
                        "value": "app",
                        "label": "app"
                      },
                      {
                        "value": "player",
                        "label": "player"
                      }
                    ],
                    "className": ""
                  }
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.seo.twitter_default_card_hint"
                }
              ]
            },
            {
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.seo.twitter_default_site"
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "text",
                    "name": "seo.twitter_default_site",
                    "placeholder": "@gnuboard",
                    "disabled": "{{_computed.isReadOnly}}",
                    "className": ""
                  }
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.seo.twitter_default_site_hint"
                }
              ]
            }
          ]
        }
      ]
    },
