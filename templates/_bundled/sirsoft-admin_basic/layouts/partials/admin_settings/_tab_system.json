{
  "meta": {
    "is_partial": true,
    "description": "환경설정 시스템 탭 콘텐츠 (실행 방식 + 예약 작업 — W5)"
  },
  "id": "tab_content_system",
  "type": "basic",
  "name": "Div",
  "if": "{{(_global.activeSettingsTab || query.tab || 'general') === 'system'}}",
  "children": [
    {
      "id": "card_execution_mode",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "admin-card"
      },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": {
            "className": "card-title"
          },
          "text": "$t:admin.settings.system.execution_title"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "card-description"
          },
          "text": "$t:admin.settings.system.execution_desc"
        },
        {
          "id": "execution_status_box",
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 p-4 mb-4"
          },
          "children": [
            {
              "id": "execution_current_row",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex items-start gap-2"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Span",
                  "props": {
                    "className": "text-label-subtle min-w-[64px]"
                  },
                  "text": "$t:admin.settings.system.current"
                },
                {
                  "id": "execution_current_value",
                  "type": "basic",
                  "name": "Span",
                  "props": {
                    "className": "text-heading"
                  },
                  "text": "{{(_local.systemDetection ?? system_status?.data?.execution)?.effective_mode === 'inprocess' ? '$t:admin.settings.system.running_without_cli' : '$t:admin.settings.system.running_with_cli'}}"
                }
              ]
            },
            {
              "id": "execution_reason_row",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex items-start gap-2 mt-2"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Span",
                  "props": {
                    "className": "text-label-subtle min-w-[64px]"
                  },
                  "text": "$t:admin.settings.system.reason"
                },
                {
                  "id": "execution_reason_body",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex-1 min-w-0"
                  },
                  "children": [
                    {
                      "id": "execution_blocked_functions",
                      "type": "basic",
                      "name": "P",
                      "if": "{{((_local.systemDetection?.detection ?? system_status?.data?.execution?.detection)?.blocked_functions ?? []).length > 0}}",
                      "props": {
                        "className": "text-secondary text-xs"
                      },
                      "text": "{{'$t:admin.settings.system.blocked_functions' + ' ' + (((_local.systemDetection?.detection ?? system_status?.data?.execution?.detection)?.blocked_functions ?? []).join(', '))}}"
                    },
                    {
                      "id": "execution_probe_message",
                      "type": "basic",
                      "name": "P",
                      "if": "{{(_local.systemDetection?.detection ?? system_status?.data?.execution?.detection)?.php_probe?.message_localized}}",
                      "props": {
                        "className": "text-secondary text-xs mt-0.5"
                      },
                      "text": "{{(_local.systemDetection?.detection ?? system_status?.data?.execution?.detection)?.php_probe?.message_localized ?? ''}}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "field_execution_mode",
          "type": "basic",
          "name": "Div",
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex flex-wrap gap-3 items-start justify-between"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex-1 min-w-0"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Label",
                      "props": {
                        "className": "form-label"
                      },
                      "text": "$t:admin.settings.system.execution_mode"
                    },
                    {
                      "id": "execution_mode_radio",
                      "type": "composite",
                      "name": "RadioGroup",
                      "props": {
                        "name": "system.execution_mode",
                        "disabled": "{{_computed.isReadOnly}}",
                        "inline": false,
                        "options": [
                          {
                            "value": "auto",
                            "label": "$t:admin.settings.system.execution_mode_auto"
                          },
                          {
                            "value": "subprocess",
                            "label": "$t:admin.settings.system.execution_mode_subprocess"
                          },
                          {
                            "value": "inprocess",
                            "label": "$t:admin.settings.system.execution_mode_inprocess"
                          }
                        ]
                      }
                    },
                    {
                      "type": "basic",
                      "name": "P",
                      "props": {
                        "className": "form-hint"
                      },
                      "text": "$t:admin.settings.system.execution_mode_hint"
                    }
                  ]
                },
                {
                  "id": "execution_detect_button",
                  "type": "basic",
                  "name": "Button",
                  "props": {
                    "type": "button",
                    "className": "btn btn-secondary whitespace-nowrap",
                    "disabled": "{{_local.systemDetecting}}"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Icon",
                      "if": "{{_local.systemDetecting}}",
                      "props": {
                        "name": "spinner",
                        "className": "spinner-sm"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "text": "$t:admin.settings.system.detect_again"
                    }
                  ],
                  "actions": [
                    {
                      "type": "click",
                      "handler": "sequence",
                      "params": {
                        "actions": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "systemDetecting": true
                            }
                          },
                          {
                            "handler": "apiCall",
                            "auth_required": true,
                            "target": "/api/admin/settings/system/detect",
                            "params": {
                              "method": "POST"
                            },
                            "onSuccess": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "systemDetecting": false,
                                  "systemDetection": "{{result.data}}"
                                }
                              },
                              {
                                "handler": "toast",
                                "params": {
                                  "type": "success",
                                  "message": "$t:admin.settings.system.detect_done"
                                }
                              }
                            ],
                            "onError": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "systemDetecting": false
                                }
                              },
                              {
                                "handler": "toast",
                                "params": {
                                  "type": "error",
                                  "message": "{{error.message ?? '$t:admin.settings.system.detect_failed'}}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "card_scheduled_tasks",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "admin-card"
      },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": {
            "className": "card-title"
          },
          "text": "$t:admin.settings.system.cron_title"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "card-description"
          },
          "text": "$t:admin.settings.system.cron_desc"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "row-stack"
          },
          "children": [
            {
              "id": "field_cron_mode",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.system.cron_mode"
                },
                {
                  "id": "cron_mode_radio",
                  "type": "composite",
                  "name": "RadioGroup",
                  "props": {
                    "name": "system.cron_mode",
                    "disabled": "{{_computed.isReadOnly}}",
                    "inline": true,
                    "options": [
                      {
                        "value": "auto",
                        "label": "$t:admin.settings.system.cron_mode_auto"
                      },
                      {
                        "value": "web",
                        "label": "$t:admin.settings.system.cron_mode_web"
                      },
                      {
                        "value": "cron",
                        "label": "$t:admin.settings.system.cron_mode_cron"
                      },
                      {
                        "value": "both",
                        "label": "$t:admin.settings.system.cron_mode_both"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "field_cron_url",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.system.cron_url"
                },
                {
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex flex-wrap gap-2 items-center"
                  },
                  "children": [
                    {
                      "id": "cron_url_value",
                      "type": "basic",
                      "name": "Input",
                      "props": {
                        "type": "text",
                        "readOnly": true,
                        "autoBinding": false,
                        "className": "flex-1 min-w-[240px] font-mono text-xs",
                        "value": "{{_local.cronUrl ?? '$t:admin.settings.system.cron_url_masked'}}"
                      }
                    },
                    {
                      "id": "cron_url_actions",
                      "type": "basic",
                      "name": "Div",
                      "comment": "버튼 셋을 한 묶음으로 둔다 — 낱개로 두면 좁은 폭에서 「보기」만 주소칸 옆에 남고 나머지 둘이 다음 줄로 떨어져 한 벌의 조작이 두 줄로 찢어진다.",
                      "props": {
                        "className": "flex flex-wrap gap-2 items-center"
                      },
                      "children": [
                    {
                      "id": "cron_url_reveal_button",
                      "type": "basic",
                      "name": "Button",
                      "if": "{{!_computed.isReadOnly && !_local.cronUrl}}",
                      "props": {
                        "type": "button",
                        "className": "btn btn-secondary whitespace-nowrap",
                        "disabled": "{{_local.cronUrlRevealing}}"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Icon",
                          "if": "{{_local.cronUrlRevealing}}",
                          "props": {
                            "name": "spinner",
                            "className": "spinner-sm"
                          }
                        },
                        {
                          "type": "basic",
                          "name": "Span",
                          "text": "$t:admin.settings.system.cron_url_reveal"
                        }
                      ],
                      "actions": [
                        {
                          "type": "click",
                          "handler": "sequence",
                          "params": {
                            "actions": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "cronUrlRevealing": true
                                }
                              },
                              {
                                "handler": "apiCall",
                                "auth_required": true,
                                "target": "/api/admin/settings/system/cron-token",
                                "params": {
                                  "method": "GET"
                                },
                                "onSuccess": [
                                  {
                                    "handler": "setState",
                                    "params": {
                                      "target": "local",
                                      "cronUrlRevealing": false,
                                      "cronUrl": "{{result.data.url}}"
                                    }
                                  }
                                ],
                                "onError": [
                                  {
                                    "handler": "setState",
                                    "params": {
                                      "target": "local",
                                      "cronUrlRevealing": false
                                    }
                                  },
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "error",
                                      "message": "{{error.message ?? '$t:admin.settings.system.cron_url_failed'}}"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "id": "cron_url_copy_button",
                      "type": "basic",
                      "name": "Button",
                      "if": "{{!_computed.isReadOnly}}",
                      "props": {
                        "type": "button",
                        "className": "btn btn-secondary whitespace-nowrap",
                        "disabled": "{{_local.cronUrlCopying}}"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Icon",
                          "if": "{{_local.cronUrlCopying}}",
                          "props": {
                            "name": "spinner",
                            "className": "spinner-sm"
                          }
                        },
                        {
                          "type": "basic",
                          "name": "Span",
                          "text": "$t:common.copy"
                        }
                      ],
                      "actions": [
                        {
                          "type": "click",
                          "handler": "sequence",
                          "params": {
                            "actions": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "cronUrlCopying": true
                                }
                              },
                              {
                                "handler": "apiCall",
                                "auth_required": true,
                                "target": "/api/admin/settings/system/cron-token",
                                "params": {
                                  "method": "GET"
                                },
                                "onSuccess": [
                                  {
                                    "handler": "setState",
                                    "params": {
                                      "target": "local",
                                      "cronUrlCopying": false
                                    }
                                  },
                                  {
                                    "handler": "copyToClipboard",
                                    "params": {
                                      "text": "{{result.data.url}}"
                                    }
                                  },
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "success",
                                      "message": "$t:admin.settings.system.cron_url_copied"
                                    }
                                  }
                                ],
                                "onError": [
                                  {
                                    "handler": "setState",
                                    "params": {
                                      "target": "local",
                                      "cronUrlCopying": false
                                    }
                                  },
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "error",
                                      "message": "{{error.message ?? '$t:admin.settings.system.cron_url_failed'}}"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "id": "cron_token_rotate_button",
                      "type": "basic",
                      "name": "Button",
                      "if": "{{!_computed.isReadOnly}}",
                      "props": {
                        "type": "button",
                        "className": "btn btn-secondary whitespace-nowrap"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "text": "$t:admin.settings.system.cron_token_rotate"
                        }
                      ],
                      "actions": [
                        {
                          "type": "click",
                          "handler": "openModal",
                          "target": "cron_token_rotate_modal"
                        }
                      ]
                    }
                      ]
                    }
                  ]
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.system.cron_url_hint"
                }
              ]
            },
            {
              "id": "field_cron_allowed_ips",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.system.cron_allowed_ips"
                },
                {
                  "type": "basic",
                  "name": "Textarea",
                  "props": {
                    "name": "system.cron_allowed_ips",
                    "rows": 2,
                    "placeholder": "203.0.113.10\n2001:db8::/32",
                    "disabled": "{{_computed.isReadOnly}}",
                    "className": "resize-none font-mono text-xs"
                  }
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.system.cron_allowed_ips_hint"
                }
              ]
            },
            {
              "id": "field_cron_min_interval",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.system.cron_min_interval"
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "number",
                    "name": "system.cron_min_interval",
                    "min": "{{settings?.data?._meta?.limits?.system_cron_min_interval_min ?? 0}}",
                    "max": "{{settings?.data?._meta?.limits?.system_cron_min_interval_max ?? 1440}}",
                    "disabled": "{{_computed.isReadOnly}}",
                    "className": "max-w-[160px]"
                  }
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "form-hint"
                  },
                  "text": "$t:admin.settings.system.cron_min_interval_hint"
                }
              ]
            },
            {
              "id": "toggle_cron_visit_fallback",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex-between"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "props": {},
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "$t:admin.settings.system.cron_visit_fallback"
                    },
                    {
                      "type": "basic",
                      "name": "P",
                      "props": {
                        "className": "text-label-subtle"
                      },
                      "text": "$t:admin.settings.system.cron_visit_fallback_desc"
                    }
                  ]
                },
                {
                  "type": "composite",
                  "name": "Toggle",
                  "props": {
                    "name": "system.cron_visit_fallback",
                    "size": "md",
                    "disabled": "{{_computed.isReadOnly}}"
                  }
                }
              ]
            },
            {
              "id": "cron_last_run_box",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 p-4"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex flex-wrap gap-3 items-center justify-between"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Div",
                      "props": {
                        "className": "flex-1 min-w-0"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "props": {
                            "className": "text-label-subtle"
                          },
                          "text": "$t:admin.settings.system.cron_last_run"
                        },
                        {
                          "id": "cron_last_run_value",
                          "type": "basic",
                          "name": "P",
                          "if": "{{_local.cronLastRun ?? system_status?.data?.cron?.last_run}}",
                          "props": {
                            "className": "text-heading"
                          },
                          "comment": "서버는 ISO 8601(`2026-09-12T21:52:21+09:00`)을 준다. 화면에는 사이트 시간대의 날짜·시각만 남긴다 — `T` 와 오프셋이 그대로 보이면 운영자가 읽을 수 없는 문자열이 된다.",
                          "text": "{{(function () { const r = _local.cronLastRun ?? system_status?.data?.cron?.last_run; return String(r?.finished_at ?? '').replace('T', ' ').slice(0, 19) + ' · ' + (r?.duration_ms ?? 0) + 'ms · ' + (r?.executed ?? 0) + ' / ' + (r?.failed ?? 0); })()}}"
                        },
                        {
                          "id": "cron_last_run_empty",
                          "type": "basic",
                          "name": "P",
                          "if": "{{!(_local.cronLastRun ?? system_status?.data?.cron?.last_run)}}",
                          "props": {
                            "className": "text-secondary text-xs"
                          },
                          "text": "$t:admin.settings.system.cron_last_run_none"
                        },
                        {
                          "id": "cron_last_run_legend",
                          "type": "basic",
                          "name": "P",
                          "props": {
                            "className": "form-hint"
                          },
                          "text": "$t:admin.settings.system.cron_last_run_legend"
                        },
                        {
                          "comment": "상태 파일을 쓰지 못하면 점검 시각이 남지 않아 다음 호출의 소급 창이 상한까지 열리고 창 안의 예약이 매번 전부 다시 실행된다. 오류가 아니라 부하로만 나타나므로 여기서 사유를 알린다.",
                          "id": "cron_state_persist_failed",
                          "type": "basic",
                          "name": "P",
                          "if": "{{system_status?.data?.cron?.state_persist_failed}}",
                          "props": {
                            "className": "text-xs text-red-600 dark:text-red-400 mt-1"
                          },
                          "text": "$t:admin.settings.system.cron_state_persist_failed"
                        }
                      ]
                    },
                    {
                      "id": "cron_run_now_button",
                      "type": "basic",
                      "name": "Button",
                      "if": "{{!_computed.isReadOnly}}",
                      "props": {
                        "type": "button",
                        "className": "btn btn-secondary whitespace-nowrap",
                        "disabled": "{{_local.cronRunning}}"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Icon",
                          "if": "{{_local.cronRunning}}",
                          "props": {
                            "name": "spinner",
                            "className": "spinner-sm"
                          }
                        },
                        {
                          "type": "basic",
                          "name": "Span",
                          "text": "$t:admin.settings.system.cron_run_now"
                        }
                      ],
                      "actions": [
                        {
                          "type": "click",
                          "handler": "sequence",
                          "params": {
                            "actions": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "cronRunning": true
                                }
                              },
                              {
                                "handler": "apiCall",
                                "auth_required": true,
                                "target": "/api/admin/settings/system/cron/run",
                                "params": {
                                  "method": "POST"
                                },
                                "onSuccess": [
                                  {
                                    "handler": "setState",
                                    "params": {
                                      "target": "local",
                                      "cronRunning": false,
                                      "cronLastRun": "{{result.data}}"
                                    }
                                  },
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "success",
                                      "message": "$t:admin.settings.system.cron_run_done"
                                    }
                                  },
                                  {
                                    "handler": "refetchDataSource",
                                    "params": {
                                      "dataSourceId": "system_status"
                                    }
                                  }
                                ],
                                "onError": [
                                  {
                                    "handler": "setState",
                                    "params": {
                                      "target": "local",
                                      "cronRunning": false
                                    }
                                  },
                                  {
                                    "handler": "toast",
                                    "params": {
                                      "type": "error",
                                      "message": "{{error.message ?? '$t:admin.settings.system.cron_run_failed'}}"
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "comment": "실행 이력 (A-5). 위의 '마지막 실행'은 직전 1회만 담고 다음 호출에 덮이므로, 지난 실행을 되짚으려면 누적 목록이 따로 있어야 한다. 서버가 코드 예약 이력을 시각 역순으로 내려보낸다.",
                      "id": "cron_history_block",
                      "type": "basic",
                      "name": "Div",
                      "props": {
                        "className": "w-full mt-4 pt-4 border-t border-gray-200 dark:border-gray-700"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "props": {
                            "className": "text-label-subtle"
                          },
                          "text": "$t:admin.settings.system.cron_history"
                        },
                        {
                          "id": "cron_history_empty",
                          "type": "basic",
                          "name": "P",
                          "if": "{{!(system_status?.data?.cron?.recent_history?.length)}}",
                          "props": {
                            "className": "text-secondary text-xs mt-1"
                          },
                          "text": "$t:admin.settings.system.cron_history_none"
                        },
                        {
                          "id": "cron_history_list",
                          "type": "basic",
                          "name": "Div",
                          "if": "{{system_status?.data?.cron?.recent_history?.length}}",
                          "props": {
                            "className": "mt-2 max-h-[400px] overflow-y-auto"
                          },
                          "children": [
                            {
                              "id": "cron_history_row_{{$hidx}}",
                              "type": "basic",
                              "name": "Div",
                              "iteration": {
                                "source": "{{system_status?.data?.cron?.recent_history ?? []}}",
                                "item_var": "entry",
                                "index_var": "$hidx"
                              },
                              "comment": "좁은 폭에서는 이름 줄이 한 줄을 다 쓰고 시각·결과가 다음 줄로 내려간다 — 세 칸을 한 줄에 우겨 넣으면 이름이 두세 글자만 남는다.",
                              "props": {
                                "className": "flex flex-wrap items-start justify-between gap-x-3 gap-y-0.5 py-1 border-b border-gray-100 dark:border-gray-700"
                              },
                              "children": [
                                {
                                  "type": "basic",
                                  "name": "Div",
                                  "props": {
                                    "className": "w-full sm:w-auto sm:flex-1 min-w-0"
                                  },
                                  "children": [
                                    {
                                      "type": "basic",
                                      "name": "P",
                                      "props": {
                                        "className": "text-xs text-gray-900 dark:text-gray-100 truncate"
                                      },
                                      "text": "{{entry.name ?? ''}}"
                                    },
                                    {
                                      "type": "basic",
                                      "name": "P",
                                      "if": "{{entry.error_output}}",
                                      "props": {
                                        "className": "text-xs text-red-600 dark:text-red-400 truncate"
                                      },
                                      "text": "{{entry.error_output ?? ''}}"
                                    }
                                  ]
                                },
                                {
                                  "type": "basic",
                                  "name": "Span",
                                  "props": {
                                    "className": "text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap"
                                  },
                                  "text": "{{String(entry.started_at ?? '').replace('T', ' ').slice(0, 19) + ' · ' + (entry.duration ?? 0) + 's'}}"
                                },
                                {
                                  "type": "basic",
                                  "name": "Span",
                                  "props": {
                                    "className": "{{entry.status === 'failed' ? 'text-xs text-red-600 dark:text-red-400 whitespace-nowrap' : 'text-xs text-green-600 dark:text-green-400 whitespace-nowrap'}}"
                                  },
                                  "text": "{{entry.status === 'failed' ? '$t:admin.settings.system.cron_history_failed' : '$t:admin.settings.system.cron_history_success'}}"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
