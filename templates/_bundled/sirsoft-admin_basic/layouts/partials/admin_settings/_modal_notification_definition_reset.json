{
    "comment": "알림 정의를 기본값으로 되돌리는 확인 창 — 채널별로 고쳐 둔 템플릿이 사라진다.\n  본인인증 메시지 쪽 같은 이름 창과 같은 형태다(대상만 다르다).",
    "meta": {
        "is_partial": true,
        "description": "알림 정의 기본값 복원 확인 모달 (스피너 포함)",
        "editor_label": "$t:admin.modal_label.admin_settings.modal_notification_definition_reset"
    },
    "id": "modal_notification_definition_reset",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:admin.settings.notification_definitions.reset_modal.title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "P",
            "props": {
                "className": "text-gray-700 dark:text-gray-300"
            },
            "text": "$t:admin.settings.notification_definitions.reset_modal.confirm_message"
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "mt-4 p-3 bg-gray-100 dark:bg-gray-700 rounded-lg"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "form-sub-label"
                    },
                    "text": "$t:admin.settings.notification_definitions.reset_modal.target_label"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "text-primary font-medium"
                    },
                    "text": "{{_global.resetTargetName ?? ''}}"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "alert-danger"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-error-soft"
                    },
                    "text": "$t:admin.settings.notification_definitions.reset_modal.warning_message"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "modal-footer-buttons"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "closeModal",
                            "target": "modal_notification_definition_reset"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-secondary",
                        "disabled": "{{_global.isResettingNotification}}"
                    },
                    "text": "$t:common.cancel"
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "복원 실행 — 본인인증 메시지 쪽 복원 창과 같은 형태이고 대상 목록만 다르다.\n               성공하면 대상을 비우고 알림 정의 목록을 다시 받는다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isResettingNotification": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/admin/notification-definitions/{{_global.resetTargetId}}/reset",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isResettingNotification": false,
                                                "resetTargetId": null,
                                                "resetTargetName": ""
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "notificationDefinitions"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.settings.notification_definitions.reset_success"
                                            }
                                        },
                                        {
                                            "handler": "closeModal",
                                            "target": "modal_notification_definition_reset"
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isResettingNotification": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message ?? '$t:admin.settings.notification_definitions.reset_failed'}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "flex-center gap-2 px-4 py-2 bg-orange-600 dark:bg-orange-500 text-white rounded-lg hover:bg-orange-700 dark:hover:bg-orange-600 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isResettingNotification}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isResettingNotification}}",
                            "props": {
                                "name": "spinner",
                                "className": "spinner-sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isResettingNotification ? '$t:admin.settings.notification_definitions.reset_modal.btn_confirming' : '$t:admin.settings.notification_definitions.reset_modal.btn_confirm'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
