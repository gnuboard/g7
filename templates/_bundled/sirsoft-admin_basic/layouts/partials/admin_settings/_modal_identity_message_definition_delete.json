{
    "comment": "본인인증 메시지 정의 삭제 확인 창. **운영자가 추가한 정의만 지울 수 있다** — 코어가 들고 온 기본\n  정의는 목록에서 삭제 버튼이 나오지 않고, 그쪽은 \"기본값 복원\" 창이 짝이다.",
    "meta": {
        "is_partial": true,
        "description": "IDV 메시지 정의 삭제 확인 모달 — 운영자 추가 정의(scope_type=policy)만 표시",
        "editor_label": "$t:admin.modal_label.admin_settings.modal_identity_message_definition_delete"
    },
    "id": "modal_identity_message_definition_delete",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:admin.settings.identity.messages.delete_modal.title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "P",
            "props": {
                "className": "text-gray-700 dark:text-gray-300"
            },
            "text": "$t:admin.settings.identity.messages.delete_modal.confirm_message"
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "mt-4 p-3 bg-gray-100 dark:bg-gray-700 rounded-lg"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "form-sub-label"
                    },
                    "text": "$t:admin.settings.identity.messages.delete_modal.target_label"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "text-primary font-medium"
                    },
                    "text": "{{_global.deleteIdentityMessageTargetName ?? ''}}"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "alert-danger"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-error-soft"
                    },
                    "text": "$t:admin.settings.identity.messages.delete_modal.warning_message"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "modal-footer-buttons"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "closeModal",
                            "target": "modal_identity_message_definition_delete"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-secondary",
                        "disabled": "{{_global.isDeletingIdentityMessage}}"
                    },
                    "text": "$t:common.cancel"
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "삭제 실행. 성공하면 대상(id·이름)을 비우고 메시지 목록을 다시 받는다 —\n               대상을 남겨 두면 창을 다시 열었을 때 이미 없는 정의를 가리킨다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isDeletingIdentityMessage": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/admin/identity/messages/definitions/{{_global.deleteIdentityMessageTargetId}}",
                                    "auth_required": true,
                                    "params": {
                                        "method": "DELETE"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isDeletingIdentityMessage": false,
                                                "deleteIdentityMessageTargetId": null,
                                                "deleteIdentityMessageTargetName": ""
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "identityMessages"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.settings.identity.messages.delete_modal.delete_success"
                                            }
                                        },
                                        {
                                            "handler": "closeModal",
                                            "target": "modal_identity_message_definition_delete"
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isDeletingIdentityMessage": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message ?? '$t:admin.settings.identity.messages.delete_modal.delete_failed'}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "flex-center gap-2 px-4 py-2 bg-red-600 dark:bg-red-500 text-white rounded-lg hover:bg-red-700 dark:hover:bg-red-600 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isDeletingIdentityMessage}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isDeletingIdentityMessage}}",
                            "props": {
                                "name": "spinner",
                                "className": "spinner-sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isDeletingIdentityMessage ? '$t:admin.settings.identity.messages.delete_modal.btn_confirming' : '$t:admin.settings.identity.messages.delete_modal.btn_confirm'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
