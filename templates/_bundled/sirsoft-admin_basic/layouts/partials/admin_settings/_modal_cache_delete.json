{
    "comment": "캐시 비우기 확인 창(고급 탭). 값이 지워지는 것이 아니라 다시 만들어지는 것이지만, 큰 사이트에서는\n  잠시 느려질 수 있어 확인을 받는다.",
    "meta": {
        "is_partial": true,
        "editor_label": "$t:admin.modal_label.admin_settings.settings_cache_delete_modal",
        "description": "캐시 삭제 확인 모달"
    },
    "id": "settings_cache_delete_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:admin.settings.modals.cache_delete_title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "py-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-gray-700 dark:text-gray-300"
                    },
                    "text": "$t:admin.settings.modals.cache_delete_confirm"
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "mt-2 text-label-subtle"
                    },
                    "text": "$t:admin.settings.modals.cache_delete_warning"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "modal-footer-buttons"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "closeModal"
                        }
                    ],
                    "props": {
                        "className": "btn btn-secondary",
                        "disabled": "{{_global.isDeletingCache}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "캐시 비우기 실행. 화면에 보이는 값이 바뀌지 않으므로 어떤 소스도 다시 부르지 않는다 —\n               결과는 토스트 하나뿐이다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isDeletingCache": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/admin/settings/clear-cache",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isDeletingCache": false
                                            }
                                        },
                                        {
                                            "handler": "closeModal"
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.settings.cache_cleared"
                                            }
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isDeletingCache": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "flex-center gap-2 px-4 py-2 bg-red-600 dark:bg-red-500 text-white rounded-lg hover:bg-red-700 dark:hover:bg-red-600 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isDeletingCache}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isDeletingCache}}",
                            "props": {
                                "name": "spinner",
                                "className": "spinner-sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isDeletingCache ? '$t:admin.settings.modals.deleting' : '$t:admin.settings.modals.delete_cache'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
