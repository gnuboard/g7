{
  "meta": {
    "is_partial": true,
    "description": "환경설정 일반 탭 콘텐츠"
  },
  "id": "tab_content_general",
  "type": "basic",
  "name": "Div",
  "if": "{{(_global.activeSettingsTab || query.tab || 'general') === 'general'}}",
  "children": [
    {
      "id": "card_site_info",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "admin-card"
      },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": {
            "className": "card-title"
          },
          "text": "$t:admin.settings.general.site_info"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "card-description"
          },
          "text": "$t:admin.settings.general.site_info_desc"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "row-stack"
          },
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "grid-2col-responsive"
              },
              "children": [
                {
                  "id": "field_site_name",
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Label",
                      "props": {
                        "className": "form-label"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "text": "$t:admin.settings.general.site_name"
                        },
                        {
                          "type": "basic",
                          "name": "Span",
                          "props": {
                            "className": "text-red-500 ml-1"
                          },
                          "text": "*"
                        },
                        {
                          "type": "composite",
                          "name": "Badge",
                          "if": "{{_computed.envLocked?.['general.site_name'] === true}}",
                          "props": {
                            "text": "$t:admin.settings.env_locked_badge",
                            "variant": "secondary",
                            "size": "sm",
                            "className": "ml-2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "basic",
                      "name": "Input",
                      "props": {
                        "type": "text",
                        "name": "general.site_name",
                        "placeholder": "그누보드7",
                        "disabled": "{{_computed.isReadOnly || _computed.envLocked?.['general.site_name'] === true}}",
                        "className": "input {{_local.errors?.['general.site_name'] ? 'input-error' : ''}}"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "if": "{{_local.errors?.['general.site_name']}}",
                      "props": {
                        "className": "form-error"
                      },
                      "text": "{{_local.errors?.['general.site_name']?.[0] ?? ''}}"
                    }
                  ]
                },
                {
                  "id": "field_site_url",
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Label",
                      "props": {
                        "className": "form-label"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "text": "$t:admin.settings.general.site_url"
                        },
                        {
                          "type": "basic",
                          "name": "Span",
                          "props": {
                            "className": "text-red-500 ml-1"
                          },
                          "text": "*"
                        },
                        {
                          "type": "composite",
                          "name": "Badge",
                          "if": "{{_computed.envLocked?.['general.site_url'] === true}}",
                          "props": {
                            "text": "$t:admin.settings.env_locked_badge",
                            "variant": "secondary",
                            "size": "sm",
                            "className": "ml-2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "basic",
                      "name": "Input",
                      "props": {
                        "type": "url",
                        "name": "general.site_url",
                        "placeholder": "https://example.com",
                        "disabled": "{{_computed.isReadOnly || _computed.envLocked?.['general.site_url'] === true}}",
                        "className": "input {{_local.errors?.['general.site_url'] ? 'input-error' : ''}}"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "if": "{{_local.errors?.['general.site_url']}}",
                      "props": {
                        "className": "form-error"
                      },
                      "text": "{{_local.errors?.['general.site_url']?.[0] ?? ''}}"
                    }
                  ]
                }
              ]
            },
            {
              "id": "field_site_description",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.general.site_description"
                },
                {
                  "type": "basic",
                  "name": "Textarea",
                  "props": {
                    "name": "general.site_description",
                    "rows": 2,
                    "placeholder": "$t:admin.settings.general.site_description_placeholder",
                    "disabled": "{{_computed.isReadOnly}}",
                    "className": "input textarea-sm resize-none"
                  }
                }
              ]
            },
            {
              "id": "field_admin_email",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "text": "$t:admin.settings.general.admin_email"
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-red-500 ml-1"
                      },
                      "text": "*"
                    }
                  ]
                },
                {
                  "type": "basic",
                  "name": "Input",
                  "props": {
                    "type": "email",
                    "name": "general.admin_email",
                    "placeholder": "admin@example.com",
                    "disabled": "{{_computed.isReadOnly}}",
                    "className": "input {{_local.errors?.['general.admin_email'] ? 'input-error' : ''}}"
                  }
                },
                {
                  "type": "basic",
                  "name": "Span",
                  "if": "{{_local.errors?.['general.admin_email']}}",
                  "props": {
                    "className": "form-error"
                  },
                  "text": "{{_local.errors?.['general.admin_email']?.[0] ?? ''}}"
                }
              ]
            },
            {
              "id": "field_site_logo",
              "type": "basic",
              "name": "Div",
              "children": [
                {
                  "type": "basic",
                  "name": "Label",
                  "props": {
                    "className": "form-label"
                  },
                  "text": "$t:admin.settings.general.site_logo"
                },
                {
                  "type": "basic",
                  "name": "P",
                  "props": {
                    "className": "text-tertiary mb-2"
                  },
                  "text": "$t:admin.settings.general.site_logo_desc"
                },
                {
                  "id": "site_logo_uploader",
                  "type": "composite",
                  "name": "FileUploader",
                  "props": {
                    "collection": "site_logo",
                    "disabled": "{{_computed.isReadOnly}}",
                    "maxFiles": 5,
                    "maxSize": "{{_global.settings?.upload?.max_file_size ?? _global.uploadSettings?.max_file_size ?? 10}}",
                    "accept": "{{_global.settings?.upload?.allowed_extensions_formatted ?? _global.uploadSettings?.allowed_extensions_formatted ?? '.jpg,.jpeg,.png,.gif,.svg,.webp'}}",
                    "imageCompression": {
                      "maxSizeMB": 1,
                      "maxWidthOrHeight": "{{_global.settings?.upload?.image_max_width ?? _global.uploadSettings?.image_max_width ?? 800}}"
                    },
                    "initialFiles": "{{settings?.data?.general?.site_logo ?? []}}",
                    "autoUpload": false,
                    "uploadTriggerEvent": "upload:site_logo",
                    "confirmBeforeRemove": true
                  },
                  "actions": [
                    {
                      "event": "onFilesChange",
                      "type": "change",
                      "if": "{{$args[0] && $args[0].length > 0}}",
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "hasChanges": true
                      }
                    },
                    {
                      "event": "onUploadComplete",
                      "type": "change",
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "hasChanges": true,
                        "form.general.site_logo": "{{[...(_local.form?.general?.site_logo ?? []), ...$args[0]]}}"
                      }
                    },
                    {
                      "event": "onUploadComplete",
                      "type": "custom",
                      "handler": "toast",
                      "params": {
                        "type": "success",
                        "message": "$t:attachment.upload_success"
                      }
                    },
                    {
                      "event": "onUploadError",
                      "type": "custom",
                      "handler": "toast",
                      "params": {
                        "type": "error",
                        "message": "{{$args[0]}}"
                      }
                    },
                    {
                      "event": "onRemove",
                      "type": "change",
                      "handler": "setState",
                      "params": {
                        "target": "local",
                        "hasChanges": true,
                        "form.general.site_logo": "{{(_local.form?.general?.site_logo ?? []).filter(item => (item.hash || item.id) !== $args[0])}}"
                      }
                    },
                    {
                      "event": "onRemove",
                      "type": "custom",
                      "handler": "toast",
                      "params": {
                        "type": "info",
                        "message": "$t:attachment.deleted"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "card_localization",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "admin-card"
      },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": {
            "className": "card-title"
          },
          "text": "$t:admin.settings.general.localization"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "card-description"
          },
          "text": "$t:admin.settings.general.localization_desc"
        },
        {
          "type": "basic",
          "name": "Div",
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "grid-2col-responsive"
              },
              "children": [
                {
                  "id": "field_language",
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Label",
                      "props": {
                        "className": "form-label"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "text": "$t:admin.settings.general.default_language"
                        },
                        {
                          "type": "basic",
                          "name": "Span",
                          "props": {
                            "className": "text-red-500 ml-1"
                          },
                          "text": "*"
                        },
                        {
                          "type": "composite",
                          "name": "Badge",
                          "if": "{{_computed.envLocked?.['general.language'] === true}}",
                          "props": {
                            "text": "$t:admin.settings.env_locked_badge",
                            "variant": "secondary",
                            "size": "sm",
                            "className": "ml-2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "composite",
                      "name": "Select",
                      "props": {
                        "name": "general.language",
                        "className": "w-full",
                        "disabled": "{{_computed.isReadOnly || _computed.envLocked?.['general.language'] === true}}",
                        "placeholder": "$t:admin.settings.general.select_language",
                        "options": "{{(_global.appConfig?.supportedLocales ?? ['ko', 'en']).map(l => ({ value: l, label: _global.appConfig?.localeNames?.[l] ?? l }))}}",
                        "error": "{{_local.errors?.['general.language']?.[0] ?? ''}}"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "if": "{{_local.errors?.['general.language']}}",
                      "props": {
                        "className": "form-error"
                      },
                      "text": "{{_local.errors?.['general.language']?.[0] ?? ''}}"
                    }
                  ]
                },
                {
                  "id": "field_timezone",
                  "type": "basic",
                  "name": "Div",
                  "children": [
                    {
                      "type": "basic",
                      "name": "Label",
                      "props": {
                        "className": "form-label"
                      },
                      "children": [
                        {
                          "type": "basic",
                          "name": "Span",
                          "text": "$t:admin.settings.general.timezone"
                        },
                        {
                          "type": "basic",
                          "name": "Span",
                          "props": {
                            "className": "text-red-500 ml-1"
                          },
                          "text": "*"
                        },
                        {
                          "type": "composite",
                          "name": "Badge",
                          "if": "{{_computed.envLocked?.['general.timezone'] === true}}",
                          "props": {
                            "text": "$t:admin.settings.env_locked_badge",
                            "variant": "secondary",
                            "size": "sm",
                            "className": "ml-2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "composite",
                      "name": "Select",
                      "props": {
                        "name": "general.timezone",
                        "className": "w-full",
                        "disabled": "{{_computed.isReadOnly || _computed.envLocked?.['general.timezone'] === true}}",
                        "placeholder": "$t:admin.settings.general.select_timezone",
                        "options": "{{_global.appConfig?.supportedTimezones ?? []}}",
                        "searchable": true,
                        "searchPlaceholder": "{{$t('common.search')}}",
                        "error": "{{_local.errors?.['general.timezone']?.[0] ?? ''}}"
                      }
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "if": "{{_local.errors?.['general.timezone']}}",
                      "props": {
                        "className": "form-error"
                      },
                      "text": "{{_local.errors?.['general.timezone']?.[0] ?? ''}}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "card_asset_serving",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "admin-card"
      },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": {
            "className": "card-title"
          },
          "text": "$t:admin.settings.general.asset_url_mode"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "card-description"
          },
          "text": "$t:admin.settings.general.asset_url_mode_help"
        },
        {
          "id": "field_asset_url_mode",
          "type": "basic",
          "name": "Div",
          "children": [
            {
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex gap-2 items-start"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex-1"
                  },
                  "children": [
                    {
                      "type": "composite",
                      "name": "Select",
                      "props": {
                        "name": "general.asset_url_mode",
                        "className": "w-full",
                        "disabled": "{{_computed.isReadOnly}}",
                        "options": [
                          {
                            "value": "extension",
                            "label": "$t:admin.settings.general.asset_url_mode_extension"
                          },
                          {
                            "value": "extensionless",
                            "label": "$t:admin.settings.general.asset_url_mode_extensionless"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "asset_url_mode_detect_button",
                  "type": "basic",
                  "name": "Button",
                  "props": {
                    "type": "button",
                    "className": "btn btn-secondary whitespace-nowrap",
                    "disabled": "{{_computed.isReadOnly}}"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "text": "$t:admin.settings.general.asset_url_mode_detect"
                    }
                  ],
                  "actions": [
                    {
                      "event": "onClick",
                      "handler": "detectAssetUrlMode"
                    }
                  ]
                }
              ]
            },
            {
              "id": "asset_url_mode_msg_detecting",
              "type": "basic",
              "name": "P",
              "if": "{{_local.asset_url_mode_detect_status === 'detecting'}}",
              "props": {
                "className": "mt-2 text-sm text-gray-500 dark:text-gray-400"
              },
              "text": "$t:admin.settings.general.asset_url_mode_detecting"
            },
            {
              "id": "asset_url_mode_msg_extension",
              "type": "basic",
              "name": "P",
              "if": "{{_local.asset_url_mode_detect_status === 'extension'}}",
              "props": {
                "className": "mt-2 text-sm text-green-600 dark:text-green-400"
              },
              "text": "$t:admin.settings.general.asset_url_mode_detect_extension"
            },
            {
              "id": "asset_url_mode_msg_extensionless",
              "type": "basic",
              "name": "P",
              "if": "{{_local.asset_url_mode_detect_status === 'extensionless'}}",
              "props": {
                "className": "mt-2 text-sm text-amber-600 dark:text-amber-400"
              },
              "text": "$t:admin.settings.general.asset_url_mode_detect_extensionless"
            },
            {
              "id": "asset_url_mode_msg_unavailable",
              "type": "basic",
              "name": "P",
              "if": "{{_local.asset_url_mode_detect_status === 'unavailable'}}",
              "props": {
                "className": "mt-2 text-sm text-red-600 dark:text-red-400"
              },
              "text": "$t:admin.settings.general.asset_url_mode_detect_unavailable"
            }
          ]
        }
      ]
    },
    {
      "id": "card_static_cache",
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "admin-card"
      },
      "children": [
        {
          "type": "basic",
          "name": "H3",
          "props": {
            "className": "card-title"
          },
          "text": "$t:admin.settings.general.static_cache_title"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "card-description"
          },
          "text": "$t:admin.settings.general.static_cache_description"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "row-stack"
          },
          "children": [
            {
              "id": "static_cache_summary_row",
              "type": "basic",
              "name": "Div",
              "props": {
                "className": "flex flex-wrap items-center gap-x-6 gap-y-2"
              },
              "children": [
                {
                  "id": "static_cache_status_row",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex items-center gap-2"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label"
                      },
                      "text": "$t:admin.settings.general.static_cache_status"
                    },
                    {
                      "id": "static_cache_status_badge",
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium",
                        "classMap": {
                          "key": "{{staticCacheStatus?.data?.enabled === false ? 'disabled' : (staticCacheStatus?.data?.publishable !== true ? 'dev_mode' : (staticCacheStatus?.data?.published ? 'published' : 'unpublished'))}}",
                          "variants": {
                            "published": "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300",
                            "unpublished": "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300",
                            "disabled": "bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300",
                            "dev_mode": "bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300"
                          }
                        }
                      },
                      "children": [
                        {
                          "id": "static_cache_status_text_disabled",
                          "type": "basic",
                          "name": "Span",
                          "if": "{{staticCacheStatus?.data?.enabled === false}}",
                          "text": "$t:admin.settings.general.static_cache_status_disabled"
                        },
                        {
                          "id": "static_cache_status_text_dev_mode",
                          "type": "basic",
                          "name": "Span",
                          "if": "{{!!staticCacheStatus?.data && staticCacheStatus?.data?.enabled !== false && staticCacheStatus?.data?.publishable !== true}}",
                          "text": "$t:admin.settings.general.static_cache_status_dev_mode"
                        },
                        {
                          "id": "static_cache_status_text_published",
                          "type": "basic",
                          "name": "Span",
                          "if": "{{staticCacheStatus?.data?.publishable === true && !!staticCacheStatus?.data?.published}}",
                          "text": "$t:admin.settings.general.static_cache_status_published"
                        },
                        {
                          "id": "static_cache_status_text_unpublished",
                          "type": "basic",
                          "name": "Span",
                          "if": "{{staticCacheStatus?.data?.publishable === true && !staticCacheStatus?.data?.published}}",
                          "text": "$t:admin.settings.general.static_cache_status_unpublished"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "static_cache_version_row",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex items-center gap-2"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label"
                      },
                      "text": "$t:admin.settings.general.static_cache_version"
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "{{Number(staticCacheStatus?.data?.version ?? 0) > 0 ? staticCacheStatus?.data?.version : '-'}}"
                    }
                  ]
                },
                {
                  "id": "static_cache_files_row",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex items-center gap-2"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label"
                      },
                      "text": "$t:admin.settings.general.static_cache_files"
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "{{staticCacheStatus?.data?.published ? Number(staticCacheStatus?.data?.files ?? 0).toLocaleString() : '-'}}"
                    }
                  ]
                },
                {
                  "id": "static_cache_published_at_row",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex items-center gap-2"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label"
                      },
                      "text": "$t:admin.settings.general.static_cache_published_at"
                    },
                    {
                      "id": "static_cache_published_at_value",
                      "type": "basic",
                      "name": "Span",
                      "if": "{{!!staticCacheStatus?.data?.published_at}}",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "{{staticCacheStatus.data.published_at | datetime('YYYY-MM-DD HH:mm:ss')}}"
                    },
                    {
                      "id": "static_cache_published_at_never",
                      "type": "basic",
                      "name": "Span",
                      "if": "{{!staticCacheStatus?.data?.published_at}}",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "$t:admin.settings.general.static_cache_never"
                    }
                  ]
                },
                {
                  "id": "static_cache_process_user_row",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "flex items-center gap-2"
                  },
                  "children": [
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-label"
                      },
                      "text": "$t:admin.settings.general.static_cache_process_user"
                    },
                    {
                      "type": "basic",
                      "name": "Span",
                      "props": {
                        "className": "text-heading"
                      },
                      "text": "{{staticCacheStatus?.data?.process_user ?? '-'}}"
                    }
                  ]
                },
                {
                  "id": "static_cache_actions",
                  "type": "basic",
                  "name": "Div",
                  "props": {
                    "className": "ml-auto"
                  },
                  "children": [
                    {
                      "id": "static_cache_republish_button",
                      "type": "basic",
                      "name": "Button",
                      "props": {
                        "type": "button",
                        "disabled": "{{_computed.isReadOnly || !(staticCacheStatus?.data?.publishable ?? false)}}",
                        "aria-disabled": "{{_computed.isReadOnly || !(staticCacheStatus?.data?.publishable ?? false)}}",
                        "className": "px-4 py-2 bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 disabled:bg-gray-400 dark:disabled:bg-gray-600 text-white dark:text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap"
                      },
                      "text": "$t:admin.settings.general.static_cache_republish_now",
                      "actions": [
                        {
                          "type": "click",
                          "handler": "openModal",
                          "target": "settings_static_cache_republish_modal"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "static_cache_failure_row",
              "type": "basic",
              "name": "Div",
              "if": "{{!!staticCacheStatus?.data?.failure}}",
              "props": {
                "className": "form-hint text-red-600 dark:text-red-400 break-words"
              },
              "children": [
                {
                  "type": "basic",
                  "name": "Span",
                  "text": "$t:admin.settings.general.static_cache_failure|count={{staticCacheStatus?.data?.failure?.count ?? 0}}"
                },
                {
                  "type": "basic",
                  "name": "Span",
                  "text": " "
                },
                {
                  "id": "static_cache_failure_reason_parent_not_writable",
                  "type": "basic",
                  "name": "Span",
                  "if": "{{staticCacheStatus?.data?.failure?.reason === 'parent_not_writable'}}",
                  "text": "$t:admin.settings.general.static_cache_failure_parent_not_writable"
                },
                {
                  "id": "static_cache_failure_reason_lock_unavailable",
                  "type": "basic",
                  "name": "Span",
                  "if": "{{staticCacheStatus?.data?.failure?.reason === 'lock_unavailable'}}",
                  "text": "$t:admin.settings.general.static_cache_failure_lock_unavailable"
                },
                {
                  "id": "static_cache_failure_reason_write_failed",
                  "type": "basic",
                  "name": "Span",
                  "if": "{{!['parent_not_writable', 'lock_unavailable'].includes(staticCacheStatus?.data?.failure?.reason ?? '')}}",
                  "text": "$t:admin.settings.general.static_cache_failure_write_failed"
                }
              ]
            },
            {
              "id": "static_cache_not_publishable_hint",
              "type": "basic",
              "name": "Div",
              "if": "{{!!staticCacheStatus?.data && staticCacheStatus?.data?.publishable !== true}}",
              "props": {
                "className": "form-hint"
              },
              "children": [
                {
                  "id": "static_cache_hint_disabled",
                  "type": "basic",
                  "name": "Span",
                  "if": "{{staticCacheStatus?.data?.enabled === false}}",
                  "text": "$t:admin.settings.general.static_cache_hint_disabled"
                },
                {
                  "id": "static_cache_hint_dev_mode",
                  "type": "basic",
                  "name": "Span",
                  "if": "{{staticCacheStatus?.data?.enabled !== false}}",
                  "text": "$t:admin.settings.general.static_cache_hint_dev_mode"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
