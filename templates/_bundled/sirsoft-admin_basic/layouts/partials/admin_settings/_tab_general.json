                                            "props": {
                                                "className": "form-label"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:admin.settings.general.site_name"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-red-500 ml-1"
                                                    },
                                                    "text": "*"
                                                },
                                                {
                                                    "type": "composite",
                                                    "name": "Badge",
                                                    "if": "{{_computed.envLocked?.['general.site_name'] === true}}",
                                                    "props": {
                                                        "text": "$t:admin.settings.env_locked_badge",
                                                        "variant": "secondary",
                                                        "size": "sm",
                                                        "className": "ml-2"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "props": {
                                                "type": "text",
                                                "name": "general.site_name",
                                                "placeholder": "그누보드7",
                                                "disabled": "{{_computed.isReadOnly || _computed.envLocked?.['general.site_name'] === true}}",
                                                "className": "input {{_local.errors?.['general.site_name'] ? 'input-error' : ''}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{_local.errors?.['general.site_name']}}",
                                            "props": {
                                                "className": "form-error"
                                            },
                                            "text": "{{_local.errors?.['general.site_name']?.[0] ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "field_site_url",
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Label",
                                            "props": {
                                                "className": "form-label"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "text": "$t:admin.settings.general.site_url"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-red-500 ml-1"
                                                    },
                                                    "text": "*"
                                                },
                                                {
                                                    "type": "composite",
                                                    "name": "Badge",
                                                    "if": "{{_computed.envLocked?.['general.site_url'] === true}}",
                                                    "props": {
                                                        "text": "$t:admin.settings.env_locked_badge",
                                                        "variant": "secondary",
                                                        "size": "sm",
                                                        "className": "ml-2"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Input",
                                            "props": {
                                                "type": "url",
                                                "name": "general.site_url",
                                                "placeholder": "https://example.com",
                                                "disabled": "{{_computed.isReadOnly || _computed.envLocked?.['general.site_url'] === true}}",
                                                "className": "input {{_local.errors?.['general.site_url'] ? 'input-error' : ''}}"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{_local.errors?.['general.site_url']}}",
                                            "props": {
                                                "className": "form-error"
                                            },
                                            "text": "{{_local.errors?.['general.site_url']?.[0] ?? ''}}"
                                        }
                                    ]
                                }
                            ]
