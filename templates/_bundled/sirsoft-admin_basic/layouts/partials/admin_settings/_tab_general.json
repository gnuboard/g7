                        {
                            "id": "field_site_description",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:admin.settings.general.site_description"
                                },
                                {
                                    "type": "basic",
                                    "name": "Textarea",
                                    "props": {
                                        "name": "general.site_description",
                                        "rows": 2,
                                        "placeholder": "$t:admin.settings.general.site_description_placeholder",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "className": "input textarea-sm resize-none"
                                    }
                                }
                            ]
                        },
                        {
                            "id": "field_admin_email",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "text": "$t:admin.settings.general.admin_email"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-red-500 ml-1"
                                            },
                                            "text": "*"
                                        }
                                    ]
                                },
                                {
                                    "type": "basic",
                                    "name": "Input",
                                    "props": {
                                        "type": "email",
                                        "name": "general.admin_email",
                                        "placeholder": "admin@example.com",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "className": "input {{_local.errors?.['general.admin_email'] ? 'input-error' : ''}}"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "if": "{{_local.errors?.['general.admin_email']}}",
                                    "props": {
                                        "className": "form-error"
                                    },
                                    "text": "{{_local.errors?.['general.admin_email']?.[0] ?? ''}}"
                                }
                            ]
                        },
                        {
                            "id": "field_site_logo",
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Label",
                                    "props": {
                                        "className": "form-label"
                                    },
                                    "text": "$t:admin.settings.general.site_logo"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-tertiary mb-2"
                                    },
                                    "text": "$t:admin.settings.general.site_logo_desc"
                                },
                                {
                                    "id": "site_logo_uploader",
                                    "type": "composite",
                                    "name": "FileUploader",
                                    "actions": [
                                        {
                                            "comment": "파일을 고른 것만으로 **아직 올라가지 않는다**(`autoUpload=false`) — 저장 버튼이 보내는\n                   신호를 받아야 올린다. 여기서는 \"고친 것이 있다\" 표시만 켜 저장 버튼을 풀어 준다.\n                   고른 파일이 없어지는 경우까지 표시를 켜지 않도록 조건을 단다.",
                                            "type": "change",
                                            "event": "onFilesChange",
                                            "handler": "setState",
                                            "if": "{{$args[0] && $args[0].length > 0}}",
                                            "params": {
                                                "target": "local",
                                                "hasChanges": true
                                            }
                                        },
                                        {
                                            "comment": "업로드가 끝나면 올라간 파일을 폼 값에 **덧붙인다**(덮어쓰지 않는다) — 이미 있던 로고를\n                   남긴 채 새 것을 더하는 화면이라 그렇다.",
                                            "type": "change",
                                            "event": "onUploadComplete",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "hasChanges": true,
                                                "form.general.site_logo": "{{[...(_local.form?.general?.site_logo ?? []), ...$args[0]]}}"
                                            }
                                        },
                                        {
                                            "comment": "같은 완료 이벤트를 **두 번 받는다** — 위는 값 갱신, 여기는 알림.\n                   갈라 둔 것은 값 갱신이 실패해도 알림이 뜨지 않게 하려는 것이 아니라, 한 블록에\n                   섞으면 어느 쪽이 화면 표시이고 어느 쪽이 상태 변경인지 읽기 어렵기 때문이다.",
                                            "type": "custom",
                                            "event": "onUploadComplete",
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:attachment.upload_success"
                                            }
                                        },
                                        {
                                            "comment": "업로드 실패 — 업로더가 준 문구를 그대로 띄운다(크기·확장자 제한은 업로드 탭이 정한다).",
                                            "type": "custom",
                                            "event": "onUploadError",
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{$args[0]}}"
                                            }
                                        },
                                        {
                                            "comment": "뺀 파일을 폼 값에서도 걸러 낸다 — 화면에서만 사라지고 저장 값에 남으면 다음 저장에\n                   되살아난다. 실제 삭제는 저장 시점에 정해진다.",
                                            "type": "change",
                                            "event": "onRemove",
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "hasChanges": true,
                                                "form.general.site_logo": "{{(_local.form?.general?.site_logo ?? []).filter(item => (item.hash || item.id) !== $args[0])}}"
                                            }
                                        },
                                        {
                                            "comment": "위 제거와 같은 이벤트의 알림 몫이다(완료 이벤트를 둘로 나눈 것과 같은 이유).",
                                            "type": "custom",
                                            "event": "onRemove",
                                            "handler": "toast",
                                            "params": {
                                                "type": "info",
                                                "message": "$t:attachment.deleted"
                                            }
                                        }
                                    ],
                                    "props": {
                                        "collection": "site_logo",
                                        "disabled": "{{_computed.isReadOnly}}",
                                        "maxFiles": 5,
                                        "maxSize": "{{_global.settings?.upload?.max_file_size ?? _global.uploadSettings?.max_file_size ?? 10}}",
                                        "accept": "{{_global.settings?.upload?.allowed_extensions_formatted ?? _global.uploadSettings?.allowed_extensions_formatted ?? '.jpg,.jpeg,.png,.gif,.svg,.webp'}}",
                                        "initialFiles": "{{settings?.data?.general?.site_logo ?? []}}",
                                        "autoUpload": false,
                                        "uploadTriggerEvent": "upload:site_logo",
                                        "confirmBeforeRemove": true,
                                        "imageCompression": {
                                            "maxSizeMB": 1,
                                            "maxWidthOrHeight": "{{_global.settings?.upload?.image_max_width ?? _global.uploadSettings?.image_max_width ?? 800}}"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
