        },
        {
            "id": "card_content_media_ttl",
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "admin-card"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "card-title"
                    },
                    "text": "$t:admin.settings.content.ttl.title"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "card-description"
                    },
                    "text": "$t:admin.settings.content.ttl.description"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex-center gap-2"
                    },
                    "children": [
                        {
                            "comment": "audit:allow layout-input-boundary-hardcoded 코어 ContentMediaUrlRewriter 고정 범위(5~1440분) — 저장 규칙 SaveSettingsRequest 가 같은 범위다",
                            "type": "basic",
                            "name": "Input",
                            "props": {
                                "type": "number",
                                "name": "content.media_url_ttl_minutes",
                                "aria-label": "$t:admin.settings.content.ttl.title",
                                "min": "5",
                                "max": "1440",
                                "disabled": "{{_computed.isReadOnly}}",
                                "className": "input w-28"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "props": {
                                "className": "text-label-subtle"
                            },
                            "text": "$t:admin.settings.content.ttl.unit"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "if": "{{_local.errors?.['content.media_url_ttl_minutes']}}",
                    "props": {
                        "className": "form-error"
                    },
                    "text": "{{_local.errors?.['content.media_url_ttl_minutes']?.[0] ?? ''}}"
                }
            ]
        }
    ]
}
