                                                            "comment": "사용 여부만 뒤집는다 — 지우지 않고 잠시 끄는 자리",
                                                            "type": "change",
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "form.content.embed_custom_providers": "{{(_local.form?.content?.embed_custom_providers ?? []).map((p, i) => i === idx ? {...p, enabled: !(p.enabled !== false)} : p)}}",
                                                                "hasChanges": true
                                                            }
                                                        }
                                                    ],
                                                    "props": {
                                                        "ariaLabel": "$t:common.row_cell|row={{provider.name ?? ''}}|column={{$t('admin.settings.content.embed.enabled')}}",
                                                        "checked": "{{provider.enabled !== false}}",
                                                        "size": "sm",
                                                        "disabled": "{{_computed.isReadOnly}}"
                                                    }
