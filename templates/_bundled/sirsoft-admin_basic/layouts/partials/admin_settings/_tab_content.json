                                                    "name": "Button",
                                                    "actions": [
                                                        {
                                                            "comment": "삭제 — 폼에서만 뺀다(저장 전이라 하단 「취소」로 되돌릴 수 있다)",
                                                            "type": "click",
                                                            "handler": "setState",
                                                            "params": {
                                                                "target": "local",
                                                                "form.content.embed_custom_providers": "{{(_local.form?.content?.embed_custom_providers ?? []).filter((p, i) => i !== idx)}}",
                                                                "hasChanges": true
                                                            }
                                                        }
