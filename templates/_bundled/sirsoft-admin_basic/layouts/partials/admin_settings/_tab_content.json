                                                                                "name": "{{provider.name ?? ''}}",
                                                                                "url_patterns_text": "{{(provider.url_patterns ?? []).join('\\n')}}",
                                                                                "player_url": "{{provider.player_url ?? ''}}",
                                                                                "id_rule": "{{provider.id_rule ?? 'alnum_dash'}}",
                                                                                "aspect": "{{provider.aspect ?? '16:9'}}",
                                                                                "allow": "{{provider.allow ?? ['fullscreen', 'encrypted-media', 'picture-in-picture']}}",
                                                                                "enabled": "{{provider.enabled !== false}}"
                                                                            },
                                                                            "sample_url": "",
                                                                            "preview": null,
                                                                            "row_index": "{{idx}}",
                                                                            "providers": "{{_local.form?.content?.embed_custom_providers ?? []}}",
                                                                            "error": null
