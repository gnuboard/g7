{
    "meta": {
        "is_partial": true,
        "editor_label": "$t:admin.modal_label.admin_settings.settings_password_confirm_modal",
        "description": "앱 키 재생성 비밀번호 확인 모달"
    },
    "id": "settings_password_confirm_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:admin.settings.modals.password_confirm_title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "py-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "alert-warning"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "triangle-exclamation",
                                "className": "text-xl text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-warning-soft"
                            },
                            "text": "$t:admin.settings.modals.app_key_warning"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                        "className": "form-label"
                    },
                    "text": "$t:admin.settings.modals.enter_password"
                },
                {
                    "type": "basic",
                    "name": "Input",
                    "actions": [
                        {
                            "type": "change",
                            "handler": "setState",
                            "params": {
                                "target": "global",
                                "appKeyPassword": "{{$event.target.value}}"
                            }
                        }
                    ],
                    "props": {
                        "type": "password",
                        "placeholder": "$t:admin.settings.modals.password_placeholder",
                        "className": "input"
                    }
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "modal-footer-buttons"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "appKeyPassword": ""
                                    }
                                },
                                {
                                    "handler": "closeModal"
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "btn btn-secondary",
                        "disabled": "{{_global.isRegeneratingKey}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isRegeneratingKey": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/admin/settings/regenerate-app-key",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST",
                                        "body": {
                                            "password": "{{_global.appKeyPassword}}"
                                        }
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isRegeneratingKey": false,
                                                "appKeyPassword": ""
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.settings.app_key_regenerated"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "appKey"
                                            }
                                        },
                                        {
                                            "handler": "closeModal"
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isRegeneratingKey": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "flex-center gap-2 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isRegeneratingKey || !_global.appKeyPassword}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isRegeneratingKey}}",
                            "props": {
                                "name": "spinner",
                                "className": "spinner-sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isRegeneratingKey ? '$t:admin.settings.modals.regenerating' : '$t:admin.settings.modals.regenerate'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
