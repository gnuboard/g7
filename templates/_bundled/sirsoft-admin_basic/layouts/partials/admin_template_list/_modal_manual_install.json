{
    "comment": "목록에 없는 템플릿을 들이는 창 — 압축 파일과 GitHub 주소 두 갈래를 탭으로 가른다.\n  탭 하나가 주소·전송 형식·요청 본문 셋을 함께 정하고, 오류는 전체 메시지와 필드별로 나눠 보여 준다.\n  탭을 옮기거나 값을 고치면 오류를 지운다. 모듈 수동 설치 창과 같은 형태다.",
    "meta": {
        "is_partial": true,
        "description": "템플릿 수동 설치 모달",
        "editor_label": "$t:admin.modal_label.admin_template_list.template_manual_install_modal"
    },
    "id": "template_manual_install_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:admin.templates.modals.manual_install_title",
        "size": "medium"
    },
    "children": [
        {
            "type": "basic",
            "name": "P",
            "props": {
                "className": "text-secondary mb-4"
            },
            "text": "$t:admin.templates.modals.manual_install_description"
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "mb-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "event": "onClick",
                            "handler": "openModal",
                            "target": "template_manifest_preview_drawer"
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-indigo-700 dark:text-indigo-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 rounded-md"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "fas fa-eye",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:admin.templates.actions.preview_manifest"
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{_global.templateInstallError}}",
            "props": {
                "className": "alert-danger"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "form-error-xs"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "triangle-exclamation",
                                "className": "text-red-500 mt-0.5",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-error-strong"
                                    },
                                    "text": "{{_global.templateInstallError}}"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{_global.templateInstallErrors?.error}}",
                                    "props": {
                                        "className": "text-error-soft mt-1 whitespace-pre-line"
                                    },
                                    "text": "{{_global.templateInstallErrors.error}}"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "template_install_tabs",
            "type": "composite",
            "name": "TabNavigation",
            "actions": [
                {
                    "comment": "갈래 전환 — 오류만 지운다(입력값은 남아 탭을 오가도 고른 것이 유지된다).",
                    "type": "change",
                    "event": "onTabChange",
                    "handler": "setState",
                    "params": {
                        "target": "global",
                        "templateInstallTab": "{{$args[0]}}",
                        "templateInstallError": null,
                        "templateInstallErrors": null
                    }
                }
            ],
            "props": {
                "activeTabId": "{{_global.templateInstallTab || 'file_upload'}}",
                "variant": "underline",
                "tabs": [
                    {
                        "id": "file_upload",
                        "label": "$t:admin.templates.tabs.file_upload",
                        "iconName": "upload"
                    },
                    {
                        "id": "github",
                        "label": "$t:admin.templates.tabs.github",
                        "iconName": "code-branch"
                    }
                ]
            }
        },
        {
            "id": "template_file_upload_tab",
            "type": "basic",
            "name": "Div",
            "if": "{{!_global.templateInstallTab || _global.templateInstallTab === 'file_upload'}}",
            "props": {
                "className": "mt-4 space-y-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "form-label"
                            },
                            "text": "$t:admin.templates.tabs.file_label"
                        },
                        {
                            "type": "basic",
                            "name": "FileInput",
                            "actions": [
                                {
                                    "comment": "파일 선택 — 객체(요청용)와 이름(표시용)을 나눠 담고 지난 오류를 지운다.",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "templateUploadFile": "{{$event.target.value}}",
                                        "templateUploadFileName": "{{$event.target.value?.name}}",
                                        "templateInstallError": null,
                                        "templateInstallErrors": null
                                    }
                                }
                            ],
                            "props": {
                                "accept": ".zip",
                                "className": "{{_global.templateInstallErrors?.file ? 'w-full border-red-500 dark:border-red-500' : 'w-full'}}",
                                "buttonText": "$t:common.browse",
                                "placeholder": "$t:admin.templates.tabs.no_file_selected"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_global.templateInstallErrors?.file}}",
                            "props": {
                                "className": "form-error-xs mt-1"
                            },
                            "text": "{{Array.isArray(_global.templateInstallErrors?.file) ? _global.templateInstallErrors.file[0] : _global.templateInstallErrors?.file}}"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-start gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "info-circle",
                                        "className": "text-blue-500 mt-0.5",
                                        "size": "sm"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "text-info-soft"
                                            },
                                            "text": "$t:admin.templates.tabs.file_requirements"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "mt-1 text-sm font-mono text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/40 px-2 py-1 rounded inline-block"
                                            },
                                            "text": "template.json"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "mt-1 text-info-soft"
                                            },
                                            "text": "$t:admin.templates.tabs.file_structure_hint"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "template_github_tab",
            "type": "basic",
            "name": "Div",
            "if": "{{_global.templateInstallTab === 'github'}}",
            "props": {
                "className": "mt-4 space-y-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "children": [
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "form-label"
                            },
                            "text": "$t:admin.templates.tabs.github_url_label"
                        },
                        {
                            "type": "basic",
                            "name": "Input",
                            "actions": [
                                {
                                    "comment": "템플릿 저장소 주소 입력 — 파일 선택과 같이 지난 오류를 함께 지운다.",
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "templateGithubUrl": "{{$event.target.value}}",
                                        "templateInstallError": null,
                                        "templateInstallErrors": null
                                    }
                                }
                            ],
                            "props": {
                                "type": "url",
                                "placeholder": "https://github.com/username/template-name",
                                "value": "{{_global.templateGithubUrl ?? ''}}",
                                "className": "input {{_global.templateInstallErrors?.github_url ? 'input-error' : ''}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "if": "{{_global.templateInstallErrors?.github_url}}",
                            "props": {
                                "className": "form-error-xs mt-1"
                            },
                            "text": "{{Array.isArray(_global.templateInstallErrors?.github_url) ? _global.templateInstallErrors.github_url[0] : _global.templateInstallErrors?.github_url}}"
                        },
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-tertiary"
                            },
                            "text": "$t:admin.templates.tabs.github_url_hint"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "p-3 bg-blue-50 dark:bg-blue-900/20 rounded-lg"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex-start gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "info-circle",
                                        "className": "text-blue-500 mt-0.5",
                                        "size": "sm"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "text-info-soft"
                                            },
                                            "text": "$t:admin.templates.tabs.github_requirements"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "mt-1 text-sm font-mono text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/40 px-2 py-1 rounded inline-block"
                                            },
                                            "text": "template.json"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "mt-1 text-info-soft"
                                            },
                                            "text": "$t:admin.templates.tabs.github_public_only"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "modal-footer-buttons"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "취소 — 입력·오류·탭을 처음 상태로 되돌린다(다시 열었을 때 지난 파일이 남지 않게).",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "templateUploadFile": null,
                                        "templateUploadFileName": null,
                                        "templateGithubUrl": null,
                                        "templateInstallError": null,
                                        "templateInstallErrors": null,
                                        "templateInstallTab": "file_upload"
                                    }
                                },
                                {
                                    "handler": "closeModal"
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "btn btn-secondary",
                        "disabled": "{{_global.isTemplateManualInstalling}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "설치 실행 — 갈래에 따라 주소·전송 형식·본문이 함께 갈린다.\n               실패는 토스트가 아니라 창 안에 남긴다(입력을 고쳐 바로 다시 시도하는 자리다).",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isTemplateManualInstalling": true,
                                        "templateInstallError": null,
                                        "templateInstallErrors": null
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "{{(!_global.templateInstallTab || _global.templateInstallTab === 'file_upload') ? '/api/admin/templates/install-from-file' : '/api/admin/templates/install-from-github'}}",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST",
                                        "contentType": "{{(!_global.templateInstallTab || _global.templateInstallTab === 'file_upload') ? 'multipart/form-data' : 'application/json'}}",
                                        "body": "{{(!_global.templateInstallTab || _global.templateInstallTab === 'file_upload') ? { file: _global.templateUploadFile } : { github_url: _global.templateGithubUrl }}}"
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isTemplateManualInstalling": false,
                                                "templateUploadFile": null,
                                                "templateUploadFileName": null,
                                                "templateGithubUrl": null,
                                                "templateInstallError": null,
                                                "templateInstallErrors": null,
                                                "templateInstallTab": "file_upload"
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.templates.install_success"
                                            }
                                        },
                                        {
                                            "comment": "7.0 JSON 레이아웃의 깨진 조각 참조는 설치를 막지 않고 빈 자리로 등록된다 — 몇 건인지 경고로 알린다.",
                                            "handler": "toast",
                                            "if": "{{(response?.data?.layout_warnings?.length ?? 0) > 0}}",
                                            "params": {
                                                "type": "warning",
                                                "message": "$t:extensions.alerts.layout_include_skipped|count={{response?.data?.layout_warnings?.length ?? 0}}"
                                            }
                                        },
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "templates"
                                            }
                                        },
                                        {
                                            "handler": "reloadExtensions"
                                        },
                                        {
                                            "handler": "closeModal"
                                        }
                                    ],
                                    "onError": {
                                        "handler": "setState",
                                        "params": {
                                            "target": "global",
                                            "isTemplateManualInstalling": false,
                                            "templateInstallError": "{{error.message}}",
                                            "templateInstallErrors": "{{error.errors}}"
                                        }
                                    }
                                }
                            ]
                        }
                    ],
                    "props": {
                        "type": "button",
                        "className": "flex-center gap-2 px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isTemplateManualInstalling || ((!_global.templateInstallTab || _global.templateInstallTab === 'file_upload') ? !_global.templateUploadFile : !_global.templateGithubUrl)}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{!_global.isTemplateManualInstalling}}",
                            "props": {
                                "name": "download",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isTemplateManualInstalling}}",
                            "props": {
                                "name": "spinner",
                                "className": "animate-spin",
                                "size": "sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isTemplateManualInstalling ? '$t:admin.templates.installing' : '$t:admin.templates.actions.install'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
