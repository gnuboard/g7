{
    "comment": "**이 템플릿이 요구하는 확장이 없는데도** 활성하겠다는 확인 창. 활성 창이 409 를 받았을 때 열린다.\n  무엇이 없는지는 전역 `activateWarningData` 에 담긴 서버 오류를 읽는다.\n  템플릿에는 강제 **비활성** 창이 없다 — 템플릿에 의존하는 확장이라는 방향이 없기 때문이다.",
    "meta": {
        "is_partial": true,
        "description": "템플릿 강제 활성화 확인 모달",
        "editor_label": "$t:admin.modal_label.admin_template_list.template_force_activate_modal"
    },
    "id": "template_force_activate_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:admin.templates.modals.activate_warning_title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "py-2"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "alert-warning"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "warning",
                                "className": "text-xl text-yellow-600 dark:text-yellow-500 flex-shrink-0 mt-0.5"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-warning-soft"
                                    },
                                    "text": "$t:admin.templates.modals.activate_warning_message"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_global.activateWarningData?.missing_modules?.length > 0}}",
                    "props": {
                        "className": ""
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-body font-medium mb-2"
                            },
                            "text": "$t:admin.templates.modals.missing_modules"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "iteration": {
                                        "source": "_global.activateWarningData?.missing_modules ?? []",
                                        "item_var": "module"
                                    },
                                    "props": {
                                        "className": "flex-center gap-2 p-2 bg-gray-50 dark:bg-gray-700/50 rounded"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "cube",
                                                "className": "text-base text-gray-500 dark:text-gray-400"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-body"
                                            },
                                            "text": "{{module.name || module.identifier}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{module.status === 'inactive'}}",
                                            "props": {
                                                "className": "text-secondary text-xs px-2 py-0.5 bg-gray-100 dark:bg-gray-600 rounded"
                                            },
                                            "text": "$t:admin.modules.status.inactive"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{module.status === 'not_installed'}}",
                                            "props": {
                                                "className": "text-xs px-2 py-0.5 bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 rounded"
                                            },
                                            "text": "$t:admin.modules.status.not_installed"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "if": "{{_global.activateWarningData?.missing_plugins?.length > 0}}",
                    "props": {
                        "className": ""
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "P",
                            "props": {
                                "className": "text-body font-medium mb-2"
                            },
                            "text": "$t:admin.templates.modals.missing_plugins"
                        },
                        {
                            "type": "basic",
                            "name": "Div",
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "iteration": {
                                        "source": "_global.activateWarningData?.missing_plugins ?? []",
                                        "item_var": "plugin"
                                    },
                                    "props": {
                                        "className": "flex-center gap-2 p-2 bg-gray-50 dark:bg-gray-700/50 rounded"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Icon",
                                            "props": {
                                                "name": "plug",
                                                "className": "text-base text-gray-500 dark:text-gray-400"
                                            }
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-body"
                                            },
                                            "text": "{{plugin.name || plugin.identifier}}"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{plugin.status === 'inactive'}}",
                                            "props": {
                                                "className": "text-secondary text-xs px-2 py-0.5 bg-gray-100 dark:bg-gray-600 rounded"
                                            },
                                            "text": "$t:admin.plugins.status.inactive"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "if": "{{plugin.status === 'not_installed'}}",
                                            "props": {
                                                "className": "text-xs px-2 py-0.5 bg-purple-100 dark:bg-purple-900/50 text-purple-600 dark:text-purple-400 rounded"
                                            },
                                            "text": "$t:admin.plugins.status.not_installed"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "mt-4 text-label"
                    },
                    "text": "$t:admin.templates.modals.force_activate_description"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "modal-footer-buttons"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "취소 — 목록을 다시 받아 켜진 모양으로 남은 스위치를 서버 값으로 되돌린다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "activateWarningData": null
                                    }
                                },
                                {
                                    "handler": "refetchDataSource",
                                    "params": {
                                        "dataSourceId": "templates"
                                    }
                                },
                                {
                                    "handler": "closeModal"
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "btn btn-secondary",
                        "disabled": "{{_global.isForceActivating}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "$t:common.cancel"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Button",
                    "actions": [
                        {
                            "comment": "강제 활성 실행 — 요구 확장이 없는 채로 켠다. 성공하면 목록과 확장 번들을 갱신한다.",
                            "type": "click",
                            "handler": "sequence",
                            "actions": [
                                {
                                    "handler": "setState",
                                    "params": {
                                        "target": "global",
                                        "isForceActivating": true
                                    }
                                },
                                {
                                    "handler": "apiCall",
                                    "target": "/api/admin/templates/activate",
                                    "auth_required": true,
                                    "params": {
                                        "method": "POST",
                                        "body": {
                                            "template_name": "{{_global.selectedTemplate.identifier}}",
                                            "force": true
                                        }
                                    },
                                    "onSuccess": [
                                        {
                                            "handler": "refetchDataSource",
                                            "params": {
                                                "dataSourceId": "templates"
                                            }
                                        },
                                        {
                                            "handler": "reloadExtensions"
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "success",
                                                "message": "$t:admin.templates.activate_success"
                                            }
                                        },
                                        {
                                            "handler": "closeModal"
                                        },
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isForceActivating": false,
                                                "activateWarningData": null,
                                                "selectedTemplate": null
                                            }
                                        },
                                        {
                                            "comment": "템플릿과 함께 꺼졌던 언어팩이 있으면 되살릴지 묻는다(서버는 목록을 건넨 뒤 지운다).\n                     강제 활성은 새로 고침을 하지 않으므로 창이 닫힐 때도 새로 고치지 않는다.",
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "reactivateLanguagePacksData": "{{(response.data?.pending_language_packs ?? [])}}",
                                                "reactivateLanguagePacksRefreshAfter": false
                                            }
                                        },
                                        {
                                            "handler": "openModal",
                                            "target": "template_reactivate_language_packs_modal",
                                            "if": "{{(response.data?.pending_language_packs ?? []).length > 0 && (current_user?.data?.permissions ?? []).some(p => (p?.identifier ?? p) === 'core.language_packs.manage')}}"
                                        }
                                    ],
                                    "onError": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "isForceActivating": false
                                            }
                                        },
                                        {
                                            "handler": "toast",
                                            "params": {
                                                "type": "error",
                                                "message": "{{error.message}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ],
                    "props": {
                        "className": "flex-center gap-2 px-4 py-2 bg-yellow-600 dark:bg-yellow-500 text-white rounded-lg hover:bg-yellow-700 dark:hover:bg-yellow-600 disabled:opacity-50 disabled:cursor-not-allowed",
                        "disabled": "{{_global.isForceActivating}}"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "if": "{{_global.isForceActivating}}",
                            "props": {
                                "name": "spinner",
                                "className": "spinner-sm"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{_global.isForceActivating ? '$t:admin.templates.activating' : '$t:admin.templates.modals.confirm_activate'}}"
                        }
                    ]
                }
            ]
        }
    ]
}
