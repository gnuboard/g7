                                                "query": {
                                                    "exclude": "{{(function(cur, on) { const next = on ? [...cur.filter(t => t !== 'admin'), 'admin'] : cur.filter(t => t !== 'admin'); return next.length > 0 ? next.join(',') : undefined; })((query.exclude || '').split(',').filter(Boolean), ($event?.target?.checked ?? $event) === true)}}",
