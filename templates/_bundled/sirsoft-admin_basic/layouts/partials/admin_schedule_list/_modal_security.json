                        },
                        {
                            "id": "schedule_security_url",
                            "type": "basic",
                            "name": "Div",
                            "if": "{{_global.scheduleSecurity?.url !== undefined}}",
                            "props": {
                                "className": "p-3 rounded-lg border border-gray-200 dark:border-gray-700"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-between gap-2"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-heading"
                                            },
                                            "text": "$t:admin.schedules.security.url.block_private_hosts"
                                        },
                                        {
                                            "type": "composite",
                                            "name": "Badge",
                                            "props": {
                                                "color": "{{_global.scheduleSecurity?.url?.block_private_hosts ? 'green' : 'gray'}}",
                                                "size": "md",
                                                "text": "{{_global.scheduleSecurity?.url?.block_private_hosts ? $t('admin.schedules.security.shell.enabled') : $t('admin.schedules.security.shell.disabled')}}"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
